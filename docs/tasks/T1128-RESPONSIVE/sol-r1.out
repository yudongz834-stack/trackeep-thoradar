@media(prefers-reduced-motion:reduce){.sweep{animation:none}.blip{transition:none}.journal-sector{transition:none}}
/* 期刊合集（第 1 期：纯本地 localStorage；抽屉＝panel 同族语言，零外部库） */
.coll-head{display:flex;align-items:center;gap:8px;padding-top:1px}
.coll-toggle{border:1px solid var(--line);background:var(--card-2);border-radius:6px;padding:6px 9px;font-size:10px;color:var(--text-2);cursor:pointer;white-space:nowrap}
.coll-toggle:hover{border-color:var(--accent);color:var(--accent-dark)}
.coll-toggle.active{background:var(--accent-soft);border-color:color-mix(in srgb,var(--accent) 35%,var(--line));color:var(--accent-on-soft)}
.coll-mask{position:fixed;inset:0;background:rgba(0,0,0,.32);z-index:40}
.coll-drawer{position:fixed;top:0;right:0;bottom:0;width:min(420px,94vw);z-index:41;display:flex;flex-direction:column;border-radius:14px 0 0 14px;border-right:0;overflow:hidden}
.coll-head-bar{padding:16px 16px 12px;display:flex;align-items:flex-start;justify-content:space-between;gap:8px;border-bottom:1px solid var(--line)}
.coll-head-bar h2{margin:5px 0 0;font-size:15px;line-height:1.25;letter-spacing:.02em}
.coll-close{width:30px;height:30px;border:1px solid var(--line);border-radius:8px;background:var(--card-2);cursor:pointer;display:grid;place-items:center;font-size:12px;color:var(--muted)}
.coll-close:hover{border-color:var(--accent);color:var(--accent-dark)}
.coll-body{flex:1;min-height:0;overflow:auto;padding:12px 14px 18px;display:flex;flex-direction:column;gap:14px}
  $('#jcat-legend').innerHTML=`<button class="journal-btn ${active?'active':''}" data-jcat="${JCATS_LEGEND_MERGED.id}" title="${t('merged.tip')}" aria-pressed="${active}">${esc(JCATS_LEGEND_MERGED.label)}<em>${total}</em></button>`;
}
function renderDesignLegend(list){
  const count=kind=>list.filter(p=>designOf(p)===kind).length;
  $('#design-legend').innerHTML=`<span><i class="legend-shape rct"></i>RCT · ${count('rct')}</span><span><i class="legend-shape cohort"></i>${t('design.cohort')} · ${count('cohort')}</span><span><i class="legend-shape"></i>${t('design.pending')} · ${count('pending')}</span><span>${t('legend.tip')}</span>`;
}
function renderScope(list,base,groups,counts,assignOf){
  const visible=new Set(list.map(p=>p.id)),POSITIONS=positions(base,groups,assignOf);
  const activeSec=activeScheme()?state.gsec:state.jcat;   // 扇区选中态随命名空间取值
  $('#journal-sectors').innerHTML=groups.map((g,i)=>sectorMarkup(g,i,groups.length,counts.get(g.cat)||0,activeSec)).join('');
  $('#blips').innerHTML=base.map(p=>{
    const pos=POSITIONS[p.id]||{left:50,top:50};
    const cls=[designOf(p),state.selected===p.id&&visible.has(p.id)?'selected':'',state.read.has(p.id)?'read':'',visible.has(p.id)?'':'dim'].join(' ');
    return `<button class="blip ${cls}" style="left:${pos.left.toFixed(2)}%;top:${pos.top.toFixed(2)}%" data-select="${esc(p.id)}" title="${tf('blip.title',{j:esc(journalName(p)),s:esc(show(p.score_total)),t:esc(p.title_zh||p.title_en||'—')})}" aria-label="${esc(p.title_zh||p.title_en||'—')}"></button>`;
  }).join('');
  const sectorSize=360/Math.max(groups.length,1);
  $('#scope-labels').innerHTML=groups.map((g,i)=>{
    const a=(-90+(i+.5)*sectorSize)*Math.PI/180,r=45.5,name=g.label.length>13?g.label.slice(0,12)+'…':g.label;
    return `<span class="scope-label" title="${esc(tf('sec.tip',{label:g.label,n:counts.get(g.cat)||0}))}" style="left:${50+Math.cos(a)*r}%;top:${50+Math.sin(a)*r}%">${esc(name)} · ${counts.get(g.cat)||0}</span>`;
  }).join('');
  const shelfEmpty=myJournalsStore.filterOn&&!list.length;
  const shelfFiltered=shelfEmpty&&windowPapers().some(p=>myJournalsStore.picks.includes(paperJournalKey(p)));
  const shelfEmptyText=tf(shelfFiltered?'shelf.empty.filtered':'shelf.empty.scope',{n:myJournalsStore.picks.length,d:state.days});
  $('#scope-empty').classList.toggle('show',!list.length);
  $('#scope-empty').classList.toggle('shelf-empty',shelfEmpty);
  $('#scope-empty').innerHTML=shelfEmpty?`${shelfEmptyText}<div class="shelf-empty-actions"><button type="button" class="shelf-empty-btn primary" data-shelf-close-filter>${t('shelf.empty.close')}</button><button type="button" class="shelf-empty-btn" data-shelf-add>${t('shelf.empty.add')}</button></div>`:!base.length?`${t('scope.empty.base')}<br>${t('scope.empty.base2')}`:`${t('scope.empty.none')}<br>${t('scope.empty.none2')}`;
  $('#hub-count').textContent=list.length;
      blip.addEventListener('focus',()=>protoShowRadarTip(p,blip));
      blip.addEventListener('mouseleave',protoHideRadarTip);
      blip.addEventListener('blur',protoHideRadarTip);
    });
    $('#journal-sectors').querySelectorAll('.journal-sector').forEach(sec=>sec.style.setProperty('--proto-domain',protoDomainColor(sec.dataset.jcat)));
  };
  /* 个性化四分区＝期刊合集/自定义阵地/我的主题+AI 设置/我的书架；分区切换只走 hidden 通道。 */
  const protoPersonalPanels={collections:['coll-list','coll-editor'],sectors:['scheme-list','scheme-editor'],topics:['topic-list','topic-editor','ai-settings'],shelf:['myjournals-panel']};
  function protoApplyPersonalPanels(){
    Object.entries(protoPersonalPanels).forEach(([tab,ids])=>ids.forEach(id=>{const el=document.getElementById(id);if(el)el.hidden=protoView==='personal'&&protoPersonalTab!==tab}));
    document.querySelectorAll('[data-proto-personal-tab]').forEach(btn=>btn.setAttribute('aria-pressed',String(btn.dataset.protoPersonalTab===protoPersonalTab)));
  }
  function protoSetPersonalTab(tab){protoPersonalTab=tab;protoApplyPersonalPanels();if(tab==='shelf')renderMyJournals()}
  document.querySelectorAll('[data-proto-personal-tab]').forEach(btn=>btn.addEventListener('click',()=>protoSetPersonalTab(btn.dataset.protoPersonalTab)));
  function protoMeasure(){document.documentElement.style.setProperty('--proto-header-h',`${Math.round(document.querySelector('.topbar').getBoundingClientRect().height)}px`)}
  const protoFiltersOpen={overview:false,reading:false};   /* 两视图缺省都收起；各自保留本次会话选择，不持久化 */
  function protoSyncFilters(){
    const open=Object.prototype.hasOwnProperty.call(protoFiltersOpen,protoView)?protoFiltersOpen[protoView]:false;
    document.body.classList.toggle('filters-open',open);
    const b=document.querySelector('.filters-toggle');
    if(b){b.setAttribute('aria-expanded',String(open));b.textContent=t(open?'filters.hide':'filters.show')}
  }
  function protoSetView(view){
    if(!['overview','reading','personal'].includes(view))return;
    protoView=view;document.body.dataset.protoView=view;protoHideRadarTip();protoSyncFilters();
    if(view==='personal'){
      if($('#coll-drawer').hidden)openCollDrawer();$('#coll-mask').hidden=true;
    }else{
      if(!$('#coll-drawer').hidden)closeCollDrawer();
      if(view==='reading'){const items=protoReadingItems(personalFiltered());if(items.length&&!items.some(p=>p.id===state.selected))state.selected=items[0].id}   // 选中校正与可见阅读卡同一份清单（含「显示其余」展开态）
    }
