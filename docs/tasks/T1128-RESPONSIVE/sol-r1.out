::selection{background:var(--accent-soft);color:var(--accent-on-soft)}
.topbar{height:76px;padding:0 20px;display:grid;grid-template-columns:auto auto minmax(220px,420px) auto;align-items:center;gap:24px;border-bottom:1px solid var(--line);background:var(--card);position:relative;z-index:20}
.brand{display:flex;align-items:center;gap:11px;min-width:max-content}
.brand-mark{width:38px;height:38px;color:var(--accent-dark)}
.brand-name{display:block;font-size:17px;letter-spacing:.08em;line-height:1.15}
.brand-sub{display:block;margin-top:5px;font:9px/1 var(--font-mono);letter-spacing:.17em;color:var(--muted)}
.scan-meta{display:flex;align-items:center;gap:9px;padding-left:22px;border-left:1px solid var(--line);white-space:nowrap}
.scan-meta b{display:block;font:600 12px/1.2 var(--font-mono);letter-spacing:.04em}
.scan-meta small{display:block;margin-top:5px;color:var(--muted);font-size:11px}
.live-dot{width:8px;height:8px;border-radius:50%;background:var(--success);box-shadow:0 0 0 4px var(--success-soft);flex:0 0 auto}
.search{height:38px;display:flex;align-items:center;gap:8px;padding:0 11px;background:var(--card-2);border:1px solid var(--line);border-radius:9px;color:var(--muted);min-width:0}
.search svg{width:15px;height:15px;flex:0 0 auto}
.search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:12px}
.search input::placeholder{color:var(--muted)}
.search kbd{font:10px/1 var(--font-mono);border:1px solid var(--line);border-radius:4px;padding:4px 5px;background:var(--card)}
.icon-btn{width:38px;height:38px;border:1px solid var(--line);border-radius:9px;background:var(--card-2);display:grid;place-items:center;cursor:pointer}
.icon-btn:hover{border-color:var(--accent);color:var(--accent-dark)}
.icon-btn svg{width:17px;height:17px}
.icon-btn.lang-btn{font:700 11px/1 var(--font-mono);letter-spacing:.06em}
.deck{height:calc(100vh - 112px);min-height:640px;padding:16px 18px;display:grid;grid-template-columns:252px minmax(420px,1fr) 350px;grid-template-areas:"queue scope detail";gap:16px;max-width:1800px;margin:0 auto}
.panel{min-width:0;min-height:0;background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow-sm)}
.queue-panel{grid-area:queue;display:flex;flex-direction:column;overflow:hidden}
.panel-head{padding:16px 16px 12px;display:flex;align-items:flex-start;justify-content:space-between;gap:8px;border-bottom:1px solid var(--line)}
.eyebrow{font:600 9px/1.2 var(--font-mono);letter-spacing:.17em;color:var(--accent-on-soft);text-transform:uppercase}
.panel-head h2,.scope-head h1{margin:5px 0 0;font-size:15px;line-height:1.25;letter-spacing:.02em}
.counter{font:600 11px/1 var(--font-mono);color:var(--muted);padding-top:3px;white-space:nowrap}
.filters{padding:12px 12px 10px;border-bottom:1px solid var(--line)}
.filter-label{margin:0 0 8px 2px;font-size:10px;color:var(--muted)}
.filter-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px}
.filter-btn{min-width:0;border:1px solid transparent;background:transparent;border-radius:7px;padding:7px 7px;display:flex;align-items:center;justify-content:space-between;gap:4px;cursor:pointer;text-align:left;font-size:10.5px;color:var(--text-2)}
.filter-btn span:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.filter-btn em{font:9px/1 var(--font-mono);font-style:normal;color:var(--muted)}
.filter-btn:hover{background:var(--card-2)}
.filter-btn.active{background:var(--accent-soft);border-color:color-mix(in srgb,var(--accent) 28%,var(--line));color:var(--accent-on-soft)}
.filter-btn.active em{color:var(--accent-on-soft)}
.quick-row{display:flex;gap:5px;margin-top:9px}
.quick-btn{flex:1;border:1px solid var(--line);background:var(--card-2);border-radius:6px;padding:6px 3px;font-size:9.5px;color:var(--muted);cursor:pointer;white-space:nowrap}
.quick-btn.active{background:var(--text);border-color:var(--text);color:var(--card)}
.queue-title{padding:12px 16px 7px;display:flex;align-items:center;justify-content:space-between;gap:10px;color:var(--muted);font-size:10px}
.queue-title [data-i18n="queue.title1"]{min-width:0}   /* FIX-3：英文混排标题不再被右侧「点击锁定」挤成三行 */
.queue-title span:last-child{font:9px/1 var(--font-mono)}
.queue-list{list-style:none;margin:0;padding:0 7px 10px;overflow:auto;min-height:0;scrollbar-width:thin;scrollbar-color:var(--line) transparent}
/* 懒加载骨架屏（2026-11-08 数据瘦身）：滑杆拉历史档案时的加载态；hidden 属性开关，无 style.display */
.rolling-skeleton{display:grid;gap:9px;padding:12px 16px 6px}
.rolling-skeleton .sk-bar{height:12px;border-radius:6px;opacity:.5;background:linear-gradient(90deg,var(--line) 25%,var(--muted) 50%,var(--line) 75%);background-size:200% 100%;animation:sk-shimmer 1.1s linear infinite}
.rolling-skeleton .sk-2{width:88%}.rolling-skeleton .sk-3{width:72%}
@keyframes sk-shimmer{from{background-position:200% 0}to{background-position:-200% 0}}
.window-hint{display:block;margin-top:4px;font-size:11px;line-height:1.4;color:var(--muted)}
.queue-item{margin:2px 0}
.queue-btn{width:100%;min-width:0;display:grid;grid-template-columns:25px minmax(0,1fr) 30px;gap:7px;align-items:start;padding:10px 8px;border:1px solid transparent;border-radius:8px;background:transparent;text-align:left;cursor:pointer}
.queue-btn:hover{background:var(--card-2)}
.queue-btn.selected{background:var(--accent-soft);border-color:color-mix(in srgb,var(--accent) 25%,var(--line))}
.queue-index{font:10px/1.4 var(--font-mono);color:var(--muted);padding-top:2px}
.queue-btn.selected .queue-index{color:var(--accent-on-soft)}
.queue-text{min-width:0}
.queue-text strong{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:11px;line-height:1.45;font-weight:550;overflow-wrap:anywhere}
.queue-text small{display:block;margin-top:5px;color:var(--muted);font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.queue-score{font:600 10px/1.4 var(--font-mono);color:var(--accent-on-soft);text-align:right}
.queue-item.read .queue-text strong{color:var(--muted)}
.queue-item.read .queue-index{color:var(--success-on-soft)}
.queue-empty{padding:28px 16px;text-align:center;color:var(--muted);font-size:12px;line-height:1.7}
.scope-panel{grid-area:scope;min-width:0;min-height:0;display:flex;flex-direction:column;padding:3px 8px 0;overflow:hidden}
.scope-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;padding:4px 4px 8px}
.scope-head h1{font-size:18px}
.scope-head p{margin:5px 0 0;color:var(--muted);font-size:10px}
.read-progress{text-align:right;white-space:nowrap}
.read-progress b{display:block;font:600 18px/1 var(--font-mono);color:var(--accent-dark)}
.read-progress small{display:block;margin-top:5px;color:var(--muted);font-size:9px}
.scope-stage{flex:1;min-height:0;display:grid;place-items:center;position:relative}
.scope{position:relative;width:min(100%,calc(100vh - 292px));max-width:640px;min-width:340px;aspect-ratio:1;border-radius:50%;background:color-mix(in srgb,var(--card) 72%,var(--bg));box-shadow:inset 0 0 0 1px var(--line),var(--shadow-card);isolation:isolate}
.scope-grid{position:absolute;inset:0;width:100%;height:100%;z-index:0;color:var(--line)}
.sweep{position:absolute;inset:0;border-radius:50%;z-index:1;pointer-events:none;background:conic-gradient(from 0deg,transparent 0deg,transparent 312deg,color-mix(in srgb,var(--accent) 4%,transparent) 326deg,color-mix(in srgb,var(--accent) 18%,transparent) 352deg,color-mix(in srgb,var(--accent) 32%,transparent) 360deg);animation:sweep 10s linear infinite}
@keyframes sweep{to{transform:rotate(360deg)}}
.scope-label{position:absolute;z-index:2;transform:translate(-50%,-50%);font:600 9px/1 var(--font-mono);letter-spacing:.04em;color:var(--muted);white-space:nowrap;pointer-events:none;background:var(--bg);border:1px solid var(--line);border-radius:4px;padding:4px 5px}
.blip{--rot:0deg;position:absolute;z-index:4;width:12px;height:12px;padding:0;border:0;border-radius:50%;background:var(--muted);transform:translate(-50%,-50%) rotate(var(--rot));cursor:pointer;transition:opacity .18s,box-shadow .18s,background .18s}
.blip:hover{background:var(--accent);box-shadow:0 0 0 5px var(--accent-soft)}
.blip.rct{width:14px;height:14px;border-radius:3px;background:var(--accent);--rot:45deg}
.blip.cohort{width:13px;height:13px;background:var(--card);border:2px solid var(--accent-dark)}
.blip.selected{z-index:6;background:var(--accent-dark);box-shadow:0 0 0 5px var(--accent-soft),0 0 0 6px var(--accent-dark)}
.blip.read:not(.selected){opacity:.38}
.blip.dim{opacity:.07;pointer-events:none}
.scope-hub{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:3;width:68px;height:68px;border-radius:50%;border:1px solid var(--line);background:var(--card);display:grid;place-content:center;text-align:center;box-shadow:var(--shadow-sm);pointer-events:none}
.scope-hub b{font:600 21px/1 var(--font-mono);color:var(--accent-dark)}
.scope-hub small{margin-top:5px;font:8px/1 var(--font-mono);letter-spacing:.13em;color:var(--muted)}
.scope-empty{display:none;position:absolute;z-index:8;left:50%;top:50%;transform:translate(-50%,-50%);width:190px;padding:16px;border:1px solid var(--line);border-radius:10px;background:var(--card);text-align:center;box-shadow:var(--shadow-card);color:var(--muted);font-size:12px;line-height:1.6}
.scope-empty.show{display:block}
.scope-foot{padding:8px 4px 0}
.legend{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:13px;color:var(--muted);font-size:9.5px}
.legend span{display:flex;align-items:center;gap:5px}
.legend-shape{width:8px;height:8px;border-radius:50%;background:var(--muted);display:inline-block}
.legend-shape.rct{border-radius:2px;background:var(--accent);transform:rotate(45deg)}
.legend-shape.cohort{background:var(--card);border:1.5px solid var(--accent-dark)}
.funnel{margin-top:10px;padding-top:10px;border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
.funnel-step{position:relative;text-align:center;color:var(--muted);font-size:9px}
.funnel-step:not(:last-child)::after{content:"→";position:absolute;right:-6px;top:2px;color:var(--line);font-family:var(--font-mono)}
.funnel-step b{display:block;margin-bottom:4px;font:600 13px/1 var(--font-mono);color:var(--text-2)}
.funnel-step:last-child b{color:var(--accent-dark)}
.detail-panel{grid-area:detail;overflow:auto;scrollbar-width:thin;scrollbar-color:var(--line) transparent}
.detail-inner{padding:17px 18px 16px}
.detail-top{display:flex;align-items:center;justify-content:space-between;gap:8px;padding-bottom:13px;border-bottom:1px solid var(--line)}
.lock-id{font:600 10px/1 var(--font-mono);letter-spacing:.12em;color:var(--accent-on-soft)}
.status-pill{display:inline-flex;align-items:center;gap:5px;border-radius:20px;background:var(--success-soft);color:var(--success-on-soft);padding:5px 7px;font-size:9px;white-space:nowrap}
.status-pill::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--success)}
.detail-journal{margin-top:16px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.journal-name{font-size:11px;font-weight:650;color:var(--text-2);overflow-wrap:anywhere}
.journal-meta{margin-top:5px;font:9px/1.4 var(--font-mono);color:var(--muted)}
.score-box{text-align:right;flex:0 0 auto}
.score-box b{font:600 28px/.9 var(--font-mono);color:var(--accent-dark)}
.score-box small{display:block;margin-top:6px;color:var(--muted);font-size:8px}
.score-track{height:3px;background:var(--line);border-radius:4px;margin-top:12px;overflow:hidden}
.score-track i{display:block;height:100%;background:var(--accent);border-radius:4px}
.detail-title{margin:16px 0 13px;font-size:19px;line-height:1.36;font-weight:650;letter-spacing:-.012em;overflow-wrap:anywhere}
.badges{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:15px}
.badge{display:inline-flex;align-items:center;min-height:23px;padding:4px 7px;border-radius:5px;background:var(--card-2);border:1px solid var(--line);color:var(--text-2);font-size:9px;line-height:1.35}
.badge.accent{background:var(--accent-soft);border-color:transparent;color:var(--accent-on-soft)}
.meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:16px}
.meta-cell{min-width:0;padding:10px 4px}
.meta-cell:nth-child(even){padding-left:12px;border-left:1px solid var(--line)}
.meta-cell small{display:block;color:var(--muted);font-size:8.5px;margin-bottom:5px}
.meta-cell b{display:block;font:500 10px/1.45 var(--font-mono);overflow-wrap:anywhere}
.excerpt-label{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px}
.excerpt-label b{font-size:11px}
.excerpt-label span{font:8px/1 var(--font-mono);color:var(--muted)}
.excerpt{margin:0;color:var(--text-2);font-size:12px;line-height:1.72;overflow-wrap:anywhere}
.honesty-note{margin:14px 0 0;padding:10px 11px;border-left:2px solid var(--line);background:var(--card-2);color:var(--muted);font-size:10px;line-height:1.6}
.detail-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:16px}
.action-btn{min-width:0;min-height:36px;display:inline-flex;align-items:center;justify-content:center;gap:5px;border:1px solid var(--line);border-radius:8px;background:var(--card-2);color:var(--text-2);text-decoration:none;font-size:10px;cursor:pointer;padding:8px}
.action-btn:hover{border-color:var(--accent);color:var(--accent-dark)}
.action-btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
html.dark .action-btn.primary{color:var(--on-accent)}
.action-btn.wide{grid-column:1/-1}
.action-btn.marked{background:var(--success-soft);border-color:transparent;color:var(--success-on-soft)}
.detail-nav{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:14px;padding-top:13px;border-top:1px solid var(--line)}
.nav-btn{border:0;background:transparent;color:var(--muted);font-size:10px;cursor:pointer;padding:5px 0}
.nav-btn:hover{color:var(--accent-dark)}
.nav-position{font:9px/1 var(--font-mono);color:var(--muted)}
.detail-empty{padding:40px 22px;text-align:center;color:var(--muted);font-size:12px;line-height:1.8}
.beian{color:var(--muted);text-decoration:none}
.footer{height:36px;padding:0 20px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:16px;color:var(--muted);font-size:9px;background:var(--card)}
.footer span{min-width:0}
.footer .keys{font-family:var(--font-mono);white-space:nowrap}
.scope{width:min(100%,calc(100vh - 360px));min-width:300px}
.tier-block{margin-top:11px}
.tier-chips{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}
.tier-chip{border:1px solid var(--line);background:var(--card-2);border-radius:6px;padding:6px 3px;color:var(--muted);font:600 10px/1 var(--font-mono);cursor:pointer}
.tier-chip:hover{border-color:var(--accent);color:var(--accent-dark)}
.tier-chip.active{background:var(--accent-soft);border-color:color-mix(in srgb,var(--accent) 35%,var(--line));color:var(--accent-on-soft)}
.window-control{margin-top:12px;padding-top:11px;border-top:1px solid var(--line)}
.window-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.window-top label{font-size:10px;color:var(--muted)}
.window-value{font:600 10px/1 var(--font-mono);color:var(--accent-on-soft);white-space:nowrap}
#window-range{display:block;width:100%;margin:9px 0 7px;accent-color:var(--accent);cursor:pointer}
.window-label{display:block;color:var(--text-2);font:9px/1.5 var(--font-mono);text-align:center;white-space:nowrap}
.journal-sectors{position:absolute;inset:0;width:100%;height:100%;z-index:1;overflow:visible}
.journal-sector{fill:transparent;stroke:var(--line);stroke-width:.55;cursor:pointer;transition:fill .18s,stroke .18s}
.journal-sector:nth-child(even){fill:color-mix(in srgb,var(--card) 20%,transparent)}
.journal-sector:hover,.journal-sector:focus-visible{fill:color-mix(in srgb,var(--accent) 10%,transparent);stroke:var(--accent);outline:none}
.journal-sector.active{fill:color-mix(in srgb,var(--accent) 18%,transparent);stroke:var(--accent-dark);stroke-width:1.4}
.journal-toolbar{display:flex;align-items:center;justify-content:center;gap:8px;min-height:22px;color:var(--muted);font-size:9px}
.journal-toolbar span{max-width:75%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.journal-clear{border:1px solid var(--line);border-radius:5px;background:var(--card-2);color:var(--text-2);padding:3px 7px;font-size:9px;cursor:pointer}
.journal-clear:disabled{opacity:.4;cursor:default}
.jcat-folds{display:flex;justify-content:center;flex-wrap:wrap;gap:5px;margin:2px 0 4px;min-height:0}
.jcat-fold{border:1px dashed var(--line);border-radius:10px;background:transparent;color:var(--muted);padding:3px 7px;font-size:8px;line-height:1.25;cursor:pointer}
.jcat-fold.open{border-style:solid}
.jcat-fold:hover{border-color:var(--accent);color:var(--accent-dark)}
.jcat-fold.active{background:var(--accent-soft);border-color:var(--accent);color:var(--accent-on-soft)}
.journal-legend{display:flex;align-items:center;justify-content:center;align-content:center;flex-wrap:wrap;gap:5px;max-height:49px;overflow:auto;margin:5px 0 7px;padding:1px 3px;scrollbar-width:thin;scrollbar-color:var(--line) transparent}
.journal-btn{max-width:150px;border:1px solid var(--line);border-radius:10px;background:transparent;color:var(--muted);padding:3px 6px;font-size:8px;line-height:1.25;cursor:pointer;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.journal-btn:hover{border-color:var(--accent);color:var(--accent-dark)}
.journal-btn.active{background:var(--accent-soft);border-color:var(--accent);color:var(--accent-on-soft)}
.journal-btn em{margin-left:4px;font:8px/1 var(--font-mono);font-style:normal}
.status-pill.has-icon::before{display:none}
.status-pill.retracted{background:var(--danger-soft);color:var(--danger-on-soft);font-weight:700}
.status-pill.concern{background:var(--warning-soft);color:var(--warning-on-soft);font-weight:650}
.status-pill.corrected{background:var(--accent-soft);color:var(--accent-on-soft)}
.status-pill.unknown{background:var(--card-2);color:var(--muted)}
.status-pill.unknown::before{background:var(--muted)}
.notice-banner{margin:12px 0 0;padding:10px 11px;border-radius:7px;font-size:10px;line-height:1.6;overflow-wrap:anywhere}
.notice-banner.retracted{background:var(--danger-soft);color:var(--danger-on-soft);border:1px solid var(--danger)}
.notice-banner.concern{background:var(--warning-soft);color:var(--warning-on-soft);border:1px solid var(--warning)}
.notice-banner.corrected{background:var(--accent-soft);color:var(--accent-on-soft);border:1px solid var(--accent)}
.notice-banner.neutral{background:var(--card-2);color:var(--text-2);border:1px solid var(--line)}
.notice-banner a{color:inherit;font-weight:650}
.interpretation{transition:opacity .18s}
.detail-inner.is-retracted .interpretation{opacity:.46;filter:grayscale(.9)}
.badge.paused{background:var(--warning-soft);border-color:transparent;color:var(--warning-on-soft)}
.interpretation-paused{margin:12px 0;padding:12px;border:1px dashed var(--warning);border-radius:7px;background:var(--warning-soft);color:var(--warning-on-soft);font-size:11px;line-height:1.6;text-align:center}
@media(max-width:1180px) and (min-width:901px){
  .topbar{gap:15px;padding:0 15px}.scan-meta{display:none}.topbar{grid-template-columns:auto minmax(220px,1fr) auto}
  .deck{grid-template-columns:220px minmax(360px,1fr) 315px;gap:11px;padding:12px}.filter-btn{font-size:9.5px}.detail-inner{padding:15px}.detail-title{font-size:17px}
}
@media(max-width:900px){
  body{overflow:auto}
  .topbar{height:auto;min-height:70px;padding:12px 14px;grid-template-columns:1fr auto;gap:12px;position:sticky;top:0}
  .scan-meta{display:none}.brand-mark{width:34px;height:34px}.brand-name{font-size:15px}.brand-sub{font-size:8px}
  .search{grid-column:1/-1;grid-row:2;height:40px}.search kbd{display:none}
  .deck{height:auto;min-height:0;padding:12px;grid-template-columns:minmax(0,1fr);grid-template-areas:"scope" "detail" "queue";gap:12px}
  .scope-panel{overflow:visible;padding:4px 0 0}.scope-head{padding:2px 3px 10px}.scope-head h1{font-size:17px}
  .scope{width:min(100%,560px);min-width:0}.scope-stage{display:grid;min-height:0}
  /* 移动端横向溢出修复：.sweep 旋转包围盒（最大 √2×盘径）伸出圆形雷达盘制造页面横滚；
     stage 层几何裁剪统一兜住（代价＝390px 一带盘缘 .scope-label 有 1-4/8 被视口边裁掉十几px，实测接受）；
     blip/辉光/hub 全在界内；桌面 >900px 不受影响 */
  .scope-stage{overflow:hidden}
  .scope-foot{padding-bottom:4px}.funnel{margin-top:12px}
  .detail-panel,.queue-panel{overflow:visible}.queue-list{max-height:620px;overflow:auto}
  .filter-btn{font-size:11px;padding:9px}.quick-btn{font-size:10px;padding:8px 4px}
  .queue-btn{padding:12px 9px}.queue-text strong{font-size:12px}.queue-text small{font-size:10px}
  .footer{height:auto;min-height:44px;padding:12px 16px;align-items:flex-start;line-height:1.5}.footer .keys{display:none}
  .journal-legend{max-height:74px}.journal-btn{font-size:9px}.window-label{font-size:10px}
}
@media(max-width:420px){
  .topbar{padding:11px 12px}.deck{padding:10px}.brand-sub{letter-spacing:.1em}
  .scope-head p{max-width:210px;line-height:1.5}.read-progress b{font-size:16px}
  .scope-label{font-size:7px;padding:3px 4px;letter-spacing:0}.scope-hub{width:56px;height:56px}.scope-hub b{font-size:18px}.scope-hub small{font-size:7px}
  .blip{width:10px;height:10px}.blip.rct{width:12px;height:12px}.blip.cohort{width:11px;height:11px}
  .legend{gap:9px;font-size:8.5px}.funnel-step{font-size:8px}.funnel-step b{font-size:12px}
  .detail-inner{padding:16px}.detail-title{font-size:18px}.excerpt{font-size:12.5px}
  .filter-grid{gap:6px}.filter-btn{font-size:10px}
  .journal-btn{max-width:125px}.window-label{white-space:normal}
}
@media(prefers-reduced-motion:reduce){.sweep{animation:none}.blip{transition:none}.journal-sector{transition:none}}
/* 期刊合集（第 1 期：纯本地 localStorage；抽屉＝panel 同族语言，零外部库） */
.coll-head{display:flex;align-items:center;gap:8px;padding-top:1px}
/* ===== 三期交互层（proto-a 移植）：底版之上仅追加交互层；不改产线令牌与骨架 ===== */
.proto-view-switcher{display:flex;align-items:center;gap:3px;padding:3px;border:1px solid var(--line);border-radius:9px;background:var(--card-2);min-width:0}
.proto-view-btn{display:flex;align-items:center;justify-content:center;gap:6px;min-height:32px;padding:6px 11px;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--muted);font-size:11px;font-weight:600;white-space:nowrap;cursor:pointer}
.proto-view-btn:hover{color:var(--text);background:var(--card)}
.proto-view-btn[aria-selected="true"]{color:var(--accent-on-soft);border-color:var(--line);background:var(--card);box-shadow:var(--shadow-sm)}
.proto-view-btn kbd{font:8px/1 var(--font-mono);opacity:.65}
.topbar{grid-template-columns:auto auto auto minmax(180px,1fr) auto auto;gap:16px}
body[data-proto-view="reading"] .deck{grid-template-columns:minmax(0,1fr) 370px;grid-template-areas:"queue detail";max-width:1680px}
body[data-proto-view="reading"] .scope-panel{display:none}
body[data-proto-view="reading"] .filters{display:grid;grid-template-columns:minmax(230px,.9fr) minmax(280px,1.3fr) minmax(230px,1fr);gap:16px;align-items:center;padding:11px 16px}
body[data-proto-view="reading"] .tier-block,body[data-proto-view="reading"] .window-control{margin-top:0}
body[data-proto-view="reading"] .window-control{padding-top:0;border-top:0}
.proto-reading-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 16px;border-bottom:1px solid var(--line);background:var(--card-2)}
.proto-reading-copy{display:flex;align-items:center;gap:10px;min-width:0;color:var(--muted);font-size:10px}
.proto-reading-copy b{color:var(--text-2);font-weight:600}
.proto-density{display:flex;flex:0 0 auto;gap:3px;padding:3px;border:1px solid var(--line);border-radius:8px;background:var(--card)}
.proto-density button{min-height:29px;padding:5px 10px;border:0;border-radius:5px;background:transparent;color:var(--muted);font-size:10px;cursor:pointer}
.proto-density button[aria-pressed="true"]{background:var(--accent-soft);color:var(--accent-on-soft)}
body[data-proto-view="reading"] .queue-title{padding-bottom:9px}
body[data-proto-view="reading"] .queue-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;align-items:start;padding:14px;overflow:auto}
body[data-proto-view="reading"] .queue-item{margin:0;min-width:0}
.proto-article{display:block;width:100%;padding:16px 17px 14px;border:1px solid var(--line);border-top:3px solid var(--proto-domain,var(--accent));border-radius:10px;background:var(--card);box-shadow:var(--shadow-sm);text-align:left;cursor:pointer}
.proto-article:hover{background:var(--card);border-color:var(--accent);box-shadow:var(--shadow-card)}
.proto-article.selected{background:var(--card);border-color:var(--accent);border-top-color:var(--proto-domain,var(--accent));box-shadow:0 0 0 2px var(--accent-soft)}
.proto-card-top{display:flex;align-items:center;flex-wrap:wrap;gap:7px 10px;min-width:0}
.proto-domain{display:inline-flex;align-items:center;gap:6px;color:var(--text-2);font-size:10px;font-weight:650}
.proto-domain::before{content:"";width:8px;height:8px;border-radius:2px;background:var(--proto-domain,var(--accent))}
.proto-type{display:inline-flex;align-items:center;gap:5px;padding:4px 6px;border:1px solid var(--line);border-radius:5px;background:var(--card-2);color:var(--text-2);font:600 9px/1 var(--font-mono)}
.proto-type svg{width:14px;height:14px;flex:0 0 auto}
.proto-priority{margin-left:auto;color:var(--accent-on-soft);font:600 8px/1 var(--font-mono);letter-spacing:.08em}
.proto-score-ring{position:relative;display:block;width:52px;height:52px;margin-left:auto;flex:0 0 auto}
.proto-score-ring svg{display:block;width:100%;height:100%;transform:rotate(-90deg)}
.proto-score-ring circle{fill:none;stroke-width:3}
.proto-score-ring .proto-ring-track{stroke:var(--line)}
.proto-score-ring .proto-ring-value{stroke:var(--accent);stroke-linecap:round}
.proto-score-number{position:absolute;inset:0;display:grid;place-content:center;text-align:center;font:650 16px/1 var(--font-mono);color:var(--text)}
.proto-score-number small{display:block;margin-top:3px;font:7px/1 var(--font-mono);color:var(--muted)}
body[data-proto-view="reading"] .queue-text{display:block;min-width:0}
body[data-proto-view="reading"] .queue-text strong{display:block;-webkit-line-clamp:unset;-webkit-box-orient:initial;overflow:visible;margin-top:13px;font-size:16px;line-height:1.55;font-weight:650;letter-spacing:-.006em}
.proto-title-en{display:block;margin-top:7px;color:var(--muted);font-size:11px;line-height:1.6;overflow-wrap:anywhere}
.proto-title-en:empty{display:none}   /* FIX-3：池外卡不重复英文副标，空副标不占位 */
.proto-finding{display:block;margin-top:13px;padding:11px 12px;border-left:2px solid var(--accent);border-radius:0 7px 7px 0;background:var(--card-2)}
.proto-finding-label{display:block;margin-bottom:5px;color:var(--accent-on-soft);font:600 8px/1.2 var(--font-mono);letter-spacing:.12em}
.proto-finding-text{display:block;color:var(--text);font-size:12px;line-height:1.65;font-weight:520}
.proto-card-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px;padding-top:11px;border-top:1px solid var(--line);color:var(--muted);font:9px/1.5 var(--font-mono)}
.proto-card-meta b{color:var(--text-2);font-weight:600}
.proto-card-extra{display:none;margin-top:13px;padding-top:13px;border-top:1px solid var(--line);grid-template-columns:1fr 1fr;gap:12px}
.proto-extra-block{display:block;padding:11px 12px;border-radius:7px;background:var(--card-2);color:var(--text-2);font-size:11px;line-height:1.7}
.proto-extra-block b{display:block;margin-bottom:6px;color:var(--muted);font:600 8px/1.2 var(--font-mono);letter-spacing:.12em}
body[data-proto-view="reading"][data-proto-density="immersive"] .queue-list{grid-template-columns:minmax(0,1040px);justify-content:center}
body[data-proto-view="reading"][data-proto-density="immersive"] .proto-article{padding:23px 25px 20px}
body[data-proto-view="reading"][data-proto-density="immersive"] .queue-text strong{font-size:21px;line-height:1.5}
body[data-proto-view="reading"][data-proto-density="immersive"] .proto-title-en{font-size:12px}
body[data-proto-view="reading"][data-proto-density="immersive"] .proto-finding-text{font-size:14px}
body[data-proto-view="reading"][data-proto-density="immersive"] .proto-card-extra{display:grid}
/* 雷达增强：真实评分驱动点径、色深和光晕；形状沿用并扩展原研究设计语义。 */
.legend-shape.review{border-radius:0;clip-path:polygon(50% 0,100% 100%,0 100%);background:var(--accent-dark)}
.legend-shape.ai{border-radius:2px;transform:rotate(45deg);background:var(--card);border:1.5px solid var(--accent-dark)}
.blip.proto-blip{width:calc(var(--proto-size,12px)*var(--proto-mark-scale,1));height:calc(var(--proto-size,12px)*var(--proto-mark-scale,1));background:var(--proto-domain,var(--muted));box-shadow:0 0 var(--proto-glow,0) color-mix(in srgb,var(--proto-domain,var(--accent)) 60%,transparent)}
.blip.proto-blip::after{content:"";position:absolute;inset:-5px;border-radius:50%}   /* 视觉点缩小，点击热区适度外扩；密集处不再抢邻点 */
.blip.proto-blip.rct{background:var(--proto-domain,var(--accent))}
.blip.proto-blip.cohort{background:var(--card);border-color:var(--proto-domain,var(--accent-dark))}
.blip.proto-blip.proto-kind-review{clip-path:none;background:transparent;box-shadow:none}
.blip.proto-blip.proto-kind-review::before{content:"";position:absolute;inset:0;background:var(--proto-domain,var(--muted));clip-path:polygon(50% 0,100% 100%,0 100%)}
.blip.proto-blip.proto-kind-review.selected,.blip.proto-blip.proto-kind-review:hover,.blip.proto-blip.proto-kind-review:focus-visible{background:transparent}
.blip.proto-blip.proto-kind-review.selected::before{background:var(--accent-dark)}
.blip.proto-blip.proto-kind-ai{border-radius:3px;--rot:45deg;box-shadow:inset 0 0 0 3px var(--card),0 0 var(--proto-glow,0) var(--proto-domain,var(--accent))}
.blip.proto-blip.proto-low:not(.selected):not(.read){opacity:.68}
.blip.proto-blip.proto-low:hover,.blip.proto-blip.proto-low:focus-visible{opacity:1}
.blip.proto-blip.dim{opacity:.07}
.blip.proto-blip:hover,.blip.proto-blip:focus-visible{background:var(--proto-domain,var(--accent));box-shadow:0 0 0 5px var(--accent-soft),0 0 14px color-mix(in srgb,var(--proto-domain,var(--accent)) 65%,transparent);outline:none}
.blip.proto-blip.selected{box-shadow:0 0 0 4px var(--accent-soft),0 0 0 5px var(--accent-dark),0 0 16px color-mix(in srgb,var(--proto-domain,var(--accent)) 65%,transparent)}
@media(max-width:900px){.blip.proto-blip{--proto-mark-scale:.75}.blip.proto-blip::after{inset:-5px}}
.journal-sectors .journal-sector{fill:color-mix(in srgb,var(--proto-domain,var(--accent)) 4%,transparent);stroke:color-mix(in srgb,var(--proto-domain,var(--line)) 38%,var(--line));stroke-width:.8}
.journal-sectors .journal-sector:nth-child(even){fill:color-mix(in srgb,var(--proto-domain,var(--accent)) 7%,transparent)}
.journal-sectors .journal-sector:hover,.journal-sectors .journal-sector:focus-visible{fill:color-mix(in srgb,var(--proto-domain,var(--accent)) 14%,transparent);stroke:var(--proto-domain,var(--accent))}
.journal-sectors .journal-sector.active{fill:color-mix(in srgb,var(--proto-domain,var(--accent)) 20%,transparent);stroke:var(--proto-domain,var(--accent-dark))}
.proto-radar-tip{position:fixed;z-index:80;width:min(310px,calc(100vw - 24px));max-height:min(460px,calc(100vh - 24px));overflow-y:auto;scrollbar-width:thin;padding:13px 14px;border:1px solid var(--line);border-radius:10px;background:var(--card);box-shadow:var(--shadow-card);pointer-events:none}
#toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);z-index:99;background:var(--text);color:var(--bg);font-size:12.5px;font-family:var(--font-sans);border-radius:10px;padding:9px 16px;box-shadow:var(--shadow-card);display:none;pointer-events:none}
.proto-radar-tip .proto-tip-journal{color:var(--accent-on-soft);font:600 9px/1.4 var(--font-mono);letter-spacing:.06em}
.proto-radar-tip strong{display:block;margin-top:6px;font-size:12px;line-height:1.55}
.proto-radar-tip p{margin:7px 0 0;color:var(--text-2);font-size:10.5px;line-height:1.6}
.proto-radar-tip small{display:block;margin-top:8px;color:var(--muted);font:9px/1.4 var(--font-mono)}
/* 个性化：同一抽屉切为全屏，三个分区复用原合集/阵地/主题模块。 */
.proto-personal-tabs{display:none;gap:5px;padding:10px 24px;border-bottom:1px solid var(--line);background:var(--card-2)}
.proto-personal-tab{min-height:34px;padding:7px 13px;border:1px solid transparent;border-radius:7px;background:transparent;color:var(--muted);font-size:11px;cursor:pointer}
.proto-personal-tab[aria-pressed="true"]{border-color:var(--line);background:var(--card);color:var(--accent-on-soft);box-shadow:var(--shadow-sm)}
body[data-proto-view="personal"]{overflow:hidden}
body[data-proto-view="personal"] .deck{display:none}
body[data-proto-view="personal"] .coll-mask{display:none}
body[data-proto-view="personal"] .coll-drawer{position:fixed;inset:var(--proto-header-h,76px) 0 0;width:100%;z-index:15;border:0;border-radius:0;background:var(--bg);box-shadow:none}
body[data-proto-view="personal"] .coll-head-bar{padding:17px 24px;background:var(--card)}
body[data-proto-view="personal"] .proto-personal-tabs{display:flex}
body[data-proto-view="personal"] .coll-body{display:block;flex:1;overflow:auto;padding:20px 24px 42px;scrollbar-width:thin;scrollbar-color:var(--line) transparent}
body[data-proto-view="personal"] #coll-list,body[data-proto-view="personal"] #coll-editor,body[data-proto-view="personal"] #scheme-list,body[data-proto-view="personal"] #scheme-editor,body[data-proto-view="personal"] #topic-list,body[data-proto-view="personal"] #topic-editor,body[data-proto-view="personal"] #ai-settings,body[data-proto-view="personal"] #myjournals-panel{width:min(1400px,100%);margin:0 auto 18px}
@media(max-width:1350px) and (min-width:901px){.scan-meta{display:none}.topbar{grid-template-columns:auto auto minmax(180px,1fr) auto auto}.proto-view-btn{padding-inline:9px}}
@media(max-width:1100px) and (min-width:901px){body[data-proto-view="reading"] .deck{grid-template-columns:minmax(0,1fr) 315px}body[data-proto-view="reading"] .queue-list{grid-template-columns:1fr}}
@media(max-width:900px){
  .topbar{grid-template-columns:1fr auto auto;gap:10px}
  .brand{grid-column:1/-1;grid-row:1}
  .proto-view-switcher{grid-column:1/-1;grid-row:2;flex-wrap:wrap}.proto-view-btn{flex:1 1 0px;min-width:0;padding:6px 6px;font-size:11px}
  .search{grid-column:1;grid-row:3;min-width:0}
  #theme-btn{grid-column:2;grid-row:3}
  #lang-btn{grid-column:3;grid-row:3}
  body[data-proto-view="reading"] .deck{grid-template-columns:minmax(0,1fr);grid-template-areas:"queue" "detail"}
  body[data-proto-view="reading"] .filters{display:block;padding:12px}
  body[data-proto-view="reading"] .tier-block,body[data-proto-view="reading"] .window-control{margin-top:11px}
  body[data-proto-view="reading"] .window-control{padding-top:11px;border-top:1px solid var(--line)}
  body[data-proto-view="reading"] .queue-list{grid-template-columns:1fr;max-height:none;overflow:visible;padding:11px}
  .proto-reading-toolbar{align-items:flex-start;flex-direction:column}.proto-density{align-self:stretch}.proto-density button{flex:1}
  body[data-proto-view="reading"][data-proto-density="immersive"] .proto-article{padding:18px}.proto-card-extra{grid-template-columns:1fr}
  body[data-proto-view="personal"] .coll-body{padding:15px 14px 32px}body[data-proto-view="personal"] .coll-head-bar,body[data-proto-view="personal"] .proto-personal-tabs{padding-inline:14px}
  .shelf-mobile-status:not([hidden]){height:30px;margin:0 4px 8px;padding:0 9px;display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid color-mix(in srgb,var(--accent) 32%,var(--line));border-radius:7px;background:var(--accent-soft);color:var(--accent-on-soft);font-size:11px}
  .shelf-mobile-status button{padding:3px 0 3px 8px;border:0;border-left:1px solid color-mix(in srgb,var(--accent) 32%,var(--line));background:transparent;color:inherit;font-size:11px;cursor:pointer}
  .proto-personal-tabs{overflow:auto}.proto-personal-tab{flex:1;white-space:nowrap}
}
@media(max-width:480px){.proto-view-btn{padding:6px 4px;font-size:10px}.proto-view-btn kbd{display:none}.proto-card-meta{align-items:flex-start;flex-direction:column}.proto-personal-tab{padding:7px 10px;font-size:10px}body[data-proto-view="personal"] .proto-personal-tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px;overflow:visible}.proto-personal-tab{width:100%;white-space:normal}}
@media(max-width:420px){.scope-empty,.scope-empty.shelf-empty{width:min(210px,72%);padding:12px 14px;font-size:11px}}
@media(prefers-reduced-motion:reduce){.proto-article{transition:none}}
/* ===== UX 原地瘦身（mock 2026-11-27）：只压缩占视野块，结构与功能不动；每条挂双诊断证据 ===== */
.topbar{height:58px}                                            /* 顶栏 76→58 */
.scope{width:min(100%,380px);min-width:0}                       /* 桌面默认 cap；手机/平板仍可到 560 */
#funnel{display:none}                                           /* 管线漏斗报表撤下用户面 */
.ai-help[data-i18n="poolup.hint"]{display:none}                 /* 说明书墙收编·开关留 title */
.jl-fold{margin:4px 0;font-size:11px;color:var(--muted)}
.jl-fold summary{cursor:pointer;list-style:none;text-align:center}
.jl-fold summary::before{content:'▸ '}
.jl-fold[open] summary::before{content:'▾ '}
.jl-fold .journal-legend{max-height:120px;margin-top:6px}
.detail-title{font-size:16px;line-height:1.45}
.meta-fold{margin:10px 0;font-size:12px;color:var(--muted)}
.meta-fold summary{cursor:pointer}
.interpretation-paused.slim{padding:6px 10px;background:none}
.deep-paused.slim{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.deep-paused.slim br{display:none}
@media(min-width:901px){
  body{overflow:auto}
  .deck{height:calc(100vh - 94px);min-height:0}                 /* 58 顶栏＋36 页脚：页脚完整且不残留 18px 空带 */
  .scope-stage{container-type:size}                             /* 盘同时受舞台宽、高约束，展开图例也会再缩小 */
  .scope{width:min(100cqw,100cqh,380px)}
}
/* 双视图筛选默认收起；各视图独立保留本次会话的展开选择，按钮文字/aria 由 protoSyncFilters 同步。 */
body[data-proto-view="reading"] .filters{display:none}
body[data-proto-view="reading"].filters-open .filters{display:grid}
body[data-proto-view="overview"]:not(.filters-open) .filters{display:none}
body[data-proto-view="overview"].filters-open .filters{display:block}
.filters-toggle{display:block;margin:8px 12px 6px;padding:6px 12px;border:1px solid var(--line);border-radius:7px;background:var(--card);color:var(--muted);font-size:11px;cursor:pointer;width:fit-content}
@media(max-width:900px){
  .topbar{height:auto}                                                     /* 三排控件按内容撑高，严禁压住主区 */
  body[data-proto-view="reading"].filters-open .filters{display:block}  /* 窄屏必须竖排，不能回退成三列横溢 */
  .scope{width:min(100%,560px)}
}
body[data-proto-view="reading"][data-proto-density="compact"] .queue-text strong{font-size:14px;line-height:1.5}  /* 只缩紧凑档；沉浸档保持 21px */
.proto-view-btn{min-height:28px;padding:5px 10px}
/* 阅读/概览头部压缩；排序行只在阅读隐藏，概览保留供队列参考。 */
body[data-proto-view="reading"] .queue-panel .panel-head{padding:8px 14px}
.queue-panel .panel-head .eyebrow{display:none}
.queue-panel .panel-head h2{font-size:15px}
body[data-proto-view="reading"] .queue-title{display:none}
body[data-proto-view="overview"] .queue-text strong{font-size:12px;line-height:1.4}
.proto-reading-copy{display:none}
body[data-proto-view="reading"] .proto-reading-toolbar{display:none}
.proto-reading-more-item{grid-column:1/-1;margin:0;padding:0 2px}
.proto-reading-more{width:100%;min-height:34px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--muted);font-size:11px;cursor:pointer}
.proto-reading-more:hover{border-color:var(--accent);color:var(--accent-dark)}
body[data-proto-view="reading"] .queue-panel .coll-head .proto-density{display:flex;gap:2px}
body:not([data-proto-view="reading"]) .proto-density{display:none}       /* 密度钮只属于阅读视图 */
.queue-panel .coll-head .proto-density button{min-height:24px;font-size:10px;padding:3px 8px;border:1px solid var(--line)}
#scope-subtitle{display:none}
.detail-top .lock-id{display:none}
/* T1127-UX2 比例调优（PI 2026-11-27 认图）：只动概览空间分配与 TAB 点击高度；数据、功能和已认可点径不变。 */
.proto-view-btn{min-height:30px}
@media(min-width:1181px){
  body[data-proto-view="overview"] .deck{grid-template-columns:280px minmax(420px,1fr) 350px}
}
@media(max-width:1180px) and (min-width:901px){
  body[data-proto-view="overview"] .deck{grid-template-columns:240px minmax(360px,1fr) 315px}
}
@media(min-width:901px){
  body[data-proto-view="overview"] .scope{width:min(100cqw,100cqh,420px)}
}
/* 首页副本状态跟随顶栏，窄屏也能看到正在阅读的数据日期。 */
.topbar:has(> :is(.shell-status,.window-hint)){height:auto;min-height:58px}
.shell-status,.topbar>.window-hint{grid-column:1/-1;color:var(--text-2);font-size:12px;line-height:1.4;margin:0}
@media(min-width:901px){
  .topbar:has(> :is(.shell-status,.window-hint)){grid-template-rows:46px;row-gap:0;padding-bottom:6px}
  .topbar:has(> :is(.shell-status,.window-hint))+.deck{height:calc(100vh - var(--proto-header-h,58px) - 36px)}
}
</style>
</head>
