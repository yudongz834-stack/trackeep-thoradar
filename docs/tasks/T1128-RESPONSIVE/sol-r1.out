+  body[data-proto-view="reading"] .deck{max-width:1840px;grid-template-columns:minmax(0,1fr) clamp(390px,22vw,460px)}
+  .proto-view-btn{min-height:34px;padding-inline:12px}
 }
 /* 首页副本状态跟随顶栏，窄屏也能看到正在阅读的数据日期。 */
 .topbar:has(> :is(.shell-status,.window-hint)){height:auto;min-height:58px}

