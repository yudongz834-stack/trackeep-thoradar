.proto-score-number small{display:block;margin-top:3px;font:7px/1 var(--font-mono);color:var(--muted)}
body[data-proto-view="reading"] .queue-text{display:block;min-width:0}
body[data-proto-view="reading"] .queue-text strong{display:block;-webkit-line-clamp:unset;-webkit-box-orient:initial;overflow:visible;margin-top:13px;font-size:16px;line-height:1.55;font-weight:650;letter-spacing:-.006em}
.proto-title-en{display:block;margin-top:7px;color:var(--muted);font-size:11px;line-height:1.6;overflow-wrap:anywhere}
.proto-title-en:empty{display:none}   /* FIX-3：池外卡不重复英文副标，空副标不占位 */
.proto-finding{display:block;margin-top:13px;padding:11px 12px;border-left:2px solid var(--accent);border-radius:0 7px 7px 0;background:var(--card-2)}
.proto-finding-label{display:block;margin-bottom:5px;color:var(--accent-on-soft);font:600 8px/1.2 var(--font-mono);letter-spacing:.12em}
.proto-finding-text{display:block;color:var(--text);font-size:12px;line-height:1.65;font-weight:520}
.proto-card-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px;padding-top:11px;border-top:1px solid var(--line);color:var(--muted);font:9px/1.5 var(--font-mono)}
.proto-card-meta b{color:var(--text-2);font-weight:600}
.proto-card-extra{display:none;margin-top:13px;padding-top:13px;border-top:1px solid var(--line);grid-template-columns:1fr 1fr;gap:12px}
.proto-extra-block{display:block;padding:11px 12px;border-radius:7px;background:var(--card-2);color:var(--text-2);font-size:11px;line-height:1.7}
.proto-extra-block b{display:block;margin-bottom:6px;color:var(--muted);font:600 8px/1.2 var(--font-mono);letter-spacing:.12em}
body[data-proto-view="reading"][data-proto-density="immersive"] .queue-list{grid-template-columns:minmax(0,1040px);justify-content:center}
body[data-proto-view="reading"][data-proto-density="immersive"] .proto-article{padding:23px 25px 20px}
body[data-proto-view="reading"][data-proto-density="immersive"] .queue-text strong{font-size:21px;line-height:1.5}
body[data-proto-view="reading"][data-proto-density="immersive"] .proto-title-en{font-size:12px}
body[data-proto-view="reading"][data-proto-density="immersive"] .proto-finding-text{font-size:14px}
body[data-proto-view="reading"][data-proto-density="immersive"] .proto-card-extra{display:grid}
/* 雷达增强：真实评分驱动点径、色深和光晕；形状沿用并扩展原研究设计语义。 */
.legend-shape.review{border-radius:0;clip-path:polygon(50% 0,100% 100%,0 100%);background:var(--accent-dark)}
.legend-shape.ai{border-radius:2px;transform:rotate(45deg);background:var(--card);border:1.5px solid var(--accent-dark)}
.blip.proto-blip{width:calc(var(--proto-size,12px)*var(--proto-mark-scale,1));height:calc(var(--proto-size,12px)*var(--proto-mark-scale,1));background:var(--proto-domain,var(--muted));box-shadow:0 0 var(--proto-glow,0) color-mix(in srgb,var(--proto-domain,var(--accent)) 60%,transparent)}
.blip.proto-blip::after{content:"";position:absolute;inset:-5px;border-radius:50%}   /* 视觉点缩小，点击热区适度外扩；密集处不再抢邻点 */
.blip.proto-blip.rct{background:var(--proto-domain,var(--accent))}
.blip.proto-blip.cohort{background:var(--card);border-color:var(--proto-domain,var(--accent-dark))}
.blip.proto-blip.proto-kind-review{clip-path:none;background:transparent;box-shadow:none}
.blip.proto-blip.proto-kind-review::before{content:"";position:absolute;inset:0;background:var(--proto-domain,var(--muted));clip-path:polygon(50% 0,100% 100%,0 100%)}
.blip.proto-blip.proto-kind-review.selected,.blip.proto-blip.proto-kind-review:hover,.blip.proto-blip.proto-kind-review:focus-visible{background:transparent}
.blip.proto-blip.proto-kind-review.selected::before{background:var(--accent-dark)}
.blip.proto-blip.proto-kind-ai{border-radius:3px;--rot:45deg;box-shadow:inset 0 0 0 3px var(--card),0 0 var(--proto-glow,0) var(--proto-domain,var(--accent))}
.blip.proto-blip.proto-low:not(.selected):not(.read){opacity:.68}
.blip.proto-blip.proto-low:hover,.blip.proto-blip.proto-low:focus-visible{opacity:1}
.blip.proto-blip.dim{opacity:.07}
.blip.proto-blip:hover,.blip.proto-blip:focus-visible{background:var(--proto-domain,var(--accent));box-shadow:0 0 0 5px var(--accent-soft),0 0 14px color-mix(in srgb,var(--proto-domain,var(--accent)) 65%,transparent);outline:none}
.blip.proto-blip.selected{box-shadow:0 0 0 4px var(--accent-soft),0 0 0 5px var(--accent-dark),0 0 16px color-mix(in srgb,var(--proto-domain,var(--accent)) 65%,transparent)}
@media(max-width:900px){.blip.proto-blip{--proto-mark-scale:.75}.blip.proto-blip::after{inset:-5px}}
.journal-sectors .journal-sector{fill:color-mix(in srgb,var(--proto-domain,var(--accent)) 4%,transparent);stroke:color-mix(in srgb,var(--proto-domain,var(--line)) 38%,var(--line));stroke-width:.8}
.journal-sectors .journal-sector:nth-child(even){fill:color-mix(in srgb,var(--proto-domain,var(--accent)) 7%,transparent)}
.journal-sectors .journal-sector:hover,.journal-sectors .journal-sector:focus-visible{fill:color-mix(in srgb,var(--proto-domain,var(--accent)) 14%,transparent);stroke:var(--proto-domain,var(--accent))}
.journal-sectors .journal-sector.active{fill:color-mix(in srgb,var(--proto-domain,var(--accent)) 20%,transparent);stroke:var(--proto-domain,var(--accent-dark))}
.proto-radar-tip{position:fixed;z-index:80;width:min(310px,calc(100vw - 24px));max-height:min(460px,calc(100vh - 24px));overflow-y:auto;scrollbar-width:thin;padding:13px 14px;border:1px solid var(--line);border-radius:10px;background:var(--card);box-shadow:var(--shadow-card);pointer-events:none}
#toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);z-index:99;background:var(--text);color:var(--bg);font-size:12.5px;font-family:var(--font-sans);border-radius:10px;padding:9px 16px;box-shadow:var(--shadow-card);display:none;pointer-events:none}
.proto-radar-tip .proto-tip-journal{color:var(--accent-on-soft);font:600 9px/1.4 var(--font-mono);letter-spacing:.06em}
.proto-radar-tip strong{display:block;margin-top:6px;font-size:12px;line-height:1.55}
.proto-radar-tip p{margin:7px 0 0;color:var(--text-2);font-size:10.5px;line-height:1.6}
.proto-radar-tip small{display:block;margin-top:8px;color:var(--muted);font:9px/1.4 var(--font-mono)}
/* 个性化：同一抽屉切为全屏，三个分区复用原合集/阵地/主题模块。 */
.proto-personal-tabs{display:none;gap:5px;padding:10px 24px;border-bottom:1px solid var(--line);background:var(--card-2)}
.proto-personal-tab{min-height:34px;padding:7px 13px;border:1px solid transparent;border-radius:7px;background:transparent;color:var(--muted);font-size:11px;cursor:pointer}
.proto-personal-tab[aria-pressed="true"]{border-color:var(--line);background:var(--card);color:var(--accent-on-soft);box-shadow:var(--shadow-sm)}
body[data-proto-view="personal"]{overflow:hidden}
body[data-proto-view="personal"] .deck{display:none}
body[data-proto-view="personal"] .coll-mask{display:none}
body[data-proto-view="personal"] .coll-drawer{position:fixed;inset:var(--proto-header-h,76px) 0 0;width:100%;z-index:15;border:0;border-radius:0;background:var(--bg);box-shadow:none}
body[data-proto-view="personal"] .coll-head-bar{padding:17px 24px;background:var(--card)}
body[data-proto-view="personal"] .proto-personal-tabs{display:flex}
body[data-proto-view="personal"] .coll-body{display:block;flex:1;overflow:auto;padding:20px 24px 42px;scrollbar-width:thin;scrollbar-color:var(--line) transparent}
body[data-proto-view="personal"] #coll-list,body[data-proto-view="personal"] #coll-editor,body[data-proto-view="personal"] #scheme-list,body[data-proto-view="personal"] #scheme-editor,body[data-proto-view="personal"] #topic-list,body[data-proto-view="personal"] #topic-editor,body[data-proto-view="personal"] #ai-settings,body[data-proto-view="personal"] #myjournals-panel{width:min(1400px,100%);margin:0 auto 18px}
@media(max-width:1350px) and (min-width:901px){.scan-meta{display:none}.topbar{grid-template-columns:auto auto minmax(180px,1fr) auto auto}.proto-view-btn{padding-inline:9px}}
@media(max-width:1100px) and (min-width:901px){body[data-proto-view="reading"] .deck{grid-template-columns:minmax(0,1fr) 315px}body[data-proto-view="reading"] .queue-list{grid-template-columns:1fr}}
@media(max-width:900px){
  .topbar{grid-template-columns:1fr auto auto;gap:10px}
  .brand{grid-column:1/-1;grid-row:1}
  .proto-view-switcher{grid-column:1/-1;grid-row:2;flex-wrap:wrap}.proto-view-btn{flex:1 1 0px;min-width:0;padding:6px 6px;font-size:11px}
  .search{grid-column:1;grid-row:3;min-width:0}
  #theme-btn{grid-column:2;grid-row:3}
  #lang-btn{grid-column:3;grid-row:3}
  body[data-proto-view="reading"] .deck{grid-template-columns:minmax(0,1fr);grid-template-areas:"queue" "detail"}
  body[data-proto-view="reading"] .filters{display:block;padding:12px}
  body[data-proto-view="reading"] .tier-block,body[data-proto-view="reading"] .window-control{margin-top:11px}
  body[data-proto-view="reading"] .window-control{padding-top:11px;border-top:1px solid var(--line)}
  body[data-proto-view="reading"] .queue-list{grid-template-columns:1fr;max-height:none;overflow:visible;padding:11px}
  .proto-reading-toolbar{align-items:flex-start;flex-direction:column}.proto-density{align-self:stretch}.proto-density button{flex:1}
  body[data-proto-view="reading"][data-proto-density="immersive"] .proto-article{padding:18px}.proto-card-extra{grid-template-columns:1fr}
  body[data-proto-view="personal"] .coll-body{padding:15px 14px 32px}body[data-proto-view="personal"] .coll-head-bar,body[data-proto-view="personal"] .proto-personal-tabs{padding-inline:14px}
  .shelf-mobile-status:not([hidden]){height:30px;margin:0 4px 8px;padding:0 9px;display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid color-mix(in srgb,var(--accent) 32%,var(--line));border-radius:7px;background:var(--accent-soft);color:var(--accent-on-soft);font-size:11px}
  .shelf-mobile-status button{padding:3px 0 3px 8px;border:0;border-left:1px solid color-mix(in srgb,var(--accent) 32%,var(--line));background:transparent;color:inherit;font-size:11px;cursor:pointer}
  .proto-personal-tabs{overflow:auto}.proto-personal-tab{flex:1;white-space:nowrap}
}
@media(max-width:480px){.proto-view-btn{padding:6px 4px;font-size:10px}.proto-view-btn kbd{display:none}.proto-card-meta{align-items:flex-start;flex-direction:column}.proto-personal-tab{padding:7px 10px;font-size:10px}body[data-proto-view="personal"] .proto-personal-tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px;overflow:visible}.proto-personal-tab{width:100%;white-space:normal}}
@media(max-width:420px){.scope-empty,.scope-empty.shelf-empty{width:min(210px,72%);padding:12px 14px;font-size:11px}}
@media(prefers-reduced-motion:reduce){.proto-article{transition:none}}
/* ===== UX 原地瘦身（mock 2026-11-27）：只压缩占视野块，结构与功能不动；每条挂双诊断证据 ===== */
.topbar{height:58px}                                            /* 顶栏 76→58 */
.scope{width:min(100%,380px);min-width:0}                       /* 桌面默认 cap；手机/平板仍可到 560 */
#funnel{display:none}                                           /* 管线漏斗报表撤下用户面 */
.ai-help[data-i18n="poolup.hint"]{display:none}                 /* 说明书墙收编·开关留 title */
.jl-fold{margin:4px 0;font-size:11px;color:var(--muted)}
.jl-fold summary{cursor:pointer;list-style:none;text-align:center}
.jl-fold summary::before{content:'▸ '}
.jl-fold[open] summary::before{content:'▾ '}
.jl-fold .journal-legend{max-height:120px;margin-top:6px}
.detail-title{font-size:16px;line-height:1.45}
.meta-fold{margin:10px 0;font-size:12px;color:var(--muted)}
.meta-fold summary{cursor:pointer}
.interpretation-paused.slim{padding:6px 10px;background:none}
.deep-paused.slim{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.deep-paused.slim br{display:none}
@media(min-width:901px){
  body{overflow:auto}
  .deck{height:calc(100vh - 94px);min-height:0}                 /* 58 顶栏＋36 页脚：页脚完整且不残留 18px 空带 */
  .scope-stage{container-type:size}                             /* 盘同时受舞台宽、高约束，展开图例也会再缩小 */
  .scope{width:min(100cqw,100cqh,380px)}
}
/* 双视图筛选默认收起；各视图独立保留本次会话的展开选择，按钮文字/aria 由 protoSyncFilters 同步。 */
body[data-proto-view="reading"] .filters{display:none}
body[data-proto-view="reading"].filters-open .filters{display:grid}
body[data-proto-view="overview"]:not(.filters-open) .filters{display:none}
body[data-proto-view="overview"].filters-open .filters{display:block}
.filters-toggle{display:block;margin:8px 12px 6px;padding:6px 12px;border:1px solid var(--line);border-radius:7px;background:var(--card);color:var(--muted);font-size:11px;cursor:pointer;width:fit-content}
@media(max-width:900px){
  .topbar{height:auto}                                                     /* 三排控件按内容撑高，严禁压住主区 */
  body[data-proto-view="reading"].filters-open .filters{display:block}  /* 窄屏必须竖排，不能回退成三列横溢 */
  .scope{width:min(100%,560px)}
}
body[data-proto-view="reading"][data-proto-density="compact"] .queue-text strong{font-size:14px;line-height:1.5}  /* 只缩紧凑档；沉浸档保持 21px */
.proto-view-btn{min-height:28px;padding:5px 10px}
/* 阅读/概览头部压缩；排序行只在阅读隐藏，概览保留供队列参考。 */
body[data-proto-view="reading"] .queue-panel .panel-head{padding:8px 14px}
.queue-panel .panel-head .eyebrow{display:none}
.queue-panel .panel-head h2{font-size:15px}
body[data-proto-view="reading"] .queue-title{display:none}
body[data-proto-view="overview"] .queue-text strong{font-size:12px;line-height:1.4}
.proto-reading-copy{display:none}
body[data-proto-view="reading"] .proto-reading-toolbar{display:none}
.proto-reading-more-item{grid-column:1/-1;margin:0;padding:0 2px}
.proto-reading-more{width:100%;min-height:34px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--muted);font-size:11px;cursor:pointer}
.proto-reading-more:hover{border-color:var(--accent);color:var(--accent-dark)}
body[data-proto-view="reading"] .queue-panel .coll-head .proto-density{display:flex;gap:2px}
body:not([data-proto-view="reading"]) .proto-density{display:none}       /* 密度钮只属于阅读视图 */
.queue-panel .coll-head .proto-density button{min-height:24px;font-size:10px;padding:3px 8px;border:1px solid var(--line)}
#scope-subtitle{display:none}
.detail-top .lock-id{display:none}
/* T1127-UX2 比例调优（PI 2026-11-27 认图）：只动概览空间分配与 TAB 点击高度；数据、功能和已认可点径不变。 */
.proto-view-btn{min-height:30px}
@media(min-width:1181px){
  body[data-proto-view="overview"] .deck{grid-template-columns:280px minmax(420px,1fr) 350px}
}
@media(max-width:1180px) and (min-width:901px){
  body[data-proto-view="overview"] .deck{grid-template-columns:240px minmax(360px,1fr) 315px}
}
@media(min-width:901px){
  body[data-proto-view="overview"] .scope{width:min(100cqw,100cqh,420px)}
}
/* 首页副本状态跟随顶栏，窄屏也能看到正在阅读的数据日期。 */
.topbar:has(> :is(.shell-status,.window-hint)){height:auto;min-height:58px}
.shell-status,.topbar>.window-hint{grid-column:1/-1;color:var(--text-2);font-size:12px;line-height:1.4;margin:0}
@media(min-width:901px){
  .topbar:has(> :is(.shell-status,.window-hint)){grid-template-rows:46px;row-gap:0;padding-bottom:6px}
  .topbar:has(> :is(.shell-status,.window-hint))+.deck{height:calc(100vh - var(--proto-header-h,58px) - 36px)}
}
</style>
</head>
<body>
<header class="topbar">
  <div class="brand">
    <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true">
      <circle cx="20" cy="20" r="17" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="20" cy="20" r="10" stroke="currentColor" stroke-width="1" opacity=".55"/>
      <path d="M20 3v34M3 20h34M20 20l11-11" stroke="currentColor" stroke-width="1" opacity=".65"/>
      <circle cx="27" cy="14" r="3" fill="currentColor"/>
    </svg>
    <div><strong class="brand-name" data-i18n="brand.name">胸科雷达</strong><span class="brand-sub">THORACIC SIGNAL DESK</span></div>
  </div>
  <div class="scan-meta"><i class="live-dot"></i><div><b id="scan-date">—</b><small id="scan-time">正在读取注入数据…</small></div></div>
  <nav class="proto-view-switcher" id="proto-view-switcher" role="tablist" aria-label="主视图切换" data-i18n-aria="view.switcher.aria">
    <button class="proto-view-btn" id="proto-tab-overview" role="tab" aria-selected="true" aria-controls="deck" data-proto-view="overview" title="概览：信号队列、雷达与锁定详情" data-i18n-title="view.overview.title"><kbd>01</kbd><span data-i18n="view.overview">概览</span></button>
    <button class="proto-view-btn" id="proto-tab-reading" role="tab" aria-selected="false" aria-controls="deck" data-proto-view="reading" tabindex="-1" title="阅读：完整标题、结论与证据" data-i18n-title="view.reading.title"><kbd>02</kbd><span data-i18n="view.reading">阅读</span></button>
    <button class="proto-view-btn" id="proto-tab-personal" role="tab" aria-selected="false" aria-controls="coll-drawer" data-proto-view="personal" tabindex="-1" title="个性化：期刊合集、自定义阵地与我的主题" data-i18n-title="view.personal.title"><kbd>03</kbd><span data-i18n="view.personal">个性化</span></button>
  </nav>
  <label class="search" title="搜索标题、期刊、PMID 或试验编号" data-i18n-title="search.title">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
    <input id="search" type="search" placeholder="在信号场中检索…" autocomplete="off" aria-label="检索窗口内文献" data-i18n-ph="search.ph" data-i18n-aria="search.aria">
    <kbd>/</kbd>
  </label>
  <button class="icon-btn" id="theme-btn" aria-label="切换深色模式" title="切换明暗模式" data-i18n-title="theme.toggle">
    <svg id="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 15.3A8.5 8.5 0 0 1 8.7 4a8.5 8.5 0 1 0 11.3 11.3Z"/></svg>
  </button>
  <button class="icon-btn lang-btn" id="lang-btn" type="button" aria-label="切换到英文界面" title="切换到英文界面 / Switch to English">EN</button>
</header>
<main class="deck">
  <aside class="panel queue-panel" aria-label="文献筛选与信号队列" data-i18n-aria="queue.aria">
    <div class="panel-head"><div><div class="eyebrow">Sweep director</div><h2 data-i18n="queue.h2">信号队列</h2></div><div class="coll-head"><button class="coll-toggle" id="coll-open" title="个性化视图 · 期刊合集/自定义阵地/我的主题">◈ 合集</button><span class="counter" id="filter-counter">—</span></div></div>
    <div class="filters" id="queue-filters">
      <div class="quick-group">
        <div class="quick-row" id="quick-filters">
          <button class="quick-btn active" data-quick="all" data-i18n="quick.all">全部</button>
          <button class="quick-btn" data-quick="rct">RCT</button>
          <button class="quick-btn" data-quick="cohort" data-i18n="quick.cohort">队列</button>
          <button class="quick-btn" data-quick="nct" data-i18n="quick.nct">含试验号</button>
        </div>
        <div class="shelf-filter-row"><button type="button" class="shelf-filter is-empty" id="myjournals-filter" aria-pressed="false" data-i18n-title="shelf.filter.tip"><span class="shelf-filter-label"><svg class="shelf-filter-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M4 2.5h8v11l-4-2.5-4 2.5z"/></svg><span data-i18n="shelf.filter">只看我的书架</span></span><span class="shelf-filter-count" id="myjournals-filter-count" aria-hidden="true"></span></button></div>
      </div>
      <div class="shelf-filter-row" id="pool-mix-control">
        <label class="ai-session" data-i18n-title="poolup.toggle.tip" title="只混排已缓存的池外题录；不自动拉取，不写官方数据"><input type="checkbox" id="pool-mix-toggle" checked><span data-i18n="poolup.toggle">混排池外缓存 · 带「池外」标</span></label>
