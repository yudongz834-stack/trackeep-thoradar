index 0000000000000000000000000000000000000000..b590935aef51d9a38e383c1b37734cace6b0fb19
--- /dev/null
+++ b/D:/claude-tmp/T1128-SMOOTH-A5-98c362c8b2ee4782bd031502825f96fd/focused.py
@@ -0,0 +1,43 @@
+from pathlib import Path
+import sys, subprocess as sp, hashlib, base64, re, os, json, shlex
+tmp,root,ev=map(Path,sys.argv[1:]); snap=tmp/'snapshot'; blob=tmp/'blobs'
+bash=Path(os.environ['ProgramFiles'])/'Git/bin/bash.exe'
+local={k:os.environ[k] for k in ['PATH','SystemRoot','COMSPEC','PATHEXT','TEMP','TMP','TMPDIR'] if k in os.environ}
+def md5(b):return base64.b64encode(hashlib.md5(b).digest()).decode()
+def script_functions(y):
+    txt=y.read_text(encoding='utf8')
+    start=txt.index('          check_object_headers()')
+    end=txt.index('          for path in "\u0024{paths[@]}"; do',start)
+    return '\n'.join(x[10:] if x else '' for x in txt[start:end].splitlines())
+cases=[]
+def check(name,wf,cwd,headers,args,want):
+    script='set -eu\ncurl() { printf "%s" "$A5_RESPONSE"; }\nsleep() { :; }\n'+script_functions(wf)+'\n'+shlex.join(args)+'\n'
+    cmd=[str(bash),'--noprofile','--norc','-s']
+    r=sp.run(cmd,cwd=cwd,input=script.encode(),capture_output=True,env={**local,'A5_RESPONSE':headers})
+    out=r.stdout.decode('utf8'); err=r.stderr.decode('utf8')
+    print(name,'exit='+str(r.returncode),out.splitlines()[:1],err.strip())
+    rec={'name':name,'workflow':str(wf),'cwd':str(cwd),'command':cmd,'bashStdin':script,'response':headers,'expectedExit':want,'exit':r.returncode,'stdout':out,'stderr':err}
+    cases.append(rec)
+    assert r.returncode==want and ((out.startswith('Verified ') and not err) if want==0 else (err.startswith('Verification failed for ') and out.count('Waiting for ')==12))
+wf=tmp/'original.yml'; mutant=tmp/'skip-host.yml'
+def obj(dig):return 'HTTP/2 200 OK\r\nContent-MD5: '+dig+'\r\nContent-Type: text/html\r\n\r\n'
+for path in ['/','/index.html']:
+    args=['verify_object','https://thoradar.online'+path,'index.html','0']
+    for cwd,src,label,expected in [(snap,blob,'working-expectation_git-response',1),(snap,snap,'working-expectation_working-response',0),(blob,blob,'git-bytes_git-response',0),(blob,snap,'git-bytes_working-response',1)]:
+        check(label+' '+path,wf,cwd,obj(md5((src/'index.html').read_bytes())),args,expected)
+url='https://www.thoradar.online/?from=www'; expected='https://thoradar.online/?from=www'
+for candidate,label,r in [(wf,'canonical',1),(mutant,'skip-host',0)]:
+    check(label+'_wrong-host-only',candidate,snap,'HTTP/2 308 Permanent Redirect\r\nLocation: https://other.invalid/?from=www\r\n\r\n',['verify_public',url,'check_redirect_headers',expected],r)
+check('canonical_correct-host',wf,snap,'HTTP/2 308 Permanent Redirect\r\nLocation: '+expected+'\r\n\r\n',['verify_public',url,'check_redirect_headers',expected],0)
+for path in ['/','/index.html']:
+    args=['verify_object','https://thoradar.online'+path,'index.html','0']
+    headers=obj(md5((blob/'index.html').read_bytes())).replace('text/html','application/octet-stream')
+    check('canonical_homepage-octet-stream '+path,wf,blob,headers,args,0)
+for path in ['/sw.js','/sw-retire.js']:
+    name='www'+path
+    args=['verify_object','https://www.thoradar.online'+path,'sw-retire.js','1']
+    digest=md5((blob/'sw-retire.js').read_bytes())
+    good='HTTP/2 200 OK\r\nContent-MD5: '+digest+'\r\nContent-Type: application/javascript\r\nCache-Control: no-store\r\n\r\n'
+    for kind,headers,rc in [('retirement',good,0),('normal',good.replace(digest,md5((blob/'sw.js').read_bytes())),1),('html-mime',good.replace('application/javascript','text/html'),1),('cacheable',good.replace('no-store','max-age=3600'),1),('redirect','HTTP/2 308 Permanent Redirect\r\nLocation: https://thoradar.online'+path+'\r\n\r\n',1)]:
+        check(name+' '+kind,wf,blob,headers,args,rc)
+(ev/'focused.json').write_text(json.dumps(cases,indent=2)+'\n',encoding='utf8')
diff --git a/D:/claude-tmp/T1128-SMOOTH-A5-98c362c8b2ee4782bd031502825f96fd/run.py b/D:/claude-tmp/T1128-SMOOTH-A5-98c362c8b2ee4782bd031502825f96fd/run.py
