+from pathlib import Path
+import sys, subprocess as sp, json, re, tempfile, hashlib, base64
+tmp,root,ev=map(Path,sys.argv[1:])
+d=root/'docs/tasks/T1128-SMOOTH'; sol=d/'online-release/sol-s12'; p=sol/'canonical.patch'
+lines=[]
+def log(s): lines.append(s); print(s)
+def cmd(args,cwd=root,expected=0):
+    r=sp.run(args,cwd=cwd,stdout=sp.PIPE,stderr=sp.STDOUT)
+    s=r.stdout.decode('utf8',errors='replace').strip()
+    log('> '+sp.list2cmdline([str(x) for x in args])+'\n'+(s+'\n' if s else '')+f'exit={r.returncode}')
+    assert expected==r.returncode
+    return s
+def raw(args,cwd=root): return sp.check_output(args,cwd=cwd)
+def md5(b): return base64.b64encode(hashlib.md5(b).digest()).decode()
+def decode(p): return p.read_text(encoding='utf-8-sig')
+def js(p): return json.loads(p.read_bytes())
+cmd(['git','rev-parse','HEAD'])
+cmd(['git','diff','HEAD','--exit-code','--','index.html','sw.js','sw-retire.js'])
+cmd(['git','ls-files','--eol','--','index.html','sw.js','sw-retire.js'])
+blobs=tmp/'blobs'; blobs.mkdir(exist_ok=True)
+for f in ['index.html','sw.js','sw-retire.js']:
+    h=cmd(['git','rev-parse','HEAD:'+f]); assert h==cmd(['git','hash-object','--path='+f,f])
+    b=raw(['git','cat-file','blob','HEAD:'+f]); (blobs/f).write_bytes(b)
+    w=(root/f).read_bytes();log(f'git cat-file blob HEAD:{f} | MD5(base64) = {md5(b)}; working file MD5(base64) = {md5(w)}; working SHA256 = {hashlib.sha256(w).hexdigest()}')
+    assert b==w.replace(b'\r\n',b'\n')
+    assert f'{f} {md5(b)}' in decode(sol/'git-blob-md5.txt')
+cmd(['git','apply','--stat',str(p)])
+cmd(['git','apply','-R','--check','--whitespace=error',str(p)])
+base=Path(tempfile.mkdtemp(prefix='replay-',dir=tmp))
+files=re.findall(r'^diff --git a/(\S+) b/\1$',decode(p),re.M)
+assert len(files)==4
+for f in files:
+    dst=base/f;dst.parent.mkdir(parents=True,exist_ok=True);dst.write_bytes(raw(['git','cat-file','blob','HEAD:'+f]))
+log('Patch replay from git cat-file blob HEAD:<four paths>; cwd='+str(base))
+for patch in [d/'sol-s7.patch',p]:
+    cmd(['git','-c','core.autocrlf=false','apply','--check','--whitespace=error',str(patch)],base)
+    cmd(['git','-c','core.autocrlf=false','apply','--whitespace=error',str(patch)],base)
+for f in files:
+    want=cmd(['git','hash-object','--path='+f,f])
+    got=cmd(['git','hash-object','--no-filters',str(base/f)])
+    assert want==got
+    log('exact Git bytes after S7 + S12: '+f+' '+got)
+report=decode(d/'sol-s12-canonical-report.md')
+links=re.findall(r'\[[^\]\n]+\]\(([^)]+)\)',report)
+for link in links:
+    f=d/link; assert f.is_file(); log(f'Sol report link OK {link} bytes={f.stat().st_size}')
+log(f'Sol report links {len(links)}/{len(links)}')
+def check_artifact(folder,name,summary):
+    result=js(folder/(name+'.json'))
+    t=result['tests']; actual={'passed':len([k for k in t if k['pass']]),'failed':len([k for k in t if not k['pass']])}
+    assert actual==summary==result['summary']
+    success=decode(folder/(name+'.stdout.txt')); fail=decode(folder/(name+'.stderr.txt'))
+    assert success.splitlines()[-1]=='SUMMARY '+json.dumps(summary,separators=(',',':'))
+    for k in t: assert (('PASS '+k['name']+'\n') in success) if k['pass'] else (('FAIL '+k['name']+': '+k['error'].splitlines()[0]) in fail)
+    assert set(result['shellRuns'])=={'install','publish'} and all(v['status']==0 for v in result['shellRuns'].values())
+    return result
+meta=js(sol/'mutation-summary.json')
+for label,expected in [('deploy',meta['canonical']),('baseline-s7',meta['baselineS7'])]:
+    r=check_artifact(sol,label,expected); code=int(decode(sol/(label+'.exit.txt')));assert code==bool(expected['failed']);log(f'Sol {label}: {expected}, exit={code}, tests + stdout + stderr matched')
+s7=Path(tempfile.mkdtemp(prefix='replay-s7-',dir=tmp))
+for f in files:
+    dst=s7/f;dst.parent.mkdir(parents=True,exist_ok=True);dst.write_bytes(raw(['git','cat-file','blob','HEAD:'+f]))
+cmd(['git','apply',str(d/'sol-s7.patch')],s7)
+assert decode(s7/'.github/workflows/deploy_oss.yml')==decode(sol/'baseline-s7.yml');log('Sol baseline-s7.yml matches HEAD + S7')
+canonical=decode(tmp/'original.yml')
+for m in meta['mutations']:
+    name=m['name']; folder=sol/name
+    assert js(folder/'summary.json')==m
+    assert canonical.count(m['before'])==1 and canonical.replace(m['before'],m['after'])==decode(folder/'deploy.yml')
+    r=check_artifact(folder,'deploy',m['summary'])
+    assert m['failed']==[x for x in r['tests'] if not x['pass']]
+    assert all(r['simulations'][s]['status']==v for s,v in m['scenarioExitCodes'].items())
+    assert m['scenarioExitCodes']==m['expectedScenarioExitCodes'] and m['exitCode']==1
+    log(f'Sol {name}: {m["summary"]}, suite exit={m["exitCode"]}; mutation, declared failures, scenario exits and logs match')
+main=js(d/'online-release/main-s12-deploy.json'); s=js(sol/'deploy.json')
+assert main['tests']==s['tests'] and main['summary']==s['summary']=={'passed':27,'failed':0}
+for origin,r in [('Sol',s),('Main',main)]:
+    for line in r['simulations']['healthy']['stdout'].splitlines():
+        if line.startswith('Verified https://thoradar.online/') and 'Content-MD5=' in line: log(origin+' '+line)
+(ev/'audit.txt').write_text('\n'.join(lines)+'\n',encoding='utf8')
