 215         ['cp', '-f', '--meta', workerMeta, retire ? 'sw-retire.js' : 'sw.js', `${origin}sw.js`],
 216         ['cp', '-f', '--meta', 'Cache-Control:public, max-age=60, s-maxage=3600', 'index.html', `${origin}index.html`]
 217       ]);
 218       const preflights = run.calls.filter(call => call.tool === 'curl' && call.args.includes('--connect-to'));
 219       assert.deepEqual(preflights.map(call => call.args.slice(-2)), domains.map(host =>
 220         [`${host}:443:thoradar-online.cn-shenzhen.taihangtop.cn:443`, `https://${host}/`]));
 221       const actions = run.calls.filter(call => call.tool === 'curl' || call.tool === 'aliyun');
 222       assert.deepEqual(actions.map(call => call.tool), ['curl', 'curl', 'aliyun', ...urls.map(() => 'curl')]);
 223       assert.deepEqual(run.refreshes, [['cdn', 'RefreshObjectCaches', '--region', 'cn-shenzhen', '--ObjectType', 'File', '--ObjectPath', refreshUrls.join('\n')]]);
 224       assert.match(run.stdout, /CDN RefreshTaskId="123456"/);
 225       assert.deepEqual(run.heads, urls);
 226       for (const call of actions.slice(3)) {
 227         assert.ok(call.args.includes('Accept-Encoding: identity'));
 228         assert.ok(!call.args.some(arg => ['-L', '--location', '--location-trusted'].includes(arg)));
 229       }
 230       for (const [url, status] of wwwRedirects.map((url, index) => [url, index === 1 ? 308 : 301])) {
 231         assert.ok(run.stdout.includes(`Verified ${url} HTTP=${status} Location=${url.replace('www.', '')}\n`));
 232       }
 233     });
 234   }
 235 
 236   for (const scenario of ['refresh-retry', 'id-retry', 'refresh-error', 'missing-task-id']) {
 237     await test(`CDN ${scenario} uses at most one retry and requires a task ID`, async () => {
 238       const run = await simulate(scenario);
 239       assert.equal(run.refreshes.length, 2);
 240       assert.deepEqual(run.refreshes[0], run.refreshes[1]);
 241       assert.equal(run.calls.filter(call => call.tool === 'sleep').length, 1);
 242       if (scenario.endsWith('-retry')) {
 243         success(run);
 244         assert.deepEqual(run.heads, urls);
 245       } else {
 246         failure(run, /CDN refresh failed or returned no RefreshTaskId/);
 247         assert.deepEqual(run.heads, []);
 248       }
 249     });
