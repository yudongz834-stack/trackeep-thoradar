from pathlib import Path
import re
p=Path(\"docs/tasks/T1128-SMOOTH/astra-v5/report.md\")
s=p.read_text(encoding=\"utf8\").replace(\"命令重放 F1 的 Git blob 首页响应\",\"命令重放以 Git blob 为基准的首页响应\").replace(\"20:22（+08:00）\",\"20:23（+08:00）\")
lines=s.splitlines()
for i in (0,1):
    lines[i]=lines[i]+\"  \"
p.write_bytes((\"\\n\".join(lines)+\"\\n\").encode())
links=re.findall(r'\\[["'^'"\\]\\n]+\\]\\((["'^)]+)'"\\)',s)
for target in links:
    f,_,anchor=target.partition(\"#\")
    path=p.parent/f
    assert path.is_file(),str(path)
    if anchor:
        assert anchor.startswith(\"L\") and 0<int(anchor[1:])<=len(path.read_text(encoding=\"utf8\").splitlines())
print(\"report links checked:\",len(links))
print(\"three-line header:\",all(lines[i].startswith(x) for i,x in enumerate((\"**干了什么**\",\"**PI 怎么亲手验**\",\"**还剩什么坑**\"))))
assert lines[-2]==\"DELIVERY-T1128-SMOOTH-A5\" and len(lines[-1])>20
print(\"delivery marker and one-sentence recap: OK\")
