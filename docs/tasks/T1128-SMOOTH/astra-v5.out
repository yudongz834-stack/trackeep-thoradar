index 0000000000000000000000000000000000000000..ee7803721175932718b201af57d0b1d7b8160034
--- /dev/null
+++ b/D:/claude-tmp/T1128-SMOOTH-A5-98c362c8b2ee4782bd031502825f96fd/setup.py
@@ -0,0 +1,27 @@
+from pathlib import Path
+import shutil, hashlib, difflib, sys
+tmp,root,ev=map(Path,sys.argv[1:])
+snap=tmp/'snapshot'
+wf=Path('.github/workflows/deploy_oss.yml')
+for rel in (wf,Path('tests/smooth/deploy-mock.mjs'),Path('tests/smooth/verify-deploy.mjs'),Path('docs/tasks/T1128-SMOOTH/release-contract.md'),*(Path(x) for x in ('sw.js','sw-retire.js','index.html','sitemap.xml'))):
+    f=snap/rel
+    f.parent.mkdir(parents=True,exist_ok=True)
+    shutil.copyfile(root/rel,f)
+    assert f.read_bytes()==(root/rel).read_bytes()
+    print(hashlib.sha256(f.read_bytes()).hexdigest(),rel)
+shutil.copyfile(snap/wf,tmp/'original.yml')
+raw=(tmp/'original.yml').read_bytes()
+changes = {
+    'allow-302': ('status != 301 && status != 308','status != 301 && status != 308 && status != 302'),
+    'www-active': ("verify_object 'https://www.thoradar.online/sw.js' sw-retire.js 1",'''verify_object 'https://www.thoradar.online/sw.js' "$active_worker" 1'''),
+    'skip-host': ('if (locations != 1 || location != expected) exit 1',r'''actual_path=location; expected_path=expected
+                sub(/^https:\/\/[^/]+/, "", actual_path); sub(/^https:\/\/[^/]+/, "", expected_path)
+                if (locations != 1 || actual_path != expected_path) exit 1'''),
+}
+for label,(old,new) in changes.items():
+    assert raw.count(old.encode())==1
+    body=raw.replace(old.encode(), new.encode().replace(b'\n',b'\r\n' if b'\r\n' in raw else b'\n'))
+    (tmp/f'{label}.yml').write_bytes(body)
+    delta=difflib.unified_diff(raw.decode().splitlines(True),body.decode().splitlines(True),fromfile=wf.as_posix(),tofile=f'{label}.yml')
+    (ev/f'{label}.diff').write_bytes(''.join(delta).encode())
+    print(label,hashlib.sha256(body).hexdigest())

