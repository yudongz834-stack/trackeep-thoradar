   1 name: Deploy to Aliyun OSS
   2 
   3 # 迁移役（2026-11-19 起）：每日流水线跑完 → 网站同步到阿里云深圳 OSS（备案接入）
   4 # 手动可触发（workflow_dispatch）＝首次部署/补发；workflow_run 挂在日报管线尾部自动跟发
   5 on:
   6   workflow_dispatch:
   7     inputs:
   8       retire:
   9         description: 'Publish the retirement worker at /sw.js'
  10         type: boolean
  11         default: false
  12   workflow_run:
  13     workflows: ["ThorRadar Daily Pipeline"]
  14     types: [completed]
  15 
  16 permissions:
  17   contents: read
  18 
  19 jobs:
  20   smooth-verify:
  21     # 日报管线成功才跟发；手动触发不受限
  22     if: github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success'
  23     runs-on: windows-latest
  24     timeout-minutes: 25
  25     steps:
  26       - name: Checkout release revision with history
  27         uses: actions/checkout@v4
  28         with:
  29           ref: ${{ github.sha }}
  30           fetch-depth: 0
  31           persist-credentials: false
  32 
  33       - uses: actions/setup-node@v4
  34         with:
  35           node-version: '24'
  36 
  37       - name: Check deployment workflow and simulate publishing
  38         run: node tests/smooth/verify-deploy.mjs "$env:RUNNER_TEMP/smooth-deploy.json"
  39 
  40       - name: Verify source invariants
  41         run: node tests/smooth/verify-source.mjs "$env:RUNNER_TEMP/smooth-source.json" --ci
  42 
  43       - name: Verify S1
  44         run: node tests/smooth/verify-s1.mjs "$env:RUNNER_TEMP/smooth-s1.json"
  45 
  46       - name: Verify S2
  47         run: node tests/smooth/verify-s2.mjs "$env:RUNNER_TEMP/smooth-s2.json"
  48 
  49       - name: Verify S3
  50         run: node tests/smooth/verify-s3.mjs "$env:RUNNER_TEMP/smooth-s3.json"
  51 
  52       - name: Prepare UX baseline from the first parent
  53         run: node tests/smooth/prepare-ci-ux-baseline.mjs "$env:GITHUB_SHA" "$env:RUNNER_TEMP/smooth-ux-baseline.html"
  54 
  55       - name: Verify UX
  56         run: |
  57           $env:XREV_SCRATCH = Join-Path $env:RUNNER_TEMP 'smooth-ux'
  58           node tests/ux/ux_probe.mjs --target index.html --base-html "$env:RUNNER_TEMP/smooth-ux-baseline.html" --label smooth-ci
  59 
  60   deploy-oss:
  61     needs: smooth-verify
  62     runs-on: ubuntu-latest
  63     concurrency:
  64       group: thoradar-oss
  65       cancel-in-progress: false
  66     steps:
  67       - name: Checkout repository
  68         uses: actions/checkout@v4
  69         with:
  70           ref: ${{ github.sha }}
  71           persist-credentials: false
  72 
  73       - name: Install OSS and CDN tools
  74         shell: bash
  75         run: |
  76           set -euo pipefail
  77           # ossutil 走 GitHub 官方发行版 v1.7.18 zip（v1.7.19 无 linux 资产·alicdn 域名美国 runner 不通）
  78           cd "$RUNNER_TEMP"
  79           curl -fsSL https://github.com/aliyun/ossutil/releases/download/v1.7.18/ossutil-v1.7.18-linux-amd64.zip -o ossutil.zip
  80           unzip -q ossutil.zip
  81           mv ossutil-v1.7.18-linux-amd64/ossutil ./ossutil
  82           chmod +x ossutil
  83           file ossutil | grep -q ELF || { echo 'ossutil download is not an ELF binary'; exit 9; }
  84           ./ossutil --version
  85 
  86           mkdir -p aliyun
  87           curl -fsSL https://github.com/aliyun/aliyun-cli/releases/download/v3.5.4/aliyun-cli-linux-3.5.4-amd64.tgz -o aliyun/cli.tgz
  88           echo 'e1eefcbbe9d772d61f770d4af8595e7297e081a0348b096765d2c41e581c3e72  aliyun/cli.tgz' | sha256sum -c -
  89           tar -xzf aliyun/cli.tgz -C aliyun
  90           chmod +x aliyun/aliyun
  91 
  92       - name: Publish and verify site
  93         shell: bash
  94         env:
  95           OSS_KEY_ID: ${{ secrets.OSS_KEY_ID }}
  96           OSS_KEY_SECRET: ${{ secrets.OSS_KEY_SECRET }}
  97           ALIBABA_CLOUD_ACCESS_KEY_ID: ${{ secrets.OSS_KEY_ID }}
  98           ALIBABA_CLOUD_ACCESS_KEY_SECRET: ${{ secrets.OSS_KEY_SECRET }}
  99           SMOOTH_RETIRE: ${{ inputs.retire && 'true' || 'false' }}
 100         run: |
 101           set -euo pipefail
 102           ossutil="$RUNNER_TEMP/ossutil"
 103           aliyun="$RUNNER_TEMP/aliyun/aliyun"
 104           "$ossutil" config -e oss-cn-shenzhen.aliyuncs.com -i "$OSS_KEY_ID" -k "$OSS_KEY_SECRET" -L CH >/dev/null 2>&1 || {
 105             echo 'OSS configuration failed' >&2
 106             exit 1
 107           }
 108           # 开桶（幂等：已存在则忽略）
 109           "$ossutil" mb oss://thoradar-online --acl public-read 2>/dev/null || echo "跳过桶创建，继续检查现有桶"
 110           # 静态站默认页：v1.7.18 website put 只认 XML 配置文件（--index-page 是幻影旗标，
 111           # 2>/dev/null || true 曾吞错致根路径 403——2026-11-20 控制台补设＋此处改 XML 正方）
 112           cat > website.xml <<'XML'
 113           <?xml version="1.0" encoding="UTF-8"?>
 114           <WebsiteConfiguration>
 115             <IndexDocument><Suffix>index.html</Suffix></IndexDocument>
 116             <ErrorDocument><Key>index.html</Key></ErrorDocument>
 117           </WebsiteConfiguration>
 118           XML
 119           "$ossutil" website --method put oss://thoradar-online website.xml
 120           # 站面文件（首页/图标/搜索登记/订阅件）——ossutil 单命令单源，逐件上传
 121           # sitemap lastmod 部署时现打当日戳（Hydrogen 11-20 审出死日期 2026-11-08 滞留）
 122           sed "s|<lastmod>[^<]*</lastmod>|<lastmod>$(date -u +%Y-%m-%d)</lastmod>|" sitemap.xml > "$RUNNER_TEMP/sitemap.xml"
 123           mv "$RUNNER_TEMP/sitemap.xml" sitemap.xml
 124           for f in favicon.ico robots.txt sitemap.xml; do
 125             "$ossutil" cp -rf --update "$f" oss://thoradar-online/
 126           done
 127           "$ossutil" cp -rf --update --meta Cache-Control:no-cache feed.xml oss://thoradar-online/
 128           "$ossutil" cp -rf --update --meta "Cache-Control:public, max-age=60, s-maxage=300" data/radar_latest.json oss://thoradar-online/data/
 129           "$ossutil" cp -rf --update --meta Cache-Control:no-cache api/ oss://thoradar-online/api/
 130           "$ossutil" cp -rf --update thoradar-skill/ oss://thoradar-online/thoradar-skill/
 131 
 132           active_worker=sw.js
 133           if [[ "$SMOOTH_RETIRE" == true ]]; then active_worker=sw-retire.js; fi
 134           worker_meta='Content-Type:application/javascript#Cache-Control:no-store'
 135           # 始终覆盖 worker，确保正常与退役可双向切换；首页沿用现有缓存头并最后写入。
 136           "$ossutil" cp -f --meta "$worker_meta" sw-retire.js oss://thoradar-online/sw-retire.js
 137           "$ossutil" cp -f --meta "$worker_meta" "$active_worker" oss://thoradar-online/sw.js
 138           "$ossutil" cp -f --meta 'Cache-Control:public, max-age=60, s-maxage=3600' index.html oss://thoradar-online/index.html
 139 
 140           # 开门＝桶级公共读（控制台定版，对象继承 ACL）——逐件 setacl 按 6.2/Hydrogen 双席审读裁撤
 141           # （v1.7.18 无 setacl 命令·对象继承桶权限已实测 200）
 142           echo '=== OSS uploads recorded'
 143           "$ossutil" ls oss://thoradar-online/ | tail -2
 144           # 两个域名都直连源站验证 SNI 与根路径 200；公网 CDN 响应在刷新提交后单独验证。
 145           echo "=== HTTPS 预检（SNI=域名 → CNAME 目标）"
 146           domains=(thoradar.online www.thoradar.online)
 147           paths=(/ /index.html /sw.js /sw-retire.js)
 148           for h in "${domains[@]}"; do
 149             code=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 15 \
 150               --max-time 30 \
 151               --connect-to "$h:443:thoradar-online.cn-shenzhen.taihangtop.cn:443" \
 152               "https://$h/")
 153             if [ "$code" != "200" ]; then echo "✗ $h 根路径 HTTPS $code（期望 200）" >&2; exit 1; fi
 154             echo "$h 根路径 HTTPS 200 ✅"
 155           done
 156 
 157           # 只刷新正式域 thoradar.online。www 的永久跳转和退役 worker 例外由 CDN 配置提供。
 158           refresh_paths=$(printf 'https://thoradar.online%s\n' "${paths[@]}")
 159           refresh_id=''
 160           for attempt in 1 2; do
 161             echo "CDN RefreshObjectCaches attempt $attempt"
 162             if refresh_id=$(
 163               "$aliyun" cdn RefreshObjectCaches --region cn-shenzhen --ObjectType File --ObjectPath "$refresh_paths" |
 164                 python3 -c 'import json, sys; value = json.load(sys.stdin).get("RefreshTaskId");
 165           if type(value) not in (str, int) or not value or not str(value).strip(): sys.exit(1)
 166           print(json.dumps(value))'
 167             ); then
 168               echo "CDN RefreshTaskId=$refresh_id"
 169               break
 170             fi
 171             if [[ "$attempt" == 2 ]]; then
 172               echo 'CDN refresh failed or returned no RefreshTaskId' >&2
 173               exit 1
 174             fi
 175             sleep 5
 176           done
 177 
 178           check_object_headers() {
 179             awk -v expected="$1" -v worker="$2" '
 180               { sub(/\r$/, "") }
 181               /^HTTP\// { status=$2; md5=""; mime=""; cache=""; next }
 182               tolower($0) ~ /^content-md5:/ { md5=$0; sub(/^[^:]+:[ \t]*/, "", md5); sub(/[ \t]+$/, "", md5) }
 183               tolower($0) ~ /^content-type:/ { mime=tolower($0); sub(/^[^:]+:[ \t]*/, "", mime); sub(/([ \t]*;.*|[ \t]+)$/, "", mime) }
 184               tolower($0) ~ /^cache-control:/ { line=tolower($0); sub(/^[^:]+:[ \t]*/, "", line); cache=cache "," line }
 185               END {
 186                 printf "HTTP=%s Content-MD5=%s expected=%s MIME=%s Cache-Control=%s", status, md5, expected, mime, cache
 187                 if (status != 200 || md5 != expected) exit 1
 188                 if (worker && (mime !~ /^(application|text)\/(javascript|ecmascript)$/ || cache !~ /,[ \t]*no-store[ \t]*(,|$)/)) exit 1
 189               }
 190             '
 191           }
 192 
 193           check_redirect_headers() {
 194             awk -v expected="$1" '
 195               { sub(/\r$/, "") }
 196               /^HTTP\// { status=$2; location=""; locations=0; next }
 197               tolower($0) ~ /^location:/ {
 198                 locations++
 199                 location=$0; sub(/^[^:]+:[ \t]*/, "", location); sub(/[ \t]+$/, "", location)
 200               }
 201               END {
 202                 printf "HTTP=%s Location=%s", status, location
 203                 if (status != 301 && status != 308) exit 1
 204                 if (locations != 1 || location != expected) exit 1
 205               }
 206             '
 207           }
 208 
 209           verify_public() {
 210             local url="$1" headers result attempt
 211             shift
 212             for attempt in {1..12}; do
 213               # 读取首个公网响应，不跟随跳转。-q 禁止 curl 配置文件覆盖命令行为。
 214               if headers=$(curl -q -sS -I -H 'Accept-Encoding: identity' --connect-timeout 5 --max-time 10 "$url"); then
 215                 if result=$("$@" <<< "$headers"); then
 216                   echo "Verified $url $result"
 217                   return 0
 218                 fi
 219               else
 220                 result='HEAD request failed'
 221               fi
 222               echo "Waiting for $url ($attempt/12) $result"
 223               # CDN 刷新从提交到生效约需 5–6 分钟。两次短等后拉长间隔，末次至少在 370 秒后。
 224               if (( attempt <= 2 )); then
 225                 sleep 5
 226               elif (( attempt < 12 )); then
 227                 sleep 40
 228               fi
 229             done
 230             echo "Verification failed for $url" >&2
 231             return 1
 232           }
 233 
 234           verify_object() {
 235             local url="$1" source="$2" worker="$3" expected
 236             expected=$(openssl dgst -md5 -binary "$source" | openssl base64 -A)
 237             verify_public "$url" check_object_headers "$expected" "$worker"
 238           }
 239 
 240           for path in "${paths[@]}"; do
 241             url="https://thoradar.online$path"
 242             case "$path" in
 243               /sw.js) verify_object "$url" "$active_worker" 1 ;;
 244               /sw-retire.js) verify_object "$url" sw-retire.js 1 ;;
 245               *) verify_object "$url" index.html 0 ;;
 246             esac
 247           done
 248 
 249           for path in / /index.html '/?from=www'; do
 250             verify_public "https://www.thoradar.online$path" check_redirect_headers "https://thoradar.online$path"
 251           done
 252           # 保留旧 www 客户端的退役入口，两件 worker 在两种发布模式都返回退役文件。
 253           verify_object 'https://www.thoradar.online/sw.js' sw-retire.js 1
 254           verify_object 'https://www.thoradar.online/sw-retire.js' sw-retire.js 1
 255           echo 'Publish verified on both domains'

