 203 
 204   for (const retire of [false, true]) {
 205     await test(`${retire ? 'retire' : 'normal'} uploads workers then index, refreshes only four main URLs and verifies both domains`, async () => {
 206       const run = await simulate('healthy', retire);
 207       success(run);
