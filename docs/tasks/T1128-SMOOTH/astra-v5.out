+++ b/D:/claude-tmp/T1128-SMOOTH-A5-98c362c8b2ee4782bd031502825f96fd/summarize.py
@@ -0,0 +1,62 @@
+from pathlib import Path
+import sys,json,subprocess as sp,datetime,hashlib,base64
+tmp,root,ev=map(Path,sys.argv[1:]);d=root/'docs/tasks/T1128-SMOOTH'
+def read(f):return json.loads(f.read_bytes())
+canon=read(ev/'canonical.json'); main=read(d/'online-release/main-s12-deploy.json')
+def md5(b):return base64.b64encode(hashlib.md5(b).digest()).decode()
+lines=[]
+def log(s=''):lines.append(s)
+log('A5 本地核验回执')
+log('Git blob    HEAD:index.html  '+md5(sp.check_output(['git','cat-file','blob','HEAD:index.html'],cwd=root)))
+log('工作树字节  index.html       '+md5((root/'index.html').read_bytes()))
+log(next(x for x in canon['simulations']['healthy']['stdout'].splitlines() if x.startswith('Verified https://thoradar.online/ ')))
+log()
+for n,p,f,exitcode in [('canonical',27,0,0),('allow-302',26,1,1),('www-active',21,6,1),('skip-host',27,0,0),('source',5,0,0)]:
+    r=read(ev/(n+'.run.json'));j=read(ev/(n+'.json'))
+    assert j['summary']==r['summary']=={'passed':p,'failed':f} and r['exit']==exitcode
+    stdout=(ev/(n+'.stdout.txt')).read_text(encoding='utf8').splitlines()
+    assert json.loads(stdout[-1].removeprefix('SUMMARY '))==r['summary']
+    log(f'[{n}]');log('cwd='+r['cwd']);log('> '+sp.list2cmdline(r['command']));log(stdout[-1]);log('exit='+str(exitcode))
+    if n not in ('canonical','source'):
+        failures=[k['name']+': '+k['error'].strip().split('\n')[0] for k in j['tests'] if not k['pass']]
+        assert len(failures)==f
+        for msg in failures:log('FAIL '+msg)
+    log()
+assert main['tests']==canon['tests'] and main['shellRuns']==canon['shellRuns']
+assert set(main['simulations'])==set(canon['simulations'])
+for s,v in canon['simulations'].items():
+    assert v==main['simulations'][s],s
+log(f'A5 vs main-s12-deploy.json: tests, shellRuns and all {len(canon["simulations"])} simulation records (stdout, stderr, status, calls) match.')
+c=canon['simulations']; active=read(ev/'www-active.json')['simulations']; a302=read(ev/'allow-302.json')['simulations']
+for tag,s0,j,u in [('allow-302','www-redirect-302',a302,'https://www.thoradar.online/'),('www-active','www-active-worker',active,'https://www.thoradar.online/sw.js')]:
+    for lab,x in [('canonical',c[s0]),(tag,j[s0])]:
+        log(f'[{lab}] {s0} scenario_exit={x["status"]}')
+        log(next(l for l in x['stdout'].splitlines() if (l.startswith('Verified '+u+' ') or l.startswith('Waiting for '+u+' '))))
+        log(x['stderr'].rstrip())
+    assert c[s0]['status']==1 and j[s0]['status']==0
+for label in ('healthy','healthy-retire'):
+    v=c[label];log('\n['+label+']')
+    for e in v['calls']:
+        a=e['args']
+        if e['tool']=='ossutil' and a[0]=='cp' and a[-1].endswith(('/sw-retire.js','/sw.js','/index.html')):log('ossutil '+sp.list2cmdline(a))
+        if e['tool']=='aliyun':log('aliyun '+sp.list2cmdline(a))
+    for line in v['stdout'].splitlines():
+        if line.startswith(('Verified ','Publish verified')):log(line)
+log('\n[stale-during-propagation-retire]')
+prop=c['stale-during-propagation-retire']; sleeps=[int(e['args'][0]) for e in prop['calls'] if e['tool']=='sleep']
+log(f'sleep seconds: {sleeps}, sum={sum(sleeps)}, main /sw.js HEAD count='+str(sum(1 for e in prop['calls'] if e['tool']=='curl' and e['args'][-1]=='https://thoradar.online/sw.js')))
+log('\n[upload-error]')
+v=c['upload-error'];calls=v['calls'];log('last upload='+json.dumps([e['args'] for e in calls if e['tool']=='ossutil' and e['args'][0]=='cp'][-1]))
+log(f'index uploads={sum(e["tool"]=="ossutil" and e["args"][0]=="cp" and e["args"][-1].endswith("/index.html") for e in calls)}; CDN refreshes={sum(e["tool"]=="aliyun" for e in calls)}; exit={v["status"]}')
+log('\n[fixture responses passed to original Bash functions; synthetic curl/sleep]')
+for row in read(ev/'focused.json'):
+    log(row['name']+' exit='+str(row['exit'])+' | '+row['stdout'].splitlines()[0])
+    assert row['exit']==row['expectedExit']
+log('\n[integrity after all runs]')
+for line in (ev/'snapshot-sha256.txt').read_text(encoding='utf-8-sig').splitlines()[:8]:
+    sha,name=line.split(maxsplit=1);assert sha==hashlib.sha256((root/name).read_bytes()).hexdigest();log(sha+' '+name)
+log('> Test-Path -LiteralPath docs/tasks/T1128-SMOOTH/mimo-m3-canonical-report.md')
+log(str((d/'mimo-m3-canonical-report.md').is_file()))
+log(datetime.datetime.now().astimezone().isoformat(timespec='seconds'))
+(ev/'review-results.txt').write_text('\n'.join(lines)+'\n',encoding='utf8')
+print('\n'.join(lines[:4]));print('\n'.join(lines[-3:]))

