index 0000000000000000000000000000000000000000..49185699f3a3760bf18158552c1f40de8ae2e517
--- /dev/null
+++ b/D:/claude-tmp/T1128-SMOOTH-A5-98c362c8b2ee4782bd031502825f96fd/run.py
@@ -0,0 +1,16 @@
+from pathlib import Path
+import sys, subprocess, json, time, os, datetime
+tmp=Path(__file__).resolve().parent
+root,ev,label=Path(sys.argv[1]),Path(sys.argv[2]),sys.argv[3]
+cwd=root if label=='source' else tmp/'snapshot'
+cmd=['node',('tests/smooth/verify-source.mjs' if label=='source' else 'tests/smooth/verify-deploy.mjs'),str(ev/(label+'.json'))]
+if label=='source': cmd+=['--ci']
+elif label!='canonical': cmd+=[str(tmp/(label+'.yml'))]
+started=datetime.datetime.now().astimezone().isoformat()
+with (ev/(label+'.stdout.txt')).open('xb') as out, (ev/(label+'.stderr.txt')).open('xb') as err:
+    res=subprocess.run(cmd,cwd=cwd,stdout=out,stderr=err)
+record={'cwd':str(cwd),'command':cmd,'started':started,'ended':datetime.datetime.now().astimezone().isoformat(),'exit':res.returncode}
+if (ev/(label+'.json')).exists(): record['summary']=json.loads((ev/(label+'.json')).read_bytes())['summary']
+(ev/(label+'.run.json')).write_text(json.dumps(record,indent=2)+'\n',encoding='utf8')
+print(label,record)
+sys.exit(res.returncode)
