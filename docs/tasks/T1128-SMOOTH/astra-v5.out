 100 const localEnv = {};
 101 for (const key of ['PATH', 'SystemRoot', 'COMSPEC', 'PATHEXT', 'TEMP', 'TMP', 'TMPDIR']) {
 102   if (process.env[key] !== undefined) localEnv[key] = process.env[key];
 103 }
 104 const bashPath = path => windows ? path.replaceAll('\\', '/') : path;
 105 const scratch = await mkdtemp(join(tmpdir(), 'thoradar-s5-deploy-'));
 106 const simulations = {};
 107 const shellRuns = {};
 108 const domains = ['thoradar.online', 'www.thoradar.online'];
 109 const refreshUrls = ['/', '/index.html', '/sw.js', '/sw-retire.js'].map(path => `https://thoradar.online${path}`);
 110 const wwwRedirects = ['/', '/index.html', '/?from=www'].map(path => `https://www.thoradar.online${path}`);
 111 const wwwWorkers = ['https://www.thoradar.online/sw.js', 'https://www.thoradar.online/sw-retire.js'];
 112 const urls = [...refreshUrls, ...wwwRedirects, ...wwwWorkers];
 113 const workerMeta = 'Content-Type:application/javascript#Cache-Control:no-store';
 114 const origin = 'oss://thoradar-online/';
 115 const publishComplete = 'Publish verified on both domains';
 116 
 117 function bashRun(args, options = {}) {
 118   const run = spawnSync(bash, ['--noprofile', '--norc', ...args], {
 119     cwd: scratch, env: localEnv, encoding: 'utf8', windowsHide: true, timeout: 60000, ...options
 120   });
 121   if (run.error) throw run.error;
 122   return { status: run.status, stdout: run.stdout, stderr: run.stderr };
 123 }
 124 
 125 async function mockCommand(path, tool) {
 126   const command = `#!/usr/bin/env bash\nexec "$SMOOTH_MOCK_NODE" "$SMOOTH_MOCK_SCRIPT" ${tool} "$@"\n`;
 127   await writeFile(path, command);
 128   await chmod(path, 0o755);
 129 }
 130 
 131 async function simulate(scenario, retire = false) {
 132   const label = retire ? `${scenario}-retire` : scenario;
 133   const trace = join(scratch, `trace-${label}.jsonl`);
 134   await writeFile(trace, '');
 135   const env = { ...localEnv, MSYS2_ARG_CONV_EXCL: '*', RUNNER_TEMP: bashPath(scratch),
 136     OSS_KEY_ID: 'mock-id', OSS_KEY_SECRET: 'mock-secret',
 137     ALIBABA_CLOUD_ACCESS_KEY_ID: 'mock-id', ALIBABA_CLOUD_ACCESS_KEY_SECRET: 'mock-secret',
 138     SMOOTH_RETIRE: String(retire), SMOOTH_MOCK_SCENARIO: scenario,
 139     SMOOTH_MOCK_NODE: bashPath(process.execPath), SMOOTH_MOCK_SCRIPT: fileURLToPath(new URL('./deploy-mock.mjs', import.meta.url)),
 140     SMOOTH_MOCK_TRACE: trace };
 141   const script = join(scratch, 'publish.sh');
 142   const run = bashRun([bashPath(script)], { env });
 143   const calls = (await readFile(trace, 'utf8')).trim().split('\n').filter(Boolean).map(line => JSON.parse(line));
 144   simulations[label] = { ...run, calls };
 145   return { ...run, calls, uploads: calls.filter(call => call.tool === 'ossutil' && call.args[0] === 'cp').map(call => call.args),
 146     refreshes: calls.filter(call => call.tool === 'aliyun').map(call => call.args),
 147     heads: calls.filter(call => call.tool === 'curl' && call.args.includes('-I')).map(call => call.args.at(-1)) };
 148 }
 149 
 150 function success(run) {
 151   assert.equal(run.status, 0, run.stderr);
 152   assert.ok(run.stdout.includes(publishComplete));
 153 }
 154 
 155 function failure(run, message) {
 156   assert.notEqual(run.status, 0, 'deployment exited 0');
 157   assert.match(run.stderr, message);
 158   assert.ok(!run.stdout.includes(publishComplete));
 159 }
 160 
 161 function rejectsPublicResponse(run, url) {
 162   failure(run, /^Verification failed for /m);
 163   assert.ok(run.stderr.includes(`Verification failed for ${url}\n`), run.stderr);
 164   assert.equal(run.heads.filter(head => head === url).length, 12);
 165   assert.ok(!run.stdout.includes(`Verified ${url} `));
 166 }
