 251 
 252   await test('stale www worker is polled before the retirement worker verifies', async () => {
 253     const run = await simulate('stale-then-current');
 254     success(run);
 255     assert.equal(run.heads.filter(url => url === wwwWorkers[0]).length, 2);
 256     assert.ok(run.stdout.includes(`Waiting for ${wwwWorkers[0]} (1/12)`));
 257     assert.deepEqual([...new Set(run.heads)], urls);
 258   });
 259 
 260   await test('main-domain CDN can take six minutes with two 5s sleeps followed by nine 40s sleeps', async () => {
 261     const run = await simulate('stale-during-propagation', true);
