  31 // Extract the two Bash blocks as GitHub Actions passes them to its shell.
  32 function section(start, end) {
  33   const from = yaml.indexOf(start);
  34   if (from < 0) return '';
  35   const to = end ? yaml.indexOf(end, from + start.length) : -1;
  36   return yaml.slice(from, to < 0 ? undefined : to);
  37 }
  38 
  39 function shellBlock(step) {
  40   const lines = step.split('\n');
  41   const start = lines.indexOf('        run: |');
  42   assert.notEqual(start, -1, 'missing Bash run block');
  43   const body = [];
  44   for (const line of lines.slice(start + 1)) {
  45     if (line && !line.startsWith('          ')) break;
  46     body.push(line.slice(10));
  47   }
  48   return body.join('\n') + '\n';
  49 }
