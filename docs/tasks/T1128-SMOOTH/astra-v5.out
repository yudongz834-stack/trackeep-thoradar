 210         ['cp', '-rf', '--update', '--meta', 'Cache-Control:no-cache', 'feed.xml', origin],
 211         ['cp', '-rf', '--update', '--meta', 'Cache-Control:public, max-age=60, s-maxage=300', 'data/radar_latest.json', `${origin}data/`],
