diff --git a/astra-v3/read-render.mjs b/astra-v3/read-render.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0e8ca5456c52c84cf5980678affc88fd223b51b5
--- /dev/null
+++ b/astra-v3/read-render.mjs
@@ -0,0 +1,92 @@
+import assert from 'node:assert/strict';
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import { createServer } from 'node:http';
+import { tmpdir } from 'node:os';
+import { basename, dirname, join, resolve } from 'node:path';
+import { ROOT, Tab, connect, freePort, launch, sha256, wire } from '../tests/aicls/lib.mjs';
+
+const out = process.argv[2];
+const s3 = JSON.parse(await readFile(join(dirname(out), 's3.json'), 'utf8'));
+const independent = JSON.parse(await readFile(join(dirname(out), 'independent.json'), 'utf8'));
+const healthy = await readFile(join(ROOT, 'index.html'), 'utf8');
+const worker = await readFile(join(ROOT, 'sw.js'));
+const raw = /const SITE_DATA = (\{[^\r\n]+\});\s*\/\*__THORADAR_DATA_END__\*\//.exec(healthy)[1];
+const edition = JSON.parse(raw);
+const cases = [
+  ['empty-briefing-date', healthy.replace(raw, () => JSON.stringify({ ...edition, briefing_date: '', papers: [] }))],
+  ['comment-wrapped-site-data-stub', '<!doctype html><html><body><!-- /*__THORADAR_DATA_START__*/ const SITE_DATA = {"briefing_date":"2026-11-28","papers":[]}; /*__THORADAR_DATA_END__*/ --><p>Comment stub</p></body></html>']
+];
+const snapshot = `(async () => {
+  const response = await (await caches.open('thoradar-shell-v1')).match('/index.html');
+  const bytes = await response.arrayBuffer();
+  const hash = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)), x => x.toString(16).padStart(2, '0')).join('');
+  return { hash, bytes: bytes.byteLength, date: SITE_DATA.briefing_date, papers: SITE_DATA.papers.length,
+    banner: document.querySelector('#shell-status').innerText, counter: document.querySelector('#filter-counter').innerText,
+    points: document.querySelectorAll('#blips .blip').length };
+})()`;
+const rows = [];
+const profile = await mkdtemp(join(tmpdir(), 'thoradar-astra-v3-render-'));
+let browser, cdp;
+try {
+  browser = await launch({ chrome: 'C:/Program Files/Google/Chrome/Application/chrome.exe', profile, port: await freePort() });
+  cdp = await connect(browser.ver.webSocketDebuggerUrl);
+  const h = { cdp, tabs: new Map() };
+  wire(h);
+  const docs = [];
+  cdp.on('Network.responseReceived', ({ type, response }, sid) => {
+    if (type === 'Document') docs.push({ sid, url: response.url, source: response.serviceWorkerResponseSource });
+  });
+  for (const [name, input] of cases) {
+    assert.equal(sha256(input), s3.fixtures[name].sha256);
+    const probe = independent.extraProbes.find(p => p.mode === name);
+    assert.equal(probe.preserved, true);
+    let page = healthy;
+    const site = createServer((req, res) => {
+      const path = new URL(req.url, 'http://127.0.0.1').pathname;
+      if (!['/index.html', '/sw.js'].includes(path)) { res.writeHead(404); res.end(); return; }
+      res.writeHead(200, { 'Content-Type': path === '/sw.js' ? 'text/javascript' : 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });
+      res.end(path === '/sw.js' ? worker : page);
+    });
+    const tab = new Tab(h, name);
+    try {
+      await new Promise((ok, fail) => { site.once('error', fail); site.listen(0, '127.0.0.1', ok); });
+      const url = `http://127.0.0.1:${site.address().port}/index.html`;
+      await tab.open(url + '?sw=1');
+      await tab.waitFor("(async () => (await navigator.serviceWorker.ready).active && !!await caches.match('/index.html'))()");
+      await cdp.send('Network.enable', {}, tab.sid);
+      page = input;
+      const settled = "document.querySelector('#shell-status').innerText.includes('暂未核实更新')";
+      await tab.goto(url);
+      await tab.waitFor(settled);
+      const first = await tab.eval(snapshot);
+      const offset = docs.length;
+      await tab.goto(url);
+      await tab.waitFor(settled);
+      const next = await tab.eval(snapshot);
+      const document = docs.slice(offset).find(d => d.sid === tab.sid && d.url === url);
+      const row = { name, inputSha256: sha256(input), independentPreserved: probe.preserved, first, next, document };
+      rows.push(row);
+      console.log(name, JSON.stringify(row));
+      assert.equal(document?.source, 'cache-storage');
+      assert.equal(first.hash, sha256(healthy));
+      assert.equal(next.hash, first.hash);
+      assert.equal(next.bytes, 539012);
+      assert.equal(next.date, edition.briefing_date);
+      assert.equal(next.papers, edition.papers.length);
+      assert.ok(next.banner.includes(edition.briefing_date));
+      assert.equal(next.points, 37);
+      assert.ok(next.counter.trim());
+    } finally {
+      await tab.close();
+      if (site.listening) await new Promise(done => { site.close(done); site.closeAllConnections(); });
+    }
+  }
+} finally {
+  try { await cdp?.send('Browser.close'); } catch {}
+  cdp?.close();
+  if (browser && await browser.stop()) process.exitCode = 1;
+  if (dirname(resolve(profile)) === resolve(tmpdir()) && basename(profile).startsWith('thoradar-astra-v3-render-')) {
+    await rm(profile, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
+  }
+  await writeFile(out, JSON.stringify(rows, null, 2) + '\n', { flag: 'wx' });
+}
diff --git a/astra-v3/record_runs.py b/astra-v3/record_runs.py
new file mode 100644
index 0000000000000000000000000000000000000000..3e2525fb077703b7987c446647e953dd33617042
--- /dev/null
+++ b/astra-v3/record_runs.py
@@ -0,0 +1,94 @@
+"""Capture the original verifier streams and the identities of its Chrome children."""
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from contextlib import ExitStack
+from datetime import datetime, timezone
+from pathlib import Path
+
+import psutil
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parent
+SOL = ROOT.parent / "trackeep-thoradar-smooth-T1128/docs/tasks/T1128-SMOOTH/sol-s4"
+NODE = shutil.which("node")
+
+
+def timestamp():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def run(name):
+    result = OUT / f"{name}.json"
+    cwd = ROOT
+    input_path = None
+    environment = os.environ.copy()
+    if name == "independent":
+        cwd = ROOT / "tests"
+        input_path = OUT / "neon-v2-s4.mjs"
+        args = ["--input-type=module", "-", str(result)]
+    elif name in ("no-date-guard", "no-script-guard"):
+        args = ["tests/smooth/verify-s3.mjs", str(result), str(SOL / f"{name}.sw.js")]
+    elif name == "render":
+        args = ["astra-v3/read-render.mjs", str(result)]
+    elif name == "ux":
+        scratch = tempfile.mkdtemp(prefix="T1128-astra-v3-ux-")
+        environment["XREV_SCRATCH"] = scratch
+        args = ["tests/ux/ux_probe.mjs", "--target", "index.html", "--base", "73dd34e", "--label", "astrav3"]
+    elif name in ("s1", "s2", "s3"):
+        args = [f"tests/smooth/verify-{name}.mjs", str(result)]
+    else:
+        raise ValueError(name)
+
+    argv = [NODE, *args]
+    record = {"name": name, "cwd": str(cwd), "argv": argv, "stdin": str(input_path) if input_path else None,
+              "started": timestamp(), "observedChrome": []}
+    if name == "ux":
+        record["XREV_SCRATCH"] = scratch
+    seen = {}
+    with ExitStack() as opened:
+        stdout = opened.enter_context((OUT / f"{name}.stdout.txt").open("xb"))
+        stderr = opened.enter_context((OUT / f"{name}.stderr.txt").open("xb"))
+        stdin = opened.enter_context(input_path.open("rb")) if input_path else subprocess.DEVNULL
+        child = subprocess.Popen(argv, cwd=cwd, env=environment, stdin=stdin, stdout=stdout, stderr=stderr)
+        record["nodePid"] = child.pid
+        parent = psutil.Process(child.pid)
+        while child.poll() is None:
+            try:
+                children = parent.children(recursive=True)
+            except psutil.NoSuchProcess:
+                break
+            for proc in children:
+                try:
+                    identity = (proc.pid, proc.create_time())
+                    if identity in seen or proc.name().lower() != "chrome.exe":
+                        continue
+                    flags = proc.cmdline()
+                    item = {"pid": proc.pid, "parent": proc.ppid(), "exe": proc.exe(), "created": identity[1],
+                            "profile": next((v.split("=", 1)[1] for v in flags if v.startswith("--user-data-dir=")), None),
+                            "type": next((v for v in flags if v.startswith("--type=")), "browser")}
+                    seen[identity] = item
+                except (psutil.NoSuchProcess, psutil.AccessDenied):
+                    continue
+            time.sleep(0.15)
+        record["exit"] = child.wait()
+    for (pid, birth), item in seen.items():
+        try:
+            item["sameProcessAfter"] = psutil.Process(pid).create_time() == birth
+        except psutil.NoSuchProcess:
+            item["sameProcessAfter"] = False
+        record["observedChrome"].append(item)
+    profiles = {v["profile"] for v in seen.values() if v["profile"]}
+    record["profileExistsAfter"] = {p: Path(p).exists() for p in sorted(profiles)}
+    record["ended"] = timestamp()
+    (OUT / f"{name}.run.json").write_text(json.dumps(record, indent=2), encoding="utf-8")
+    print(name, "exit", record["exit"], "Chrome PIDs", len(seen), "alive",
+          [x["pid"] for x in seen.values() if x["sameProcessAfter"]], flush=True)
+
+
+for suite in sys.argv[1:]:
+    run(suite)
diff --git a/astra-v3/validate_evidence.py b/astra-v3/validate_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..bd92c4682e4762f8abe779f025d166e7ff1b5d4a
--- /dev/null
+++ b/astra-v3/validate_evidence.py
@@ -0,0 +1,79 @@
+import hashlib
+import json
+from pathlib import Path
+
+folder = Path(__file__).resolve().parent
+tree = folder.parent
+task = tree.parent / "trackeep-thoradar/docs/tasks/T1128-SMOOTH"
+
+
+def load(name):
+    return json.loads((folder / f"{name}.json").read_bytes())
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+expected = {
+    "index.html": "33c50bef723b0a3f32b51bc2d5927ff4391bb58eb474996f1a7d9dff96bc1def",
+    "sw.js": "e882e9e2eef0bf36781b8b03ecec23eb81221fa8b33272cdc9de3e368f76394f",
+    "sw-retire.js": "5ae38f2ba965f4e1b1d340da2ba5fadd8b58af82a1e271a02ddff97ab5686199"
+}
+core = load("independent")
+v2 = json.loads((task / "neon-v2/neon-v2-verify.json").read_bytes())
+healthy = expected["index.html"]
+for name, value in expected.items():
+    assert digest(tree / name) == core["sha256"][name] == value
+    assert (tree / name).read_bytes() == (tree.parent / "trackeep-thoradar-smooth-T1128" / name).read_bytes()
+assert v2["sha256"]["index.html"] == healthy
+assert len(core["checks"]) == 12 and all(x["pass"] for x in core["checks"])
+assert len(core["extraProbes"]) == len(load("render")) == 2
+s3 = {v["name"]: v for v in load("s3")["checks"]}
+for name in ["empty-briefing-date", "comment-wrapped-site-data-stub"]:
+    old = next(p for p in v2["extraProbes"] if p["mode"] == name)
+    new = next(p for p in core["extraProbes"] if p["mode"] == name)
+    observe = next(p for p in load("render") if p["name"] == name)
+    detail = s3[name]["detail"]
+    assert old["preserved"] is False and new["preserved"] is True
+    assert any(r["sha256"] == old["cachedHash"] and r["bytes"] == old["cachedBytes"] and r["finished"]
+               for r in detail["requests"])
+    assert observe["inputSha256"] == old["cachedHash"]
+    assert detail["before"] == detail["after"] == {"sha256": healthy, "bytes": 539012}
+    assert new["cachedHash"] == healthy and new["cachedBytes"] == 539012
+    assert observe["next"]["hash"] == healthy and observe["next"]["bytes"] == 539012
+    assert detail["next"]["source"] == observe["document"]["source"] == "cache-storage"
+    assert detail["nextPage"]["date"] == observe["next"]["date"] == "2026-11-27"
+    assert detail["nextPage"]["papers"] == observe["next"]["papers"] == 40
+    assert observe["next"]["counter"] == "40 / 40" and observe["next"]["points"] == 37
+    print(f"{name}: preserved=true  bytes=539012  next=cache-storage  date=2026-11-27  papers=40  counter=40 / 40  points=37")
+zero = next(x for x in core["checks"] if x["name"] == "valid-zero-papers-accepted")
+assert zero["nextSnap"]["date"] == "2026-11-28" and zero["nextSnap"]["papersLen"] == 0 and zero["nextSnap"]["points"] == 0
+assert zero["storage"]["hash"] == zero["expectedHash"] == s3["valid-zero-papers"]["detail"]["after"]["sha256"]
+assert len(core["negativeControls"]) == 5
+assert {x["mutation"] for x in core["negativeControls"] if x["caughtRed"]} == {"mut-mime", "mut-status-503"}
+for row in core["negativeControls"]:
+    assert row["caughtRed"] == (row["cachedHashAfter"] != healthy)
+    print(f'{row["mutation"]}: {"RED-CAUGHT" if row["caughtRed"] else "SURVIVED"}  cache={row["cachedHashAfter"]}')
+failures = {"no-date-guard": {"empty-briefing-date", "invalid-calendar-date"},
+            "no-script-guard": {"comment-wrapped-site-data-stub"}}
+for suite, count in [("s3", 9), ("s1", 9), ("s2", 24), ("no-date-guard", 9), ("no-script-guard", 9)]:
+    data = load(suite)
+    bad = {x["name"] for x in data["checks"] if not x["pass"]}
+    assert len(data["checks"]) == count and bad == failures.get(suite, set())
+    assert data["summary"] == {"passed": count - len(bad), "failed": len(bad)}
+    for row in data["checks"]:
+        if row["name"] in bad:
+            assert row["detail"]["status"] == "updated" and row["detail"]["after"]["sha256"] != healthy
+    print(f"{suite}: {count-len(bad)} PASS / {len(bad)} FAIL")
+ux = (folder / "ux.stdout.txt").read_text(encoding="utf-8")
+assert "SUMMARY 46 PASS / 0 FAIL" in ux
+print("UX: 46 PASS / 0 FAIL")
+for suite in ["independent", "s3", "no-date-guard", "no-script-guard", "s1", "s2", "ux", "render"]:
+    run = load(suite + ".run")
+    assert run["exit"] == (1 if suite in failures else 0)
+    assert any(x["type"] == "browser" for x in run["observedChrome"])
+    assert not any(x["sameProcessAfter"] for x in run["observedChrome"])
+    assert run["profileExistsAfter"] and not any(run["profileExistsAfter"].values())
+    print(f'{suite}: exit={run["exit"]}  observedChrome={len(run["observedChrome"])}  survivingTestPID=0  remainingProfile=0')
+print("VERDICT PASS")

