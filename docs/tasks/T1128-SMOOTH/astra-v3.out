const result = {
  source: 'Neon V2 independent adversarial verification + 4 in-memory negative controls against S3 candidate index.html and sw.js',
  startedAt: new Date().toISOString(),
  baselineCommit: gitRead(['rev-parse', 'HEAD']).trim(),
  environment: { os: version(), release: release(), arch: arch(), node: process.version },
  runs: 1,
  seed: null,
  sha256: {
    'index.html': v1Hash,
    'sw.js': sha256(await readFile(join(ROOT, 'sw.js'))),
    'sw-retire.js': sha256(retireSrc),
    'empty-markers-stub': sha256(emptyMarkersHtml),
    'valid-zero-papers': zeroHash
  },
  checks: [],
  extraProbes: [],
  negativeControls: [],
  requests: [],
  errors: []
};

let currentMode = 'v1';
let currentWorkerMode = 'normal';

const s3GuardBlock = [
  '  const block = html.slice(dataStart, end).trim();',
  '  const declaration = /^const\\s+SITE_DATA\\s*=\\s*(\\{[\\s\\S]*\\})\\s*;?$/.exec(block);',
  '  if (!declaration) return null;',
  '  try {',
  '    const data = JSON.parse(declaration[1]);',
  '    if (typeof data.briefing_date !== \'string\' || !Array.isArray(data.papers)) return null;',
  '  } catch (_) {',
  '    return null;',
  '  }'
].join('\n');

const workerVariants = {
  normal: workerSrc,
  'mut-marker-order-naive': replaceOnce(workerSrc, 'const end = html.indexOf(DATA_END, dataStart);', 'const end = html.indexOf(DATA_END);'),
  'mut-marker-order-orderless': replaceOnce(
    replaceOnce(workerSrc, 'const end = html.indexOf(DATA_END, dataStart);', 'const end = html.indexOf(DATA_END);'),
    'const block = html.slice(dataStart, end).trim();',
    'const block = (start < end ? html.slice(dataStart, end) : html.slice(end + DATA_END.length, start)).trim();'
  ),
  'mut-mime': replaceOnce(workerSrc, " || mime !== 'text/html'", ''),
  'mut-status-503': replaceOnce(workerSrc, 'response.status !== 200', 'response.status < 200'),
  'mut-s3-site-data-guard': replaceOnce(workerSrc, s3GuardBlock, '  // mutated: S3 SITE_DATA guard removed')
};

const site = createServer((req, res) => {
  const { pathname } = new URL(req.url, 'http://127.0.0.1');
  const row = { mode: currentMode, workerMode: currentWorkerMode, method: req.method, url: req.url, ts: Date.now() };
  result.requests.push(row);
  if (pathname === '/sw.js') {
    row.status = 200;
    res.writeHead(200, { 'Content-Type': 'text/javascript', 'Cache-Control': 'no-store' });
    res.end(workerVariants[currentWorkerMode]);
    return;
  }
  if (pathname === '/api/ai-probe' && req.method === 'POST') {
    row.status = 200;
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end('{"ok":true}');
    return;
  }
  if (pathname === '/data/radar_latest.json') {
    row.status = 200;
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end('{"papers":[]}');
    return;
  }
  if (pathname === '/' || pathname === '/index.html') {
    const map = {
      v1: { status: 200, mime: 'text/html; charset=utf-8', body: html },
      'reversed-markers': { status: 200, mime: 'text/html; charset=utf-8', body: reversedHtml },
      'json-mime-valid-html': { status: 200, mime: 'application/json', body: v2Html },
      'status-503-valid-html': { status: 503, mime: 'text/html; charset=utf-8', body: v2Html },
      'empty-markers-stub': { status: 200, mime: 'text/html; charset=utf-8', body: emptyMarkersHtml },
      'missing-site-data': { status: 200, mime: 'text/html; charset=utf-8', body: missingSiteDataHtml },
      'bad-json-site-data': { status: 200, mime: 'text/html; charset=utf-8', body: badJsonHtml },
      'wrong-date-type': { status: 200, mime: 'text/html; charset=utf-8', body: wrongDateTypeHtml },
      'wrong-papers-type': { status: 200, mime: 'text/html; charset=utf-8', body: wrongPapersTypeHtml },
      'null-site-data': { status: 200, mime: 'text/html; charset=utf-8', body: nullSiteDataHtml },
      'valid-zero-papers': { status: 200, mime: 'text/html; charset=utf-8', body: zeroPapersHtml },
      'empty-briefing-date': { status: 200, mime: 'text/html; charset=utf-8', body: emptyDateHtml },
      'comment-wrapped-site-data-stub': { status: 200, mime: 'text/html; charset=utf-8', body: commentWrappedSiteDataHtml }
    };
    const cfg = map[currentMode];
    row.status = cfg.status;
    row.mime = cfg.mime;
    res.writeHead(cfg.status, { 'Content-Type': cfg.mime, 'Cache-Control': 'no-store' });
    res.end(cfg.body);
    return;
  }
  row.status = 404;
  res.writeHead(404, { 'Content-Type': 'text/plain' });
  res.end('not found');
});

async function until(label, fn, timeout = 10000) {
  const end = Date.now() + timeout;
  while (Date.now() < end) {
    const v = await fn();
    if (v) return v;
    await sleep(30);
  }
  throw new Error('Timed out: ' + label);
}

let browser, browserExit, profile, cdp, origin;
const temp = resolve(tmpdir());
const prefix = 'thoradar-neon-v2-';

async function runInContext(label, workerMode, fn) {
  currentWorkerMode = workerMode;
  currentMode = 'v1';
  const { browserContextId } = await cdp.send('Target.createBrowserContext');
  const docs = [];
  const netReqs = [];
  let session;
  const onResp = ({ type, loaderId, response }, sid) => {
    if (sid !== session || !response.url.startsWith(origin + '/')) return;
    netReqs.push({ type, loaderId, url: response.url, status: response.status, fromServiceWorker: response.fromServiceWorker, source: response.serviceWorkerResponseSource ?? null });
    if (type === 'Document') docs.push({ loaderId, url: response.url, status: response.status, fromServiceWorker: response.fromServiceWorker, source: response.serviceWorkerResponseSource ?? null });
  };
  cdp.on('Network.responseReceived', onResp);
  try {
    const { targetId } = await cdp.send('Target.createTarget', { url: 'about:blank', browserContextId });
    ({ sessionId: session } = await cdp.send('Target.attachToTarget', { targetId, flatten: true }));
    const send = (m, a = {}) => cdp.send(m, a, session);
    for (const d of ['Page', 'Runtime', 'Network', 'ServiceWorker']) await send(d + '.enable');
    const ev = async (f, ...args) => {
      const { result: r, exceptionDetails } = await send('Runtime.evaluate', {
        expression: `(${f})(${args.map(x => JSON.stringify(x)).join(',')})`, awaitPromise: true, returnByValue: true
      });
      if (exceptionDetails) throw new Error(exceptionDetails.exception?.description ?? exceptionDetails.text);
      return r.value;
    };
    const nav = async (path, waitReady = true) => {
      const url = origin + path;
      const { loaderId, errorText } = await send('Page.navigate', { url });
      if (errorText) throw new Error(errorText);
      const doc = await until('doc ' + path, () => docs.find(d => d.loaderId === loaderId && d.url === url));
      await until('loaded ' + path, async () => {
        try {
          return await ev((u, wr) => location.href === u && document.readyState === 'complete' && (!wr || document.body.dataset.protoReady === 'true'), url, waitReady);
        } catch (_) { return false; }
      });
      return doc;
    };
    const storage = () => ev(async () => {
      const regs = await navigator.serviceWorker.getRegistrations();
      const names = await caches.keys();
      const shell = names.find(n => n.startsWith('thoradar-shell-'));
      const cache = shell && await caches.open(shell);
      const resp = cache && await cache.match('/index.html');
      const buf = resp && await resp.arrayBuffer();
      const hash = buf ? Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', buf)), b => b.toString(16).padStart(2, '0')).join('') : null;
      return { registrations: regs.length, active: regs[0]?.active?.state ?? null, names, hash, bytes: buf?.byteLength ?? null };
    });
    const snap = () => ev(() => ({
      date: typeof SITE_DATA !== 'undefined' ? SITE_DATA.briefing_date : null,
      papersLen: typeof SITE_DATA !== 'undefined' && Array.isArray(SITE_DATA.papers) ? SITE_DATA.papers.length : null,
      points: document.querySelectorAll('#blips .blip').length,
      banner: document.getElementById('shell-status')?.textContent ?? null
    }));
    const warm = async () => {
      await nav('/index.html?sw=1');
      await until('warmed', async () => {
        const st = await storage();
        return st.active === 'activated' && st.hash === v1Hash && st;
      });
    };
    return await fn({ nav, storage, snap, warm, ev, netReqs });
  } finally {
    await cdp.send('Target.disposeBrowserContext', { browserContextId }).catch(() => {});
  }
}

try {
  await new Promise((ok, fail) => { site.once('error', fail); site.listen(0, '127.0.0.1', ok); });
  origin = `http://127.0.0.1:${site.address().port}`;
  profile = await mkdtemp(join(temp, prefix));
  browser = spawn('C:/Program Files/Google/Chrome/Application/chrome.exe', [...chromeArgs(0, profile), '--no-proxy-server'], { stdio: ['ignore', 'ignore', 'ignore'], windowsHide: true });
  browserExit = new Promise(done => { browser.once('exit', (code, signal) => done({ code, signal })); browser.once('error', e => done({ error: e.message })); });
  const port = await until('DevToolsActivePort', async () => {
    const t = await readFile(join(profile, 'DevToolsActivePort'), 'utf8').catch(() => '');
    return t.includes('/devtools/browser/') && t.trim().split(/\r?\n/)[0];
  }, 15000);
  const ver = await fetch(`http://127.0.0.1:${port}/json/version`).then(r => r.json());
  cdp = await connect(ver.webSocketDebuggerUrl);
  result.environment.chrome = await cdp.send('Browser.getVersion');

  // 1. All 4 V1 + 5 S3/extra invalid payloads MUST be rejected AND next navigation MUST remain healthy
  const rejectModes = [
    'reversed-markers',
    'json-mime-valid-html',
    'status-503-valid-html',
    'empty-markers-stub',
    'missing-site-data',
    'bad-json-site-data',
    'wrong-date-type',
    'wrong-papers-type',
    'null-site-data'
  ];
  await runInContext('adversarial-reject', 'normal', async ctx => {
    await ctx.warm();
    for (const mode of rejectModes) {
      currentMode = mode;
      const reqStart = result.requests.length;
      const doc = await ctx.nav('/index.html');
      const finalBanner = await until('banner settled ' + mode, async () => {
        const s = await ctx.snap();
        return (s.banner?.includes('暂未核实更新') || s.banner?.includes('有新版') || s.banner?.includes('与服务器一致')) && s;
      });
      const st = await ctx.storage();
      const upstream = result.requests.slice(reqStart).filter(r => r.mode === mode);
      const preserved = st.hash === v1Hash;
      const honestBanner = finalBanner.banner?.includes('暂未核实更新') && finalBanner.date === d1 && finalBanner.points > 0;
      // Always verify next navigation still renders healthy v1 (no date:null / points:0)
      const nextDoc = await ctx.nav('/index.html');
      const nextSnap = await ctx.snap();
      const nextHealthy = nextDoc.source === 'cache-storage' && nextSnap.date === d1 && nextSnap.points > 0 && nextSnap.banner !== null;
      const pass = doc.source === 'cache-storage' && preserved && honestBanner && upstream.length > 0 && nextHealthy;
      const entry = { name: `adversarial-${mode}`, pass, doc, finalBanner, storage: st, expectedHash: v1Hash, upstream, nextNavCheck: { doc: nextDoc, snap: nextSnap } };
      result.checks.push(entry);
      console.log(`${pass ? 'PASS' : 'FAIL'} adversarial-${mode} preserved=${preserved} nextDate=${nextSnap.date} nextPoints=${nextSnap.points} banner=${JSON.stringify(finalBanner.banner)}`);
    }
  });

  // 2. Valid zero-papers MUST be accepted and rendered on next navigation
  await runInContext('valid-zero-papers', 'normal', async ctx => {
    await ctx.warm();
    currentMode = 'valid-zero-papers';
    const doc = await ctx.nav('/index.html');
    const finalBanner = await until('banner zero', async () => {
      const s = await ctx.snap();
      return (s.banner?.includes('有新版') || s.banner?.includes('暂未核实更新') || s.banner?.includes('与服务器一致')) && s;
    });
    const st = await ctx.storage();
    const nextDoc = await ctx.nav('/index.html');
    const nextSnap = await ctx.snap();
    const pass = doc.source === 'cache-storage' && finalBanner.banner?.includes('有新版') &&
      st.hash === zeroHash && nextDoc.source === 'cache-storage' &&
      nextSnap.date === d2 && nextSnap.papersLen === 0 && nextSnap.points === 0;
    result.checks.push({ name: 'valid-zero-papers-accepted', pass, doc, finalBanner, storage: st, expectedHash: zeroHash, nextDoc, nextSnap });
    console.log(`${pass ? 'PASS' : 'FAIL'} valid-zero-papers-accepted hashMatch=${st.hash === zeroHash} nextDate=${nextSnap.date} nextPapers=${nextSnap.papersLen} banner=${JSON.stringify(finalBanner.banner)}`);
  });

  // 3. Extra adversarial probes (informational edge-case observations)
  for (const mode of ['empty-briefing-date', 'comment-wrapped-site-data-stub']) {
    await runInContext(`probe-${mode}`, 'normal', async ctx => {
      await ctx.warm();
      currentMode = mode;
      await ctx.nav('/index.html');
      const finalBanner = await until('probe banner ' + mode, async () => {
        const s = await ctx.snap();
        return (s.banner?.includes('有新版') || s.banner?.includes('暂未核实更新') || s.banner?.includes('与服务器一致')) && s;
      });
      const st = await ctx.storage();
      const preserved = st.hash === v1Hash;
      let nextSnap = null;
      if (!preserved) {
        const nextDoc = await ctx.nav('/index.html', false);
        nextSnap = { doc: nextDoc, snap: await ctx.snap() };
      }
      result.extraProbes.push({ mode, preserved, banner: finalBanner.banner, cachedHash: st.hash, cachedBytes: st.bytes, nextSnap });
      console.log(`PROBE ${mode} preserved=${preserved} bytes=${st.bytes} banner=${JSON.stringify(finalBanner.banner)}`);
    });
  }

  // 4. Navigation whitelist & bypass checks
  await runInContext('bypass-checks', 'normal', async ctx => {
    await ctx.warm();
    const q1 = await ctx.nav('/?foo=bar');
    const q2 = await ctx.nav('/index.html?sw=1&extra=1');
    const subRes = await ctx.ev(async () => {
      const [r1, r2, r3] = await Promise.all([
        fetch('/index.html'),
        fetch('/data/radar_latest.json'),
        fetch('/api/ai-probe', { method: 'POST', body: '{}' })
      ]);
      return { htmlOk: r1.ok, dataOk: r2.ok, postOk: r3.ok };
    });
    const recent = ctx.netReqs.slice(-6);
    const nonNavHtml = recent.find(r => r.type !== 'Document' && r.url.endsWith('/index.html'));
    const dataReq = recent.find(r => r.url.endsWith('/data/radar_latest.json'));
    const postReq = recent.find(r => r.url.endsWith('/api/ai-probe'));
    const pass = !q1.fromServiceWorker && !q2.fromServiceWorker && !nonNavHtml?.fromServiceWorker && !dataReq?.fromServiceWorker && !postReq?.fromServiceWorker && subRes.htmlOk && subRes.dataOk && subRes.postOk;
    result.checks.push({ name: 'whitelist-and-bypass', pass, q1, q2, nonNavHtml, dataReq, postReq, subRes });
    console.log(`${pass ? 'PASS' : 'FAIL'} whitelist-and-bypass`);
  });

  // 5. Five Independent In-Memory Negative Controls (naive vs orderless marker-order + mime + 503 + S3 SITE_DATA guard)
  const negPairs = [
    ['mut-marker-order-naive', 'reversed-markers'],
    ['mut-marker-order-orderless', 'reversed-markers'],
    ['mut-mime', 'json-mime-valid-html'],
    ['mut-status-503', 'status-503-valid-html'],
    ['mut-s3-site-data-guard', 'empty-markers-stub']
  ];
  for (const [mutName, mode] of negPairs) {
    await runInContext(`neg-${mutName}`, mutName, async ctx => {
      await ctx.warm();
      currentMode = mode;
      await ctx.nav('/index.html');
      const finalBanner = await until('neg banner ' + mutName, async () => {
        const s = await ctx.snap();
        return (s.banner?.includes('暂未核实更新') || s.banner?.includes('有新版') || s.banner?.includes('与服务器一致')) && s;
      });
      const st = await ctx.storage();
      let nextSnap = null;
      if (mutName === 'mut-s3-site-data-guard') {
        await ctx.nav('/index.html', false);
        nextSnap = await ctx.snap();
      }
      const mutatedBrokeProtection = st.hash !== v1Hash && finalBanner.banner?.includes('有新版');
      result.negativeControls.push({ mutation: mutName, input: mode, caughtRed: mutatedBrokeProtection, finalBanner, cachedHashAfter: st.hash, originalV1Hash: v1Hash, nextSnap });
      console.log(`${mutatedBrokeProtection ? 'RED-CAUGHT' : 'SURVIVED'} neg-${mutName} input=${mode} banner=${JSON.stringify(finalBanner.banner)} hashChanged=${st.hash !== v1Hash}${nextSnap ? ` nextDate=${nextSnap.date} nextPoints=${nextSnap.points}` : ''}`);
    });
  }

  // 6. Static production host gate check
  const prodGateTest = (href) => {
    const { hostname, protocol } = new URL(href);
    return protocol === 'https:' && (hostname === 'thoradar.online' || hostname.endsWith('.thoradar.online'));
  };
  const gateCases = [
    ['https://thoradar.online/', true],
    ['https://www.thoradar.online/', true],
    ['http://thoradar.online/', false],
    ['https://evil-thoradar.online/', false],
    ['https://thoradar.online.evil.com/', false],
    ['http://127.0.0.1:8080/', false]
  ].map(([u, expect]) => ({ url: u, expect, actual: prodGateTest(u), pass: prodGateTest(u) === expect }));
  const gatePass = gateCases.every(c => c.pass);
  result.checks.push({ name: 'production-domain-gate', pass: gatePass, cases: gateCases });
  console.log(`${gatePass ? 'PASS' : 'FAIL'} production-domain-gate`);

} finally {
  try { if (cdp) await cdp.send('Browser.close'); } catch (_) {}
  cdp?.close();
  if (browser) {
    let exit = await Promise.race([browserExit, sleep(4000).then(() => null)]);
    if (!exit && browser.pid) { browser.kill(); exit = await Promise.race([browserExit, sleep(3000).then(() => null)]); }
    result.cleanup = { pid: browser.pid, exit };
  }
  if (site.listening) await new Promise(done => { site.close(done); site.closeAllConnections(); });
  if (profile && dirname(resolve(profile)) === temp && basename(profile).startsWith(prefix)) {
    await rm(profile, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
    result.cleanup.profileRemoved = true;
  }
  result.endedAt = new Date().toISOString();
  await mkdir(dirname(resolve(outJson)), { recursive: true });
  await writeFile(outJson, JSON.stringify(result, null, 2) + '\n');
  console.log('NEON_V2_DONE ' + JSON.stringify({
    checksPassed: result.checks.filter(c => c.pass).length,
    checksFailed: result.checks.filter(c => !c.pass).length,
    negCaughtRed: result.negativeControls.filter(n => n.caughtRed).length,
    negTotal: result.negativeControls.length,
    extraProbes: result.extraProbes.length
  }));
}

