    assert.deepEqual(result.checks.find(check => check.name === 'write-scope').outOfScope, ['feed.xml']);
  } finally {
    git(['reset', '--', 'feed.xml']);
    assert.deepEqual(await readFile(join(tree, 'feed.xml')), feed);
