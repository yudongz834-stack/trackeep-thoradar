 succeeded in 745ms:
name: Deploy to Aliyun OSS

# 迁移役（2026-11-19 起）：每日流水线跑完 → 网站同步到阿里云深圳 OSS（备案接入）
# 手动可触发（workflow_dispatch）＝首次部署/补发；workflow_run 挂在日报管线尾部自动跟发
on:
  workflow_dispatch:
    inputs:
      retire:
        description: 'Publish the retirement worker at /sw.js'
        type: boolean
        default: false
  workflow_run:
    workflows: ["ThorRadar Daily Pipeline"]
    types: [completed]

permissions:
  contents: read

jobs:
  smooth-verify:
    # 日报管线成功才跟发；手动触发不受限
    if: github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success'
    runs-on: windows-latest
    timeout-minutes: 25
    steps:
      - name: Checkout release revision with history
        uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false

      - uses: actions/setup-node@v4
        with:
          node-version: '24'

      - name: Check deployment workflow and simulate publishing
        run: node tests/smooth/verify-deploy.mjs "$env:RUNNER_TEMP/smooth-deploy.json"

      - name: Verify source invariants
        run: node tests/smooth/verify-source.mjs "$env:RUNNER_TEMP/smooth-source.json"

      - name: Verify S1
        run: node tests/smooth/verify-s1.mjs "$env:RUNNER_TEMP/smooth-s1.json"

      - name: Verify S2
        run: node tests/smooth/verify-s2.mjs "$env:RUNNER_TEMP/smooth-s2.json"

      - name: Verify S3
        run: node tests/smooth/verify-s3.mjs "$env:RUNNER_TEMP/smooth-s3.json"

      - name: Verify UX
        run: |
          $env:XREV_SCRATCH = Join-Path $env:RUNNER_TEMP 'smooth-ux'
          node tests/ux/ux_probe.mjs --target index.html --base 73dd34e --label smooth-ci

  deploy-oss:
    needs: smooth-verify
    runs-on: ubuntu-latest
    concurrency:
      group: thoradar-oss
      cancel-in-progress: false
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false

      - name: Install OSS and CDN tools
        shell: bash
        run: |
          set -euo pipefail
          # ossutil 走 GitHub 官方发行版 v1.7.18 zip（v1.7.19 无 linux 资产·alicdn 域名美国 runner 不通）
          cd "$RUNNER_TEMP"
          curl -fsSL https://github.com/aliyun/ossutil/releases/download/v1.7.18/ossutil-v1.7.18-linux-amd64.zip -o ossutil.zip
          unzip -q ossutil.zip
          mv ossutil-v1.7.18-linux-amd64/ossutil ./ossutil
          chmod +x ossutil
          file ossutil | grep -q ELF || { echo 'ossutil download is not an ELF binary'; exit 9; }
          ./ossutil --version

          mkdir -p aliyun
          curl -fsSL https://github.com/aliyun/aliyun-cli/releases/download/v3.5.4/aliyun-cli-linux-3.5.4-amd64.tgz -o aliyun/cli.tgz
          echo 'e1eefcbbe9d772d61f770d4af8595e7297e081a0348b096765d2c41e581c3e72  aliyun/cli.tgz' | sha256sum -c -
          tar -xzf aliyun/cli.tgz -C aliyun
          chmod +x aliyun/aliyun

      - name: Publish and verify site
        shell: bash
        env:
          OSS_KEY_ID: ${{ secrets.OSS_KEY_ID }}
          OSS_KEY_SECRET: ${{ secrets.OSS_KEY_SECRET }}
          ALIBABA_CLOUD_ACCESS_KEY_ID: ${{ secrets.OSS_KEY_ID }}
          ALIBABA_CLOUD_ACCESS_KEY_SECRET: ${{ secrets.OSS_KEY_SECRET }}
          SMOOTH_RETIRE: ${{ inputs.retire && 'true' || 'false' }}
        run: |
          set -euo pipefail
          ossutil="$RUNNER_TEMP/ossutil"
          aliyun="$RUNNER_TEMP/aliyun/aliyun"
          "$ossutil" config -e oss-cn-shenzhen.aliyuncs.com -i "$OSS_KEY_ID" -k "$OSS_KEY_SECRET" -L CH >/dev/null 2>&1 || {
            echo 'OSS configuration failed' >&2
            exit 1
          }
          # 开桶（幂等：已存在则忽略）
          "$ossutil" mb oss://thoradar-online --acl public-read 2>/dev/null || echo "跳过桶创建，继续检查现有桶"
          # 静态站默认页：v1.7.18 website put 只认 XML 配置文件（--index-page 是幻影旗标，
          # 2>/dev/null || true 曾吞错致根路径 403——2026-11-20 控制台补设＋此处改 XML 正方）
          cat > website.xml <<'XML'
          <?xml version="1.0" encoding="UTF-8"?>
          <WebsiteConfiguration>
            <IndexDocument><Suffix>index.html</Suffix></IndexDocument>
            <ErrorDocument><Key>index.html</Key></ErrorDocument>
          </WebsiteConfiguration>
          XML
          "$ossutil" website --method put oss://thoradar-online website.xml
          # 站面文件（首页/图标/搜索登记/订阅件）——ossutil 单命令单源，逐件上传
          # sitemap lastmod 部署时现打当日戳（Hydrogen 11-20 审出死日期 2026-11-08 滞留）
          sed "s|<lastmod>[^<]*</lastmod>|<lastmod>$(date -u +%Y-%m-%d)</lastmod>|" sitemap.xml > "$RUNNER_TEMP/sitemap.xml"
          mv "$RUNNER_TEMP/sitemap.xml" sitemap.xml
          for f in favicon.ico robots.txt sitemap.xml; do
            "$ossutil" cp -rf --update "$f" oss://thoradar-online/
          done
          "$ossutil" cp -rf --update --meta Cache-Control:no-cache feed.xml oss://thoradar-online/
          "$ossutil" cp -rf --update --meta "Cache-Control:public, max-age=60, s-maxage=300" data/radar_latest.json oss://thoradar-online/data/
          "$ossutil" cp -rf --update --meta Cache-Control:no-cache api/ oss://thoradar-online/api/
          "$ossutil" cp -rf --update thoradar-skill/ oss://thoradar-online/thoradar-skill/

          active_worker=sw.js
          if [[ "$SMOOTH_RETIRE" == true ]]; then active_worker=sw-retire.js; fi
          worker_meta='Content-Type:application/javascript#Cache-Control:no-store'
          # 始终覆盖 worker，确保正常与退役可双向切换；首页沿用现有缓存头并最后写入。
          "$ossutil" cp -f --meta "$worker_meta" sw-retire.js oss://thoradar-online/sw-retire.js
          "$ossutil" cp -f --meta "$worker_meta" "$active_worker" oss://thoradar-online/sw.js
          "$ossutil" cp -f --meta 'Cache-Control:public, max-age=60, s-maxage=3600' index.html oss://thoradar-online/index.html

          # 开门＝桶级公共读（控制台定版，对象继承 ACL）——逐件 setacl 按 6.2/Hydrogen 双席审读裁撤
          # （v1.7.18 无 setacl 命令·对象继承桶权限已实测 200）
          echo '=== OSS uploads recorded'
          "$ossutil" ls oss://thoradar-online/ | tail -2
          # 验锁闸：逼流量走 CNAME 目标实测 HTTPS（DNS 切换前后都成立；证书/绑定/静态页回归＝部署判红）
          # 双域逐验＋严格断言 http_code==200（Sol 11-20 审出：curl -sf 连 304 也放行还谎报 200）
          echo "=== HTTPS 预检（SNI=域名 → CNAME 目标）"
          domains=(thoradar.online www.thoradar.online)
          paths=(/ /index.html /sw.js /sw-retire.js)
          for h in "${domains[@]}"; do
            code=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 15 \
              --max-time 30 \
              --connect-to "$h:443:thoradar-online.cn-shenzhen.taihangtop.cn:443" \
              "https://$h/")
            if [ "$code" != "200" ]; then echo "✗ $h 根路径 HTTPS $code（期望 200）" >&2; exit 1; fi
            echo "$h 根路径 HTTPS 200 ✅"
          done

          urls=()
          for h in "${domains[@]}"; do
            for path in "${paths[@]}"; do urls+=("https://$h$path"); done
          done
          refresh_paths=$(printf '%s\n' "${urls[@]}")
          refresh_id=''
          for attempt in 1 2; do
            echo "CDN RefreshObjectCaches attempt $attempt"
            if refresh_id=$(
              "$aliyun" cdn RefreshObjectCaches --region cn-shenzhen --ObjectType File --ObjectPath "$refresh_paths" 2>/dev/null |
                python3 -c 'import json, sys; value = json.load(sys.stdin).get("RefreshTaskId");
          if type(value) not in (str, int) or not value or not str(value).strip(): sys.exit(1)
          print(json.dumps(value))' 2>/dev/null
            ); then
              echo "CDN RefreshTaskId=$refresh_id"
              break
            fi
            if [[ "$attempt" == 2 ]]; then
              echo 'CDN refresh failed or returned no RefreshTaskId' >&2
              exit 1
            fi
            sleep 5
          done

          verify_object() {
            local url="$1" source="$2" worker="$3" expected headers result attempt
            expected=$(openssl dgst -md5 -binary "$source" | openssl base64 -A)
            for attempt in {1..12}; do
              if headers=$(curl -sS -I -H 'Accept-Encoding: identity' --connect-timeout 5 --max-time 10 "$url"); then
                if result=$(awk -v expected="$expected" -v worker="$worker" '
                  { sub(/\r$/, "") }
                  /^HTTP\// { status=$2; md5=""; mime=""; cache=""; next }
                  tolower($0) ~ /^content-md5:/ { md5=$0; sub(/^[^:]+:[ \t]*/, "", md5); sub(/[ \t]+$/, "", md5) }
                  tolower($0) ~ /^content-type:/ { mime=tolower($0); sub(/^[^:]+:[ \t]*/, "", mime); sub(/([ \t]*;.*|[ \t]+)$/, "", mime) }
                  tolower($0) ~ /^cache-control:/ { line=tolower($0); sub(/^[^:]+:[ \t]*/, "", line); cache=cache "," line }
                  END {
                    printf "HTTP=%s Content-MD5=%s expected=%s MIME=%s Cache-Control=%s", status, md5, expected, mime, cache
                    if (status != 200 || md5 != expected) exit 1
                    if (worker && (mime !~ /^(application|text)\/(javascript|ecmascript)$/ || cache !~ /,[ \t]*no-store[ \t]*(,|$)/)) exit 1
                  }
                ' <<< "$headers"); then
                  echo "Verified $url $result"
                  return 0
                fi
              else
                result='HEAD request failed'
              fi
              echo "Waiting for $url ($attempt/12) $result"
              if [[ "$attempt" != 12 ]]; then sleep 5; fi
            done
            echo "Verification failed for $url" >&2
            return 1
          }

          for url in "${urls[@]}"; do
            case "$url" in
              */sw.js) verify_object "$url" "$active_worker" 1 ;;
              */sw-retire.js) verify_object "$url" sw-retire.js 1 ;;
              *) verify_object "$url" index.html 0 ;;
            esac
          done
          echo 'Publish verified on both domains'
import { execFileSync } from 'node:child_process';
import { readFile, writeFile } from 'node:fs/promises';
import { join } from 'node:path';
import { ROOT, gitRead, norm, sha256 } from '../aicls/lib.mjs';

const output = process.argv[2];
if (!output) throw new Error('Usage: node tests/smooth/verify-source.mjs <result.json>');
const paths = ['index.html', 'sw.js', 'sw-retire.js', 'tests/smooth/verify-s1.mjs',
  'tests/smooth/verify-s2.mjs', 'tests/smooth/run-regressions.mjs', 'tests/smooth/verify-source.mjs'];
const candidate = await readFile(join(ROOT, 'index.html'), 'utf8');
const baseline = gitRead(['show', '73dd34e:index.html']);
const sections = [
  ['official-data', '/*__THORADAR_DATA_START__*/', '/*__THORADAR_DATA_END__*/'],
  ['official-paper-initialization', 'const INJECTED_PAPERS=', 'let PAPERS=INJECTED_PAPERS.slice();'],
  ['official-window-and-merge', 'function inWindow(p){', 'const windowPapers=()=>PAPERS.filter(inWindow);']
];
const checks = [];
for (const [name, start, end] of sections) {
  const extract = source => {
    const from = source.indexOf(start);
    const to = source.indexOf(end, from + start.length);
    if (from < 0 || to < 0) throw new Error('Section missing: ' + name);
    return source.slice(from, to + end.length);
  };
  const from = extract(norm(baseline));
  const to = extract(norm(candidate));
  checks.push({ name, pass: from === to, baselineSha256: sha256(from), candidateSha256: sha256(to) });
}

const tracked = gitRead(['diff', '--name-only', '73dd34e', '--']).trim().split(/\r?\n/).filter(Boolean);
const untracked = gitRead(['ls-files', '--others', '--exclude-standard']).trim().split(/\r?\n/).filter(Boolean);
const outOfScope = [...tracked, ...untracked].filter(path =>
  !['index.html', 'sw.js', 'sw-retire.js', '.github/workflows/deploy_oss.yml'].includes(path) &&
  !path.startsWith('tests/smooth/') && !path.startsWith('docs/tasks/T1128-SMOOTH/'));
checks.push({ name: 'write-scope', pass: outOfScope.length === 0, tracked, untracked, outOfScope });
const syntax = paths.slice(1).map(path => {
  execFileSync(process.execPath, ['--check', path], { cwd: ROOT, stdio: 'inherit' });
  return path;
});
execFileSync('git', ['diff', '--check', '73dd34e', '--'], { cwd: ROOT, stdio: 'inherit' });
checks.push({ name: 'node-syntax-and-git-diff-check', pass: true, syntax });
for (const check of checks) console.log((check.pass ? 'PASS ' : 'FAIL ') + check.name + ' ' + JSON.stringify(check));
const files = Object.fromEntries(await Promise.all(paths.map(async path =>
  [path, sha256(await readFile(join(ROOT, path)))])));
console.log('SHA256 ' + JSON.stringify(files));
const summary = { passed: checks.filter(check => check.pass).length, failed: checks.filter(check => !check.pass).length };
console.log('SUMMARY ' + JSON.stringify(summary));
await writeFile(output, JSON.stringify({ timestamp: new Date().toISOString(), runs: 1, seed: null,
  baseline: gitRead(['rev-parse', '73dd34e']).trim(), checks, files, summary }, null, 2) + '\n', { flag: 'wx' });
if (summary.failed) process.exitCode = 1;

hook: PostToolUse
 succeeded in 774ms:
**干了什么**　接好了正常发布、退役发布、双域刷新验真和前置 CI。C1 候选的本机模拟与核心回归均通过。\
**PI 怎么亲手验**　打开[发布模拟原始输出](sol-s5/deploy.stdout.txt)，看到 `PASS normal`、`PASS retire` 和末行 `"passed":18,"failed":0` 即为本机模拟通过。\
**还剩什么坑**　保留现有主分支的日报数据后，固定基线会阻止部署。主控须裁定日报基线后才能放行发布，Astra 独立复核和 PI 线上验收也待完成。

## 地图影响

⑥ Sol S5 已交付隔离工作树候选、原始证据和[增量补丁](sol-s5/candidate.diff)。C1 首页、正常 worker、退役 worker 的 SHA-256 与开工记录及委任状逐件一致。补丁只含四个施工文件，可叠在 C1 候选上。[开工哈希](sol-s5/hashes-before.json) · [收尾哈希](sol-s5/hashes-after.stdout.txt) · [补丁检查退出码](sol-s5/patch.run.json)

## 改动清单

- [部署工作流](../../../.github/workflows/deploy_oss.yml)新增 `smooth-verify`，用 Windows、全历史和 Node 24 依次跑发布检查、源码、S1/S2/S3 和 UX。检查与上传显式使用同一 `github.sha`。部署依赖闸门，发布任务通过同一并发组串行执行。
- `/sw-retire.js` 始终上传仓内退役 worker。`retire=true` 时 `/sw.js` 也上传该文件，默认模式上传仓内 `sw.js`。两个 worker 均强制覆盖，带 `application/javascript` 和 `no-store`。首页以原有 `public, max-age=60, s-maxage=3600` 最后上传。
- 保留双域直连 HTTPS 预检。固定 Aliyun CLI `v3.5.4` 并校验 SHA-256，通过 OSS secret 的 CLI 环境别名刷新双域四条路径。每次提交八个 URL，最多两次调用，要求返回 `RefreshTaskId`。随后逐 URL 轮询 HTTP 200 和对应本地文件的 Content-MD5，另查两个 worker 的 MIME 和 `no-store`，全部通过才输出完成。
- [发布测试](../../../tests/smooth/verify-deploy.mjs)从 YAML 提取实际 Bash，使用[假命令](../../../tests/smooth/deploy-mock.mjs)回放。`verify-source` 只增加 `.github/workflows/deploy_oss.yml` 这一个白名单条目。既有浏览器试卷照原入口和判据执行。

## 验证状态

Windows 11 Pro x64 `10.0.26300`、Node `24.14.0`、Chrome `158.0.8127.88`、Git Bash `5.2.37`。浏览器使用隔离配置和本机回环服务。发布模拟使用合成凭证及应答。表中退出码来自每条原命令的捕获记录。

| 验证 | 结果 | 退出码 | 原始证据 |
| --- | --- | ---: | --- |
| 发布静态与 Bash 模拟 | 18 通过 | 0 | [stdout](sol-s5/deploy.stdout.txt) · [stderr](sol-s5/deploy.stderr.txt) · [JSON，含各模拟子进程输出和调用参数](sol-s5/deploy.json) · [命令](sol-s5/deploy.run.json) |
| 删掉 MD5 比较 | 16 通过，2 失败 | 1 | [stdout](sol-s5/no-md5.stdout.txt) · [stderr](sol-s5/no-md5.stderr.txt) · [JSON](sol-s5/no-md5.json) · [命令与删除内容](sol-s5/no-md5.run.json) |
| `verify-source` | 5 通过 | 0 | [stdout](sol-s5/source.stdout.txt) · [stderr](sol-s5/source.stderr.txt) · [JSON](sol-s5/source.json) · [命令](sol-s5/source.run.json) |
| S1 | 9 通过 | 0 | [stdout](sol-s5/s1.stdout.txt) · [stderr](sol-s5/s1.stderr.txt) · [JSON](sol-s5/s1.json) |
| S2 | 24 通过 | 0 | [stdout](sol-s5/s2.stdout.txt) · [stderr](sol-s5/s2.stderr.txt) · [JSON](sol-s5/s2.json) |
| S3 | 9 通过 | 0 | [stdout](sol-s5/s3.stdout.txt) · [stderr](sol-s5/s3.stderr.txt) · [JSON](sol-s5/s3.json) |
| UX | 46 通过 | 0 | [stdout](sol-s5/ux.stdout.txt) · [stderr](sol-s5/ux.stderr.txt) · [量测 JSON](sol-s5/ux-measurements/) |
| YAML 语法 | 解析通过 | 0 | [stdout](sol-s5/yaml.stdout.txt) · [stderr](sol-s5/yaml.stderr.txt) · [命令](sol-s5/yaml.run.json) |
| Git 差异 | `diff --check` 和补丁反向应用检查均通过 | 0 | [补丁统计](sol-s5/patch-1.stdout.txt) · [命令和退出码](sol-s5/patch.run.json) |
