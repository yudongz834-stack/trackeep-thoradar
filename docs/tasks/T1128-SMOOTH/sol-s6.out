"C:\\Program Files\\PowerShell\\7\\pwsh.exe" -Command '$wt = (Resolve-Path -LiteralPath '"'.t1128-s6-worktree').Path
"'$root = Join-Path $wt '"'docs/tasks/T1128-SMOOTH/sol-s6'
"'$outDir = Join-Path $root '"'rerun'
"'$ids = [System.Collections.Generic.HashSet[int]]::new()
$s1 = Get-Content -Raw -LiteralPath (Join-Path $outDir '"'s1.json') | ConvertFrom-Json
"'$s2 = Get-Content -Raw -LiteralPath (Join-Path $outDir '"'s2.json') | ConvertFrom-Json
[void]"'$ids.Add([int]$s1.cleanup.browserPid)
[void]$ids.Add([int]$s2.cleanup.pid)
$logs = @('"'s3.stdout.txt','ux-local.stdout.txt','daily/ux-ci-daily.stdout.txt','daily-final/ux-ci-daily.stdout.txt','daily-final/ux-ci-stale-parent.stdout.txt')
foreach ("'$name in $logs) {
  foreach ($row in (Get-Content -LiteralPath (Join-Path $outDir $name) | Where-Object { $_ -match '"'browser pid=' })) {
    foreach ("'$match in [regex]::Matches($row,'"'(?:browser pid=|收尾前=|主进程结束后残留=|逐 PID 结束=|复查仍存活=)([0-9,]+)')) {
      foreach ("'$part in $match.Groups[1].Value.Split('"',')) { [void]"'$ids.Add([int]$part) }
    }
  }
}
$sorted = @($ids | Sort-Object)
$rows = foreach ($processId in $sorted) {
  $proc = Get-Process -Id $processId -ErrorAction SilentlyContinue
  if ($null -eq $proc) { "pid=$processId status=not-found" }
  else { "pid=$processId status=present name=$($proc.ProcessName)" }
}
$rows | Set-Content -Encoding utf8NoBOM -LiteralPath (Join-Path $outDir '"'process-recheck.stdout.txt')
"'$code = [int](@($rows | Where-Object { $_ -match '"'status=present' }).Count -gt 0)
@{command='Get-Process -Id <each captured PID> -ErrorAction SilentlyContinue'; exitCode="'$code; pids=$sorted; logs=$logs} | ConvertTo-Json -Depth 4 | Set-Content -Encoding utf8NoBOM -LiteralPath (Join-Path $outDir '"'process-recheck.run.json')
"'$rows
if ($code) { exit $code }' in D:\trackeep\trackeep-product\trackeep-thoradar-smooth-T1128
