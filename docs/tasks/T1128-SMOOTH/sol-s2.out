890:'poolup.toggle':'Mix off-pool cache · with an "Off-pool" badge','poolup.toggle.tip':'Mix cached off-pool records only; no automatic fetch and no writes to official data','poolup.hint':'When off-pool records are present, entries are mixed by date. They have no official tier, score or sector, and tier/sector filters do not apply to them. In the reading view at most 3 of the first 12 cards are off-pool; official papers fill the rest, and the overview queue still lists everything. Off-pool entries use the later of the official anchor day and your local today as the upper window bound, while the lower bound still follows the official anchor. Legacy year-only cache entries are not assigned a guessed date: refresh the records panel explicitly. Expired cache still mixes in, but carries a "Stale" badge. Off-pool entries have no warning, curation or publication-status checks.','poolup.sorted':'Signal queue · by date, off-pool first','poolup.badge':'Off-pool','poolup.notier':'Off-pool · no official tier','poolup.uncategorized':'Off-pool · Unclassified','poolup.detail.tip':'From your personal off-pool records cache; no official tier, score or sector assignment',
891:'poolup.stale':'Stale','poolup.stale.tip':'Off-pool cache expired: these are older records. Click "Refresh" in the records panel to refetch','poolup.unchecked':'Not checked','poolup.unchecked.status':'Publication status · not checked','poolup.unchecked.curated':'Not checked · not part of curation','poolup.scope.empty':'No official signals in the list under the current filters; {n} off-pool cached records are in the signal queue.','poolup.scope.empty2':'The radar plots official signals only; off-pool entries are in the signal queue.',
1657:function statusOf(p){
1658:  const kind=String(p.status?.kind||'');
1659:  if(kind==='retracted')return {kind,label:t('status.retracted'),cls:'retracted'};
1660:  if(kind==='concern')return {kind,label:t('status.concern'),cls:'concern'};
1661:  if(kind==='corrected')return {kind,label:t('status.corrected'),cls:'corrected'};
1662:  if(kind==='ok')return {kind,label:t('status.ok'),cls:''};
1663:  return {kind,label:t('status.unknown'),cls:'unknown'};
1665:function noticeMarkup(p,status){
1666:  const note=String(p.status?.note||'').trim();
1667:  if(!['retracted','concern','corrected'].includes(status.kind)&&!note)return '';
1668:  const ref=p.status?.notice_ref||p.status?.notice_pmid||'';
1670:  const label=status.kind==='retracted'?t('status.retracted'):status.kind==='concern'?t('status.concern'):status.kind==='corrected'?t('status.corrected'):t('notice.generic');
1671:  return `<div class="notice-banner ${status.cls||'neutral'}"><strong>${label}</strong>${note?`<br>${esc(note)}`:''}${ref?`<br>${t('notice.ref')}${esc(ref)}`:''}${link?`<br><a href="${esc(link)}" target="_blank" rel="noopener">${t('notice.link')}</a>`:''}</div>`;
1703:  const index=list.findIndex(item=>item.id===p.id),marked=state.read.has(p.id),status=statusOf(p),degraded=p.publish_state==='degraded';
1712:  $('#detail').innerHTML=`<div class="detail-inner ${status.kind==='retracted'?'is-retracted':''}">
1713:    <div class="detail-top"><span class="lock-id">SIGNAL LOCK / ${String(index+1).padStart(2,'0')}</span><span class="status-pill ${['retracted','concern','corrected'].includes(status.kind)?'has-icon':''} ${status.cls}">${p.pool_ext?t('poolup.unchecked.status'):status.label}</span></div>
1714:    ${noticeMarkup(p,status)}
1728:      <div class="meta-cell"><small>PMID</small><b>${esc(show(p.pmid))}</b></div><div class="meta-cell"><small>${t('meta.status')}</small><b>${esc(p.pool_ext?t('poolup.unchecked'):status.label)}</b></div>
1752:function render(){
1835:const windowRange=$('#window-range');
1836:windowRange.addEventListener('input',event=>{const d=Number(event.target.value);state.days=d;render();if(d>1)ensureRollingData()});   // >1 天才需要历史档案：懒加载触发点
1837:windowRange.addEventListener('pointerdown',()=>{if(!rollingPromise)ensureRollingData()});   // 预测性预取：手按滑杆即开始拉（单例 Promise 去重，含 days=1 点击）
1930:  const mobile=$('#shelf-mobile-status');mobile.hidden=!on;
1931:  mobile.innerHTML=on?`<span>${tf('shelf.mobile.status',{n:myJournalsStore.picks.length})}</span><button type="button" data-shelf-close-filter>${t('shelf.mobile.close')}</button>`:'';
2446:    if(res.status!==429&&res.status!==503)return res;   // 其余状态码原样交调用方出文案（err.pubmed.search／err.pubmed.fetch）
2485:  if(!res.ok)throw new Error(tf('err.pubmed.search',{s:res.status}));
2492:  if(!res.ok)throw new Error(tf('err.pubmed.fetch',{s:res.status}));
2531:    throw new Error(redactSecret(`${tf('err.ai.http',{s:res.status})}${detail?`：${detail}`:''}`,true,cfg.apiKey));   // 报文里的报错原文可能夹带钥匙：出口处先打码，按这次请求实际带出去的那把 Key 抹（主题检索／分类／深评／连通测试四处共用这一条路）
2745:  const statusEl=$('#ai-test-status'),btn=$('#ai-test');
2746:  if(!cfg.baseUrl||!cfg.apiKey||!cfg.model){statusEl.className='ai-status bad';statusEl.textContent=t('ai.need3');return}
2747:  btn.disabled=true;statusEl.className='ai-status pending';statusEl.textContent=t('ai.testing');
2753:    statusEl.className='ai-status ok';statusEl.textContent=`${t('ai.ok')} ${cfg.model}${clean?tf('ai.reply',{c:clean}):''}`;
2755:    statusEl.className='ai-status bad';
2756:    if(e instanceof StopError)statusEl.textContent=t('ai.timeout');
2757:    else if(e instanceof TransportError&&e.kind==='cors')statusEl.textContent=t('ai.cors');
2758:    else statusEl.textContent=tf('ai.fail',{m:redactSecret(e&&e.message?e.message:'—')});
