function toggleSectorFilter(sec){   // 扇区过滤（再点清除）：官方＝阵地号；自定义＝方案阵地 id/未分组
  if(activeScheme())state.gsec=state.gsec===sec?null:sec;
  else state.jcat=state.jcat===sec?null:sec;
  render();
}
function toggleSectorFold(gid){   // 折叠：自定义阵地态存方案（数据，跨会话）；未分组态存视图（会话态）
  if(gid===UNGROUPED_ID){state.gsecFolded.has(gid)?state.gsecFolded.delete(gid):state.gsecFolded.add(gid);persistView();render();return}
  const scheme=activeScheme();
  const g=scheme&&scheme.sectors.find(g=>g.id===gid);
  if(!g)return;
  g.folded=!g.folded;
  persistSchemes();
  render();
}
