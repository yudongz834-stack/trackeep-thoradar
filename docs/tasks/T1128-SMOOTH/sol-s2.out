+    if (event.data?.type === 'thoradar-shell-retired' &&
+        [workerUrl, retireUrl].includes(event.source?.scriptURL)) {
+      clearTimeout(replyTimeout);
+      show(event.data.unregistered && event.data.cleared ? 'disabled' : 'disableFailed');
+      return;
+    }
+    if (!controller || event.source !== controller || event.data?.type !== 'thoradar-shell-state') return;
+    const next = event.data.status;
+    if (!['network', 'checking', 'current', 'updated', 'unavailable', 'fallback'].includes(next)) return;
+    if (next !== 'checking') clearTimeout(replyTimeout);
+    show(next);
+  });
   if (controller) {
     show('checking');
-    const replyTimeout = setTimeout(() => show('unavailable'), 12000);
-    worker.addEventListener('message', event => {
-      if (event.source !== controller || event.data?.type !== 'thoradar-shell-state') return;
-      const next = event.data.status;
-      if (!['network', 'checking', 'current', 'updated', 'unavailable'].includes(next)) return;
