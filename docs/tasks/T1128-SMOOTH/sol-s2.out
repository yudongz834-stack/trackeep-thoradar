const fs = require('node:fs');
const {createHash} = require('node:crypto');
const d = 'docs/tasks/T1128-SMOOTH/';
const read = file => JSON.parse(fs.readFileSync(d + file, 'utf8'));
const check = (ok, what) => { if ("'!ok) throw new Error(what); };
const hashes = Object.fromEntries(['"'index.html', 'sw.js', 'sw-retire.js'].map(file =>
  [file, createHash('sha256').update(fs.readFileSync(file)).digest('hex')]));
for (const [run, pass, fail, red] of [
  ['core-final-01',9,0],['core-final-02',9,0],
  ['matrix-01',24,0],['matrix-02',24,0],
  ['mutation-local-return',3,1,'second-open-uses-cache-storage-before-slow-origin'],
  ['mutation-truncated',7,1,'truncated-html-cannot-overwrite-healthy-shell'],
  ['mutation-retire',1,1,'retirement-cleans-prefix-unregisters-and-notifies-open-reader']
]) {
  const got = read('sol-s2-' + run + '.json');
  check(got.summary.passed === pass && got.summary.failed === fail, run + ' summary');
  check(got.checks.filter(c=>"'!c.pass).map(c=>c.name).join('"'') === (red || ''), run + ' failure id');
  for (const [file, hash] of Object.entries(got.sha256)) {
    if (file in hashes) check(hashes[file] === hash, run + ' ' + file + ' hash');
  }
  check(got.cleanup.exit.code === 0 && "'!got.cleanup.forced && got.cleanup.profileRemoved, run + '"' cleanup');
  console.log(run, got.startedAt, got.endedAt, JSON.stringify(got.summary), red || '');
}
for (const [suite, pass, fail, code] of [['ux',46,0,0],['aicls',39,1,1],['poolup',39,1,1]]) {
  const got = read('sol-s2-legacy-evidence/' + suite + '.json');
  check(got.summary.PASS === pass && got.summary.FAIL === fail && got.exitCode === code, suite + ' summary');
  check(got.tests.filter(t=>t.result==='FAIL').map(t=>t.id).join('') === (fail ? 'R08' : ''), suite + ' failure id');
  for (const [file, hash] of Object.entries(hashes)) check(got.target[file] === hash, suite + ' ' + file + ' hash');
  const stdout = fs.readFileSync(d + 'sol-s2-legacy-evidence/' + suite + '.stdout.txt', 'utf8');
  check(stdout.includes('复查仍存活=无'), suite + ' cleanup');
  if (fail) check(stdout.includes('基线 {\"query\":\"Mortality\",\"list\":0,\"noQuery\":1}｜施工后 {\"query\":\"Mortality\",\"list\":0,\"noQuery\":1}'), suite + ' R08 evidence');
  console.log(suite, got.startedAt, got.endedAt, JSON.stringify(got.summary), got.exitCode);
}
const source = read('sol-s2-source.json');
check(source.summary.passed === 5, 'source checks');
for (const [file, hash] of Object.entries(hashes)) check(source.files[file] === hash, 'source ' + file);
const report = fs.readFileSync(d + 'sol-s2-report.md', 'utf8');
for (const [, href] of report.matchAll(/\\]\\((["'^)]+)'"\\)/g)) if ("'!href.startsWith('"'https:')) {
  const path = href.startsWith('/D:/') ? href.slice(1) : d + href;
  check(fs.existsSync(path), 'missing report link ' + path);
}
console.log('Report links and candidate SHA-256 matched', hashes);
