// ===== 懒加载（2026-11-08 数据瘦身）：默认窗=1 天只用内嵌 SITE_DATA，首屏 0 外部请求；
// 拖滑杆 >1 天/点击滑杆/启动时窗口偏好 >1 天才拉 radar_latest.json；单例 Promise 防重；
// 加载中骨架屏＋aria-busy；失败静默保留现有数据＋滑杆旁提示（可重试）。
let rollingPromise=null,rollHintTimer=null;
function setRollBusy(on){
  const skel=$('#rolling-skeleton'),list=$('#queue-list');
  if(skel)skel.hidden=!on;   // hidden 属性开关（[hidden] 全局 !important），无 style.display
  if(list){if(on)list.setAttribute('aria-busy','true');else list.removeAttribute('aria-busy')}
}
function showRollHint(){
  const hint=$('#window-hint');if(!hint)return;
  hint.hidden=false;
  clearTimeout(rollHintTimer);rollHintTimer=setTimeout(()=>{hint.hidden=true},6000);
}
function ensureRollingData(){
  if(rollingPromise)return rollingPromise;
  setRollBusy(true);
  rollingPromise=fetch('data/radar_latest.json').then(async response=>{
    if(!response.ok)throw new Error('rolling window unavailable');
    const payload=await response.json(),latest=Array.isArray(payload)?payload:payload?.papers;
    if(!Array.isArray(latest))throw new Error('rolling window schema mismatch');
    PAPERS=mergePapers(latest);ANCHOR=findAnchor(PAPERS);renderHeader();render();
  }).catch(error=>{
    rollingPromise=null;   // 失败放行重试：下次滑杆交互再拉
    console.info('滚动窗数据不可用，已静默降级为注入数据。');
    showRollHint();
  }).finally(()=>{
    setRollBusy(false);
  });
  return rollingPromise;
}
restoreView();   // 先恢复持久化态（扇区/档位/时间窗/折叠/深色），再首帧渲染防闪
ANCHOR=findAnchor(PAPERS);
renderHeader();renderFunnel();render();
if(state.days>1)ensureRollingData();   // 老用户窗口偏好 >1 天：首屏照旧秒出注入数据，后台补拉历史
clsPrewarm();   // 已有 AI 分类缓存的回访用户：首帧先按内容哈希未就绪（＝走关键词）出图，哈希在后台算好后重渲一次
