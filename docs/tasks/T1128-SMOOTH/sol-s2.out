function point(angle,radius){
  const rad=angle*Math.PI/180;
  return {x:300+Math.cos(rad)*radius,y:300+Math.sin(rad)*radius};
}
function sectorMarkup(group,index,total,count,activeSec){
  const active=activeSec===group.cat;
  const top=group.journals.slice(0,3).map(j=>j.name).join(' · ');
  const attrs=`class="journal-sector ${active?'active':''}" data-jcat="${esc(group.cat)}" tabindex="0" role="button" aria-pressed="${active}" aria-label="${tf('sec.filter.aria',{n:esc(group.label)})}"`;
  const title=`<title>${esc(tf('sec.tip',{label:group.label,n:count}))}${top?esc(tf('sec.tip.top',{top})):''}</title>`;
  if(total===1)return `<circle cx="300" cy="300" r="284" ${attrs}>${title}</circle>`;
  const wedge=360/total,start=-90+index*wedge,end=start+wedge,a=point(start,284),b=point(end,284);
  const d=`M300 300L${a.x.toFixed(3)} ${a.y.toFixed(3)}A284 284 0 ${wedge>180?1:0} 1 ${b.x.toFixed(3)} ${b.y.toFixed(3)}Z`;
  return `<path d="${d}" ${attrs}>${title}</path>`;
}
function renderTierFilters(base){
  $('#tier-filters').innerHTML=TIERS.map(tier=>{
    const active=state.tiers.has(tier),count=base.filter(p=>String(p.tier||'').toUpperCase()===tier).length;
    return `<button class="tier-chip ${active?'active':''}" data-tier="${tier}" aria-pressed="${active}" title="${tf('tier.chip.title',{n:tier})}">${tier}<small> · ${count}</small></button>`;
  }).join('');
}
function renderWindow(){
  $('#window-range').value=String(state.days);
  $('#window-value').textContent=`${state.days} ${t('unit.days')}`;
  if(!ANCHOR){$('#window-label').textContent=`${t('data.window')} — · ${state.days} ${t('unit.days')}`;return}
  const start=isoDate(dateMs(ANCHOR)-(state.days-1)*DAY_MS);
  $('#window-label').textContent=`${t('data.window')} ${monthDay(start)} ~ ${monthDay(ANCHOR)} · ${state.days} ${t('unit.days')}`;
}
function shelfQueueEmptyMarkup(){
  if(myJournalsStore.filterOn)return `<li class="queue-empty shelf-queue-empty">${t('queue.empty1')}<br><button type="button" class="shelf-empty-link" data-shelf-close-filter>${t('shelf.empty.close')}</button></li>`;
  return `<li class="queue-empty">${t('queue.empty1')}<br>${t('queue.empty2')}</li>`;
}
function renderQueue(list){
  $('#filter-counter').textContent=`${String(list.length).padStart(2,'0')} / ${personalPaperTotal()}`;
  if(!list.length){$('#queue-list').innerHTML=shelfQueueEmptyMarkup();return}
  $('#queue-list').innerHTML=list.map((p,i)=>`<li class="queue-item ${state.read.has(p.id)?'read':''}${p.pool_ext?' pool-ext-item':''}">
    <button class="queue-btn ${state.selected===p.id?'selected':''}" data-select="${esc(p.id)}" aria-label="${tf('lock.aria',{t:esc(p.title_zh||p.title_en||'—')})}">
      <span class="queue-index">${state.read.has(p.id)?'✓':String(i+1).padStart(2,'0')}</span>
      <span class="queue-text"><strong>${esc(p.title_zh||p.title_en||'—')}</strong><small>${poolBadge(p)}${esc(journalName(p))} · ${esc(p.category_label||categoryOf(p.category).short)}</small></span>
      <span class="queue-score">${esc(show(p.score_total))}</span>
    left=Math.max(12,Math.min(innerWidth-w-12,left));
    radarTip.style.left=`${left}px`;radarTip.style.top=`${Math.max(12,Math.min(innerHeight-h-12,r.top-24))}px`;
  }
  renderScope=function(list,base,groups,counts,assignOf){
    baseRenderScope(list,base,groups,counts,assignOf);
    $('#scope-labels').querySelectorAll('.scope-label').forEach(el=>{if(/·\s*0$/.test(el.textContent.trim()))el.remove()});   // 0 篇不占标签位；不动原 renderScope 的角度与数据语义
    if(!list.length&&$('#scope-empty').classList.contains('show')&&!myJournalsStore.filterOn){   // FIX-3：官方在列为空而池外派生条在列时，空态不再写「当前数据窗口内无论文」（那只是官方口径）
      const poolN=personalFiltered().filter(p=>p.pool_ext).length;
      if(poolN)$('#scope-empty').innerHTML=`${tf('poolup.scope.empty',{n:poolN})}<br>${t('poolup.scope.empty2')}`;
    }
    $('#blips').querySelectorAll('.blip').forEach(blip=>{
      const p=PAPERS.find(item=>item.id===blip.dataset.select);if(!p)return;
      const kind=protoStudyKind(p),score=protoScore(p),size=5+Math.round(score/100*4);
      blip.classList.add('proto-blip',`proto-kind-${kind}`);
      blip.classList.toggle('proto-low',score<45);
      blip.style.setProperty('--proto-domain',protoDomainColor(jcatOf(p)));
      blip.style.setProperty('--proto-size',`${size}px`);
      blip.style.setProperty('--proto-glow',score>=60?'10px':score>=45?'6px':'2px');
      blip.removeAttribute('title');
      blip.addEventListener('mouseenter',()=>protoShowRadarTip(p,blip));
      blip.addEventListener('focus',()=>protoShowRadarTip(p,blip));
      blip.addEventListener('mouseleave',protoHideRadarTip);
      blip.addEventListener('blur',protoHideRadarTip);
    });
    $('#journal-sectors').querySelectorAll('.journal-sector').forEach(sec=>sec.style.setProperty('--proto-domain',protoDomainColor(sec.dataset.jcat)));
  };
  /* 个性化四分区＝期刊合集/自定义阵地/我的主题+AI 设置/我的书架；分区切换只走 hidden 通道。 */
  const protoPersonalPanels={collections:['coll-list','coll-editor'],sectors:['scheme-list','scheme-editor'],topics:['topic-list','topic-editor','ai-settings'],shelf:['myjournals-panel']};
  function protoApplyPersonalPanels(){
    Object.entries(protoPersonalPanels).forEach(([tab,ids])=>ids.forEach(id=>{const el=document.getElementById(id);if(el)el.hidden=protoView==='personal'&&protoPersonalTab!==tab}));
    document.querySelectorAll('[data-proto-personal-tab]').forEach(btn=>btn.setAttribute('aria-pressed',String(btn.dataset.protoPersonalTab===protoPersonalTab)));
  }
  function protoSetPersonalTab(tab){protoPersonalTab=tab;protoApplyPersonalPanels();if(tab==='shelf')renderMyJournals()}
  document.querySelectorAll('[data-proto-personal-tab]').forEach(btn=>btn.addEventListener('click',()=>protoSetPersonalTab(btn.dataset.protoPersonalTab)));
  function protoMeasure(){document.documentElement.style.setProperty('--proto-header-h',`${Math.round(document.querySelector('.topbar').getBoundingClientRect().height)}px`)}
  const protoFiltersOpen={overview:false,reading:false};   /* 两视图缺省都收起；各自保留本次会话选择，不持久化 */
  function protoSyncFilters(){
    const open=Object.prototype.hasOwnProperty.call(protoFiltersOpen,protoView)?protoFiltersOpen[protoView]:false;
    document.body.classList.toggle('filters-open',open);
    const b=document.querySelector('.filters-toggle');
    if(b){b.setAttribute('aria-expanded',String(open));b.textContent=t(open?'filters.hide':'filters.show')}
  }
  function protoSetView(view){
    if(!['overview','reading','personal'].includes(view))return;
    protoView=view;document.body.dataset.protoView=view;protoHideRadarTip();protoSyncFilters();
    if(view==='personal'){
      if($('#coll-drawer').hidden)openCollDrawer();$('#coll-mask').hidden=true;
    }else{
      if(!$('#coll-drawer').hidden)closeCollDrawer();
      if(view==='reading'){const items=protoReadingItems(personalFiltered());if(items.length&&!items.some(p=>p.id===state.selected))state.selected=items[0].id}   // 选中校正与可见阅读卡同一份清单（含「显示其余」展开态）
    }
    document.querySelectorAll('.proto-view-btn[data-proto-view]').forEach(btn=>{const active=btn.dataset.protoView===view;btn.setAttribute('aria-selected',String(active));btn.tabIndex=active?0:-1});
    const drawer=$('#coll-drawer');
    if(view==='personal'){drawer.setAttribute('role','region');drawer.removeAttribute('aria-modal')}else{drawer.setAttribute('role','dialog');drawer.setAttribute('aria-modal','true')}
    deck.setAttribute('aria-labelledby',`proto-tab-${view==='personal'?'overview':view}`);
    $('#coll-close').setAttribute('aria-label',view==='personal'?t('coll.close.back'):t('coll.close.label'));
    protoApplyPersonalPanels();render();protoMeasure();
  }
  $('#proto-view-switcher').addEventListener('click',event=>{const btn=event.target.closest('[data-proto-view]');if(btn)protoSetView(btn.dataset.protoView)});
  $('#proto-view-switcher').addEventListener('keydown',event=>{
    const tabs=[...document.querySelectorAll('.proto-view-btn')],current=tabs.indexOf(document.activeElement);if(current<0)return;
    let next=null;if(['ArrowRight','ArrowDown'].includes(event.key))next=(current+1)%tabs.length;if(['ArrowLeft','ArrowUp'].includes(event.key))next=(current-1+tabs.length)%tabs.length;if(event.key==='Home')next=0;if(event.key==='End')next=tabs.length-1;
    if(next!==null){event.preventDefault();event.stopPropagation();protoSetView(tabs[next].dataset.protoView);tabs[next].focus()}   // stopPropagation：截停产线 ←→ 锁定切换，防一键两动
  });
  /* 顶栏「◈ 合集」按钮改道：切换个性化视图（原抽屉打开逻辑退役）；clone 重绑甩掉旧 listener，id 不变故 render() 徽章同步不受影响。 */

