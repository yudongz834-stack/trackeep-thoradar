     })().catch(() => show('disableFailed'));
     return;
   }
-  if (!worker) return;
+  if (!worker || !storage) {
+    show('fallback');
+    return;
+  }
 
+  let replyTimeout;
+  worker.addEventListener('message', event => {
+    if (event.data?.type === 'thoradar-shell-retired' &&
+        [workerUrl, retireUrl].includes(event.source?.scriptURL)) {
+      clearTimeout(replyTimeout);
+      show(event.data.unregistered && event.data.cleared ? 'disabled' : 'disableFailed');
+      return;
+    }
+    if (status === 'disabled' || status === 'disableFailed' || !controller ||
+        event.source !== controller || event.data?.type !== 'thoradar-shell-state') return;
+    const next = event.data.status;
+    if (!['network', 'checking', 'current', 'updated', 'unavailable', 'fallback'].includes(next)) return;
+    if (next !== 'checking') clearTimeout(replyTimeout);
+    show(next);
+  });
   if (controller) {
     show('checking');
-    const replyTimeout = setTimeout(() => show('unavailable'), 12000);
-    worker.addEventListener('message', event => {
-      if (event.source !== controller || event.data?.type !== 'thoradar-shell-state') return;
-      const next = event.data.status;
-      if (!['network', 'checking', 'current', 'updated', 'unavailable'].includes(next)) return;
-      if (next !== 'checking') clearTimeout(replyTimeout);
-      show(next);
-    });
-    controller.postMessage({ type: 'thoradar-shell-status' });
+    replyTimeout = setTimeout(() => show('unavailable'), 12000);
+    try { controller.postMessage({ type: 'thoradar-shell-status' }); }
+    catch (_) { clearTimeout(replyTimeout); show('unavailable'); }
   }
-  if (canRegister) worker.register(workerUrl, { updateViaCache: 'none' }).catch(() => {});
+  if (canRegister) worker.register(workerUrl, { updateViaCache: 'none' }).catch(() => {
+    if (!controller) show('fallback');
+  });
 })();
 </script>
 </body>
diff --git a/sw-retire.js b/sw-retire.js
new file mode 100644
index 0000000000000000000000000000000000000000..197fa34b3778cbac10ded12353861e3b71e5503a
--- /dev/null
+++ b/sw-retire.js
@@ -0,0 +1,23 @@
+const CACHE_PREFIX = 'thoradar-shell-';
+
+self.addEventListener('install', event => {
+  event.waitUntil(self.skipWaiting());
+});
+
+self.addEventListener('activate', event => {
+  event.waitUntil((async () => {
+    let cleared = false;
+    try {
+      const names = await caches.keys();
+      await Promise.all(names.filter(name => name.startsWith(CACHE_PREFIX)).map(name => caches.delete(name)));
+      cleared = true;
+    } catch (_) {
+      // Cache Storage can be blocked. Still release control of the site.
+    }
+    const unregistered = await self.registration.unregister().catch(() => false);
+    const clients = await self.clients.matchAll({ type: 'window', includeUncontrolled: true });
+    for (const client of clients) {
+      client.postMessage({ type: 'thoradar-shell-retired', cleared, unregistered });
+    }
+  })());
+});
