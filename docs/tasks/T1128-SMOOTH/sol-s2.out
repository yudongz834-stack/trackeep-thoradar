#!/usr/bin/env node
// T1125-AICLS 探针共用件（tests/aicls/lib.mjs）——供 aicls_probe.mjs / aicls_mutants.mjs / aicls_regress.mjs / aicls_shots.mjs 四件共用，本身不单独运行
// 性质：施工方自建探针＝自证手段，不构成验收结论（验收样本与验收权归独立复核席）。
// 零依赖：Node ≥22（自带 WebSocket/fetch/http）＋本机 Chrome 或 Edge（CDP 驱动、独立 profile）。
// 零 LLM、零真钥匙：AI 请求一律打到本探针自起的本机假应答服务（页面的 BaseURL 指向它）；NCBI 接口由浏览器网络层拦截应答；
//   浏览器侧另用 host-resolver-rules 封死外网 DNS。临时件只落系统临时目录、跑完即清；进程清理只按 PID。
// 钥匙纪律：探针只用写死的假钥匙占位串；输出里只报「带钥匙＝对／错／缺」，任何钥匙值都不进日志。
import {spawn,execFileSync} from 'node:child_process';
import {createServer} from 'node:http';
import {readFileSync,mkdirSync,rmSync,existsSync} from 'node:fs';
import {dirname,extname,join,normalize,resolve} from 'node:path';
import {fileURLToPath} from 'node:url';
import {tmpdir} from 'node:os';
import net from 'node:net';
import {createHash} from 'node:crypto';

export const HERE=dirname(fileURLToPath(import.meta.url));   // tests/aicls
export const ROOT=normalize(join(HERE,'..','..'));           // 仓根
export const sleep=ms=>new Promise(r=>setTimeout(r,ms));
export const sha256=data=>createHash('sha256').update(data).digest('hex');
export const norm=s=>String(s).replace(/\r\n/g,'\n');        // 行尾统一成 LF 再比（工作树件是 CRLF，仓内 blob 是 LF）
export const argOf=(argv,k,d)=>{const i=argv.indexOf(k);return i>=0&&argv[i+1]&&!argv[i+1].startsWith('--')?argv[i+1]:d};
export const gitRead=(args,cwd=ROOT)=>execFileSync('git',['-c','core.quotepath=false',...args],{cwd,maxBuffer:64*1024*1024}).toString('utf8');

// ---------- 结果账：begin／check／note／end；退出码 0＝全绿、1＝有红 ----------
export function ledger(){
  const results=[];let cur=null;
  const api={
    results,
    begin(id,name){cur={id,name,fails:[],notes:[]}},
    check(cond,msg){if(cur&&!cond)cur.fails.push(msg);return Boolean(cond)},
    note(msg){if(cur)cur.notes.push(msg)},
    skip(id,name,why){results.push({id,name,fails:[],notes:[why],ok:true,skipped:true});console.log(`SKIP ${id} ${name}\n     · ${why}`)},
    end(){
      const r=cur;cur=null;r.ok=r.fails.length===0;results.push(r);
      console.log(`${r.ok?'PASS':'FAIL'} ${r.id} ${r.name}`);
      r.notes.forEach(n=>console.log(`     · ${n}`));r.fails.forEach(f=>console.log(`     ✗ ${f}`));
      return r.ok;
    },
    finish(label){
      const bad=results.filter(r=>!r.ok),skipped=results.filter(r=>r.skipped).length;
      console.log(`\n==== ${label} SUMMARY ${results.length-bad.length-skipped} PASS / ${bad.length} FAIL / ${skipped} SKIP：${results.map(r=>r.id+(r.skipped?' ∅':r.ok?' ✓':' ✗')).join('  ')} ====`);
      return bad.length;
    }
  };
  return api;
}

// ---------- 站内服务：/index.html＝受测件，/baseline.html＝基线件，/v1/messages＝假 AI，其余只读映射仓根 ----------
export const FAKE_KEY_A='PROBE-FAKE-KEY-A-0000',FAKE_KEY_B='PROBE-FAKE-KEY-B-0000';   // 假钥匙占位串（记住档用 A、会话档用 B）——不是任何真钥匙
export function aiText(rec,text){return {status:200,text,delay:0}}
export async function startServer({target,baseline=null}){
  const mime={'.html':'text/html; charset=utf-8','.json':'application/json; charset=utf-8','.js':'text/javascript; charset=utf-8','.xml':'application/xml','.ico':'image/x-icon','.md':'text/markdown; charset=utf-8'};
  const ai={log:[],respond:null,expectKey:FAKE_KEY_A};   // respond(rec)→{status,text,delay}|Promise<…>；为空＝默认应答（分类＝全归第一个阵地；深评＝固定正文）
  ai.default=rec=>rec.kind==='cls'
    ?aiText(rec,JSON.stringify(rec.payload.papers.map(p=>({pmid:p.pmid,sec:rec.payload.sectors[0].id}))))   // 分类：全归 order 里第一个阵地
    :rec.kind==='deep'
    ?aiText(rec,`【研究问题】\n探针假深评正文 PMID ${rec.payload.pmid}。\n【设计与样本】\n摘要未报告。\n【主要发现】\n占位。`)
    :aiText(rec,'OK');   // 其余（连通测试／主题判官的纯文本消息）：回一句短话
  const server=createServer((req,res)=>{
    const u=new URL(req.url,'http://x');
    if(u.pathname==='/v1/messages'){   // 假 AI（Anthropic Messages 形制）：解析请求体→记账→交场景应答器
      let body='';
      req.on('data',c=>{body+=c});
      req.on('end',async()=>{
        let reqBody=null,payload=null;
        try{reqBody=JSON.parse(body);payload=JSON.parse(reqBody.messages[0].content)}catch(e){}
        const got=req.headers['x-api-key'];
        const rec={n:ai.log.length+1,t:Date.now(),done:0,keyState:got===undefined?'缺':ai.expectKey&&got===ai.expectKey?'对':'错',keyLen:got?String(got).length:0,
          model:reqBody&&reqBody.model,maxTokens:reqBody&&reqBody.max_tokens,anthropic:req.headers['anthropic-version']||'',
          user:reqBody&&reqBody.messages&&reqBody.messages[0]&&reqBody.messages[0].content,kind:payload&&Array.isArray(payload.sectors)?'cls':payload&&'pmid' in payload?'deep':'judge',payload,status:200,hung:false};
        ai.log.push(rec);
        try{
          const out=await (ai.respond||ai.default)(rec);
          if(out.delay)await sleep(out.delay);
          if(res.writableEnded){rec.status='client-gone';return}
          rec.status=out.status;
          res.writeHead(out.status,{'content-type':'application/json','cache-control':'no-store'});
          res.end(JSON.stringify(out.status===200?{id:'msg_probe',type:'message',role:'assistant',model:rec.model,stop_reason:'end_turn',content:[{type:'text',text:out.text}]}:{type:'error',error:{type:'api_error',message:out.text||'probe error'}}));
        }catch(e){rec.status='probe-fault:'+e.message;try{res.writeHead(500);res.end('{}')}catch(e2){}}
        rec.done=Date.now();
      });
      return;
    }
    let file=null,type=null;
    if(u.pathname==='/index.html'){file=target;type='text/html; charset=utf-8'}
    else if(u.pathname==='/baseline.html'&&baseline){file=baseline;type='text/html; charset=utf-8'}
    else{const rel=normalize(decodeURIComponent(u.pathname)).replace(/^[\\/]+/,'');file=join(ROOT,rel);if(!file.startsWith(ROOT))file=null}
    if(!file||!existsSync(file)){res.writeHead(404);res.end('not found');return}
    res.writeHead(200,{'content-type':type||mime[extname(file)]||'application/octet-stream','cache-control':'no-store'});
    res.end(readFileSync(file));
  });
  await new Promise(r=>server.listen(0,'127.0.0.1',r));
  return {server,origin:`http://127.0.0.1:${server.address().port}`,ai};
}

// ---------- CDP 极简客户端 ----------
export async function connect(wsUrl){
  const ws=new WebSocket(wsUrl);
  await new Promise((res,rej)=>{ws.addEventListener('open',res,{once:true});ws.addEventListener('error',()=>rej(new Error('DevTools WebSocket 连不上')),{once:true})});
  let seq=0;const pending=new Map(),listeners=new Map();
  ws.addEventListener('message',ev=>{
    const msg=JSON.parse(ev.data);
    if(msg.id!=null){const p=pending.get(msg.id);if(!p)return;pending.delete(msg.id);msg.error?p.rej(new Error(`${p.method}: ${JSON.stringify(msg.error)}`)):p.res(msg.result)}
    else (listeners.get(msg.method)||[]).forEach(fn=>fn(msg.params,msg.sessionId));
  });
  return {
    send(method,params={},sessionId){const id=++seq;return new Promise((res,rej)=>{   // 每条命令 90s 兜底：CDP 不回话不许把探针挂死
      const timer=setTimeout(()=>{if(pending.delete(id))rej(new Error(`CDP 超时 90s：${method}`))},90000);
      pending.set(id,{res:v=>{clearTimeout(timer);res(v)},rej:e=>{clearTimeout(timer);rej(e)}});
      ws.send(JSON.stringify({id,method,params,sessionId}));
    })},
    on(method,fn){if(!listeners.has(method))listeners.set(method,[]);listeners.get(method).push(fn)},
    close(){ws.close()}
  };
}

// ---------- 页签：求值／等待／eutils 拦截／对话框自动应答／控制台与异常记账 ----------
export const EUTILS='https://eutils.ncbi.nlm.nih.gov/entrez/eutils/';
export class Tab{
  constructor(h,name){this.h=h;this.name=name;this.onload=null;this.log=[];this.errors=[];this.consoleTexts=[];this.dialogs=[];this.responder=null;this.hooks={}}
  async open(url){
    const {targetId}=await this.h.cdp.send('Target.createTarget',{url:'about:blank'});
    const {sessionId}=await this.h.cdp.send('Target.attachToTarget',{targetId,flatten:true});
    this.targetId=targetId;this.sid=sessionId;this.h.tabs.set(sessionId,this);
    await this.h.cdp.send('Page.enable',{},sessionId);await this.h.cdp.send('Runtime.enable',{},sessionId);
    await this.h.cdp.send('Fetch.enable',{patterns:[{urlPattern:EUTILS+'*',requestStage:'Request'}]},sessionId);   // eutils 全拦，不打真网
    if(this.preScript){const r=await this.h.cdp.send('Page.addScriptToEvaluateOnNewDocument',{source:this.preScript},sessionId);this.preScriptId=r.identifier}   // 可选：页面脚本跑之前先执行（如拆掉 crypto.subtle 模拟 file:// 降级）
    await this.goto(url);
  }
  async close(){try{if(this.preScriptId)await this.h.cdp.send('Page.removeScriptToEvaluateOnNewDocument',{identifier:this.preScriptId},this.sid)}catch(e){}try{await this.h.cdp.send('Target.closeTarget',{targetId:this.targetId})}catch(e){}this.h.tabs.delete(this.sid)}
  async goto(url){
    const loaded=new Promise(r=>{this.onload=r});
    await this.h.cdp.send('Page.navigate',{url},this.sid);
    await Promise.race([loaded,sleep(30000).then(()=>{throw new Error(`页面 30s 未触发 load：${url}`)})]);
    this.onload=null;
    await this.waitFor('document.body&&document.body.dataset.protoReady==="true"',20000,'protoReady');
  }
  async eval(expr){
    const r=await this.h.cdp.send('Runtime.evaluate',{expression:expr,awaitPromise:true,returnByValue:true},this.sid);
    if(r.exceptionDetails)throw new Error(`页面求值异常：${(r.exceptionDetails.exception&&r.exceptionDetails.exception.description)||r.exceptionDetails.text}\n  expr: ${expr.slice(0,200)}`);
    return r.result.value;
  }
  async waitFor(expr,timeout=10000,label=expr){
    const t0=Date.now();
    for(;;){
      let v=false;try{v=Boolean(await this.eval(expr))}catch(e){v=false}
      if(v)return Date.now()-t0;
      if(Date.now()-t0>timeout)throw new Error(`等待超时 ${timeout}ms：${label}`);
      await sleep(100);
    }
  }
  async paused(p){   // eutils 拦截：记账→按场景应答（默认压 200ms 让时间线可分辨）
    const u=new URL(p.request.url),rec={t:Date.now(),kind:u.pathname.split('/').pop().replace('.fcgi',''),db:u.searchParams.get('db')||'',url:p.request.url,code:null};
    this.log.push(rec);
    await sleep(200);
    try{await this.responder(p,rec,this)}catch(e){rec.code='mock-error:'+e.message}
    rec.done=Date.now();
  }
  mark(){return this.log.length}
  since(mark){return this.log.slice(mark)}
}
export function wire(h){   // 把 CDP 事件接到页签上
  h.cdp.on('Page.loadEventFired',(_p,sid)=>{const t=h.tabs.get(sid);if(t&&t.onload){const f=t.onload;t.onload=null;f()}});
  h.cdp.on('Fetch.requestPaused',(p,sid)=>{const t=h.tabs.get(sid);if(t)t.paused(p).catch(e=>console.log('mock fault',e.message))});
  const push=(arr,txt)=>arr.push(String(txt).slice(0,600));
  h.cdp.on('Runtime.exceptionThrown',(p,sid)=>{const t=h.tabs.get(sid);if(t)push(t.errors,(p.exceptionDetails&&(p.exceptionDetails.exception?p.exceptionDetails.exception.description:p.exceptionDetails.text))||'exception')});
  h.cdp.on('Runtime.consoleAPICalled',(p,sid)=>{   // 页面自己打的一切控制台文本都记账（含 info／warn／log）：供「钥匙零日志」断言逐字搜
    const t=h.tabs.get(sid);if(!t)return;
    const text=(p.args||[]).map(a=>a.value!==undefined?String(a.value):(a.description||a.type||'')).join(' ');
    push(t.consoleTexts,text);
    if(p.type==='error')push(t.errors,'console.error: '+text);
  });
  h.cdp.on('Page.javascriptDialogOpening',(p,sid)=>{   // 页面弹的 confirm／alert／prompt：记下原文并点「确定」，不让页面卡住
    const t=h.tabs.get(sid);if(t)t.dialogs.push({type:p.type,message:p.message,url:p.url});
    h.cdp.send('Page.handleJavaScriptDialog',{accept:true},sid).catch(()=>{});
  });
}
export const eutilsOK=async(p,rec,tab)=>{   // 主题检索用到的两种 NCBI 应答：esearch 回 2 个 PMID，efetch 回对应题录（签名同 Tab.responder：(p,rec,tab)）
  const u=new URL(rec.url),body=rec.kind==='esearch'
    ?JSON.stringify({esearchresult:{count:'2',retmax:'2',retstart:'0',idlist:['80000001','80000002']}})
    :`<?xml version="1.0"?><PubmedArticleSet>${['80000001','80000002'].map(id=>`<PubmedArticle><MedlineCitation><PMID Version="1">${id}</PMID><Article><Journal><Title>Probe journal</Title><JournalIssue><PubDate><Year>2026</Year></PubDate></JournalIssue></Journal><ArticleTitle>Probe topic article ${id}</ArticleTitle><Abstract><AbstractText>Probe abstract ${id}.</AbstractText></Abstract></Article></MedlineCitation></PubmedArticle>`).join('')}</PubmedArticleSet>`;
  await tab.h.cdp.send('Fetch.fulfillRequest',{requestId:p.requestId,responseCode:200,responseHeaders:[{name:'Content-Type',value:rec.kind==='esearch'?'application/json':'application/xml'},{name:'Access-Control-Allow-Origin',value:'*'}],body:Buffer.from(body).toString('base64')},tab.sid);
  rec.code=200;
};

// ---------- 浏览器：起／停（清理只按 PID；命令行须带本探针的 profile 路径才认） ----------
export function chromeArgs(port,profile){return ['--headless=new',`--remote-debugging-port=${port}`,`--user-data-dir=${profile}`,'--no-first-run','--no-default-browser-check','--disable-extensions','--disable-sync','--disable-background-networking','--disable-component-update','--disable-default-apps','--disable-client-side-phishing-detection','--disable-domain-reliability','--metrics-recording-only','--no-pings','--mute-audio','--disable-background-timer-throttling','--disable-backgrounding-occluded-windows','--disable-renderer-backgrounding','--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE 127.0.0.1','--window-size=1440,900','about:blank']}
export async function freePort(){return new Promise((res,rej)=>{const s=net.createServer();s.once('error',rej);s.listen(0,'127.0.0.1',()=>{const p=s.address().port;s.close(()=>res(p))})})}
async function waitDevtools(port){const t0=Date.now();for(;;){try{const r=await fetch(`http://127.0.0.1:${port}/json/version`);if(r.ok)return await r.json()}catch(e){}if(Date.now()-t0>20000)throw new Error('浏览器 DevTools 端口 20s 未起');await sleep(250)}}
const ps=cmd=>{try{return execFileSync('pwsh',['-NoProfile','-Command',cmd],{encoding:'utf8'})}catch(e){return ''}};
export async function launch({chrome,profile,port,label}){
  const tag=profile.replace(/\//g,'\\');   // 进程清理认人用：命令行里须含这段完整路径（通配符转义）
  const escTag=tag.replace(/[[\]*?]/g,ch=>'`'+ch);
  const probePids=()=>ps(`Get-CimInstance Win32_Process | Where-Object { $_.Name -match '^(chrome|msedge)' -and $_.CommandLine -like '*${escTag}*' } | Select-Object -ExpandProperty ProcessId`).split(/\r?\n/).map(x=>x.trim()).filter(x=>/^\d+$/.test(x));
  const proc=spawn(chrome,chromeArgs(port,profile),{stdio:'ignore'});
  const ver=await waitDevtools(port);
  const stop=async()=>{   // 先按 PID 结束主进程，再逐 PID 复查残留（只认命令行带本 profile 的），逐 PID 结束后再复查一次并贴原始结果
    const before=probePids();
    if(proc.exitCode===null&&proc.signalCode===null){proc.kill();const t0=Date.now();while(proc.exitCode===null&&proc.signalCode===null&&Date.now()-t0<8000)await sleep(100)}
    await sleep(1200);
    const alive=probePids(),killed=[];
    for(const pid of alive)ps(`Stop-Process -Id ${pid} -Force -ErrorAction SilentlyContinue`),killed.push(pid);
    await sleep(500);
    const still=probePids();
    console.log(`     cleanup | browser pid=${proc.pid} exitCode=${proc.exitCode} signalCode=${proc.signalCode} | 带 profile 标记的进程：收尾前=${before.join(',')||'无'} | 主进程结束后残留=${alive.join(',')||'无'} | 逐 PID 结束=${killed.join(',')||'无'} | 复查仍存活=${still.join(',')||'无'}`);
    return still.length;
  };
  return {proc,ver,stop};
}

// ---------- 页面侧小工具（经 evaluate 注入） ----------
export const P={
  view:v=>`(()=>{const b=document.querySelector('[data-proto-view="${v}"]');if(!b)return 'MISSING';b.click();return 'ok'})()`,
  tab:n=>`(()=>{const b=document.querySelector('[data-proto-personal-tab="${n}"]');if(!b)return 'MISSING';b.click();return 'ok'})()`,
  click:s=>`(()=>{const el=document.querySelector(${JSON.stringify(s)});if(!el)return 'MISSING:'+${JSON.stringify(s)};el.click();return 'ok'})()`,
  type:(s,v)=>`(()=>{const el=document.querySelector(${JSON.stringify(s)});if(!el)return 'MISSING:'+${JSON.stringify(s)};el.focus();el.value=${JSON.stringify(v)};el.dispatchEvent(new Event('input',{bubbles:true}));return 'ok'})()`,
  check:(s,on)=>`(()=>{const el=document.querySelector(${JSON.stringify(s)});if(!el)return 'MISSING:'+${JSON.stringify(s)};el.checked=${on?'true':'false'};el.dispatchEvent(new Event('change',{bubbles:true}));return 'ok'})()`,
  key:(s,k)=>`(()=>{const el=document.querySelector(${JSON.stringify(s)});if(!el)return 'MISSING:'+${JSON.stringify(s)};el.dispatchEvent(new KeyboardEvent('keydown',{key:${JSON.stringify(k)},bubbles:true,cancelable:true}));return 'ok'})()`,
};

// ---------- 静态材料（统一 LF）：区块提取／新增行／内联脚本语法／I18N 键集 ----------
export const between=(x,a,b)=>{const i=x.indexOf(a);const j=i>=0?x.indexOf(b,i):-1;return j>=0?x.slice(i,j+b.length):null};
export const block=(text,marker)=>{const i=text.indexOf(marker);if(i<0)return null;const j=text.indexOf('\n}\n',i);return j>=0?text.slice(i,j+3):null};
export const lineOf=(text,marker)=>text.split('\n').filter(l=>l.includes(marker)).join('\n');
export function inlineScripts(html){const out=[];for(const m of html.matchAll(/<script(?:\s[^>]*)?>([\s\S]*?)<\/script>/g))out.push(m[1]);return out}
export function readI18n(html){   // 从内联脚本里取 I18N 双表：返回 {zh:Map<键,值>,en:Map<键,值>}（值只认单／双引号字符串字面量）；取不到＝null（交给调用方报红）
  const src=inlineScripts(html).join('\n');
  const m=/const I18N=\{\s*zh:\{([\s\S]*?)\n\},\s*en:\{([\s\S]*?)\n\}\s*\n\};/.exec(src);
  if(!m)return null;
#!/usr/bin/env node
// T1127-UX 随仓验收探针：折叠、阅读可达性、矮屏雷达、字号、英文态、窄屏/深色与官方数据面差分。
// 用法：node tests/ux/ux_probe.mjs [--target index.html] [--base main] [--only F1,F9] [--shots 目录] [--label 名称]
//   --base 给 F8 官方数据面差分提供基线提交；--page baseline 可把基线当负对照（新功能不存在应红）。
// 零真 Key／零真 LLM／NCBI 全拦；临时件只落系统临时目录。零依赖，复用 tests/aicls/lib.mjs 的 CDP 客户端。
import {writeFileSync,mkdirSync,rmSync} from 'node:fs';
import {join,resolve} from 'node:path';
import {tmpdir} from 'node:os';
import {ROOT,sleep,ledger,startServer,connect,Tab,wire,launch,freePort,P,gitRead} from '../aicls/lib.mjs';

const argv=process.argv.slice(2);
const arg=(k,d)=>{const i=argv.indexOf(k);return i>=0&&argv[i+1]&&!argv[i+1].startsWith('--')?argv[i+1]:d};
const PAGE=arg('--page','index'),JUDGE=!argv.includes('--no-judge'),LABEL=arg('--label','run');
const SHOTS=arg('--shots',null);
const CHROME=arg('--chrome','C:/Program Files/Google/Chrome/Application/chrome.exe');
const CAND=resolve(arg('--target',process.env.XREV_CAND_HTML||join(ROOT,'index.html')));
const ONLYSET=arg('--only',process.env.XREV_ONLY||'').split(',').map(s=>s.trim()).filter(Boolean),ONLY=id=>ONLYSET.length===0||ONLYSET.includes(id);
const BASE_REV=arg('--base','main');
const SCRATCH_ROOT=resolve(process.env.XREV_SCRATCH||join(tmpdir(),'T1127-ux-probe'));
const BASE=join(SCRATCH_ROOT,`baseline-${BASE_REV.replace(/[^a-zA-Z0-9._-]/g,'_')}.html`);
const SCRATCH=join(SCRATCH_ROOT,`ux-harness-${LABEL}`),OUT=join(SCRATCH_ROOT,`out-${LABEL}`);
const L=ledger(),{check,note}=L;
const HAN=/[\u4e00-\u9fff]/;

// ---------- 页面侧量测（一段纯读表达式；元素不存在一律回 null，父提交件上也能跑） ----------
const SNAP=`(()=>{const q=s=>document.querySelector(s);
 const T=e=>(e.innerText||e.textContent||'').replace(/\\s+/g,' ').trim();
 const R=s=>{const e=typeof s==='string'?q(s):s;if(!e)return null;const r=e.getBoundingClientRect(),c=getComputedStyle(e);
   return {x:+r.x.toFixed(1),y:+r.y.toFixed(1),w:+r.width.toFixed(1),h:+r.height.toFixed(1),bottom:+r.bottom.toFixed(1),display:c.display,fs:c.fontSize,lh:c.lineHeight,ov:c.overflow,txt:T(e).slice(0,110)}};
 const list=q('#queue-list'),lr=list?list.getBoundingClientRect():null;
 const items=list?[...list.querySelectorAll('.queue-item')]:[];
 const frac=it=>{const r=it.getBoundingClientRect();return r.height>0&&lr?Math.max(0,Math.min(r.bottom,lr.bottom)-Math.max(r.top,lr.top))/r.height:0};   // 该条在列表可视框内露出的高度占比
 const inBox=it=>{const r=it.getBoundingClientRect();return !!lr&&r.height>0&&r.top>=lr.top-0.5&&r.bottom<=lr.bottom+0.5};
 const half=it=>{const r=it.getBoundingClientRect();return !!lr&&r.height>0&&!inBox(it)&&r.bottom>lr.top+0.5&&r.top<lr.bottom-0.5};
 const tg=q('.filters-toggle'),f=q('.filters'),sc=q('#scope'),sr=sc?sc.getBoundingClientRect():null;
 const attr=(s,a)=>{const e=q(s);return e?e.getAttribute(a):null};
 const C=sr&&sr.width>0?{x:sr.left+sr.width/2,y:sr.top+sr.height/2,r:sr.width/2}:null;
 const inDisc=(x,y)=>!!C&&((x-C.x)*(x-C.x)+(y-C.y)*(y-C.y)<=C.r*C.r);
 const nm=e=>((e.className&&e.className.baseVal!==undefined?e.className.baseVal:e.className)||e.tagName).toString().split(' ')[0].slice(0,24);
 const probe=el=>{if(!el||!C)return null;const r=el.getBoundingClientRect();if(r.width===0||r.height===0)return {y:0,w:0,h:0,inDisc:0,covered:0,tops:''};let n=0,inn=0,cov=0;const tops={};   // 盒内 9×3 取样：落在盘圆内的比例／最上层元素属于盘（＝这点点不到控件）的比例
   for(let i=1;i<=9;i++)for(let j=1;j<=3;j++){const x=r.left+r.width*i/10,y=r.top+r.height*j/4;if(y<0||y>innerHeight||x<0||x>innerWidth)continue;n++;if(inDisc(x,y))inn++;const e=document.elementFromPoint(x,y);if(e&&sc.contains(e)){cov++;const k=nm(e);tops[k]=(tops[k]||0)+1}}
   return {y:+r.y.toFixed(1),w:+r.width.toFixed(1),h:+r.height.toFixed(1),inDisc:n?+(inn/n).toFixed(2):0,covered:n?+(cov/n).toFixed(2):0,tops:Object.keys(tops).join(',')}};
 const cover={};for(const [k,sel] of Object.entries({toolbar:'.journal-toolbar',clear:'#journal-clear',selection:'#journal-selection',jcatLegend:'#jcat-legend',jlSummary:'.jl-fold summary',design:'#design-legend',scheme:'#scheme-select',progress:'.read-progress'}))cover[k]=probe(q(sel));
 cover.folds=[...document.querySelectorAll('#jcat-folds .jcat-fold')].map(probe);
 const covered=Object.entries(cover).filter(([k,v])=>k!=='folds'&&v&&v.covered>0).map(([k,v])=>k+'_'+Math.round(v.covered*100)+'%').concat(cover.folds.map((v,i)=>v&&v.covered>0?'阵地折叠钮'+(i+1)+'_'+Math.round(v.covered*100)+'%':null).filter(Boolean));
 const blips=[...document.querySelectorAll('#blips .blip')].filter(b=>getComputedStyle(b).opacity!=='0');
 const out=blips.filter(b=>{const r=b.getBoundingClientRect();return sr&&(r.left<sr.left-1||r.right>sr.right+1||r.top<sr.top-1||r.bottom>sr.bottom+1)}).length;
 const FS={};for(const [k,s] of Object.entries({cardTitle:'#queue-list .queue-item .queue-text strong',cardTitleEn:'#queue-list .proto-title-en',cardFinding:'#queue-list .proto-finding-text',cardFindingLabel:'#queue-list .proto-finding-label',cardMeta:'#queue-list .proto-card-meta',cardExtra:'#queue-list .proto-extra-block',cardDomain:'#queue-list .proto-domain',queueSmall:'#queue-list .queue-text small',
   detailExcerpt:'#detail .excerpt',detailTitle:'.detail-title',detailJournalName:'.detail-journal .journal-name',detailJournalMeta:'.detail-journal .journal-meta',badge:'#detail .badge',metaCellB:'#detail .meta-cell b',metaCellSmall:'#detail .meta-cell small',paused:'#detail .interpretation-paused',deepStrong:'#deep-box strong',deepBtn:'#deepreview-btn',actionBtn:'.detail-actions .action-btn',excerptLabelB:'#detail .excerpt-label b',excerptLabelSpan:'#detail .excerpt-label span',honesty:'#detail .honesty-note',
   footer:'.footer',toggle:'.filters-toggle',tierChip:'.tier-chip',quickBtn:'.quick-btn',filterLabel:'.filter-label',jlSummary:'.jl-fold summary',foldChip:'.jcat-fold',designLegend:'.legend',scopeLabel:'.scope-label',toolbar:'.journal-toolbar',topbarName:'.brand-name',viewBtn:'.proto-view-btn',scoreBox:'.score-box b'})){const e=q(s);FS[k]=e?getComputedStyle(e).fontSize:null}
 const metaCells=[...document.querySelectorAll('.meta-fold .meta-cell')];
 return {
  view:document.body.dataset.protoView,filtersOpen:document.body.classList.contains('filters-open'),density:document.body.dataset.protoDensity,lang:document.documentElement.lang,dark:document.documentElement.classList.contains('dark'),
  vw:innerWidth,vh:innerHeight,docSH:document.documentElement.scrollHeight,bodySH:document.body.scrollHeight,docSW:document.documentElement.scrollWidth,bodySW:document.body.scrollWidth,bodyOv:getComputedStyle(document.body).overflow,
  toggle:tg?Object.assign(R(tg),{ariaExpanded:tg.getAttribute('aria-expanded'),ariaControls:tg.getAttribute('aria-controls'),title:tg.getAttribute('title')}):null,
  filters:f?Object.assign(R(f),{cols:getComputedStyle(f).gridTemplateColumns}):null,
  queue:{n:items.length,full:items.filter(inBox).length,vis90:items.filter(it=>frac(it)>=0.9).length,half:items.filter(half).length,list:R('#queue-list'),firstH:items[0]?+items[0].getBoundingClientRect().height.toFixed(1):null},
  panel:R('.queue-panel'),head:R('.panel-head'),qtitle:R('.queue-title'),rtoolbar:R('#proto-reading-toolbar'),
  topbar:R('.topbar'),search:R('.search'),viewSwitcher:R('#proto-view-switcher'),deck:R('.deck'),footer:R('.footer'),gapUnderFooter:q('.footer')?+(innerHeight-q('.footer').getBoundingClientRect().bottom).toFixed(1):null,
  scope:R('#scope'),stage:R('.scope-stage'),scopeHead:R('.scope-head'),foot:R('.scope-foot'),
  toolbar:R('.journal-toolbar'),folds:R('#jcat-folds'),jcatLegend:R('#jcat-legend'),designLegend:R('#design-legend'),funnel:R('#funnel'),
  jl:q('.jl-fold')?Object.assign(R('.jl-fold'),{open:q('.jl-fold').open,summary:R('.jl-fold summary'),legend:R('#journal-legend'),pills:document.querySelectorAll('#journal-legend .journal-btn').length,activePills:document.querySelectorAll('#journal-legend .journal-btn.active').length}):null,
  cover,covered,maxCovered:+Math.max(0,...Object.values(cover).filter(v=>v&&!Array.isArray(v)).map(v=>v.covered),...cover.folds.map(v=>v?v.covered:0)).toFixed(2),
  clearDisabled:q('#journal-clear')?q('#journal-clear').disabled:null,blipOut:out,blipN:blips.length,
  hint:R('.ai-help[data-i18n="poolup.hint"]'),mixLabelTitle:attr('#pool-mix-control label','title'),mixCtrl:R('#pool-mix-control'),
  detail:Object.assign(R('#detail'),{panel:R('.detail-panel'),scrollH:q('.detail-panel')?q('.detail-panel').scrollHeight:null,clientH:q('.detail-panel')?q('.detail-panel').clientHeight:null,
    title:R('.detail-title'),excerpt:R('#detail .excerpt'),excerptLabel:R('#detail .excerpt-label'),honesty:R('#detail .honesty-note'),paused:R('#detail .interpretation-paused'),deep:R('#deep-box'),actions:R('.detail-actions'),nav:R('.detail-nav'),
    metaFold:q('.meta-fold')?Object.assign(R('.meta-fold'),{open:q('.meta-fold').open,cells:metaCells.length,cellsVisible:metaCells.filter(c=>c.checkVisibility()).length}):null,
    metaGrid:R('#detail .meta-grid'),journalMeta:R('.detail-journal .journal-meta'),
    order:[...document.querySelectorAll('#detail .detail-inner > *')].map(e=>(e.className||e.tagName).toString().split(' ')[0]),
    pausedTitle:attr('#detail .interpretation-paused','title'),deepTitle:attr('#deep-box','title'),pausedBrInPaused:document.querySelectorAll('#detail .interpretation > .interpretation-paused br').length,
    deepBtn:!!q('#deepreview-btn'),deepBtnVisible:!!(q('#deepreview-btn')&&q('#deepreview-btn').checkVisibility()),
    actionsInFirstScreen:q('.detail-actions')?q('.detail-actions').getBoundingClientRect().top<=innerHeight:null,excerptInFirstScreen:q('#detail .excerpt')?q('#detail .excerpt').getBoundingClientRect().top<=innerHeight:null,
    excerptVisibleH:q('#detail .excerpt')?+Math.max(0,Math.min(innerHeight,q('.detail-panel').getBoundingClientRect().bottom)-q('#detail .excerpt').getBoundingClientRect().top).toFixed(1):null}),
  texts:{toggle:tg?T(tg):null,jlSummary:q('.jl-fold summary')?T(q('.jl-fold summary')):null,metaSummary:q('.meta-fold summary')?T(q('.meta-fold summary')):null,collOpen:T(q('#coll-open')),langBtn:T(q('#lang-btn')),docTitle:document.title,foot:q('.footer')?T(q('.footer')):null},
  fs:FS};
})()`;
// 英文态「界面骨架里还剩哪些中国字」：只扫界面骨架（不含论文题名/摘要等内容）＋title／aria-label／placeholder
const CJKSCAN=`(()=>{const han=/[\\u4e00-\\u9fff]/;const out=new Set();const roots=['.topbar','.queue-panel .panel-head','.filters','.queue-title','#proto-reading-toolbar','.scope-head','.scope-foot','.footer','#detail .detail-top','#detail .detail-journal','#detail .excerpt-label','#detail .detail-actions','#detail .detail-nav','#detail .meta-fold summary'];
 const walk=root=>{if(!root)return;const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let n;while(n=w.nextNode()){const s=n.nodeValue.replace(/\\s+/g,' ').trim();if(s&&han.test(s)&&!/\\d{6,}/.test(s))out.add('文:'+s.slice(0,40))}
   root.querySelectorAll('[title],[aria-label],[placeholder]').forEach(e=>{for(const a of ['title','aria-label','placeholder']){const v=e.getAttribute(a);if(v&&han.test(v))out.add(a+':'+v.slice(0,40))}});
   if(root.matches&&root.matches('[title],[aria-label],[placeholder]'))for(const a of ['title','aria-label','placeholder']){const v=root.getAttribute(a);if(v&&han.test(v))out.add(a+':'+v.slice(0,40))}};
 roots.forEach(s=>walk(document.querySelector(s)));
 const tg=document.querySelector('.filters-toggle');if(tg&&han.test(tg.textContent))out.add('文:'+tg.textContent.trim());
 return [...out].sort()})()`;
const snap=async tab=>tab.eval(SNAP);
const vis=s=>Boolean(s&&s.filters&&s.filters.display!=='none'&&s.filters.h>0);
const labelOpen=s=>Boolean(s&&s.toggle&&/^收起筛选/.test(s.toggle.txt));
const shot=async(h,tab,name)=>{if(!SHOTS)return null;const r=await h.cdp.send('Page.captureScreenshot',{format:'png'},tab.sid);const p=join(SHOTS,`${LABEL}-${name}.png`);writeFileSync(p,Buffer.from(r.data,'base64'));return p};
const size=async(h,tab,w,hh,mobile=false)=>{await h.cdp.send('Emulation.setDeviceMetricsOverride',{width:w,height:hh,deviceScaleFactor:1,mobile},tab.sid);await sleep(350)};
// 新页签：先落到同源页→定视口→清库→等 450ms（防上一幕防抖落盘写回）→再清→导航
const fresh=async(h,path,w=1440,hh=714,mobile=false)=>{const t=new Tab(h,'x');await t.open(`${h.origin}/index.html`);await size(h,t,w,hh,mobile);
  await t.eval('localStorage.clear();sessionStorage.clear();1');await sleep(450);await t.eval('localStorage.clear();sessionStorage.clear();1');await t.goto(`${h.origin}${path}`);await sleep(350);return t};
const errs=(tab,where)=>{const n=tab.errors.length;check(n===0,`${where}：页面运行期异常 ${n} 条：${tab.errors.slice(0,2).join(' | ').slice(0,300)}`);return n};
const covList=s=>s.scope&&s.scope.w?(s.covered.join('＋')||'无'):null;
const maxCovered=s=>s.scope&&s.scope.w?Math.max(0,...Object.values(s.cover).filter(v=>v&&!Array.isArray(v)).map(v=>v.covered),...s.cover.folds.map(v=>v?v.covered:0)):0;
const brief=s=>({view:s.view,filters:vis(s)?`${s.filters.display} ${s.filters.w}×${s.filters.h}`:'隐',toggle:s.toggle?s.toggle.txt:null,queue:`全见 ${s.queue.full}（≥90%可见 ${s.queue.vis90}）＋半截 ${s.queue.half}／共 ${s.queue.n}`,
  topbar:s.topbar.h,deck:s.deck.h,footer:`bottom=${s.footer.bottom} 余 ${s.gapUnderFooter}px`,scope:s.scope&&s.scope.w?`${s.scope.w}×${s.scope.h} 台高${s.stage.h}`:null,盘盖住:s.scope&&s.scope.w?covList(s):null,blipOut:s.blipOut});
const sec=(id,name)=>L.begin(id,name);
const save=(name,data)=>{mkdirSync(OUT,{recursive:true});writeFileSync(join(OUT,name),JSON.stringify(data,null,1))};
const clickSector=tab=>tab.eval(`(()=>{const ss=[...document.querySelectorAll('#journal-sectors .journal-sector')];if(!ss.length)return null;const s=ss[0];s.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true}));return s.dataset.jcat})()`);
const mousePoint=async(h,tab,p)=>{
  await h.cdp.send('Input.dispatchMouseEvent',{type:'mouseMoved',x:p.x,y:p.y,button:'none',pointerType:'mouse'},tab.sid);
  await h.cdp.send('Input.dispatchMouseEvent',{type:'mousePressed',x:p.x,y:p.y,button:'left',clickCount:1,pointerType:'mouse'},tab.sid);
  await h.cdp.send('Input.dispatchMouseEvent',{type:'mouseReleased',x:p.x,y:p.y,button:'left',clickCount:1,pointerType:'mouse'},tab.sid);
};
const mouseClick=async(h,tab,selector)=>{
  const p=await tab.eval(`(()=>{const e=document.querySelector(${JSON.stringify(selector)});if(!e)return null;e.scrollIntoView({block:'center',inline:'center'});const r=e.getBoundingClientRect();return {x:r.x+r.width/2,y:r.y+r.height/2}})()`);
  if(!p)throw new Error(`真实鼠标目标不存在：${selector}`);
  await mousePoint(h,tab,p);
};

async function main(){
  rmSync(SCRATCH,{recursive:true,force:true});mkdirSync(SCRATCH,{recursive:true});if(SHOTS)mkdirSync(SHOTS,{recursive:true});
  mkdirSync(SCRATCH_ROOT,{recursive:true});writeFileSync(BASE,gitRead(['show',`${BASE_REV}:index.html`]));
  const srv=await startServer({target:CAND,baseline:BASE}),port=await freePort(),profile=join(SCRATCH,'profile');
  const browser=await launch({chrome:CHROME,profile,port,label:LABEL});
  const h={cdp:null,tabs:new Map(),origin:srv.origin};h.cdp=await connect(browser.ver.webSocketDebuggerUrl);wire(h);
  const path=PAGE==='baseline'?'/baseline.html':'/index.html';
  try{
    console.log(`ux probe | ${browser.ver.Browser} | page=${path}（${PAGE==='baseline'?`基线 ${BASE_REV}＝负对照`:`受测件 ${CAND}`}）| judge=${JUDGE} | label=${LABEL}`);
    {const t=await fresh(h,path);const m=await t.eval('({ready:document.body.dataset.protoReady,papers:PAPERS.length,anchor:ANCHOR,lang:LANG,site:SITE_DATA.briefing_date,degraded:PAPERS.filter(p=>String(p.publish_state)==="degraded").length,hasToggle:!!document.querySelector(".filters-toggle")})');console.log('页面概况：'+JSON.stringify(m));await t.close()}
    // ================= F1 折叠行为（任务书要点 2）：1440×714 =================
    if(ONLY('F1')){
      const t=await fresh(h,path);const steps=[];
      const step=async(name,fn)=>{if(fn)await fn();await sleep(250);const s=await snap(t);steps.push({name,...s});console.log(`  [${name}] ${JSON.stringify(brief(s))}`);return s};
      const clickToggle=()=>t.eval(P.click('.filters-toggle'));
      const s0=await step('A0 概览首屏（缺省）');
      const s1=await step('A1 概览点折叠钮①',clickToggle);
      const s2=await step('A2 概览点折叠钮②',clickToggle);
#!/usr/bin/env node
// T1125-AICLS 零回归差分（tests/aicls/aicls_regress.mjs）——施工席自证件：不构成验收结论，验收权归独立复核席
// 用法：node tests/aicls/aicls_regress.mjs [--target <index.html>] [--baseline <rev>] [--only R12,R17] [--label 名称] [--chrome <chrome.exe|msedge.exe>]
//   --only：全序列照跑（后面的步骤依赖前面的状态），只比对并输出点名的步骤。
// 做什么：基线件（git show <baseline>:index.html，baseline 缺省取 git merge-base HEAD main）与施工后件，在同一浏览器同一页签里先后各跑一遍
//   同一套「只碰既有功能」的真实入口操作（合集／阵地方案／主题词 P1 路径／书架／池外刊入册与题录面板／语言／深色／时间窗／我的主题运行／键盘／删除与重载），
//   每一步之后比对四样：①页面＋浏览器存储快照（归一化后）②界面文案表（页面上所有带 data-i18n* 的元素按键取当前文案：基线有而施工后没有＝红、同键不同文＝红）
//   ③AI 请求种类序列 ④NCBI 请求序列（含相邻请求间隔是否 ≥3s——节拍回归也抓得住）。全部相等才算这一步零回归。
// 防「空对空」的三道闸（都是变异红证里真被存活变异揪出来的洞，补在这里）：
//   ①任一步执行故障＝红——两侧故障一字不差也不算过（故障说明这一步没比上；界面入口点不到就是没点到）。
//   ②某一步的快照与上一步一字不差＝红（入口没点到、或这一步什么都没做）。所以「开了又关」的操作一律拆成两步各比一次。
//   ③关键步骤带场景自检 meta（如书架筛选后的列表长度）：两侧都须满足「这一步真的改变了什么」，不满足＝红。
// 另有一道静态闸 R00：既有文案逐键不变——基线中英两表的每个键在施工后件里同名同值，白名单键（WHITE）除外；施工后新增的键单列不计。
// 归一化只抹天然差异：随机生成的 id（c_/s_/g_/t_ 按出现次序编号）、毫秒时间戳、标签间的排版空白、本机时间文本。施工后件独有的新界面件（分类进度行／深评块／
//   钥匙开关／AI 设置标题）取快照时从克隆节点里剔掉——它们是本单的新增面，不参与「既有功能零回归」的比对，由 aicls_probe.mjs 另行守。
// 快照一律在步骤做完、等各防抖落盘（250ms）走完之后取，避开两侧时序差；自动消失的提示条文本不计入快照。
// 同时断言：全程不出现分类／深评请求（不点新功能＝零新增调用）。退出码：0＝全部一致，1＝有差异，2＝探针自身崩溃。
import {readFileSync,writeFileSync,mkdirSync,rmSync} from 'node:fs';
import {join,resolve} from 'node:path';
import {tmpdir} from 'node:os';
import {ROOT,sleep,sha256,norm,argOf,gitRead,ledger,startServer,connect,Tab,wire,launch,freePort,P,readI18n,FAKE_KEY_A} from './lib.mjs';

const argv=process.argv.slice(2);
const TARGET=resolve(ROOT,argOf(argv,'--target',join(ROOT,'index.html')));
const LABEL=argOf(argv,'--label','run');
const CHROME=argOf(argv,'--chrome','C:/Program Files/Google/Chrome/Application/chrome.exe');
const ONLY=argOf(argv,'--only','').split(',').map(s=>s.trim()).filter(Boolean);
const SCRATCH_ROOT=resolve(process.env.AICLS_SCRATCH||join(tmpdir(),`thoradar-t1125-aicls-regress-${LABEL}`));
const SCRATCH=join(SCRATCH_ROOT,'harness');
let BASE=argOf(argv,'--baseline','');
if(!BASE){try{BASE=gitRead(['merge-base','HEAD','main']).trim()||'HEAD'}catch(e){BASE='HEAD'}}
const L=ledger(),{check,note}=L;
const skip=id=>ONLY.length&&!ONLY.includes(id);   // --only R12,R17：全序列照跑（后面的步骤依赖前面的状态），只比对并输出点名的步骤
const WHITE=new Set(['ai.title']);   // 既有文案里本单有意改动的键（AI 设置标题改成「分类与深评共用」的说明）；此外任何一条既有文案被改都算回归

// ---------- 归一化：随机 id 按出现次序编号；毫秒时间戳抹平 ----------
let normIds={};
const normalize=s=>String(s)
  .replace(/\b([csgt])_([a-z0-9]{6,})/g,(m,p,id)=>{normIds[id]=normIds[id]||`${p}_#${Object.keys(normIds).length}`;return normIds[id]})
  .replace(/\b1[6-9]\d{11}\b/g,'<TS>')
  .replace(/>\s+</g,'><')                                                    // 标签之间的排版空白（模板缩进，不是内容）
  .replace(/\d{4}\/\d{1,2}\/\d{1,2} \d{1,2}:\d{2}:\d{2}/g,'<LOCALTS>')       // 本机时间文本（主题「上次运行」、题录面板「更新于」）：两侧必然不同
  .replace(/\d{1,2}\/\d{1,2}\/\d{4}, \d{1,2}:\d{2}:\d{2} [AP]M/g,'<LOCALTS>');
// 快照表达式：从克隆节点取 innerHTML（不动页面）；施工后件独有的新界面件两边都剔（基线里本就没有）
const STRIP='#cls-progress,#deep-box,.deep-note,.deep-err,.ai-session,[data-i18n="ai.title"]';   // .ai-session＝钥匙「仅本会话」开关行
const SNAP=`(()=>{const N=x=>x==null?x:String(x).replace(/>\\s+</g,'><').replace(/\\d{4}\\/\\d{1,2}\\/\\d{1,2} \\d{1,2}:\\d{2}:\\d{2}/g,'<LOCALTS>').replace(/\\d{1,2}\\/\\d{1,2}\\/\\d{4}, \\d{1,2}:\\d{2}:\\d{2} [AP]M/g,'<LOCALTS>');   // N：页内先抹「标签间排版空白」与「本机时间文本」——快照随后会被 JSON 转义，出来再抹就匹配不上了
  const S=s=>{const el=document.querySelector(s);if(!el)return null;const c=el.cloneNode(true);c.querySelectorAll(${JSON.stringify(STRIP)}).forEach(n=>n.remove());return N(c.innerHTML)},text=s=>{const el=document.querySelector(s);return el?N(el.textContent):null};
  return JSON.stringify({main:{queue:S('#queue-list'),queueHead:S('.queue-panel .panel-head'),filters:S('.queue-panel .filters'),blips:S('#blips'),sectors:S('#journal-sectors'),labels:S('#scope-labels'),detail:S('#detail'),jlegend:S('#journal-legend'),folds:S('#jcat-folds'),clegend:S('#jcat-legend'),dlegend:S('#design-legend'),funnel:S('#funnel'),counter:text('#filter-counter'),read:text('#read-count'),sub:text('#scope-subtitle'),hub:text('#hub-count'),sel:text('#journal-selection'),tiers:S('#tier-filters'),wlabel:text('#window-label'),wvalue:text('#window-value'),empty:S('#scope-empty'),mobile:S('#shelf-mobile-status'),skeleton:document.querySelector('#rolling-skeleton').hidden,scan:text('#scan-date')+'|'+text('#scan-time')},
    chrome:{head:S('header.topbar')},tabs:S('.proto-personal-tabs'),
    drawer:{collList:S('#coll-list'),collEditor:S('#coll-editor'),schemeList:S('#scheme-list'),schemeEditor:S('#scheme-editor'),topicList:S('#topic-list'),topicEditor:S('#topic-editor'),shelf:S('#myjournals-panel'),ai:S('#ai-settings'),hidden:document.querySelector('#coll-drawer').hidden,testStatus:text('#ai-test-status'),testBtn:document.querySelector('#ai-test').disabled},
    overlays:{topicBody:S('#topic-run-body'),topicStats:text('#topic-run-stats'),topicTitle:text('#topic-run-title'),topicHidden:document.querySelector('#topic-overlay').hidden,poolBody:S('#pool-body'),poolStats:text('#pool-stats'),poolTitle:text('#pool-title'),poolHidden:document.querySelector('#pool-overlay').hidden},
    ui:{view:document.body.dataset.protoView,density:document.body.dataset.protoDensity,lang:LANG,dark:document.documentElement.classList.contains('dark'),title:document.title,days:state.days,selected:String(state.selected),quick:state.quick,jcat:String(state.jcat),gsec:String(state.gsec),journal:String(state.journal),query:state.query,papers:PAPERS.length},
    ls:Object.fromEntries(Object.keys(localStorage).sort().map(k=>{let v=localStorage.getItem(k);if(k==='thoradar.ai.v1'){try{const o=JSON.parse(v);delete o.sessionOnly;v=JSON.stringify(o)}catch(e){}}return [k,v]}))})})()`;
// 界面文案表：页面上所有带 data-i18n* 的元素「键→当前文案」（文本或 title／placeholder／aria-label 属性）。改了一条既有文案、或一个既有文案件不见了，都从这里露出来
const I18NMAP=`(()=>{const N=v=>String(v==null?'':v).replace(/\\d{4}\\/\\d{1,2}\\/\\d{1,2} \\d{1,2}:\\d{2}:\\d{2}/g,'<LOCALTS>').replace(/\\d{1,2}\\/\\d{1,2}\\/\\d{4}, \\d{1,2}:\\d{2}:\\d{2} [AP]M/g,'<LOCALTS>').replace(/\\s+/g,' ').trim(),out={};
  for(const el of document.querySelectorAll('[data-i18n],[data-i18n-title],[data-i18n-ph],[data-i18n-aria]')){
    const k=el.getAttribute('data-i18n')||el.getAttribute('data-i18n-title')||el.getAttribute('data-i18n-ph')||el.getAttribute('data-i18n-aria');if(!k||k in out)continue;
    const attr=el.hasAttribute('data-i18n')?'':el.hasAttribute('data-i18n-title')?'title':el.hasAttribute('data-i18n-ph')?'placeholder':'aria-label';
    out[k]=attr?N(el.getAttribute(attr)):N(el.textContent);
  }
  return out})()`;
const LS=(k,v)=>`localStorage.setItem(${JSON.stringify(k)},${JSON.stringify(JSON.stringify(v))})`;
const clickN=(sel,i)=>`(()=>{const els=document.querySelectorAll(${JSON.stringify(sel)});const el=els[${i}];if(!el)return 'MISSING:'+${JSON.stringify(sel)}[${i}]+'（共 '+els.length+' 个）';el.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true,view:window}));return 'ok'})()`;   // 一律派发鼠标事件：雷达扇区是 SVG 元素，没有 click()
const setValue=(sel,v)=>`(()=>{const el=document.querySelector(${JSON.stringify(sel)});if(!el)return 'MISSING:'+${JSON.stringify(sel)};el.value=${JSON.stringify(v)};el.dispatchEvent(new Event('input',{bubbles:true}));return 'ok'})()`;
const keyOn=(target,key)=>`(()=>{const el=${target==='input'?'document.querySelector("#search")':'document.body'};el.dispatchEvent(new KeyboardEvent('keydown',{key:${JSON.stringify(key)},bubbles:true,cancelable:true}));return 1})()`;
const ensureSector=t=>t.eval(`(()=>{if(schemeEditingSector)return 'kept';const els=document.querySelectorAll('[data-sector-select]');if(!els.length)return 'MISSING:[data-sector-select]';els[0].dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true,view:window}));return 'ok'})()`);   // 「选阵地」是开关：已选中就不再点
const needs=r=>{if(r!=='ok'&&r!=='kept')throw new Error('界面入口点不到：'+r)};
const windowTo=async(t,d)=>{needs(await t.eval(setValue('#window-range',String(d))));await t.eval('rollingPromise?rollingPromise.then(()=>"loaded"):"no-fetch"');await sleep(400)};
// 场景自检用的页内取值（都是只读或算完即还原，不落盘不重渲）
const PASSING=`const own=Object.prototype.hasOwnProperty,collKeys=collectionFilterKeys(),ok=p=>{const quickOk=state.quick==='all'||(state.quick==='nct'?Boolean(p.nct_id):designOf(p)===state.quick);return tierOk(p)&&journalOk(p)&&quickOk&&(!collKeys||collKeys.has(paperJournalKey(p)))}`;   // 「过得了除书架外的现有筛选」
#!/usr/bin/env node
// T1125-POOLUP 零回归差分（沿用单A 30 步真实入口序列；tests/aicls 原卷只跑不改）。
// 用法：node tests/poolup/poolup_regress.mjs [--target <index.html>] [--baseline 06d08e8] [--only R12,R17] [--label 名称] [--chrome ...]
//   --only：全序列照跑（后面的步骤依赖前面的状态），只比对并输出点名的步骤。
// 做什么：基线件（git show <baseline>:index.html，baseline 缺省取 git merge-base HEAD main）与施工后件，在同一浏览器同一页签里先后各跑一遍
//   同一套「只碰既有功能」的真实入口操作（合集／阵地方案／主题词 P1 路径／书架／池外刊入册与题录面板／语言／深色／时间窗／我的主题运行／键盘／删除与重载），
//   每一步之后比对四样：①页面＋浏览器存储快照（归一化后）②界面文案表（页面上所有带 data-i18n* 的元素按键取当前文案：基线有而施工后没有＝红、同键不同文＝红）
//   ③AI 请求种类序列 ④NCBI 请求序列（含相邻请求间隔是否 ≥3s——节拍回归也抓得住）。全部相等才算这一步零回归。
// 防「空对空」的三道闸（都是变异红证里真被存活变异揪出来的洞，补在这里）：
//   ①任一步执行故障＝红——两侧故障一字不差也不算过（故障说明这一步没比上；界面入口点不到就是没点到）。
//   ②某一步的快照与上一步一字不差＝红（入口没点到、或这一步什么都没做）。所以「开了又关」的操作一律拆成两步各比一次。
//   ③关键步骤带场景自检 meta（如书架筛选后的列表长度）：两侧都须满足「这一步真的改变了什么」，不满足＝红。
// 另有一道静态闸 R00：既有文案逐键不变——基线中英两表的每个键在施工后件里同名同值，白名单键（WHITE）除外；施工后新增的键单列不计。
// 归一化只抹天然差异：随机生成的 id（c_/s_/g_/t_ 按出现次序编号）、毫秒时间戳、标签间的排版空白、本机时间文本。施工后件独有的新界面件（分类进度行／深评块／
//   钥匙开关／AI 设置标题）取快照时从克隆节点里剔掉——它们是本单的新增面，不参与「既有功能零回归」的比对，由 aicls_probe.mjs 另行守。
// 快照一律在步骤做完、等各防抖落盘（250ms）走完之后取，避开两侧时序差；自动消失的提示条文本不计入快照。
// 同时断言：全程不出现分类／深评请求（不点新功能＝零新增调用）。退出码：0＝全部一致，1＝有差异，2＝探针自身崩溃。
import {readFileSync,writeFileSync,mkdirSync,rmSync} from 'node:fs';
import {join,resolve} from 'node:path';
import {tmpdir} from 'node:os';
import {ROOT,sleep,sha256,norm,argOf,gitRead,ledger,startServer,connect,Tab,wire,launch,freePort,P,readI18n,FAKE_KEY_A} from './lib.mjs';

const argv=process.argv.slice(2);
const TARGET=resolve(ROOT,argOf(argv,'--target',join(ROOT,'index.html')));
const LABEL=argOf(argv,'--label','run');
const CHROME=argOf(argv,'--chrome','C:/Program Files/Google/Chrome/Application/chrome.exe');
const ONLY=argOf(argv,'--only','').split(',').map(s=>s.trim()).filter(Boolean);
const SCRATCH_ROOT=resolve(process.env.AICLS_SCRATCH||join(tmpdir(),`thoradar-t1125-aicls-regress-${LABEL}`));
const SCRATCH=join(SCRATCH_ROOT,'harness');
let BASE=argOf(argv,'--baseline','');
if(!BASE){try{BASE=gitRead(['merge-base','HEAD','main']).trim()||'HEAD'}catch(e){BASE='HEAD'}}
