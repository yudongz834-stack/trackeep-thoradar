name: Deploy to Aliyun OSS

# 迁移役（2026-11-19 起）：每日流水线跑完 → 网站同步到阿里云深圳 OSS（备案接入）
# 手动可触发（workflow_dispatch）＝首次部署/补发；workflow_run 挂在日报管线尾部自动跟发
on:
  workflow_dispatch:
  workflow_run:
    workflows: ["ThorRadar Daily Pipeline"]
    types: [completed]

permissions:
  contents: read

jobs:
  deploy-oss:
    # 日报管线成功才跟发；手动触发不受限
    if: github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Sync site to Aliyun OSS (thoradar-online · cn-shenzhen)
        env:
          OSS_KEY_ID: ${{ secrets.OSS_KEY_ID }}
          OSS_KEY_SECRET: ${{ secrets.OSS_KEY_SECRET }}
        run: |
          set -e
          # ossutil 走 GitHub 官方发行版 v1.7.18 zip（v1.7.19 无 linux 资产·alicdn 域名美国 runner 不通）
          curl -sL https://github.com/aliyun/ossutil/releases/download/v1.7.18/ossutil-v1.7.18-linux-amd64.zip -o ossutil.zip
          unzip -q ossutil.zip
          mv ossutil-v1.7.18-linux-amd64/ossutil ./ossutil
          chmod +x ossutil
          file ossutil | grep -q ELF || { echo "下载的不是程序："; head -c 200 ossutil; exit 9; }
          ./ossutil --version | head -1
          ./ossutil config -e oss-cn-shenzhen.aliyuncs.com -i "$OSS_KEY_ID" -k "$OSS_KEY_SECRET" -L CH
          # 开桶（幂等：已存在则忽略）
          ./ossutil mb oss://thoradar-online --acl public-read 2>/dev/null || echo "桶已存在，跳过创建"
          # 静态站默认页：v1.7.18 website put 只认 XML 配置文件（--index-page 是幻影旗标，
          # 2>/dev/null || true 曾吞错致根路径 403——2026-11-20 控制台补设＋此处改 XML 正方）
          cat > website.xml <<'XML'
          <?xml version="1.0" encoding="UTF-8"?>
          <WebsiteConfiguration>
            <IndexDocument><Suffix>index.html</Suffix></IndexDocument>
            <ErrorDocument><Key>index.html</Key></ErrorDocument>
          </WebsiteConfiguration>
          XML
          ./ossutil website --method put oss://thoradar-online website.xml
          # 站面文件（首页/图标/搜索登记/订阅件）——ossutil 单命令单源，逐件上传
          # 分层缓存（Sol 11-22 审）：浏览器 max-age=60 秒快速见新版，CDN s-maxage 缓存减少回源。
          # 首页 1 小时 CDN 缓存＝日报 05:03 发布后最晚 06:03 全网可见；数据文件 5 分钟对齐日报粒度。
          ./ossutil cp -rf --update --meta "Cache-Control:public, max-age=60, s-maxage=3600" index.html oss://thoradar-online/
          # sitemap lastmod 部署时现打当日戳（Hydrogen 11-20 审出死日期 2026-11-08 滞留）
          sed -i "s|<lastmod>[^<]*</lastmod>|<lastmod>$(date -u +%Y-%m-%d)</lastmod>|" sitemap.xml
          for f in favicon.ico robots.txt sitemap.xml; do
            ./ossutil cp -rf --update "$f" oss://thoradar-online/
          done
          ./ossutil cp -rf --update --meta Cache-Control:no-cache feed.xml oss://thoradar-online/
          ./ossutil cp -rf --update --meta "Cache-Control:public, max-age=60, s-maxage=300" data/radar_latest.json oss://thoradar-online/data/
          ./ossutil cp -rf --update --meta Cache-Control:no-cache api/ oss://thoradar-online/api/
          ./ossutil cp -rf --update thoradar-skill/ oss://thoradar-online/thoradar-skill/
          # 开门＝桶级公共读（控制台定版，对象继承 ACL）——逐件 setacl 按 6.2/Hydrogen 双席审读裁撤
          # （v1.7.18 无 setacl 命令·对象继承桶权限已实测 200）
          echo "=== 同步完成，桶内对象数："
          ./ossutil ls oss://thoradar-online/ | tail -2
          # 验锁闸：逼流量走 CNAME 目标实测 HTTPS（DNS 切换前后都成立；证书/绑定/静态页回归＝部署判红）
          # 双域逐验＋严格断言 http_code==200（Sol 11-20 审出：curl -sf 连 304 也放行还谎报 200）
          echo "=== HTTPS 预检（SNI=域名 → CNAME 目标）"
          for h in thoradar.online www.thoradar.online; do
            code=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 15 \
              --connect-to "$h:443:thoradar-online.cn-shenzhen.taihangtop.cn:443" \
              "https://$h/")
            if [ "$code" != "200" ]; then echo "✗ $h 根路径 HTTPS $code（期望 200）"; exit 1; fi
            echo "$h 根路径 HTTPS 200 ✅"
          done

import { execFileSync } from 'node:child_process';
import { readFile, writeFile } from 'node:fs/promises';
import { join } from 'node:path';
import { ROOT, gitRead, norm, sha256 } from '../aicls/lib.mjs';

const output = process.argv[2];
if (!output) throw new Error('Usage: node tests/smooth/verify-source.mjs <result.json>');
const paths = ['index.html', 'sw.js', 'sw-retire.js', 'tests/smooth/verify-s1.mjs',
  'tests/smooth/verify-s2.mjs', 'tests/smooth/run-regressions.mjs', 'tests/smooth/verify-source.mjs'];
const candidate = await readFile(join(ROOT, 'index.html'), 'utf8');
const baseline = gitRead(['show', '73dd34e:index.html']);
const sections = [
  ['official-data', '/*__THORADAR_DATA_START__*/', '/*__THORADAR_DATA_END__*/'],
  ['official-paper-initialization', 'const INJECTED_PAPERS=', 'let PAPERS=INJECTED_PAPERS.slice();'],
  ['official-window-and-merge', 'function inWindow(p){', 'const windowPapers=()=>PAPERS.filter(inWindow);']
];
const checks = [];
for (const [name, start, end] of sections) {
  const extract = source => {
    const from = source.indexOf(start);
    const to = source.indexOf(end, from + start.length);
    if (from < 0 || to < 0) throw new Error('Section missing: ' + name);
    return source.slice(from, to + end.length);
  };
  const from = extract(norm(baseline));
  const to = extract(norm(candidate));
  checks.push({ name, pass: from === to, baselineSha256: sha256(from), candidateSha256: sha256(to) });
}

const tracked = gitRead(['diff', '--name-only', '73dd34e', '--']).trim().split(/\r?\n/).filter(Boolean);
const untracked = gitRead(['ls-files', '--others', '--exclude-standard']).trim().split(/\r?\n/).filter(Boolean);
const outOfScope = [...tracked, ...untracked].filter(path =>
  !['index.html', 'sw.js', 'sw-retire.js'].includes(path) &&
  !path.startsWith('tests/smooth/') && !path.startsWith('docs/tasks/T1128-SMOOTH/'));
checks.push({ name: 'write-scope', pass: outOfScope.length === 0, tracked, untracked, outOfScope });
const syntax = paths.slice(1).map(path => {
  execFileSync(process.execPath, ['--check', path], { cwd: ROOT, stdio: 'inherit' });
  return path;
});
execFileSync('git', ['diff', '--check', '73dd34e', '--'], { cwd: ROOT, stdio: 'inherit' });
checks.push({ name: 'node-syntax-and-git-diff-check', pass: true, syntax });
for (const check of checks) console.log((check.pass ? 'PASS ' : 'FAIL ') + check.name + ' ' + JSON.stringify(check));
const files = Object.fromEntries(await Promise.all(paths.map(async path =>
  [path, sha256(await readFile(join(ROOT, path)))])));
console.log('SHA256 ' + JSON.stringify(files));
const summary = { passed: checks.filter(check => check.pass).length, failed: checks.filter(check => !check.pass).length };
console.log('SUMMARY ' + JSON.stringify(summary));
await writeFile(output, JSON.stringify({ timestamp: new Date().toISOString(), runs: 1, seed: null,
  baseline: gitRead(['rev-parse', '73dd34e']).trim(), checks, files, summary }, null, 2) + '\n', { flag: 'wx' });
if (summary.failed) process.exitCode = 1;

import { execFileSync, spawn } from 'node:child_process';
import { createWriteStream } from 'node:fs';
import { cp, mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
import { arch, release, tmpdir, version } from 'node:os';
import { basename, dirname, join, resolve } from 'node:path';
import { finished } from 'node:stream/promises';
import { ROOT, gitRead, sha256 } from '../aicls/lib.mjs';

const name = process.argv[2] || 'sol-s2-regressions';
if (!/^[a-zA-Z0-9-]+$/.test(name)) throw new Error('Use a single evidence directory name');
const directory = join(ROOT, 'docs/tasks/T1128-SMOOTH', name);
await mkdir(directory);
const temp = resolve(tmpdir());
const prefix = 'thoradar-sol-s2-regress-';
const scratch = await mkdtemp(join(temp, prefix));
const chrome = 'C:/Program Files/Google/Chrome/Application/chrome.exe';
const chromeVersion = execFileSync('pwsh', ['-NoProfile', '-Command',
  `(Get-Item -LiteralPath '${chrome}').VersionInfo.ProductVersion`], { encoding: 'utf8' }).trim();
const metadata = {
  target: Object.fromEntries(await Promise.all(['index.html', 'sw.js', 'sw-retire.js'].map(async file =>
    [file, sha256(await readFile(join(ROOT, file)))]))),
  baseline: gitRead(['rev-parse', '73dd34e']).trim(),
  environment: { os: version(), release: release(), arch: arch(), node: process.version, chrome: chromeVersion },
  runs: 1,
  seed: null
};

const suites = [
  ['ux', 'tests/ux/ux_probe.mjs', '--base', 'sol-s2'],
  ['aicls', 'tests/aicls/aicls_regress.mjs', '--baseline', 'sols2'],
  ['poolup', 'tests/poolup/poolup_regress.mjs', '--baseline', 'sols2']
];
async function run([name, script, baseArg, label]) {
  const args = [script, '--target', 'index.html', baseArg, '73dd34e', '--label', label];
  const home = join(scratch, name);
  const env = { ...process.env, XREV_SCRATCH: home, AICLS_SCRATCH: home };
  delete env.XREV_ONLY;
  const stdout = join(directory, name + '.stdout.txt');
  const stderr = join(directory, name + '.stderr.txt');
  const stdoutStream = createWriteStream(stdout, { flags: 'wx' });
  const stderrStream = createWriteStream(stderr, { flags: 'wx' });
  const startedAt = new Date().toISOString();
  console.log('RUN node ' + args.join(' '));
  const child = spawn(process.execPath, args, { cwd: ROOT, env, windowsHide: true });
  child.stdout.pipe(stdoutStream);
  child.stderr.pipe(stderrStream);
  const [{ exitCode, signal }] = await Promise.all([
    new Promise((done, fail) => {
      child.once('error', fail);
      child.once('close', (exitCode, signal) => done({ exitCode, signal }));
    }),
    finished(stdoutStream), finished(stderrStream)
  ]);
  const log = await readFile(stdout, 'utf8');
  const endedAt = new Date().toISOString();
  if (name === 'ux') {
    await cp(join(home, 'out-' + label), join(directory, 'ux-measurements'), { recursive: true })
      .catch(error => { if (error.code !== 'ENOENT') throw error; });
  }
  const tests = Array.from(log.matchAll(/^(PASS|FAIL|SKIP)\s+(\S+)\s+(.*)$/gm), ([, result, id, title]) =>
    ({ result, id, title }));
  const summary = Object.fromEntries(['PASS', 'FAIL', 'SKIP'].map(key =>
    [key, tests.filter(test => test.result === key).length]));
  const reportedSummary = log.split(/\r?\n/).find(line => line.includes(' SUMMARY '));
  const result = { ...metadata, scriptSha256: sha256(await readFile(join(ROOT, script))),
    command: ['node', ...args], startedAt, endedAt, exitCode, signal, summary, reportedSummary, tests };
  await writeFile(join(directory, name + '.json'), JSON.stringify(result, null, 2) + '\n');
  console.log(`${name} exit=${exitCode} ${reportedSummary || JSON.stringify(summary)}`);
  return exitCode;
}

const results = await Promise.allSettled(suites.map(run));
for (const result of results) if (result.status === 'rejected') console.error(result.reason);
if (dirname(resolve(scratch)) === temp && basename(scratch).startsWith(prefix)) {
  await rm(scratch, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });
}
if (results.some(result => result.status === 'rejected' || result.value !== 0)) process.exitCode = 1;


