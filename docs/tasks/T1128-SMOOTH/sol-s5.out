name: Deploy to Aliyun OSS

# 迁移役（2026-11-19 起）：每日流水线跑完 → 网站同步到阿里云深圳 OSS（备案接入）
# 手动可触发（workflow_dispatch）＝首次部署/补发；workflow_run 挂在日报管线尾部自动跟发
on:
  workflow_dispatch:
  workflow_run:
    workflows: ["ThorRadar Daily Pipeline"]
    types: [completed]

permissions:
  contents: read

jobs:
  deploy-oss:
    # 日报管线成功才跟发；手动触发不受限
    if: github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Sync site to Aliyun OSS (thoradar-online · cn-shenzhen)
        env:
          OSS_KEY_ID: ${{ secrets.OSS_KEY_ID }}
          OSS_KEY_SECRET: ${{ secrets.OSS_KEY_SECRET }}
          ALIBABA_CLOUD_ACCESS_KEY_ID: ${{ secrets.OSS_KEY_ID }}
          ALIBABA_CLOUD_ACCESS_KEY_SECRET: ${{ secrets.OSS_KEY_SECRET }}
        run: |
          set -e
          # ossutil 走 GitHub 官方发行版 v1.7.18 zip（v1.7.19 无 linux 资产·alicdn 域名美国 runner 不通）
          curl -sL https://github.com/aliyun/ossutil/releases/download/v1.7.18/ossutil-v1.7.18-linux-amd64.zip -o ossutil.zip
          unzip -q ossutil.zip
          mv ossutil-v1.7.18-linux-amd64/ossutil ./ossutil
          chmod +x ossutil
          file ossutil | grep -q ELF || { echo "下载的不是程序："; head -c 200 ossutil; exit 9; }
          ./ossutil --version | head -1
          ./ossutil config -e oss-cn-shenzhen.aliyuncs.com -i "$OSS_KEY_ID" -k "$OSS_KEY_SECRET" -L CH
          # 开桶（幂等：已存在则忽略）
          ./ossutil mb oss://thoradar-online --acl public-read 2>/dev/null || echo "桶已存在，跳过创建"
          # 静态站默认页：v1.7.18 website put 只认 XML 配置文件（--index-page 是幻影旗标，
          # 2>/dev/null || true 曾吞错致根路径 403——2026-11-20 控制台补设＋此处改 XML 正方）
          cat > website.xml <<'XML'
          <?xml version="1.0" encoding="UTF-8"?>
          <WebsiteConfiguration>
            <IndexDocument><Suffix>index.html</Suffix></IndexDocument>
            <ErrorDocument><Key>index.html</Key></ErrorDocument>
          </WebsiteConfiguration>
          XML
          ./ossutil website --method put oss://thoradar-online website.xml
          # 缓存原型（T1127-CACHE-N1）：当日单文件保留原子性；先数据后首页，最后统一精准刷新。
          # 浏览器 5 分钟内直接复用；首页过期后同步校验，多日 JSON 另享 1 小时 fetch 后台更新。
          # CDN 同日长缓存，发布时必须刷新；导航 SWR 已经本地 Chrome 反例排除，不写入首页策略。
          ./ossutil cp -rf --update --meta "Cache-Control:public, max-age=300, s-maxage=86400, stale-while-revalidate=3600" data/radar_latest.json oss://thoradar-online/data/
          ./ossutil cp -rf --update --meta "Cache-Control:public, max-age=300, s-maxage=3600" feed.xml oss://thoradar-online/
          ./ossutil cp -rf --update --meta "Cache-Control:public, max-age=300, s-maxage=3600" api/ oss://thoradar-online/api/
          ./ossutil cp -rf --update --meta "Cache-Control:public, max-age=86400, s-maxage=604800" favicon.ico oss://thoradar-online/
          # sitemap lastmod 部署时现打当日戳（Hydrogen 11-20 审出死日期 2026-11-08 滞留）
          sed -i "s|<lastmod>[^<]*</lastmod>|<lastmod>$(date -u +%Y-%m-%d)</lastmod>|" sitemap.xml
          ./ossutil cp -rf --update --meta "Cache-Control:public, max-age=3600, s-maxage=86400" robots.txt oss://thoradar-online/
          ./ossutil cp -rf --update --meta "Cache-Control:public, max-age=3600, s-maxage=86400" sitemap.xml oss://thoradar-online/
          ./ossutil cp -rf --update thoradar-skill/ oss://thoradar-online/thoradar-skill/
          # 首页最后上传；当日 SITE_DATA 仍只在这一份文件内，不建立第二份真相。
          ./ossutil cp -rf --update --meta "Cache-Control:public, max-age=300, s-maxage=86400" index.html oss://thoradar-online/
          # 开门＝桶级公共读（控制台定版，对象继承 ACL）——逐件 setacl 按 6.2/Hydrogen 双席审读裁撤
          # （v1.7.18 无 setacl 命令·对象继承桶权限已实测 200）
          echo "=== 同步完成，桶内对象数："
          ./ossutil ls oss://thoradar-online/ | tail -2
          # 长 CDN 缓存的必要配套：精准刷新失败即发布失败；重试一次后交 PI 处理，禁止假报完成。
          echo "=== CDN 精准刷新（官方 CLI v3.5.4，固定版本与 SHA-256）"
          mkdir -p .cache-tools/aliyun
          curl -fsSL https://github.com/aliyun/aliyun-cli/releases/download/v3.5.4/aliyun-cli-linux-3.5.4-amd64.tgz -o .cache-tools/aliyun/cli.tgz
          echo "e1eefcbbe9d772d61f770d4af8595e7297e081a0348b096765d2c41e581c3e72  .cache-tools/aliyun/cli.tgz" | sha256sum -c -
          tar -xzf .cache-tools/aliyun/cli.tgz -C .cache-tools/aliyun
          chmod +x .cache-tools/aliyun/aliyun
          urls=$(printf '%s\n' \
            'https://thoradar.online/' \
            'https://thoradar.online/index.html' \
            'https://www.thoradar.online/' \
            'https://www.thoradar.online/index.html' \
            'https://thoradar.online/data/radar_latest.json' \
            'https://thoradar.online/feed.xml')
          refresh_ok=0
          for attempt in 1 2; do
            echo "CDN RefreshObjectCaches 第 $attempt 次"
            if .cache-tools/aliyun/aliyun cdn RefreshObjectCaches --region cn-shenzhen --ObjectType File --ObjectPath "$urls" >cdn-refresh.json 2>cdn-refresh.err; then
              if python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d.get("RefreshTaskId")' cdn-refresh.json; then
                cat cdn-refresh.json
                refresh_ok=1
                break
              fi
            fi
            cat cdn-refresh.err
            if [ "$attempt" -eq 1 ]; then sleep 5; fi
          done
          if [ "$refresh_ok" != 1 ]; then echo "✗ CDN 精准刷新失败：不得宣称发布完成"; exit 1; fi
          # 刷新后最多轮询 60 秒：Content-MD5 必须切到刚上传版本，防旧首页/旧档案继续命中。
          check_md5() {
            local url="$1" file="$2" expected actual attempt
            expected=$(openssl dgst -md5 -binary "$file" | openssl base64 -A)
            for attempt in {1..12}; do
              actual=$(curl -sSI -H 'Accept-Encoding: identity' --connect-timeout 15 --max-time 60 "$url" | tr -d '\r' | awk 'tolower($1)=="content-md5:"{print $2}' | tail -1)
              if [ "$actual" = "$expected" ]; then echo "$url Content-MD5 已更新 ✅"; return 0; fi
              sleep 5
            done
            echo "✗ $url Content-MD5 未在 60 秒内切换（期望 $expected，实际 ${actual:-缺失}）"
            return 1
          }
          check_md5 'https://thoradar.online/' index.html
          check_md5 'https://www.thoradar.online/' index.html
          check_md5 'https://thoradar.online/data/radar_latest.json' data/radar_latest.json
          # 验锁闸：逼流量走 CNAME 目标实测 HTTPS（DNS 切换前后都成立；证书/绑定/静态页回归＝部署判红）
          # 双域逐验＋严格断言 http_code==200（Sol 11-20 审出：curl -sf 连 304 也放行还谎报 200）
          echo "=== HTTPS 预检（SNI=域名 → CNAME 目标）"
          for h in thoradar.online www.thoradar.online; do
            code=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 15 \
              --connect-to "$h:443:thoradar-online.cn-shenzhen.taihangtop.cn:443" \
              "https://$h/")
            if [ "$code" != "200" ]; then echo "✗ $h 根路径 HTTPS $code（期望 200）"; exit 1; fi
            echo "$h 根路径 HTTPS 200 ✅"
          done


