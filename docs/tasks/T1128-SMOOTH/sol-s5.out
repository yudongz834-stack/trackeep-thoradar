@'
import difflib
import subprocess
from pathlib import Path

workflow = '.github/workflows/deploy_oss.yml'
source = 'tests/smooth/verify-source.mjs'
files = [workflow, source, 'tests/smooth/verify-deploy.mjs', 'tests/smooth/deploy-mock.mjs']
parts = []
for name in files:
    raw = Path(name).read_text(encoding='utf-8')
    if name == workflow:
        old = subprocess.check_output(['git', 'show', 'HEAD:' + name]).decode('utf-8').replace('\\r\\n', '\\n')
    elif name == source:
        entry = \", '.github/workflows/deploy_oss.yml'\"
        assert raw.count(entry) == 1
        old = raw.replace(entry, '')
    else:
        old = ''
    parts.append(f'diff --git a/{name} b/{name}\\n')
    if not old:
        parts.append('new file mode 100644\\n')
    parts.extend(difflib.unified_diff(old.splitlines(keepends=True), raw.splitlines(keepends=True),
                 fromfile=f'a/{name}' if old else '/dev/null', tofile=f'b/{name}'))
Path('docs/tasks/T1128-SMOOTH/sol-s5/candidate.diff').write_bytes(''.join(parts).encode())
