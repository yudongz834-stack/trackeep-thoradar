      const tabs = matches.filter(e => label(e) === '策略内容' && (e.matches('[role=tab],button,a') || e.tabIndex >= 0));
      const editors = elements('pre,code,textarea,.monaco-editor,.view-lines,.ace_editor,.cm-editor').map(e => ({
