          urls=()
          for h in "${domains[@]}"; do
            for path in "${paths[@]}"; do urls+=("https://$h$path"); done
          done
          # 实测本账号 CDN 只登记 thoradar.online；www 不属本账号，混入会整批 InvalidDomain.NotFound。
          # 只刷新可管理域，www 仍必须在下方独立通过同一 MD5 验证，内容陈旧即发布失败。
          refresh_paths=$(printf 'https://thoradar.online%s\n' "${paths[@]}")
          refresh_id=''
          for attempt in 1 2; do
            echo "CDN RefreshObjectCaches attempt $attempt"
            if refresh_id=$(
              "$aliyun" cdn RefreshObjectCaches --region cn-shenzhen --ObjectType File --ObjectPath "$refresh_paths" |
                python3 -c 'import json, sys; value = json.load(sys.stdin).get("RefreshTaskId");
          if type(value) not in (str, int) or not value or not str(value).strip(): sys.exit(1)
          print(json.dumps(value))'
            ); then
              echo "CDN RefreshTaskId=$refresh_id"
              break
            fi
            if [[ "$attempt" == 2 ]]; then
              echo 'CDN refresh failed or returned no RefreshTaskId' >&2
              exit 1
            fi
            sleep 5
          done

          verify_object() {
            local url="$1" source="$2" worker="$3" expected headers result attempt
            expected=$(openssl dgst -md5 -binary "$source" | openssl base64 -A)
            for attempt in {1..12}; do
              if headers=$(curl -sS -I -H 'Accept-Encoding: identity' --connect-timeout 5 --max-time 10 "$url"); then
                if result=$(awk -v expected="$expected" -v worker="$worker" '
                  { sub(/\r$/, "") }
                  /^HTTP\// { status=$2; md5=""; mime=""; cache=""; next }
                  tolower($0) ~ /^content-md5:/ { md5=$0; sub(/^[^:]+:[ \t]*/, "", md5); sub(/[ \t]+$/, "", md5) }
                  tolower($0) ~ /^content-type:/ { mime=tolower($0); sub(/^[^:]+:[ \t]*/, "", mime); sub(/([ \t]*;.*|[ \t]+)$/, "", mime) }
                  tolower($0) ~ /^cache-control:/ { line=tolower($0); sub(/^[^:]+:[ \t]*/, "", line); cache=cache "," line }
                  END {
                    printf "HTTP=%s Content-MD5=%s expected=%s MIME=%s Cache-Control=%s", status, md5, expected, mime, cache
                    if (status != 200 || md5 != expected) exit 1
                    if (worker && (mime !~ /^(application|text)\/(javascript|ecmascript)$/ || cache !~ /,[ \t]*no-store[ \t]*(,|$)/)) exit 1
                  }
                ' <<< "$headers"); then
                  echo "Verified $url $result"
                  return 0
                fi
              else
                result='HEAD request failed'
              fi
              echo "Waiting for $url ($attempt/12) $result"
              # CDN 刷新从提交到生效约需 5–6 分钟。两次短等后拉长间隔，末次至少在 370 秒后。
              if (( attempt <= 2 )); then
                sleep 5
              elif (( attempt < 12 )); then
                sleep 40
              fi
            done
            echo "Verification failed for $url" >&2
            return 1
          }

          for url in "${urls[@]}"; do
            case "$url" in
              */sw.js) verify_object "$url" "$active_worker" 1 ;;
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { chmod, copyFile, mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const [output, candidate] = process.argv.slice(2);
if (!output) throw new Error('Usage: node tests/smooth/verify-deploy.mjs <result.json> [workflow.yml]');

const root = fileURLToPath(new URL('../../', import.meta.url));
const workflow = resolve(candidate || join(root, '.github/workflows/deploy_oss.yml'));
const yaml = (await readFile(workflow, 'utf8')).replace(/\r\n/g, '\n');
const windows = process.platform === 'win32';
const gitBash = join(process.env.ProgramFiles || 'C:/Program Files', 'Git/bin/bash.exe');
const bash = windows && existsSync(gitBash) ? gitBash : 'bash';
const tests = [];

async function test(name, run) {
  try {
    await run();
    tests.push({ name, pass: true });
  assert.ok(installStep.indexOf(checksum) > installStep.indexOf(download));
  assert.ok(installStep.indexOf('tar -xzf aliyun/cli.tgz') > installStep.indexOf(checksum));
  assert.doesNotMatch(installStep, /secrets\./);
});

const localEnv = {};
for (const key of ['PATH', 'SystemRoot', 'COMSPEC', 'PATHEXT', 'TEMP', 'TMP', 'TMPDIR']) {
  if (process.env[key] !== undefined) localEnv[key] = process.env[key];
}
const bashPath = path => windows ? path.replaceAll('\\', '/') : path;
const scratch = await mkdtemp(join(tmpdir(), 'thoradar-s5-deploy-'));
const simulations = {};
const shellRuns = {};
const domains = ['thoradar.online', 'www.thoradar.online'];
const urls = domains.flatMap(domain => ['/', '/index.html', '/sw.js', '/sw-retire.js'].map(path => `https://${domain}${path}`));
const refreshUrls = urls.filter(url => new URL(url).hostname === 'thoradar.online');
const workerMeta = 'Content-Type:application/javascript#Cache-Control:no-store';
const origin = 'oss://thoradar-online/';
const publishComplete = 'Publish verified on both domains';

function bashRun(args, options = {}) {
  const run = spawnSync(bash, ['--noprofile', '--norc', ...args], {
    cwd: scratch, env: localEnv, encoding: 'utf8', windowsHide: true, timeout: 60000, ...options
  });
  if (run.error) throw run.error;
  return { status: run.status, stdout: run.stdout, stderr: run.stderr };
}

async function mockCommand(path, tool) {
  const command = `#!/usr/bin/env bash\nexec "$SMOOTH_MOCK_NODE" "$SMOOTH_MOCK_SCRIPT" ${tool} "$@"\n`;
  await writeFile(path, command);
  await chmod(path, 0o755);
}

async function simulate(scenario, retire = false) {
  const label = retire ? `${scenario}-retire` : scenario;
  const trace = join(scratch, `trace-${label}.jsonl`);
  await writeFile(trace, '');
  const env = { ...localEnv, MSYS2_ARG_CONV_EXCL: '*', RUNNER_TEMP: bashPath(scratch),
    OSS_KEY_ID: 'mock-id', OSS_KEY_SECRET: 'mock-secret',
    ALIBABA_CLOUD_ACCESS_KEY_ID: 'mock-id', ALIBABA_CLOUD_ACCESS_KEY_SECRET: 'mock-secret',
    SMOOTH_RETIRE: String(retire), SMOOTH_MOCK_SCENARIO: scenario,
    SMOOTH_MOCK_NODE: bashPath(process.execPath), SMOOTH_MOCK_SCRIPT: fileURLToPath(new URL('./deploy-mock.mjs', import.meta.url)),
    SMOOTH_MOCK_TRACE: trace };
  const script = join(scratch, 'publish.sh');
  const run = bashRun([bashPath(script)], { env });
  const calls = (await readFile(trace, 'utf8')).trim().split('\n').filter(Boolean).map(line => JSON.parse(line));
  simulations[label] = { ...run, calls };
  return { ...run, calls, uploads: calls.filter(call => call.tool === 'ossutil' && call.args[0] === 'cp').map(call => call.args),
    refreshes: calls.filter(call => call.tool === 'aliyun').map(call => call.args),
    heads: calls.filter(call => call.tool === 'curl' && call.args.includes('-I')).map(call => call.args.at(-1)) };
}

function success(run) {
  assert.equal(run.status, 0, run.stderr);
  assert.ok(run.stdout.includes(publishComplete));
}

function failure(run, message) {
  assert.notEqual(run.status, 0, 'deployment exited 0');
  assert.match(run.stderr, message);
  assert.ok(!run.stdout.includes(publishComplete));
}

try {
  let deployScript;
  await test('Bash syntax for tool installation and production publish', () => {
    deployScript = shellBlock(deployStep);
    for (const [name, input] of [['install', shellBlock(installStep)], ['publish', deployScript]]) {
      const run = bashRun(['-n'], { input });
      shellRuns[name] = run;
      assert.equal(run.status, 0, run.stderr);
    }
  });
  assert.ok(deployScript, 'cannot simulate an absent publish step');
  const bin = join(scratch, 'bin');
  const aliyun = join(scratch, 'aliyun');
  await mkdir(bin);
  await mkdir(aliyun);
import fs from 'node:fs/promises';

const dir = 'D:/claude-tmp';
const target = '[target-redacted]';
const host = 'ram.console.aliyun.com';
const policy = 'ThoradarCDNRefreshOnly';
const action = 'cdn:RefreshObjectCaches';
const run = '[redacted]';
const command = process.argv[2];
const fail = code => { throw new Error(code); };

const source = JSON.parse((await fs.readFile(dir + '/thoradar-cdn-refresh-only.json', 'utf8')).replace(/^\uFEFF/, ''));
const list = value => Array.isArray(value) ? value : [value];
const owner = /^acs:cdn:\*:(\d+):domain\/thoradar\.online$/.exec(list(source.Statement?.[0]?.Resource)[0])?.[1];
const resource = owner && 'acs:cdn:*:' + owner + ':domain/thoradar.online';
const policyShape = doc => {
  const fields = (value, keys) => !!value && !Array.isArray(value) && typeof value === 'object' && Object.keys(value).sort().join(',') === keys;
  const oneStatement = Array.isArray(doc?.Statement) && doc.Statement.length === 1;
  const statement = oneStatement && doc.Statement[0];
  return {
    versionAndKeysExact: fields(doc, 'Statement,Version') && doc.Version === '1',
    oneStatement,
    statementKeysExact: fields(statement, 'Action,Effect,Resource'),
    effectExact: statement?.Effect === 'Allow',
    actionExact: list(statement?.Action).length === 1 && list(statement?.Action)[0] === action,
    resourceExact: !!resource && list(statement?.Resource).length === 1 && list(statement?.Resource)[0] === resource
  };
};

async function releaseIdentity() {
  const log = (await fs.readFile(dir + '/T1128-deploy-failed-r5.log', 'utf8')).replace(/\\+"/g, '"');
  const watch = await fs.readFile(dir + '/T1128-deploy-watch-r5.txt', 'utf8');
  const values = key => [...new Set(Array.from(log.matchAll(new RegExp('\\b' + key + ':([^\\s\\]]+)', 'g')), hit => hit[1]))];
  const names = values('[target-redacted]');
  const proof = {
    run,
    watchHasRun: new RegExp('\\b' + run + '\\b').test(watch),
    forbiddenRAM: /\bForbidden\.RAM\b/.test(log),
    refreshAction: values('AuthAction').join() === action,
    subuser: values('AuthPrincipalType').join() === 'SubUser',
    implicitDeny: values('NoPermissionType').join() === 'ImplicitDeny',
    principalCount: names.length,
    ownerMatches: !!owner && values('AuthPrincipalOwnerId').join() === owner,
    sourcePolicyExact: Object.values(policyShape(source)).every(Boolean)
  };
  proof.identityJoinReady = Object.entries(proof).every(([key, value]) => key === 'run' || (key === 'principalCount' ? value === 1 : value === true));
  return {proof, principal: proof.identityJoinReady ? names[0] : null};
}

async function proxy(route, body) {
  const response = await fetch('http://127.0.0.1:3456/' + route + '?target=' + target,
    {method: body === undefined ? 'GET' : 'POST', body, signal: AbortSignal.timeout(10000)});
  let json;
  try { json = await response.json(); } catch { fail('proxy_' + route + '_invalid_response'); }
  if (!response.ok || json.error) fail('proxy_' + route + '_http_' + response.status);
  return json;
}

const helpers = String.raw`
const visible = e => !!(e?.getClientRects().length && getComputedStyle(e).visibility === 'visible');
const elements = (selector, parent = document) => [...parent.querySelectorAll(selector)].filter(visible);
const label = e => (e?.innerText || e?.getAttribute('aria-label') || e?.title || '').replace(/\s+/g, ' ').trim();
const exact = (text, parent = document, selector = 'button,a,[role=tab],[role=button]') => elements(selector, parent).filter(e => label(e) === text);
const loading = () => elements('[aria-busy=true],.ant-spin-spinning,.next-loading-tip,[class*="loading-mask"]').length;
const modal = () => elements('[role=dialog],.next-dialog,.ant-modal,.next-drawer,[class*="drawer-wrapper"]');
const isChallengeText = s => /短信验证|扫码验证|二次认证|身份验证|重新登录|安全验证|验证身份|安全校验|滑块验证|手机验证|二次验证|多因素认证|证件号码|人机验证|请完成验证|verify your identity/i.test(s);
const challenge = () => elements('h1,h2,h3,[role=dialog],[class*="dialog-title"],[class*="modal-title"],[class*="verify-title"]').some(e => isChallengeText(label(e))) ||
  elements('iframe[id*="captcha" i],iframe[src*="captcha" i],iframe[src*="verify" i],iframe[src*="sec.aliyun" i],[class*="captcha" i],[class*="nc-container"]').length > 0;
const tableRows = (parent = document) => elements('tbody tr,[role=rowgroup] [role=row]', parent).filter(row => !row.querySelector('th,[role=columnheader]'));
const cellLabels = row => elements('td,[role=cell],[role=gridcell]', row).map(label);
const equalTexts = (a,b) => a.length === b.length && a.every((item,i) => item === b[i]);
const setInput = (input, value) => {
  Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(input, value);
  input.dispatchEvent(new Event('input', {bubbles:true}));
  input.dispatchEvent(new Event('change', {bubbles:true}));
};
const simplePath = href => {
  try {
    const url = new URL(href, location.href);
