    'if(location.origin!=="https://' + host + '") return JSON.stringify({error:"unexpected_origin"});' +
    'if(challenge()) return JSON.stringify({challenge:true});' +
    'if (!(' + JSON.stringify(allowed) + ').some(path=>path.endsWith("*")?location.pathname.startsWith(path.slice(0,-1)):location.pathname===path)) return JSON.stringify({error:"unexpected_ram_route"});' +
    'return JSON.stringify({challenge:false, ...(' + fn.toString() + ')()});})()';
  const reply = await proxy('eval', source);
  if (typeof reply.value !== 'string') fail('page_evaluation_failed');
  const result = JSON.parse(reply.value);
  if (result.error) fail(result.error);
  return result;
}

const detailPath = ['/policies/detail'];
const usersPath = ['/users', '/users/*'];
let result;
try {
