import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
const dir = process.argv[2];
const read = file => JSON.parse(readFileSync(dir + '/' + file + '.json', 'utf8'));
const good = read('deploy');
const apex = read('apex-only');
const noMd5 = read('without-md5-gate');
assert.deepEqual(good.summary, { passed: 18, failed: 0 });
assert.deepEqual(apex.summary, { passed: 16, failed: 2 });
assert.deepEqual(noMd5.summary, { passed: 16, failed: 2 });
const expected = ['thoradar.online', 'www.thoradar.online'].flatMap(host =>
  ['/', '/index.html', '/sw.js', '/sw-retire.js'].map(file => 'https://' + host + file));
const emit = value => console.log(JSON.stringify(value));
for (const scenario of ['healthy', 'healthy-retire']) {
  const calls = good.simulations[scenario].calls;
  const refreshes = calls.filter(x => x.tool === 'aliyun');
  assert.equal(refreshes.length, 1);
  const request = refreshes[0].args.at(-1).split('\\n');
  const observedHeads = calls.filter(x => x.tool === 'curl' && x.args.includes('-I')).map(x => x.args.at(-1));
  assert.deepEqual(request, expected);
  assert.deepEqual(observedHeads, expected);
  emit({ scenario, refreshRequests: refreshes.length, request, orderedVerificationMatches: true });
}
const waits = good.simulations['stale-during-propagation-retire'].calls.filter(x => x.tool === 'sleep').map(x => Number(x.args[0]));
assert.deepEqual(waits, [5, 5, ...Array(9).fill(40)]);
emit({ scenario: 'stale-during-propagation-retire', waits, seconds: waits.reduce((total, wait) => total + wait, 0) });
const wrong = good.simulations['wrong-md5-retire'];
assert.equal(wrong.status, 1);
assert.match(wrong.stderr, /Verification failed for https:\\/\\/www\\.thoradar\\.online\\/sw\\.js/);
assert.equal(noMd5.simulations['wrong-md5-retire'].status, 0);
emit({ scenario: 'wrong-md5-retire', workflowExit: wrong.status, stderr: wrong.stderr.trim(), mutatedWorkflowExit: noMd5.simulations['wrong-md5-retire'].status });
for (const [label, result] of [['deploy', good], ['apex-only', apex], ['without-md5-gate', noMd5]]) {
  emit({ label, summary: result.summary, failures: result.tests.filter(test => "'!test.pass).map(test => test.name) });
}
