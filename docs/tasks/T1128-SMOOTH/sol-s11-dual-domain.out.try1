    return url.pathname.split('/').map((part,i) => i === 0 || /^(users|policies|detail|identities|permissions|accounts|summary)$/.test(part) ? part : '[part]').join('/');
  } catch { return null; }
};
const signedPolicy = url => url.pathname === '/policies/detail' &&
  url.searchParams.get('policyType') === 'Custom' && url.searchParams.get('policyName') === arg.policy;
`;

async function ui(fn, allowed, args = {}) {
  const info = await proxy('info');
  const url = new URL(info.url);
  if (url.hostname !== host && /(?:^|\.)(?:aliyun\.com|alibabacloud\.com)$/.test(url.hostname) &&
      /login|signin|passport|sec|captcha|verify|auth|account/i.test(url.hostname.split('.')[0])) return {challenge:true};
  if (url.origin !== 'https://' + host) fail('named_target_outside_ram_console');
