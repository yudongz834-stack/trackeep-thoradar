  !path.startsWith('tests/smooth/') && !path.startsWith('docs/tasks/T1128-SMOOTH/'));
checks.push({ name: 'write-scope', pass: outOfScope.length === 0, tracked, untracked, outOfScope });
const syntax = paths.slice(1).map(path => {
