149:        sec('F2b','F2b 阅读视图点击展开、再点收起');check(vis(s5)&&s5.filters.display==='grid',`阅读展开后筛选区应可见（grid）；实得 display=${s5.filters.display} h=${s5.filters.h} cols=${s5.filters.cols}`);check(!vis(s6),`再点应收起；实得 display=${s6.filters.display}`);check(vis(s7),'再点应重新展开');note(`展开：${s5.filters.w}×${s5.filters.h}px，列=${s5.filters.cols}；首屏全见阅读卡 收起 ${s4.queue.full} 张 → 展开 ${s5.queue.full} 张`);L.end();
150:        sec('F2c','F2c 概览默认收起、点击展开后再收起，队列空间随动作增减');check(s0.view==='overview'&&!vis(s0),`概览缺省应收起筛选区；实得 display=${s0.filters.display}`);check(vis(s1)&&vis(s3),`概览点钮应展开；实得 A1 display=${s1.filters.display}／A3 display=${s3.filters.display}`);check(!vis(s2),'概览再点应收起');check(s2.queue.full>s1.queue.full,`收起后全见条目应增多：展开 ${s1.queue.full} 条 → 收起 ${s2.queue.full} 条`);note(`1440×714 队列全见条目：展开 ${s1.queue.full}（另 ${s1.queue.half} 条半截）→ 收起 ${s2.queue.full}（另 ${s2.queue.half} 条半截）｜列表可视高 ${s1.queue.list.h}px → ${s2.queue.list.h}px`);L.end();
151:        sec('F2d','F2d 双视图各自保留展开选择，切页不错位');check(!vis(s4),'首次进阅读应默认收起');check(vis(s8)&&s8.view==='overview','阅读展开时切概览，应恢复概览此前的展开态');check(vis(s9),`阅读此前已展开，切回后应仍展开；实得 display=${s9.filters.display}`);L.end();
152:        sec('F2e','F2e 刷新后回到双视图默认收起（不把临时展开态持久化）');check(s10.view==='overview'&&!vis(s10)&&s10.filtersOpen===false&&s10.toggle.txt===s0.toggle.txt,`刷新后应回概览且筛选收起；实得 view=${s10.view} filtersOpen=${s10.filtersOpen} 钮「${s10.toggle.txt}」`);note(`刷新后：概览、筛选区 display=${s10.filters.display}、钮「${s10.toggle.txt}」、队列全见 ${s10.queue.full} 条（首屏 ${s0.queue.full} 条）`);L.end();
153:        sec('F2f','F2f 折叠钮标签与筛选区实际状态一致（钮写「收起筛选」当且仅当筛选区正开着）');check(mismatch.length===0,`标签与实际状态错位 ${mismatch.length} 步：${mismatch.map(m=>`${m.n}[${m.view}] 筛选区${m.filtersVisible?'开着':'收着'}而钮写「${m.label}」`).join('；')}`);L.end();
