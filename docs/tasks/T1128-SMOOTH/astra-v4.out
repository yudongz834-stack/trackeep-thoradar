diff --git a/docs/tasks/T1128-SMOOTH/astra-v4/daily.py b/docs/tasks/T1128-SMOOTH/astra-v4/daily.py
new file mode 100644
index 0000000000000000000000000000000000000000..9842423800fd5c91a2d80072f6e454c85b71323c
--- /dev/null
+++ b/docs/tasks/T1128-SMOOTH/astra-v4/daily.py
@@ -0,0 +1,127 @@
+"""Build private Git history and replay daily gates entirely offline."""
+from run import BASE, FILES, FIX, HERE, OUT, ROOT, check, data, data_parts, digest, git, invoke, normalize, save, suite, ux
+import json
+import re
+import shutil
+import sys
+
+def fgit(label, *args):
+    return check(label, ["git", "-c", "core.hooksPath=NUL", "-c", "commit.gpgsign=false",
+        "-c", "user.name=A4 fixture", "-c", "user.email=a4@example.invalid", *args], FIX)
+
+def result(name):
+    return json.loads((OUT / (name + ".json")).read_text(encoding="utf-8"))
+
+def source(name, code, ci=True):
+    run = suite(name, "source", FIX, *(["--ci"] if ci else []))
+    assert run.returncode == code, name
+    return {c["name"]: c for c in result(name)["checks"]}
+
+def prep(name, target):
+    head = git("rev-parse", "HEAD", cwd=FIX).decode().strip()
+    check(name, ["node", "tests/smooth/prepare-ci-ux-baseline.mjs", head, target], FIX)
+
+def make_fixture():
+    assert not FIX.exists()
+    check("clone-fixture", ["git", "clone", "--shared", "--no-checkout", str(ROOT), str(FIX)])
+    fgit("remove-local-origin", "remote", "remove", "origin")
+    fgit("select-initial-parent", "switch", "--detach", BASE + "^")
+    for name in FILES:
+        if name not in ("index.html", ".github/workflows/daily_thoradar.yml", "tests/aicls/lib.mjs"):
+            (FIX/name).parent.mkdir(exist_ok=True, parents=True)
+            shutil.copyfile(ROOT/name, FIX/name)
+    # The historical edition uses exactly the old data contract, with the release candidate shell.
+    before, current_block, after = data_parts(normalize((ROOT/"index.html").read_bytes()))
+    _, old_block, _ = data_parts(git("show", BASE+"^:index.html"))
+    marker = b'<meta name="a4-parent-only" content="independent-shell-witness">'
+    assert before.count(b"</head>") == 1 and marker not in before and current_block != old_block
+    parent_page = before.replace(b"</head>", marker+b"\n</head>")+old_block+after
+    (FIX/"index.html").write_bytes(parent_page)
+    fgit("stage-parent", "add", "-A")
+    fgit("commit-parent", "commit", "-m", "A4 isolated parent with November 27 data and shell witness")
+    assert all(c["pass"] for c in source("source-local-old", 0, False).values())
+    paths = git("diff", "--name-only", BASE+"^", BASE).decode().splitlines()
+    assert len(paths) == 16 and "index.html" in paths
+    for name in paths:
+        (FIX/name).parent.mkdir(exist_ok=True,parents=True)
+        if name == "index.html":
+            shutil.copyfile(ROOT/name, FIX/name)
+        else:
+            (FIX/name).write_bytes(git("show", BASE+":"+name))
+    fgit("stage-daily", "add", "--", *paths)
+    fgit("commit-daily", "commit", "-m", "A4 replay November 28 release and fifteen historical daily objects")
+    assert not fgit("daily-status", "status", "--porcelain")
+    assert fgit("daily-paths", "diff", "--name-only", "HEAD^", "HEAD").decode().splitlines() == paths
+    for p in paths:
+        if p != "index.html":
+            assert git("rev-parse", "HEAD:"+p, cwd=FIX) == git("rev-parse", BASE+":"+p)
+    ci = source("source-ci-daily", 0)
+    assert ci["official-data"]["paperCount"] == 43 and ci["write-scope"]["outOfScope"] == []
+    assert all(ci["write-scope"][k] == [] for k in ("tracked", "untracked"))
+    baseline = HERE/"prepared.html"
+    prep("prepare-daily", baseline)
+    pb, pd, pa = data_parts(git("show","HEAD^:index.html",cwd=FIX))
+    cb, cd, ca = data_parts(git("show","HEAD:index.html",cwd=FIX))
+    actual = normalize(baseline.read_bytes())
+    assert actual == pb+cd+pa and actual != cb+cd+ca and marker in pb and marker not in cb
+    save("baseline-oracle", dict(parent=git("rev-parse","HEAD^",cwd=FIX).decode().strip(),
+        current=git("rev-parse","HEAD",cwd=FIX).decode().strip(), expected=digest(pb+cd+pa),
+        prepared=digest(actual), currentAsBaseline=digest(cb+cd+ca), oldBlock=digest(pd),
+        newBlock=digest(cd), parentWitnessInBaseline=marker in actual, parentWitnessInTarget=marker in cb+cd+ca,
+        paths=paths, identicalNonHtmlBlobs=15))
+    assert source("source-strict-daily", 1, False)["official-data"]["pass"] is False
+    page = FIX/"index.html"
+    backup = HERE/"restore-page.bin"
+    shutil.copyfile(page, backup)
+    for name, anchor, edit in [("bad-json", b'"briefing_date":"2026-11-28"', b'"briefing_date":!'),
+                               ("bad-date", b'"briefing_date":"2026-11-28"', b'"briefing_date":"2026-02-30"')]:
+        try:
+            changed = backup.read_bytes()
+            assert anchor in changed
+            page.write_bytes(changed.replace(anchor, edit, 1))
+            assert not source("source-ci-"+name, 1)["official-data"]["pass"]
+        finally:
+            shutil.copyfile(backup, page)
+    feed = FIX/"feed.xml"
+    feedcopy = HERE/"restore-feed.bin"
+    shutil.copyfile(feed,feedcopy)
+    try:
+        feed.write_bytes(feedcopy.read_bytes()+b"\n<!-- A4 local delta -->\n")
+        assert source("source-ci-dirty", 1)["write-scope"]["outOfScope"] == ["feed.xml"]
+        fgit("stage-dirty-feed","add","--","feed.xml")
+        shutil.copyfile(feedcopy, feed)
+        assert source("source-ci-staged", 1)["write-scope"]["outOfScope"] == ["feed.xml"]
+    finally:
+        shutil.copyfile(feedcopy,feed)
+        fgit("restore-private-index","add","--","feed.xml")
+    assert not fgit("clean-after-negatives","status","--porcelain")
+
+def sparse_day():
+    # Keep today's official registries and app code, replay an actual two-paper issue.
+    current = normalize((ROOT/"index.html").read_bytes())
+    before, block, after = data_parts(current)
+    small = data(git("show","7feecfa:index.html"))
+    assert small["briefing_date"] == "2026-11-02" and len(small["papers"]) == 2
+    current_data = data(current)
+    for k in ("generated_at","briefing_date","funnel","papers"):
+        current_data[k] = small[k]
+    payload = json.dumps(current_data,ensure_ascii=False,separators=(",",":")).encode()
+    newblock, count = re.subn(rb"(const SITE_DATA\s*=\s*)\{.*\}(\s*;)", lambda m:m[1]+payload+m[2],block,flags=re.S)
+    assert count == 1
+    (FIX/"index.html").write_bytes(before+newblock+after)
+    fgit("stage-small","add","--","index.html")
+    fgit("commit-small","commit","-m","A4 replay two genuine November 2 papers with current registries")
+    assert not fgit("small-status","status","--porcelain")
+    assert source("source-ci-small", 0)["official-data"]["paperCount"] == 2
+    baseline = HERE/"prepared-small.html"
+    prep("prepare-small", baseline)
+    assert normalize(baseline.read_bytes()) == normalize((FIX/"index.html").read_bytes())
+    save("small-oracle", dict(historicalCommit=git("rev-parse","7feecfa").decode().strip(),
+        historicalDate=small["briefing_date"], paperCount=len(small["papers"]), replacedFields=["generated_at","briefing_date","funnel","papers"],
+        shellBeforeSha256=digest(before+after), preparedEqualsTarget=True))
+    return ux("ux-ci-small",FIX,"--base-html",baseline).returncode
+
+if __name__ == "__main__":
+    if sys.argv[1] == "fixture": make_fixture()
+    elif sys.argv[1] == "daily-ux": sys.exit(ux("ux-ci-daily",FIX,"--base-html",HERE/"prepared.html").returncode)
+    elif sys.argv[1] == "small": sys.exit(sparse_day())
diff --git a/docs/tasks/T1128-SMOOTH/astra-v4/run.py b/docs/tasks/T1128-SMOOTH/astra-v4/run.py
new file mode 100644
index 0000000000000000000000000000000000000000..2296141d6526d0b21eb4358fadf1d91a064a43f8
--- /dev/null
+++ b/docs/tasks/T1128-SMOOTH/astra-v4/run.py
@@ -0,0 +1,115 @@
+"""T1128-SMOOTH-A4 local evidence collector. Run from the supplied checkout."""
+import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[3]
+OUT = HERE / "evidence"
+OUT.mkdir(exist_ok=True)
+FIX = HERE / "private-repo"
+BASE = "28131f314f92a05227fd5923607d717c426da2c5"
+WF = ".github/workflows/deploy_oss.yml"
+FILES = ["index.html", "sw.js", "sw-retire.js", WF, ".github/workflows/daily_thoradar.yml",
+         "tests/aicls/lib.mjs", "tests/ux/ux_probe.mjs",
+         *(p.relative_to(ROOT).as_posix() for p in sorted((ROOT / "tests/smooth").glob("*.mjs")))]
+ENV = {k: os.environ[k] for k in ("PATH", "SystemRoot", "WINDIR", "COMSPEC", "PATHEXT", "TEMP",
+       "TMP", "ProgramFiles", "ProgramFiles(x86)", "LOCALAPPDATA", "USERPROFILE", "SystemDrive")
+       if k in os.environ}
+
+def digest(b):
+    return hashlib.sha256(b).hexdigest()
+
+def save(name, record):
+    (OUT / (name + ".json")).write_text(json.dumps(record, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+
+def invoke(name, cmd, cwd=ROOT, extra=None):
+    cmd = list(map(str, cmd))
+    begin = datetime.datetime.now(datetime.timezone.utc)
+    record = {"cwd": str(cwd), "argv": cmd, "startUtc": begin.isoformat(), "runs": 1, "seed": None}
+    run = subprocess.run(cmd, cwd=cwd, env={**ENV, **(extra or {})}, capture_output=True)
+    for ext, raw in [("stdout", run.stdout), ("stderr", run.stderr)]:
+        (OUT / f"{name}.{ext}.txt").write_bytes(raw)
+    record.update(exit=run.returncode, endUtc=datetime.datetime.now(datetime.timezone.utc).isoformat())
+    save(name + ".run", record)
+    print(name, "exit", run.returncode, flush=True)
+    return run
+
+def check(name, cmd, cwd=ROOT):
+    p = invoke(name, cmd, cwd)
+    p.check_returncode()
+    return p.stdout
+
+def suite(name, kind, cwd=ROOT, *options):
+    return invoke(name, ["node", f"tests/smooth/verify-{kind}.mjs", OUT / (name + ".json"), *options], cwd)
+
+def git(*args, cwd=ROOT):
+    return subprocess.check_output(["git", *args], cwd=cwd, env=ENV)
+
+def data_parts(page):
+    m = re.search(rb"/\*__THORADAR_DATA_START__\*/(.*?)/\*__THORADAR_DATA_END__\*/", page, re.S)
+    assert m and page.count(m[0]) == 1
+    return page[:m.start()], m[0], page[m.end():]
+
+def normalize(page):
+    return page.replace(b"\r\n", b"\n")
+
+def data(page):
+    return json.loads(re.search(rb"const SITE_DATA\s*=\s*(\{.*\})\s*;", data_parts(page)[1], re.S)[1])
+
+def capture(label):
+    hashes = {name: digest((ROOT / name).read_bytes()) for name in FILES}
+    report = data((ROOT / "index.html").read_bytes())
+    record = dict(hashes=hashes, head=git("rev-parse", "HEAD").decode().strip(),
+                  briefingDate=report["briefing_date"], count=len(report["papers"]), platform=platform.platform(),
+                  node=check(label+"-node", ["node", "-v"]).decode().strip(),
+                  git=check(label+"-git", ["git", "--version"]).decode().strip(),
+                  python=platform.python_version(), chrome=check(label+"-chrome", ["pwsh","-NoProfile","-Command",
+                  "(Get-Item 'C:/Program Files/Google/Chrome/Application/chrome.exe').VersionInfo.ProductVersion"]).decode().strip())
+    save(label, record)
+    print(json.dumps(record, ensure_ascii=True))
+    assert record["head"] == BASE and (record["briefingDate"], record["count"]) == ("2026-11-28", 43)
+    assert list(hashes.values())[:3] == ["27ba018a9a3b4936ec734820af8cb505262bd55f41ae382047615f0a58d7c706",
+          "e882e9e2eef0bf36781b8b03ecec23eb81221fa8b33272cdc9de3e368f76394f",
+          "5ae38f2ba965f4e1b1d340da2ba5fadd8b58af82a1e271a02ddff97ab5686199"]
+
+def deploy(name):
+    switches = {"deploy-no-md5": (b" || md5 != expected", b""),
+        "deploy-retire-wrong": (b"then active_worker=sw-retire.js;", b"then active_worker=sw.js;")}
+    if name not in switches:
+        return suite(name, "deploy")
+    path = OUT / (name + ".yml")
+    original = (ROOT / WF).read_bytes()
+    before, after = switches[name]
+    assert original.count(before) == 1
+    path.write_bytes(original.replace(before, after))
+    return suite(name, "deploy", ROOT, path)
+
+def ux(name, cwd, *args):
+    work = Path(tempfile.mkdtemp(prefix="a4-ux-")).resolve()
+    try:
+        result = invoke(name, ["node", "tests/ux/ux_probe.mjs", "--target", "index.html",
+                               *args, "--label", name], cwd, {"XREV_SCRATCH":str(work)})
+        source = work / ("out-" + name)
+        if source.is_dir():
+            shutil.copytree(source, OUT / (name + "-measurements"))
+        return result
+    finally:
+        assert work.parent == Path(tempfile.gettempdir()).resolve() and work.name.startswith("a4-ux-")
+        if not list(work.glob("ux-harness-*/profile")):
+            shutil.rmtree(work)
+
+if __name__ == "__main__":
+    name = sys.argv[1]
+    if name.startswith("inventory-"): capture(name)
+    elif name.startswith("deploy"): sys.exit(deploy(name).returncode)
+    elif name == "ux-local": sys.exit(ux(name, ROOT, "--base", BASE).returncode)
+    else: sys.exit(suite(name, name.split("-")[0], ROOT, *sys.argv[2:]).returncode)
diff --git a/docs/tasks/T1128-SMOOTH/astra-v4/wiring.py b/docs/tasks/T1128-SMOOTH/astra-v4/wiring.py
new file mode 100644
index 0000000000000000000000000000000000000000..cdfd81be3962a87a35b66fed3be9afe40df5dc33
--- /dev/null
+++ b/docs/tasks/T1128-SMOOTH/astra-v4/wiring.py
@@ -0,0 +1,47 @@
+"""Inspect the real workflow structure and local publish trace with an independent oracle."""
+import json
+import base64
+import hashlib
+import re
+import yaml
+from run import OUT, ROOT, WF
+
+workflow = yaml.load((ROOT / WF).read_text(encoding="utf-8"), Loader=yaml.BaseLoader)
+verify = workflow["jobs"]["smooth-verify"]
+deploy = workflow["jobs"]["deploy-oss"]
+for job in (verify, deploy):
+    assert "continue-on-error" not in job
+    assert all("if" not in s and "continue-on-error" not in s for s in job["steps"])
+refs = [job["steps"][0]["with"]["ref"] for job in (verify, deploy)]
+expected_ref = "$" + "{{ github.sha }}"
+assert refs == [expected_ref, expected_ref]
+assert deploy["needs"] == "smooth-verify" and "if" not in deploy
+commands = [s["run"] for s in verify["steps"] if "run" in s]
+scripts = [re.search(r"node (\S+\.mjs)", s)[1] for s in commands]
+assert scripts == ["tests/smooth/verify-"+k+".mjs" for k in ("deploy","source","s1","s2","s3")] + [
+    "tests/smooth/prepare-ci-ux-baseline.mjs", "tests/ux/ux_probe.mjs"]
+assert "--ci" in commands[1] and "--base-html" in commands[-1]
+assert not any(" --only" in s or "--no-judge" in s for s in commands)
+print(json.dumps(dict(trigger=workflow["on"], condition=verify["if"], refs=refs, needs=deploy["needs"],
+    steps=scripts, shellGate="no step condition or continue-on-error", yaml=yaml.__version__)))
+
+trace = json.loads((OUT / "deploy.json").read_text(encoding="utf-8"))
+for label, worker in [("healthy", "sw.js"), ("healthy-retire", "sw-retire.js")]:
+    sim = trace["simulations"][label]
+    uploads = [c["args"] for c in sim["calls"] if c["tool"]=="ossutil" and c["args"][0]=="cp"]
+    checks = {}
+    for line in sim["stdout"].splitlines():
+        match = re.match(r"Verified (\S+) HTTP=(\d+) Content-MD5=(\S+) expected=(\S+) MIME=(\S+) Cache-Control=(.*)",line)
+        if not match: continue
+        url, status, md5, expected, mime, cache = match.groups()
+        source = worker if url.endswith("/sw.js") else "sw-retire.js" if url.endswith("/sw-retire.js") else "index.html"
+        local = base64.b64encode(hashlib.md5((ROOT/source).read_bytes()).digest()).decode()
+        assert status == "200" and md5 == expected == local
+        if source.endswith(".js"):
+            assert "javascript" in mime.lower() and "no-store" in cache.lower()
+        checks[url] = dict(source=source, md5=local)
+    urls = ["https://"+d+p for d in ("thoradar.online","www.thoradar.online") for p in ("/","/index.html","/sw.js","/sw-retire.js")]
+    assert list(checks) == urls
+    assert [c["args"][-1] for c in sim["calls"] if c["tool"]=="aliyun"] == ["\n".join(urls)]
+    assert uploads[-2][-2:] == [worker,"oss://thoradar-online/sw.js"] and uploads[-1][-2]=="index.html"
+    print(json.dumps(dict(mode=label, uploads=uploads[-3:], checks=checks)))

