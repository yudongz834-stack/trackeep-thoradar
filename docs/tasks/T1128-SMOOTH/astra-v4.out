def inject_index_html(papers: List[Dict[str, Any]], funnel: Dict[str, int], day: str,
                      journal_meta: Optional[Dict[str, Any]] = None,
                      journal_ids: Optional[Dict[str, str]] = None) -> None:
    html = INDEX_HTML.read_text(encoding="utf-8")
    if DATA_START not in html or DATA_END not in html:
        raise RuntimeError("index.html 缺少数据注入标记（DATA_START/DATA_END），拒绝盲写")
    # 空数据守卫：产出 0 篇而线上现有非空数据时拒绝覆盖（2026-11-07 判例：一次限流跑
    # fetched 276 → journal_matched 0，把 13 篇好数据洗成空，全站白屏半天）。
    # 档案/账本照常在调用方落盘（当日 0 篇是真实历史），只是 index 保留旧数据等正常跑再注入。
    if not papers:
        old = re.search(re.escape(DATA_START) + r".*?" + re.escape(DATA_END), html, flags=re.S)
        if old and '"papers":[]' not in old.group(0):
            log(f"【空数据守卫】本次产出 0 篇而线上现有非空数据"
                f"（fetched={funnel.get('fetched')} journal_matched={funnel.get('journal_matched')}），"
                f"拒绝注入覆盖；待下次正常产出再注入")
            return
    payload = {
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M"),
        "briefing_date": day,
        "funnel": funnel,
        "papers": [slim_paper(p) for p in apply_status_overlay(papers)],   # 覆盖层后过热视图白名单
    }
    if journal_meta is not None:  # 期刊名→阵地类目映射（前端旧档论文无 jcat 时按刊名回补；P21）
        payload["journal_meta"] = journal_meta
    if journal_ids is not None:  # 刊键→NLM ID（前端期刊合集稳定键；新键平行追加，旧键一字不动）
        payload["journal_ids"] = journal_ids
    block = f"{DATA_START}\n    const SITE_DATA = {json.dumps(payload, ensure_ascii=False, separators=(',', ':'))};\n    {DATA_END}"
    new_html = re.sub(
        re.escape(DATA_START) + r".*?" + re.escape(DATA_END),
        lambda _: block, html, flags=re.S)
    if new_html == html and SITE_DATA_MARKER_STALE.search(html):
        raise RuntimeError("index.html 注入未生效，拒绝假绿")
    INDEX_HTML.write_text(new_html, encoding="utf-8")

