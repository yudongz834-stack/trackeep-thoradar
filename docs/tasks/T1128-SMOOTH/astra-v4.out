209:        sec('F4b','F4b 阅读卡「一句话结论」字号未缩');check(rc.cardFinding==='12px'&&ri.cardFinding==='14px',`一句话结论字号：紧凑 ${rc.cardFinding}（应 12px）、沉浸 ${ri.cardFinding}（应 14px）`);note(`一句话结论：紧凑 ${rc.cardFinding}／沉浸 ${ri.cardFinding}；附加块 ${ri.cardExtra}；英文副标 紧凑 ${rc.cardTitleEn}／沉浸 ${ri.cardTitleEn}`);L.end();
