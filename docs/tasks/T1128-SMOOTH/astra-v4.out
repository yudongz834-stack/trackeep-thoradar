160:    if(ONLY('F3')){
185:        sec('F3a','F3a 视口高约 714px：页脚（临床免责声明）完整可见');check(r.footerOK&&r.gap>=0,`1440×714 页脚 bottom=${r.footerBottom} 应 ≤714 且高度不缩（实得余 ${r.gap}px）`);check(/临床|原文/.test(r.footTxt),`页脚应带临床免责文字；实得「${r.footTxt}」`);note(`1440×714：顶栏 ${r.topbar}px＋主区 ${r.deck}px＋页脚 ${r.footerH}px＝bottom ${r.footerBottom}，视口下余 ${r.gap}px｜页脚「${r.footTxt}…」｜body overflow=${r.bodyOv}`);L.end();
186:        sec('F3b','F3b 视口高约 714px：雷达盘不截断下方控件（#jcat-folds 等）');check(r.maxCovered===0&&r.blipOut===0,`1440×714 被盘盖住的控件：${covList({scope:{w:1},covered:r.covered})}；实得盘 ${r.scope}（台高 ${r.stageH}、头 ${r.headH}、脚 ${r.footH}）`);note(`1440×714 盘 ${r.scope}｜舞台高 ${r.stageH}px（盘 380px 居中，舞台比盘矮就上下溢出）｜头 ${r.headH}px 脚 ${r.footH}px（阵地折叠钮 ${r.foldN} 个）｜各控件被盖比例：${Object.entries(r.cover).filter(([k])=>k!=='folds').map(([k,v])=>`${k} ${v?Math.round(v.covered*100)+'%':'-'}`).join('、')}｜阵地折叠钮 ${r.cover.folds.map(v=>Math.round(v.covered*100)+'%').join('/')}｜出盘点 ${r.blipOut} 个`);L.end();
188:        sec('F3b2','F3b2 视口高约 714px：选了扇区后「清除」钮点得到（没被雷达盘盖住）');check(sr714&&sr714.clearDisabled===false&&sr714.clearCovered===0,`1440×714 清除钮 disabled=${sr714&&sr714.clearDisabled}、取样点被盘盖住 ${sr714?Math.round(sr714.clearCovered*100)+'%':'-'}（盖住它的元素：${sr714&&sr714.clearTops}）`);check(sr714&&sr714.clearWorked===true,'真鼠标点击「清除」后刊源/阵地筛选应归零');note(sectorRows.map(x=>`${x.size}：刊源行「${x.toolbarTxt}」清除钮盒 ${x.clearRect} 被盖 ${Math.round(x.clearCovered*100)}%｜真鼠标清除=${x.clearWorked}`).join('｜'));L.end();
190:        sec('F3c','F3c 720px 及以上各档视口：页脚可见、盘不盖控件');const bad=std.filter(x=>!(x.footerOK&&x.maxCovered===0));check(bad.length===0,`出问题：${bad.map(x=>`${x.size} 页脚余${x.gap}px、盘盖住 ${x.covered.join('＋')}`).join('；')||'无'}`);note(std.map(x=>`${x.size}：顶栏 ${x.topbar}·主区 ${x.deck}px·页脚余 ${x.gap}px·盘 ${x.scope}·台高 ${x.stageH}px·盖 ${x.covered.join('＋')||'无'}·队列 开${x.qOpen}/收${x.qClosed}`).join('｜'));L.end();
191:        sec('F3d','F3d 页脚下方不留空带（主区高度按实际顶栏高扣减）');check(Math.abs(r.gap)<=1,`1440×714 页脚下留了 ${r.gap}px 空带（.deck 高度仍按 100vh−112px 扣，顶栏已 76→58）`);note(`页脚下空带：${rows.map(x=>`${x.size}＝${x.gap}px`).join('、')}`);L.end();
198:    if(ONLY('F4')){
