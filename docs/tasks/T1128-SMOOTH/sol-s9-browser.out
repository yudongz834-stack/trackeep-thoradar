"'`;

async function ui(code, paths, args = {}) {
  const info = await proxy('"'info');
  const url = new URL(info.url);
  if (url.protocol === 'https:' && /(?:"'^|'"\\.)(?:aliyun\\.com|alibabacloud\\.com)"'$/.test(url.hostname) &&
      /(?:login|signin|passport|sec|captcha|verify|auth)/i.test(url.hostname.split('"'.')[0])) fail('security_challenge');
  if (url.protocol "'!== '"'https:' || url.hostname "'!== HOST) fail('"'named_target_outside_ram_console');
  const browserCode = '(() => {' + helpers + '\\n' +
    'if(location.origin"'!=="https://'"' + HOST + '\") return JSON.stringify({error:\"named_target_outside_ram_console\"});' +
    'if(challenge) return JSON.stringify({error:\"security_challenge\",detected:true});' +
    'if("'!('"' + JSON.stringify(paths) + ').some(p=>p.endsWith(\"*\")?location.pathname.startsWith(p.slice(0,-1)):location.pathname===p)) return JSON.stringify({error:\"unexpected_ram_route\"});' +
