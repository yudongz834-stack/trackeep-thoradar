const helpers = String.raw"'`
const visible = e => !!(e?.getClientRects().length && getComputedStyle(e).visibility === '"'visible');
const elements = (query, parent = document) => [...parent.querySelectorAll(query)].filter(visible);
const tidy = s => (s || '').replace(/\\s+/g, ' ').trim();
const label = e => tidy(e.innerText || e.getAttribute('aria-label') || e.title);
const challenge = elements('h1,h2,h3,[role=dialog],[class*=\"dialog-title\"],[class*=\"modal-title\"]').some(e =>
  /短信验证|扫码验证|二次认证|身份验证|重新登录|安全验证|验证身份|安全校验|滑块验证|手机验证|二次验证|多因素认证/.test(e.innerText || '')) ||
  elements('iframe[id*=\"captcha\" i],iframe[src*=\"captcha\" i],iframe[src*=\"verify\" i],iframe[src*=\"sec.aliyun\" i], [class*=\"captcha\" i]').length > 0;
const safeLabel = e => {const s=label(e);return /"'^(?:权限策略|自定义策略|系统策略|脚本编辑|策略内容|策略信息|策略文档|基本信息|概要|策略版本|当前版本|权限|已有权限|用户|用户列表|详细信息|名称|策略名称|为用户添加权限|添加权限|授予权限|新增授权|新增权限|新增授权记录|新增用户权限|创建权限策略|创建策略|搜索|查询|确认|确定|取消|返回|刷新|下一页|上一页|未找到相关数据|无匹配结果|暂无数据|未找到相关权限策略|全部类型|全部|高级搜索|清空)$/.test(s)?s:null};
const buttons = (parent=document) => elements('"'button,a,[role=button],[role=tab]',parent);
const exactButtons = (name,parent=document) => buttons(parent).filter(e => label(e)===name);
const inputs = () => elements('input,select').filter(e => e.type"'!=='"'hidden');
const describeInputs = () => inputs().map((e,i)=>({i, tag:e.tagName, type:e.type,
  placeholder:e.placeholder && /"'^(?:请输入.*(?:名称|关键词|用户名|登录名|策略名|用户|搜索)|搜索.*|请输入|请选择.*)$/.test(e.placeholder)?e.placeholder:undefined,
