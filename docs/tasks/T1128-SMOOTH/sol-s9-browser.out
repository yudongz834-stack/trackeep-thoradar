mparison]::Ordinal)}\n}\nfunction Test-SolS8Foreground {\n  $state=Get-SolS8WindowState ([SolS8Foreground]::GetForegroundWindow())\n  return ($state.chrome -and ($state.exact -or ($state.prefix -and $state.suffix)))\n}\nif($data.action -in @('check','activate')){\n  $matchesList=[Collections.Generic.List[IntPtr]]::new()\n  $callback=[SolS8Foreground+EnumWindowsProc]{\n    param($window,$unused)\n    if([SolS8Foreground]::IsWindowVisible($window)){\n      $s=Get-SolS8WindowState $window\n      if($s.chrome -and ($s.exact -or ($s.prefix -and $s.suffix))){ $matchesList.Add($window) }\n    }\n    return $true\n  }\n  [void][SolS8Foreground]::EnumWindows($callback,[IntPtr]::Zero)\n  if($data.action -eq 'activate' -and $matchesList.Count -eq 1 -and !(Test-SolS8Foreground)){\n    $selectedWindow=$matchesList[0]\n    if([SolS8Foreground]::IsIconic($selectedWindow)){\n      [void][SolS8Foreground]::ShowWindowAsync($selectedWindow,9)\n    }\n    [SolS8Foreground]::SwitchToThisWindow($selectedWindow,$true)\n    Start-Sleep -Milliseconds 200\n    if(!(Test-SolS8Foreground)){\n      $windowTitle=[Text.StringBuilder]::new(2048)\n      [void][SolS8Foreground]::GetWindowText($selectedWindow,$windowTitle,$windowTitle.Capacity)\n      $shell=New-Object -ComObject WScript.Shell\n      [void]$shell.AppActivate($windowTitle.ToString())\n      Start-Sleep -Milliseconds 200\n    }\n  }\n  $fg=Get-SolS8WindowState ([SolS8Foreground]::GetForegroundWindow())\n  $fg | Add-Member -NotePropertyName matchingWindows -NotePropertyValue $matchesList.Count\n  $fg | ConvertTo-Json -Compress\n  if(!(Test-SolS8Foreground)){ exit 23 }\n  exit 0\n}\nif(!(Test-SolS8Foreground)){ exit 23 }\nAdd-Type -AssemblyName System.Windows.Forms\nif($data.action -eq 'paste'){\n  Set-Clipboard -Value $data.text\n  if(!(Test-SolS8Foreground)){ exit 23 }\n  [Windows.Forms.SendKeys]::SendWait('^a')\n  if(!(Test-SolS8Foreground)){ exit 23 }\n  [Windows.Forms.SendKeys]::SendWait('^v')\n} elseif($data.action -eq 'copy'){\n  