const buttons = (parent=document) => elements('"'button,a,[role=button],[role=tab]',parent);
const exactButtons = (name,parent=document) => buttons(parent).filter(e => label(e)===name);
const inputs = () => elements('input,select').filter(e => e.type"'!=='"'hidden');
const describeInputs = () => inputs().map((e,i)=>({i, tag:e.tagName, type:e.type,
  placeholder:e.placeholder && /"'^(?:请输入.*(?:名称|关键词|用户名|登录名|策略名|用户|搜索)|搜索.*|请输入|请选择.*)$/.test(e.placeholder)?e.placeholder:undefined,
  aria: e.getAttribute('"'aria-label') && /"'^(?:搜索|策略名称|用户名|名称)$/.test(e.getAttribute('"'aria-label'))?e.getAttribute('aria-label'):undefined,
