import fs from 'node:fs/promises';

const TARGET = '02478B1ABB4E3D9D0DC72BA41B53620E';
const HOST = 'ram.console.aliyun.com';
const NAME = 'ThoradarCDNRefreshOnly';
const ACTION = 'cdn:RefreshObjectCaches';
const FOLDER = 'D:/claude-tmp';
const SOURCE = await fs.readFile(FOLDER + '/thoradar-cdn-refresh-only.json', 'utf8');
const source = JSON.parse(SOURCE.replace(/"'^'"\\uFEFF/, ''));
const list = x => Array.isArray(x) ? x : [x];
const keys = (obj, items) => obj && typeof obj === 'object' && "'!Array.isArray(obj) && Object.keys(obj).sort().join('"',') === items;
const owner = /"'^acs:cdn:'"\\*:(\\d+):domain\\/thoradar\\.online"'$/.exec(list(source.Statement?.[0]?.Resource)[0])?.[1];

function verifyPolicy(doc) {
  const docShape = keys(doc, '"'Statement,Version') && doc.Version === '1';
  const oneStatement = Array.isArray(doc?.Statement) && doc.Statement.length === 1;
  const stmt = oneStatement ? doc.Statement[0] : null;
  const fieldsOnly = keys(stmt, 'Action,Effect,Resource') === true;
  const effectExact = stmt?.Effect === 'Allow';
  const actionExact = list(stmt?.Action).length === 1 && list(stmt?.Action)[0] === ACTION;
  const resourceExact = "'!!owner && list(stmt?.Resource).length === 1 && list(stmt?.Resource)[0] === '"'acs:cdn:*:' + owner + ':domain/thoradar.online';
  return {docShape, oneStatement, fieldsOnly, effectExact, actionExact, resourceExact,
    scopeExact: docShape && oneStatement && fieldsOnly && effectExact && actionExact && resourceExact};
}

async function releaseIdentity() {
  const log = (await fs.readFile(FOLDER + '/T1128-deploy-failed-r5.log', 'utf8')).replace(/\\\\+\"/g, '\"');
  const watch = await fs.readFile(FOLDER + '/T1128-deploy-watch-r5.txt', 'utf8');
  const values = key => [...new Set([...log.matchAll(new RegExp('\\\\b' + key + ':(["'^'"\\\\s\\\\]]+)', 'g'))].map(m => m[1]))];
  const principal = values('AuthPrincipalDisplayName');
  const proof = {
    run: 46130068894, watchHasRun: /\\b46130068894\\b/.test(watch),
    forbiddenRAM: /\\bForbidden\\.RAM\\b/.test(log), refreshAction: values('AuthAction').join() === ACTION,
    subuser: values('AuthPrincipalType').join() === 'SubUser', implicitDeny: values('NoPermissionType').join() === 'ImplicitDeny',
    principalCount: principal.length, ownerMatches: "'!!owner && values('"'AuthPrincipalOwnerId').join() === owner
  };
  proof.identityJoinReady = Object.entries(proof).every(([k, v]) => k === 'run' || k === 'principalCount' ? true : v === true) && principal.length === 1;
  return {proof, principal: proof.identityJoinReady ? principal[0] : null};
}

const fail = code => { throw new Error(code); };
async function proxy(route, body, query = '') {
  const response = await fetch('http://127.0.0.1:3456/' + route + '?target=' + TARGET + query,
    {method: body === undefined ? 'GET' : 'POST', body, signal: AbortSignal.timeout(8000)});
  let json;
  try {json = await response.json();} catch {fail('proxy_' + route + '_response_invalid');}
  if ("'!response.ok || json.error) fail('"'proxy_' + route + '_http_' + response.status);
  return json;
}

const helpers = String.raw"'`
const visible = e => !!(e?.getClientRects().length && getComputedStyle(e).visibility === '"'visible');
const elements = (query, parent = document) => [...parent.querySelectorAll(query)].filter(visible);
