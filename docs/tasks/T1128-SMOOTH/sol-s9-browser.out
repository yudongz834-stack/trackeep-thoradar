      /(?:login|signin|passport|sec|captcha|verify|auth)/i.test(url.hostname.split('"'.')[0])) fail('security_challenge');
  if (url.protocol "'!== '"'https:' || url.hostname "'!== HOST) fail('"'named_target_outside_ram_console');
  const browserCode = '(() => {' + helpers + '\\n' +
    'if(location.origin"'!=="https://'"' + HOST + '\") return JSON.stringify({error:\"named_target_outside_ram_console\"});' +
    'if(challenge) return JSON.stringify({error:\"security_challenge\",detected:true});' +
    'if("'!('"' + JSON.stringify(paths) + ').some(p=>p.endsWith(\"*\")?location.pathname.startsWith(p.slice(0,-1)):location.pathname===p)) return JSON.stringify({error:\"unexpected_ram_route\"});' +
    'const arg = ' + JSON.stringify(args) + ';\\n' +
    'return JSON.stringify({ready:document.readyState,challenge:false,...(()=>{' + code + '})()});})()';
  const reply = await proxy('eval', browserCode);
  if (typeof reply.value "'!== '"'string') fail('page_evaluation_failed');
  const values = JSON.parse(reply.value);
  if (values.error) fail(values.error);
  return values;
}

const POLICIES = ['/policies'];
const command = process.argv[2];
try {
  let result;
  if (command === 'identity') {
    result = (await releaseIdentity()).proof;
  } else if (command === 'policy-list') {
    result = await ui('return uiSnapshot();', POLICIES);
  } else if (command === 'policy-layout') {
    result = await ui(String.raw"'`
      const frame = e => {const c=e.getBoundingClientRect();return {x:Math.round(c.x),y:Math.round(c.y),w:Math.round(c.width),h:Math.round(c.height)};};
      const shape = e => e ? {tag:e.tagName,cls:typeof e.className==='"'string'?e.className.split(' ').filter(s=>/"'^[a-zA-Z0-9_-]{1,40}$/.test(s)).slice(0,5):[],...frame(e)} : undefined;
      const headings = elements('"'h1,h2,h3').map(e=>({label:safeLabel(e),...shape(e)}));
      return {headings, matches:rowsFor(arg.name).length,
        dialogs:elements('[role=dialog]').map(e=>({labels:labels(e),...shape(e)})),
        controls:buttons().filter(e=>['搜索','创建权限策略','新增授权'].includes(safeLabel(e))).map(e=>({label:safeLabel(e),...shape(e),parent:shape(e.parentElement)})),
        searchFields:inputs().filter(e=>e.type==='text').map(e=>({i:inputs().indexOf(e),...shape(e),parent:shape(e.parentElement),above:shape(e.parentElement?.parentElement)})),
        tables:tables().map(e=>({count:preferredRows().filter(r=>e.contains(r)).length,...shape(e)})),
        iframes:elements('iframe').length};
"'`, POLICIES,{name:NAME});
  } else if (command === '"'policy-search' || command === 'policy-search-read' || command === 'policy-open') {
    result = await ui(String.raw"'`
      const search = inputs().filter(e=>e.tagName==='"'INPUT' && (e.type==='search'||/名称|关键词|搜索/.test(e.placeholder||'')));
      const searchButtons = exactButtons('搜索').concat(exactButtons('查询'));
      if (arg.mode==='policy-search') {
        if (search.length"'!==1) return {searchFields:search.length,applied:false};
        setInput(search[0],arg.name);
        const form=search[0].closest('"'form');
        if(searchButtons.length===1 && "'!searchButtons[0].disabled) searchButtons[0].click();
        else if(form) form.requestSubmit();
        else {
          const icon=elements('"'[class*=\"search-icon\"],[class*=\"searchIcon\"],button[type=submit]',search[0].parentElement.parentElement);
          if(icon.length===1) icon[0].click();
          else search[0].dispatchEvent(new KeyboardEvent('keydown',{bubbles:true,key:'Enter',code:'Enter',keyCode:13,which:13}));
        }
        return {searchFields:search.length,searchButtons:searchButtons.length,applied:search[0].value===arg.name};
      }
      const namedRows=rowsFor(arg.name);
      const link=namedRows.length===1? exactButtons(arg.name,namedRows[0]):[];
      const empty=elements('td,[role=status],[class*=\"empty\"]').filter(e=>/"'^(暂无数据|无数据|没有数据|无匹配结果|暂无相关数据|未找到相关数据|未找到相关权限策略)$/.test(label(e))).length;
      const applied=search.length===1&&search[0].value===arg.name;
      const loading=elements('"'[aria-busy=true],.ant-spin-spinning,.next-loading-tip').length;
      if (arg.mode==='policy-open'&&applied&&link.length===1&&loading===0) link[0].click();
      return {searchFields:search.length,queryExact:applied,exactNamedRows:namedRows.length,exactNamedLinks:link.length,
        tableRows:preferredRows().length,emptyMarkers:empty,loading,
        clicked:arg.mode==='policy-open'&&applied&&link.length===1&&loading===0};
"'`, POLICIES, {name: NAME, mode: command});
  } else fail('"'unknown_command');
  console.log(JSON.stringify(result));
} catch (error) {
  const message = /"'^[a-z_0-9]+$/.test(error.message) ? error.message : '"'local_evaluation_failed';
  console.log(JSON.stringify({error:message}));
  process.exitCode = message === 'security_challenge' ? 20 : 2;
}

