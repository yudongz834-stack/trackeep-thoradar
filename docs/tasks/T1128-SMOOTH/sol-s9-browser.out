    result = (await releaseIdentity()).proof;
  } else if (command === 'policy-list') {
    result = await ui('return uiSnapshot();', POLICIES);
  } else if (command === 'policy-search' || command === 'policy-search-read' || command === 'policy-open') {
    result = await ui(String.raw"'`
      const search = inputs().filter(e=>e.tagName==='"'INPUT' && (e.type==='search'||/名称|关键词|搜索/.test(e.placeholder||'')));
      const searchButtons = exactButtons('搜索').concat(exactButtons('查询'));
      if (arg.mode==='policy-search') {
        if (search.length"'!==1) return {searchFields:search.length,applied:false};
        setInput(search[0],arg.name);
        const form=search[0].closest('"'form');
        if(searchButtons.length===1 && "'!searchButtons[0].disabled) searchButtons[0].click();
        else if(form) form.requestSubmit();
        else {
          const icon=elements('"'[class*=\"search-icon\"],[class*=\"searchIcon\"],button[type=submit]',search[0].parentElement.parentElement);
          if(icon.length===1) icon[0].click();
          else search[0].dispatchEvent(new KeyboardEvent('keydown',{bubbles:true,key:'Enter',code:'Enter',keyCode:13,which:13}));
        }
        return {searchFields:search.length,searchButtons:searchButtons.length,applied:search[0].value===arg.name};
      }
      const namedRows=rowsFor(arg.name);
      const link=namedRows.length===1? exactButtons(arg.name,namedRows[0]):[];
      const empty=elements('td,[role=status],[class*=\"empty\"]').filter(e=>/"'^(暂无数据|无数据|没有数据|无匹配结果|暂无相关数据|未找到相关数据|未找到相关权限策略)$/.test(label(e))).length;
