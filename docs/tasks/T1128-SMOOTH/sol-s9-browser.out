"'`, POLICIES, {name: NAME, mode: command});
  } else fail('"'unknown_command');
  console.log(JSON.stringify(result));
} catch (error) {
  const message = /"'^[a-z_0-9]+$/.test(error.message) ? error.message : '"'local_evaluation_failed';
  console.log(JSON.stringify({error:message}));
