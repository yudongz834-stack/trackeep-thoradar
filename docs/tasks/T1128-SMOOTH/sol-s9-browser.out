exec
"C:\\Program Files\\PowerShell\\7\\pwsh.exe" -Command '$body = @'"'
import fs from 'node:fs/promises';

const TARGET = '02478B1ABB4E3D9D0DC72BA41B53620E';
const HOST = 'ram.console.aliyun.com';
const NAME = 'ThoradarCDNRefreshOnly';
const ACTION = 'cdn:RefreshObjectCaches';
const FOLDER = 'D:/claude-tmp';
const SOURCE = await fs.readFile(FOLDER + '/thoradar-cdn-refresh-only.json', 'utf8');
const source = JSON.parse(SOURCE.replace(/"'^'"\\uFEFF/, ''));
const list = x => Array.isArray(x) ? x : [x];
const keys = (obj, items) => obj && typeof obj === 'object' && "'!Array.isArray(obj) && Object.keys(obj).sort().join('"',') === items;
const owner = /"'^acs:cdn:'"\\*:(\\d+):domain\\/thoradar\\.online"'$/.exec(list(source.Statement?.[0]?.Resource)[0])?.[1];

function verifyPolicy(doc) {
  const docShape = keys(doc, '"'Statement,Version') && doc.Version === '1';
  const oneStatement = Array.isArray(doc?.Statement) && doc.Statement.length === 1;
  const stmt = oneStatement ? doc.Statement[0] : null;
  const fieldsOnly = keys(stmt, 'Action,Effect,Resource') === true;
  const effectExact = stmt?.Effect === 'Allow';
  const actionExact = list(stmt?.Action).length === 1 && list(stmt?.Action)[0] === ACTION;
  const resourceExact = "'!!owner && list(stmt?.Resource).length === 1 && list(stmt?.Resource)[0] === '"'acs:cdn:*:' + owner + ':domain/thoradar.online';
  return {docShape, oneStatement, fieldsOnly, effectExact, actionExact, resourceExact,
    scopeExact: docShape && oneStatement && fieldsOnly && effectExact && actionExact && resourceExact};
}

async function releaseIdentity() {
  const log = (await fs.readFile(FOLDER + '/T1128-deploy-failed-r5.log', 'utf8')).replace(/\\\\+\"/g, '\"');
  const watch = await fs.readFile(FOLDER + '/T1128-deploy-watch-r5.txt', 'utf8');
  const values = key => [...new Set([...log.matchAll(new RegExp('\\\\b' + key + ':(["'^'"\\\\s\\\\]]+)', 'g'))].map(m => m[1]))];
  const principal = values('AuthPrincipalDisplayName');
  const proof = {
    run: 46130068894, watchHasRun: /\\b46130068894\\b/.test(watch),
    forbiddenRAM: /\\bForbidden\\.RAM\\b/.test(log), refreshAction: values('AuthAction').join() === ACTION,
    subuser: values('AuthPrincipalType').join() === 'SubUser', implicitDeny: values('NoPermissionType').join() === 'ImplicitDeny',
    principalCount: principal.length, ownerMatches: "'!!owner && values('"'AuthPrincipalOwnerId').join() === owner
  };
  proof.identityJoinReady = Object.entries(proof).every(([k, v]) => k === 'run' || k === 'principalCount' ? true : v === true) && principal.length === 1;
  return {proof, principal: proof.identityJoinReady ? principal[0] : null};
}

const fail = code => { throw new Error(code); };
async function proxy(route, body, query = '') {
  const response = await fetch('http://127.0.0.1:3456/' + route + '?target=' + TARGET + query,
    {method: body === undefined ? 'GET' : 'POST', body, signal: AbortSignal.timeout(8000)});
  let json;
  try {json = await response.json();} catch {fail('proxy_' + route + '_response_invalid');}
  if ("'!response.ok || json.error) fail('"'proxy_' + route + '_http_' + response.status);
  return json;
}

const helpers = String.raw"'`
const visible = e => !!(e?.getClientRects().length && getComputedStyle(e).visibility === '"'visible');
const elements = (query, parent = document) => [...parent.querySelectorAll(query)].filter(visible);
const tidy = s => (s || '').replace(/\\s+/g, ' ').trim();
const label = e => tidy(e.innerText || e.getAttribute('aria-label') || e.title);
const challenge = elements('h1,h2,h3,[role=dialog],[class*=\"dialog-title\"],[class*=\"modal-title\"]').some(e =>
  /短信验证|扫码验证|二次认证|身份验证|重新登录|安全验证|验证身份|安全校验|滑块验证|手机验证|二次验证|多因素认证/.test(e.innerText || '')) ||
  elements('iframe[id*=\"captcha\" i],iframe[src*=\"captcha\" i],iframe[src*=\"verify\" i],iframe[src*=\"sec.aliyun\" i], [class*=\"captcha\" i]').length > 0;
const safeLabel = e => {const s=label(e);return /"'^(?:权限策略|自定义策略|系统策略|脚本编辑|策略内容|策略信息|策略文档|基本信息|概要|策略版本|当前版本|权限|已有权限|用户|用户列表|详细信息|名称|策略名称|为用户添加权限|添加权限|授予权限|新增授权|新增权限|新增授权记录|新增用户权限|创建权限策略|创建策略|搜索|查询|确认|确定|取消|返回|刷新|下一页|上一页|未找到相关数据|无匹配结果|暂无数据|未找到相关权限策略|全部类型|全部|高级搜索|清空)$/.test(s)?s:null};
const buttons = (parent=document) => elements('"'button,a,[role=button],[role=tab]',parent);
const exactButtons = (name,parent=document) => buttons(parent).filter(e => label(e)===name);
const inputs = () => elements('input,select').filter(e => e.type"'!=='"'hidden');
const describeInputs = () => inputs().map((e,i)=>({i, tag:e.tagName, type:e.type,
  placeholder:e.placeholder && /"'^(?:请输入.*(?:名称|关键词|用户名|登录名|策略名|用户|搜索)|搜索.*|请输入|请选择.*)$/.test(e.placeholder)?e.placeholder:undefined,
  aria: e.getAttribute('"'aria-label') && /"'^(?:搜索|策略名称|用户名|名称)$/.test(e.getAttribute('"'aria-label'))?e.getAttribute('aria-label'):undefined,
  role: e.getAttribute('role')||undefined, disabled:e.disabled || undefined}));
const tables = () => elements('table,[role=table],[role=grid]');
const preferredRows = () => elements('tbody tr,[role=rowgroup] [role=row]').filter(e=>"'!e.querySelector('"'th,[role=columnheader]'));
const labels = (parent=document) => [...new Set(buttons(parent).map(safeLabel).filter(Boolean))];
const setInput = (e,value) => {
  Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(e,value);
  e.dispatchEvent(new Event('input',{bubbles:true}));
  e.dispatchEvent(new Event('change',{bubbles:true}));
};
const mainTable = () => tables().filter(t=>t.tagName==='TABLE'&&t.querySelector('tbody')).sort((a,b)=>b.getBoundingClientRect().width-a.getBoundingClientRect().width)[0];
const rowsFor = (value,parent=document) => elements('tbody tr,[role=rowgroup] [role=row]',parent).filter(row=>
  elements('td,[role=cell],[role=gridcell]',row).some(cell=>label(cell)===value||elements('a',cell).some(a=>label(a)===value)));
const uiSnapshot = () => ({
  controls:labels(), inputs:describeInputs(), tables:tables().length, rows:preferredRows().length,
  dialogs:elements('[role=dialog]').length, loading:elements('[aria-busy=true],.ant-spin-spinning,.next-loading-tip').length
});
"'`;

async function ui(code, paths, args = {}) {
  const info = await proxy('"'info');
  const url = new URL(info.url);
  if (url.protocol === 'https:' && /(?:"'^|'"\\.)(?:aliyun\\.com|alibabacloud\\.com)"'$/.test(url.hostname) &&
      /(?:login|signin|passport|sec|captcha|verify|auth)/i.test(url.hostname.split('"'.')[0])) fail('security_challenge');
  if (url.protocol "'!== '"'https:' || url.hostname "'!== HOST) fail('"'named_target_outside_ram_console');
  const browserCode = '(() => {' + helpers + '\\n' +
    'if(location.origin"'!=="https://'"' + HOST + '\") return JSON.stringify({error:\"named_target_outside_ram_console\"});' +
    'if(challenge) return JSON.stringify({error:\"security_challenge\",detected:true});' +
    'if("'!('"' + JSON.stringify(paths) + ').some(p=>p.endsWith(\"*\")?location.pathname.startsWith(p.slice(0,-1)):location.pathname===p)) return JSON.stringify({error:\"unexpected_ram_route\"});' +
    'const arg = ' + JSON.stringify(args) + ';\\n' +
    'return JSON.stringify({ready:document.readyState,challenge:false,...(()=>{' + code + '})()});})()';
  const reply = await proxy('eval', browserCode);
  if (typeof reply.value "'!== '"'string') fail('page_evaluation_failed');
  const values = JSON.parse(reply.value);
  if (values.error) fail(values.error);
  return values;
}

const POLICIES = ['/policies'];
const command = process.argv[2];
try {
  let result;
  if (command === 'identity') {
    result = (await releaseIdentity()).proof;
  } else if (command === 'policy-list') {
    result = await ui('return uiSnapshot();', POLICIES);
  } else if (command === 'policy-layout') {
    result = await ui(String.raw"'`
      const frame = e => {const c=e.getBoundingClientRect();return {x:Math.round(c.x),y:Math.round(c.y),w:Math.round(c.width),h:Math.round(c.height)};};
      const shape = e => e ? {tag:e.tagName,cls:typeof e.className==='"'string'?e.className.split(' ').filter(s=>/"'^[a-zA-Z0-9_-]{1,40}$/.test(s)).slice(0,5):[],...frame(e)} : undefined;
      const headings = elements('"'h1,h2,h3').map(e=>({label:safeLabel(e),...shape(e)}));
      return {headings, matches:rowsFor(arg.name).length,
        dialogs:elements('[role=dialog]').map(e=>({labels:labels(e),...shape(e)})),
        controls:buttons().filter(e=>['搜索','创建权限策略','新增授权'].includes(safeLabel(e))).map(e=>({label:safeLabel(e),...shape(e),parent:shape(e.parentElement)})),
        searchFields:inputs().filter(e=>e.type==='text').map(e=>({i:inputs().indexOf(e),...shape(e),parent:shape(e.parentElement),above:shape(e.parentElement?.parentElement)})),
        tables:tables().map(e=>({count:preferredRows().filter(r=>e.contains(r)).length,...shape(e)})),
        iframes:elements('iframe').length};
"'`, POLICIES,{name:NAME});
  } else if (['"'policy-search','policy-search-submit','policy-search-read','policy-open','policy-create-open'].includes(command)) {
    result = await ui(String.raw"'`
      const search = elements('"'.next-search-input input[role=searchbox]');
      const searchButtons=elements('button.next-search-btn').filter(e=>label(e)==='搜索');
      if (arg.mode==='policy-search') {
        if (search.length"'!==1 || searchButtons.length!==1) return {searchFields:search.length,searchButtons:searchButtons.length,applied:false};
        setInput(search[0],arg.name);
        return {searchFields:search.length,searchButtons:searchButtons.length,inputExact:search[0].value===arg.name};
      }
      const inputExact=search.length===1&&search[0].value===arg.name;
      if(arg.mode==='"'policy-search-submit'){
        const ready=inputExact&&searchButtons.length===1&&"'!searchButtons[0].disabled;
        if(ready) searchButtons[0].click();
        return {inputExact,searchButtons:searchButtons.length,clicked:ready};
      }
      const table=mainTable();
      const namedRows=table?rowsFor(arg.name,table):[];
      const link=namedRows.length===1? exactButtons(arg.name,namedRows[0]):[];
      const empty=elements('"'td,[role=status],[class*=\"empty\"]').filter(e=>/"'^(暂无数据|无数据|没有数据|无匹配结果|暂无相关数据|未找到相关数据|未找到相关权限策略|没有相关数据|没有找到符合条件的记录)$/.test(label(e))).length;
      const loading=elements('"'[aria-busy=true],.ant-spin-spinning,.next-loading-tip').length;
      const canOpen=arg.mode==='policy-open'&&inputExact&&link.length===1&&loading===0;
      if(canOpen) link[0].click();
      const total=[...new Set(elements('[class*=\"pagination\"],[class*=\"next-pagination\"]').map(e=>/共\\s*(\\d+)\\s*(?:条|项)/.exec(label(e))?.[1]).filter(v=>v"'!==undefined))].map(Number);
      const create=exactButtons('"'创建权限策略');
      const canCreate=arg.mode==='policy-create-open'&&inputExact&&namedRows.length===0&&empty>0&&loading===0&&
        create.length===1&&"'!create[0].disabled;
      if(canCreate) create[0].click();
      return {searchFields:search.length,queryExact:inputExact,exactNamedRows:namedRows.length,exactNamedLinks:link.length,
        tableRows:table?preferredRows().filter(r=>table.contains(r)).length:null,emptyMarkers:empty,total,loading,clicked:canOpen||canCreate};
`, POLICIES, {name: NAME, mode: command});
  } else if(command==='"'create-layout'||command==='create-script-tab') {
    result = await ui(String.raw"'`
      const tabs=elements('"'#policy-script-tab');
      const editors=elements('.monaco-editor');
      const clicked=arg.open&&tabs.length===1&&editors.length===0;
      if(clicked) tabs[0].click();
      return {...uiSnapshot(),scriptTabs:tabs.length,clicked,editors:editors.length,
        editorInputs:editors.map(e=>[...e.querySelectorAll('textarea,[contenteditable=true]')].map(x=>({tag:x.tagName,cls:x.className}))),
        monacoGlobal: typeof globalThis.monaco==='object'};
"'`, ['"'/policies/create'],{open:command==='create-script-tab'});
  } else fail('unknown_command');
  console.log(JSON.stringify(result));
} catch (error) {
  const message = /"'^[a-z_0-9]+$/.test(error.message) ? error.message : '"'local_evaluation_failed';
  console.log(JSON.stringify({error:message}));
  process.exitCode = message === 'security_challenge' ? 20 : 2;
}

