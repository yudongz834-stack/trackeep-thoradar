assert("'!/[a-z0-9_.+-]+@[a-z0-9.-]+'"\\.[a-z]{2,}/i.test(all));
assert.match(report,/"'^.*干了什么.*'"\\r?\\n.*PI 怎么亲手验.*\\r?\\n.*还剩什么坑.*\\r?\\n/m);
assert.match(report,/\\nDELIVERY-T1128-SMOOTH-S10\\r?\\n["'^'"\\r\\n]+\\s*"'$/);
console.log(JSON.stringify({reportAndEvidenceVerified:true,policyReadbacksIdentical:true,permissionsDeltaExact:true,singleSubmit:true,closedTabVerified:true,identityLeakScanPassed:true}));
