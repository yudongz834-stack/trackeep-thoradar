const evidence=fs.readFileSync(root+'online-release/sol-s10/browser-observations.txt','utf8');
const entries=new Map();
let current;
for (const line of evidence.split(/\\r?\\n/)) {
  if(line.startsWith('> ')) current=line.slice(2);
  if(line.startsWith('{')) entries.set(current,[...(entries.get(current)||[]),JSON.parse(line)]);
}
const first=cmd=>entries.get('node "'$p '"'+cmd)?.[0];
const policies=entries.get('node "'$p policy-verify'"');
assert.equal(policies.length,2);
assert.deepEqual(policies[0],policies[1]);
assert.equal(policies[0].exactScope,true);
assert.equal(policies[0].sanitizedPolicy.Statement[0].Action,'cdn:RefreshObjectCaches');
assert.equal(policies[0].sanitizedPolicy.Statement[0].Resource,'acs:cdn:*:<CDN_OWNER_ACCOUNT_ID>:domain/thoradar.online');
