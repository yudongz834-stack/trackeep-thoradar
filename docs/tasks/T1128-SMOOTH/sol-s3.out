D:\trackeep\trackeep-product\trackeep-thoradar-smooth-T1128\docs\tasks\T1128-SMOOTH\sol-s3-report.md
diff --git a/docs/tasks/T1128-SMOOTH/sol-s3-recheck/run-no-data-validation.ps1 b/docs/tasks/T1128-SMOOTH/sol-s3-recheck/run-no-data-validation.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..04a8408ddf4720698747e3b8443aa33028a66ede
--- /dev/null
+++ b/docs/tasks/T1128-SMOOTH/sol-s3-recheck/run-no-data-validation.ps1
@@ -0,0 +1,43 @@
+$ErrorActionPreference = 'Stop'
+$root = (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '../../../..')).Path
+$destination = Join-Path $PSScriptRoot 'no-data-validation'
+$files = @('.json', '.stdout.txt', '.stderr.txt', '.run.json')
+foreach ($extension in $files) {
+    if (Test-Path -LiteralPath "$destination$extension") {
+        throw "Evidence already exists at $destination$extension"
+    }
+}
+
+$candidatePath = Join-Path $root 'sw.js'
+$candidate = [IO.File]::ReadAllText($candidatePath)
+$start = $candidate.IndexOf('  const block = html.slice(dataStart, end).trim();', [StringComparison]::Ordinal)
+$end = $candidate.IndexOf('  return { response, html };', [StringComparison]::Ordinal)
+if ($start -lt 0 -or $end -le $start) { throw 'Could not isolate the new data validation' }
+$deleted = $candidate.Substring($start, $end - $start)
+if (-not $deleted.Contains('JSON.parse(declaration[1])')) { throw 'Mutation did not remove JSON.parse' }
+$temporaryWorker = Join-Path ([IO.Path]::GetTempPath()) ('thoradar-sol-s3-' + [guid]::NewGuid() + '.js')
+
+try {
+    [IO.File]::WriteAllText($temporaryWorker, $candidate.Remove($start, $end - $start))
+    $test = Join-Path $root 'tests/smooth/verify-s3.mjs'
+    $command = @('node', $test, "$destination.json", $temporaryWorker)
+    $metadata = [ordered]@{
+        command = $command
+        candidateSha256 = (Get-FileHash -LiteralPath $candidatePath).Hash.ToLowerInvariant()
+        mutatedSha256 = (Get-FileHash -LiteralPath $temporaryWorker).Hash.ToLowerInvariant()
+        deleted = $deleted
+    }
+    node $test "$destination.json" $temporaryWorker 1> "$destination.stdout.txt" 2> "$destination.stderr.txt"
+    $metadata.exitCode = $LASTEXITCODE
+    $metadata | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath "$destination.run.json" -Encoding utf8
+    $result = Get-Content -Raw -LiteralPath "$destination.json" | ConvertFrom-Json
+    $neon = $result.checks | Where-Object name -eq 'neon-empty-markers-stub'
+    if ($metadata.exitCode -ne 1 -or $result.summary.failed -ne 5 -or $result.summary.passed -ne 1 -or
+        -not $neon -or $neon.pass -or $neon.detail.after.sha256 -ne $result.fixtures.'neon-empty-markers-stub'.sha256) {
+        throw 'Expected the five rejected responses to re-enter the cache when validation was removed'
+    }
+    Get-Content -LiteralPath "$destination.stdout.txt" | Select-String '^SUMMARY'
+    Write-Output "Mutation exit $($metadata.exitCode); 156-byte Neon response replaced the healthy cache"
+} finally {
+    Remove-Item -LiteralPath $temporaryWorker -ErrorAction SilentlyContinue
+}
diff --git a/docs/tasks/T1128-SMOOTH/sol-s3-report.md b/docs/tasks/T1128-SMOOTH/sol-s3-report.md
new file mode 100644
index 0000000000000000000000000000000000000000..e924fcafc09d9fc2cebe74c58af3e7cf2a84ec55
--- /dev/null
+++ b/docs/tasks/T1128-SMOOTH/sol-s3-report.md
@@ -0,0 +1,68 @@
+**干了什么**　修复了胸科雷达首页缓存写入校验。156 B 的空标记损坏页和另外四个坏样本均被拒绝，合法零篇版在下次打开时正常显示。  
+**PI 怎么亲手验**　点击专项原始输出，看到 `PASS neon-empty-markers-stub` 一行的 `before` 和 `after` 都是 `539012` 字节且 SHA-256 相同，就验到了健康副本被保留。[专项原始输出](sol-s3-recheck/after.stdout.txt)  
+**还剩什么坑**　AICLS 和 POOLUP 的 R08 仍因基线与候选均搜到零篇而无法判定。S3 施工自测完毕，待独立复核和主控整合。
+
+## 地图影响
+
+T1128-SMOOTH-S3 对应胸科雷达顺畅改造 ③.4 的 R2 返修。指定隔离工作树里已有 S3 候选和首轮证据，本轮核对基线后，使用同一版专项脚本复跑旧版、新版和删减版，并补齐正式回执。岗位卡为 `builder-jobspec`，轨道版本为 `T1128-SMOOTH v1`，委任席位为 `codex-gpt`，点名档位为 `gpt-6.2-sol`。
+
+`sw.js` 的 `fetchShell` 在现有 HTTP 200、`basic`、HTML MIME、标记顺序及 `</html>` 收尾检查后，提取两个标记之间的 `const SITE_DATA = …` 声明，用 `JSON.parse` 验证 JSON 对象并检查 `briefing_date` 是字符串、`papers` 是数组。安装预取与后台核新共用该函数。相对 S2 的生产代码差异限于这一处。[worker 差异](sol-s3-recheck/worker.diff.txt) [源文件检查](sol-s3-recheck/source.json)
+
+Neon 的 156 B 样本与独立证据中的 SHA-256 完全一致。旧版在收到 HTTP 200、`text/html` 响应后将 539,012 B 的健康副本换成了这 156 B，下次从 Cache Storage 读到损坏壳。候选版对五个异常输入均报告 `unavailable`，健康副本的长度和 SHA-256 在刷新前后完全一致，下次打开仍从 Cache Storage 显示 `2026-11-27` 的 40 篇。零篇用例更新为 `2026-11-28`，下次打开从 Cache Storage 读出 `papers.length === 0`。缺块用例在结束标记外放置了一个合法声明，验证了声明必须位于标记之间。[Neon 独立样本](/D:/trackeep/trackeep-product/trackeep-thoradar/docs/tasks/T1128-SMOOTH/neon-v1/neon-v1-verify.json:141) [基线 JSON](sol-s3-recheck/before.json) [候选 JSON](sol-s3-recheck/after.json)
+
+## 遗留风险
+
+- AICLS 和 POOLUP 各有一项 R08 原样失败。两套脚本都挑中 `Mortality`，基线和候选均报告 `list: 0, noQuery: 1`，因此这项检索差分仍未验证。[AICLS 原始输出](sol-s3-recheck-regressions/aicls.stdout.txt) [POOLUP 原始输出](sol-s3-recheck-regressions/poolup.stdout.txt)
+- 验证环境为本机 Chrome 和回环测试服务。线上、CDN 和真机未验。独立复核由主控另行验收。
+
+## 证据
+
+Windows 11 Pro x64 `10.0.26300`，Node `v24.14.0`，Chrome `158.0.8127.88`，CDP `1.3`，无随机种子。专项正式复跑从北京时间 `2026-11-28 11:58:20` 开始，最后一套既有回归于 `12:00:37` 结束。各套精确 UTC 起止、命令、哈希及逐项结果在 JSON。旧三项负对照通过既有测试设施返回变异响应。S3 负对照只从临时 worker 文件删掉数据块检查，保留原来的 HTTP、MIME、标记与收尾检查。删除代码原文、变异 SHA-256 与实际退出码留在运行记录。[S3 负对照运行记录](sol-s3-recheck/no-data-validation.run.json) [既有回归汇总输出](sol-s3-recheck/legacy.stdout.txt)
