import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
const base = process.argv[2];
const read = name => JSON.parse(readFileSync(base + '/' + name + '.json', 'utf8'));
const positive = read('deploy');
const apex = read('apex-only');
const md5 = read('without-md5-gate');
assert.deepEqual(positive.summary, { passed: 18, failed: 0 });
assert.deepEqual(apex.summary, { passed: 16, failed: 2 });
assert.deepEqual(md5.summary, { passed: 16, failed: 2 });
const urls = ['thoradar.online', 'www.thoradar.online'].flatMap(
  host => ['/', '/index.html', '/sw.js', '/sw-retire.js'].map(path => 'https://' + host + path),
);
for (const scenario of ['healthy', 'healthy-retire']) {
  const run = positive.simulations[scenario];
  assert.equal(run.status, 0);
  const cdn = run.calls.filter(call => call.tool === 'aliyun');
  const heads = run.calls.filter(call => call.tool === 'curl' && call.args.includes('-I')).map(call => call.args.at(-1));
  assert.deepEqual(cdn.map(call => call.args), [['cdn', 'RefreshObjectCaches', '--region', 'cn-shenzhen', '--ObjectType', 'File', '--ObjectPath', urls.join('\\n')]]);
  assert.deepEqual(heads, urls);
  console.log(JSON.stringify({ scenario, refreshRequests: cdn.length, urls, verificationOrderEqual: true }));
}
const waits = positive.simulations['stale-during-propagation-retire'].calls
  .filter(call => call.tool === 'sleep').map(call => Number(call.args[0]));
assert.deepEqual(waits, [5, 5, ...Array(9).fill(40)]);
console.log(JSON.stringify({ scenario: 'stale-during-propagation-retire', waits, seconds: waits.reduce((sum, seconds) => sum + seconds, 0) }));
const failedApex = apex.tests.filter(test => "'!test.pass);
assert.deepEqual(failedApex.map(test => test.name.split('"' ')[0]), ['normal', 'retire']);
for (const failure of failedApex) {
  for (const missing of urls.slice(4)) assert.ok(failure.error.includes(missing));
}
console.log(JSON.stringify({ scenario: 'apex-only', summary: apex.summary, failures: failedApex.map(test => test.name) }));
const originalWrong = Object.entries(positive.simulations).find(([name]) => name.startsWith('wrong-md5'))[1];
const mutatedWrong = Object.entries(md5.simulations).find(([name]) => name.startsWith('wrong-md5'))[1];
assert.equal(originalWrong.status, 1);
assert.equal(mutatedWrong.status, 0);
const wrongMd5 = md5.tests.find(test => test.name === 'post-publish verification rejects wrong-md5');
assert.equal(wrongMd5.pass, false);
console.log(JSON.stringify({ scenario: 'without-md5-gate', summary: md5.summary, originalWrongMd5Exit: originalWrong.status, mutatedWrongMd5Exit: mutatedWrong.status, failure: wrongMd5.name }));

