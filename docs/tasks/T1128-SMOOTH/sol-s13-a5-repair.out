name: Deploy to Aliyun OSS

# 迁移役（2026-11-19 起）：每日流水线跑完 → 网站同步到阿里云深圳 OSS（备案接入）
# 手动可触发（workflow_dispatch）＝首次部署/补发；workflow_run 挂在日报管线尾部自动跟发
on:
  workflow_dispatch:
    inputs:
      retire:
        description: 'Publish the retirement worker at /sw.js'
        type: boolean
        default: false
  workflow_run:
    workflows: ["ThorRadar Daily Pipeline"]
    types: [completed]

permissions:
  contents: read

jobs:
  smooth-verify:
    # 日报管线成功才跟发；手动触发不受限
    if: github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success'
    runs-on: windows-latest
    timeout-minutes: 25
    steps:
      - name: Checkout release revision with history
        uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false

      - uses: actions/setup-node@v4
        with:
          node-version: '24'

      - name: Check deployment workflow and simulate publishing
        run: node tests/smooth/verify-deploy.mjs "$env:RUNNER_TEMP/smooth-deploy.json"

      - name: Verify source invariants
        run: node tests/smooth/verify-source.mjs "$env:RUNNER_TEMP/smooth-source.json" --ci

      - name: Verify S1
        run: node tests/smooth/verify-s1.mjs "$env:RUNNER_TEMP/smooth-s1.json"

      - name: Verify S2
        run: node tests/smooth/verify-s2.mjs "$env:RUNNER_TEMP/smooth-s2.json"

      - name: Verify S3
        run: node tests/smooth/verify-s3.mjs "$env:RUNNER_TEMP/smooth-s3.json"

      - name: Prepare UX baseline from the first parent
        run: node tests/smooth/prepare-ci-ux-baseline.mjs "$env:GITHUB_SHA" "$env:RUNNER_TEMP/smooth-ux-baseline.html"

      - name: Verify UX
        run: |
          $env:XREV_SCRATCH = Join-Path $env:RUNNER_TEMP 'smooth-ux'
          node tests/ux/ux_probe.mjs --target index.html --base-html "$env:RUNNER_TEMP/smooth-ux-baseline.html" --label smooth-ci

  deploy-oss:
    needs: smooth-verify
    runs-on: ubuntu-latest
    concurrency:
      group: thoradar-oss
      cancel-in-progress: false
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false

      - name: Install OSS and CDN tools
        shell: bash
        run: |
          set -euo pipefail
          # ossutil 走 GitHub 官方发行版 v1.7.18 zip（v1.7.19 无 linux 资产·alicdn 域名美国 runner 不通）
          cd "$RUNNER_TEMP"
          curl -fsSL https://github.com/aliyun/ossutil/releases/download/v1.7.18/ossutil-v1.7.18-linux-amd64.zip -o ossutil.zip
          unzip -q ossutil.zip
          mv ossutil-v1.7.18-linux-amd64/ossutil ./ossutil
          chmod +x ossutil
          file ossutil | grep -q ELF || { echo 'ossutil download is not an ELF binary'; exit 9; }
          ./ossutil --version

          mkdir -p aliyun
          curl -fsSL https://github.com/aliyun/aliyun-cli/releases/download/v3.5.4/aliyun-cli-linux-3.5.4-amd64.tgz -o aliyun/cli.tgz
          echo 'e1eefcbbe9d772d61f770d4af8595e7297e081a0348b096765d2c41e581c3e72  aliyun/cli.tgz' | sha256sum -c -
          tar -xzf aliyun/cli.tgz -C aliyun
          chmod +x aliyun/aliyun

      - name: Publish and verify site
        shell: bash
        env:
          OSS_KEY_ID: ${{ secrets.OSS_KEY_ID }}
          OSS_KEY_SECRET: ${{ secrets.OSS_KEY_SECRET }}
          ALIBABA_CLOUD_ACCESS_KEY_ID: ${{ secrets.OSS_KEY_ID }}
          ALIBABA_CLOUD_ACCESS_KEY_SECRET: ${{ secrets.OSS_KEY_SECRET }}
          SMOOTH_RETIRE: ${{ inputs.retire && 'true' || 'false' }}
        run: |
          set -euo pipefail
          ossutil="$RUNNER_TEMP/ossutil"
          aliyun="$RUNNER_TEMP/aliyun/aliyun"
          "$ossutil" config -e oss-cn-shenzhen.aliyuncs.com -i "$OSS_KEY_ID" -k "$OSS_KEY_SECRET" -L CH >/dev/null 2>&1 || {
            echo 'OSS configuration failed' >&2
            exit 1
          }
          # 开桶（幂等：已存在则忽略）
          "$ossutil" mb oss://thoradar-online --acl public-read 2>/dev/null || echo "跳过桶创建，继续检查现有桶"
          # 静态站默认页：v1.7.18 website put 只认 XML 配置文件（--index-page 是幻影旗标，
          # 2>/dev/null || true 曾吞错致根路径 403——2026-11-20 控制台补设＋此处改 XML 正方）
          cat > website.xml <<'XML'
          <?xml version="1.0" encoding="UTF-8"?>
          <WebsiteConfiguration>
            <IndexDocument><Suffix>index.html</Suffix></IndexDocument>
            <ErrorDocument><Key>index.html</Key></ErrorDocument>
          </WebsiteConfiguration>
          XML
          "$ossutil" website --method put oss://thoradar-online website.xml
          # 站面文件（首页/图标/搜索登记/订阅件）——ossutil 单命令单源，逐件上传
          # sitemap lastmod 部署时现打当日戳（Hydrogen 11-20 审出死日期 2026-11-08 滞留）
          sed "s|<lastmod>[^<]*</lastmod>|<lastmod>$(date -u +%Y-%m-%d)</lastmod>|" sitemap.xml > "$RUNNER_TEMP/sitemap.xml"
          mv "$RUNNER_TEMP/sitemap.xml" sitemap.xml
          for f in favicon.ico robots.txt sitemap.xml; do
            "$ossutil" cp -rf --update "$f" oss://thoradar-online/
          done
          "$ossutil" cp -rf --update --meta Cache-Control:no-cache feed.xml oss://thoradar-online/
          "$ossutil" cp -rf --update --meta "Cache-Control:public, max-age=60, s-maxage=300" data/radar_latest.json oss://thoradar-online/data/
          "$ossutil" cp -rf --update --meta Cache-Control:no-cache api/ oss://thoradar-online/api/
          "$ossutil" cp -rf --update thoradar-skill/ oss://thoradar-online/thoradar-skill/

          active_worker=sw.js
          if [[ "$SMOOTH_RETIRE" == true ]]; then active_worker=sw-retire.js; fi
          worker_meta='Content-Type:application/javascript#Cache-Control:no-store'
          # 始终覆盖 worker，确保正常与退役可双向切换；首页沿用现有缓存头并最后写入。
          "$ossutil" cp -f --meta "$worker_meta" sw-retire.js oss://thoradar-online/sw-retire.js
          "$ossutil" cp -f --meta "$worker_meta" "$active_worker" oss://thoradar-online/sw.js
          "$ossutil" cp -f --meta 'Cache-Control:public, max-age=60, s-maxage=3600' index.html oss://thoradar-online/index.html

          # 开门＝桶级公共读（控制台定版，对象继承 ACL）——逐件 setacl 按 6.2/Hydrogen 双席审读裁撤
          # （v1.7.18 无 setacl 命令·对象继承桶权限已实测 200）
          echo '=== OSS uploads recorded'
          "$ossutil" ls oss://thoradar-online/ | tail -2
          # 两个域名都直连源站验证 SNI 与根路径 200；公网 CDN 响应在刷新提交后单独验证。
          echo "=== HTTPS 预检（SNI=域名 → CNAME 目标）"
          domains=(thoradar.online www.thoradar.online)
          paths=(/ /index.html /sw.js /sw-retire.js)
          for h in "${domains[@]}"; do
            code=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 15 \
              --max-time 30 \
              --connect-to "$h:443:thoradar-online.cn-shenzhen.taihangtop.cn:443" \
              "https://$h/")
            if [ "$code" != "200" ]; then echo "✗ $h 根路径 HTTPS $code（期望 200）" >&2; exit 1; fi
            echo "$h 根路径 HTTPS 200 ✅"
          done

          # 只刷新正式域 thoradar.online。www 的永久跳转和退役 worker 例外由 CDN 配置提供。
          refresh_paths=$(printf 'https://thoradar.online%s\n' "${paths[@]}")
          refresh_id=''
          for attempt in 1 2; do
            echo "CDN RefreshObjectCaches attempt $attempt"
            if refresh_id=$(
              "$aliyun" cdn RefreshObjectCaches --region cn-shenzhen --ObjectType File --ObjectPath "$refresh_paths" |
                python3 -c 'import json, sys; value = json.load(sys.stdin).get("RefreshTaskId");
          if type(value) not in (str, int) or not value or not str(value).strip(): sys.exit(1)
          print(json.dumps(value))'
            ); then
              echo "CDN RefreshTaskId=$refresh_id"
              break
            fi
            if [[ "$attempt" == 2 ]]; then
              echo 'CDN refresh failed or returned no RefreshTaskId' >&2
              exit 1
            fi
            sleep 5
          done

          check_object_headers() {
            awk -v expected="$1" -v worker="$2" '
              { sub(/\r$/, "") }
              /^HTTP\// { status=$2; md5=""; mime=""; cache=""; next }
              tolower($0) ~ /^content-md5:/ { md5=$0; sub(/^[^:]+:[ \t]*/, "", md5); sub(/[ \t]+$/, "", md5) }
              tolower($0) ~ /^content-type:/ { mime=tolower($0); sub(/^[^:]+:[ \t]*/, "", mime); sub(/([ \t]*;.*|[ \t]+)$/, "", mime) }
              tolower($0) ~ /^cache-control:/ { line=tolower($0); sub(/^[^:]+:[ \t]*/, "", line); cache=cache "," line }
              END {
                printf "HTTP=%s Content-MD5=%s expected=%s MIME=%s Cache-Control=%s", status, md5, expected, mime, cache
                if (status != 200 || md5 != expected) exit 1
                if (worker && (mime !~ /^(application|text)\/(javascript|ecmascript)$/ || cache !~ /,[ \t]*no-store[ \t]*(,|$)/)) exit 1
              }
            '
          }

          check_redirect_headers() {
            awk -v expected="$1" '
              { sub(/\r$/, "") }
              /^HTTP\// { status=$2; location=""; locations=0; next }
              tolower($0) ~ /^location:/ {
                locations++
                location=$0; sub(/^[^:]+:[ \t]*/, "", location); sub(/[ \t]+$/, "", location)
              }
              END {
                printf "HTTP=%s Location=%s", status, location
                if (status != 301 && status != 308) exit 1
                if (locations != 1 || location != expected) exit 1
              }
            '
          }

          verify_public() {
            local url="$1" headers result attempt
            shift
            for attempt in {1..12}; do
              # 读取首个公网响应，不跟随跳转。-q 禁止 curl 配置文件覆盖命令行为。
              if headers=$(curl -q -sS -I -H 'Accept-Encoding: identity' --connect-timeout 5 --max-time 10 "$url"); then
                if result=$("$@" <<< "$headers"); then
                  echo "Verified $url $result"
                  return 0
                fi
              else
                result='HEAD request failed'
              fi
              echo "Waiting for $url ($attempt/12) $result"
              # CDN 刷新从提交到生效约需 5–6 分钟。两次短等后拉长间隔，末次至少在 370 秒后。
              if (( attempt <= 2 )); then
                sleep 5
              elif (( attempt < 12 )); then
                sleep 40
              fi
            done
            echo "Verification failed for $url" >&2
            return 1
          }

          verify_object() {
            local url="$1" source="$2" worker="$3" expected
            expected=$(openssl dgst -md5 -binary "$source" | openssl base64 -A)
            verify_public "$url" check_object_headers "$expected" "$worker"
          }

          for path in "${paths[@]}"; do
            url="https://thoradar.online$path"
            case "$path" in
              /sw.js) verify_object "$url" "$active_worker" 1 ;;
              /sw-retire.js) verify_object "$url" sw-retire.js 1 ;;
              *) verify_object "$url" index.html 0 ;;
            esac
          done

          for path in / /index.html '/?from=www'; do
            verify_public "https://www.thoradar.online$path" check_redirect_headers "https://thoradar.online$path"
          done
          # 保留旧 www 客户端的退役入口，两件 worker 在两种发布模式都返回退役文件。
          verify_object 'https://www.thoradar.online/sw.js' sw-retire.js 1
          verify_object 'https://www.thoradar.online/sw-retire.js' sw-retire.js 1
          echo 'Publish verified on both domains'
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { chmod, copyFile, mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const [output, candidate] = process.argv.slice(2);
if (!output) throw new Error('Usage: node tests/smooth/verify-deploy.mjs <result.json> [workflow.yml]');

const root = fileURLToPath(new URL('../../', import.meta.url));
const workflow = resolve(candidate || join(root, '.github/workflows/deploy_oss.yml'));
const yaml = (await readFile(workflow, 'utf8')).replace(/\r\n/g, '\n');
const windows = process.platform === 'win32';
const gitBash = join(process.env.ProgramFiles || 'C:/Program Files', 'Git/bin/bash.exe');
const bash = windows && existsSync(gitBash) ? gitBash : 'bash';
const tests = [];

async function test(name, run) {
  try {
    await run();
    tests.push({ name, pass: true });
    console.log(`PASS ${name}`);
  } catch (error) {
    tests.push({ name, pass: false, error: error.message });
    console.error(`FAIL ${name}: ${error.message}`);
  }
}

// Extract the two Bash blocks as GitHub Actions passes them to its shell.
function section(start, end) {
  const from = yaml.indexOf(start);
  if (from < 0) return '';
  const to = end ? yaml.indexOf(end, from + start.length) : -1;
  return yaml.slice(from, to < 0 ? undefined : to);
}

function shellBlock(step) {
  const lines = step.split('\n');
  const start = lines.indexOf('        run: |');
  assert.notEqual(start, -1, 'missing Bash run block');
  const body = [];
  for (const line of lines.slice(start + 1)) {
    if (line && !line.startsWith('          ')) break;
    body.push(line.slice(10));
  }
  return body.join('\n') + '\n';
}

const verifyJob = section('\n  smooth-verify:\n', '\n  deploy-oss:\n');
const deployJob = section('\n  deploy-oss:\n');
const installStep = section('\n      - name: Install OSS and CDN tools\n', '\n      - name: Publish and verify site\n');
const deployStep = section('\n      - name: Publish and verify site\n');

await test('Windows Node 24 gate runs the real checks in order before the same revision deploys', () => {
  assert.match(verifyJob, /\n    if: github\.event_name == 'workflow_dispatch' \|\| github\.event\.workflow_run\.conclusion == 'success'\n/);
  assert.match(verifyJob, /\n    runs-on: windows-latest\n/);
  assert.match(verifyJob, /\n          fetch-depth: 0\n/);
  assert.match(verifyJob, /actions\/setup-node@v4\n        with:\n          node-version: '24'/);
  assert.match(deployJob, /\n    needs: smooth-verify\n/);
  assert.doesNotMatch(deployJob, /\n    if:/);
  for (const job of [verifyJob, deployJob]) {
    assert.match(job, /uses: actions\/checkout@v4\n        with:\n          ref: \$\{\{ github\.sha \}\}/);
    assert.doesNotMatch(job, /continue-on-error:|always\(\)|success\(\)\s*\|\|/);
  }
  let previous = -1;
  const commands = [
    ...['deploy', 'source', 's1', 's2', 's3'].map(suffix =>
      `run: node tests/smooth/verify-${suffix}.mjs "$env:RUNNER_TEMP/smooth-${suffix}.json"${suffix === 'source' ? ' --ci' : ''}`),
    'run: node tests/smooth/prepare-ci-ux-baseline.mjs "$env:GITHUB_SHA" "$env:RUNNER_TEMP/smooth-ux-baseline.html"',
    'node tests/ux/ux_probe.mjs --target index.html --base-html "$env:RUNNER_TEMP/smooth-ux-baseline.html" --label smooth-ci'
  ];
  for (const command of commands) {
    const current = verifyJob.indexOf(command + '\n');
    assert.ok(current > previous, `missing or out of order: ${command}`);
    previous = current;
  }
  assert.match(verifyJob, /\$env:XREV_SCRATCH = Join-Path \$env:RUNNER_TEMP 'smooth-ux'/);
  assert.doesNotMatch(verifyJob, /run-regressions|tests\/(aicls|poolup)\/|secrets\./);
});

await test('manual retire is a boolean defaulting to false and CLI aliases reuse the OSS secrets', () => {
  assert.match(yaml, /\n  workflow_dispatch:\n    inputs:\n      retire:\n        description: [^\n]+\n        type: boolean\n        default: false\n/);
  assert.match(deployStep, /\n          SMOOTH_RETIRE: \$\{\{ inputs\.retire && 'true' \|\| 'false' \}\}\n/);
  assert.match(deployStep, /\n          ALIBABA_CLOUD_ACCESS_KEY_ID: \$\{\{ secrets\.OSS_KEY_ID \}\}\n/);
  assert.match(deployStep, /\n          ALIBABA_CLOUD_ACCESS_KEY_SECRET: \$\{\{ secrets\.OSS_KEY_SECRET \}\}\n/);
});

await test('the Aliyun CLI download pins v3.5.4 and checks SHA-256 before extraction', () => {
  const download = 'https://github.com/aliyun/aliyun-cli/releases/download/v3.5.4/aliyun-cli-linux-3.5.4-amd64.tgz';
  const checksum = "echo 'e1eefcbbe9d772d61f770d4af8595e7297e081a0348b096765d2c41e581c3e72  aliyun/cli.tgz' | sha256sum -c -";
  assert.match(installStep, /\n          set -euo pipefail\n/);
  assert.ok(installStep.includes(download));
  assert.ok(installStep.indexOf(checksum) > installStep.indexOf(download));
  assert.ok(installStep.indexOf('tar -xzf aliyun/cli.tgz') > installStep.indexOf(checksum));
  assert.doesNotMatch(installStep, /secrets\./);
});

const localEnv = {};
for (const key of ['PATH', 'SystemRoot', 'COMSPEC', 'PATHEXT', 'TEMP', 'TMP', 'TMPDIR']) {
  if (process.env[key] !== undefined) localEnv[key] = process.env[key];
}
const bashPath = path => windows ? path.replaceAll('\\', '/') : path;
const scratch = await mkdtemp(join(tmpdir(), 'thoradar-s5-deploy-'));
const simulations = {};
const shellRuns = {};
const domains = ['thoradar.online', 'www.thoradar.online'];
const refreshUrls = ['/', '/index.html', '/sw.js', '/sw-retire.js'].map(path => `https://thoradar.online${path}`);
const wwwRedirects = ['/', '/index.html', '/?from=www'].map(path => `https://www.thoradar.online${path}`);
const wwwWorkers = ['https://www.thoradar.online/sw.js', 'https://www.thoradar.online/sw-retire.js'];
const urls = [...refreshUrls, ...wwwRedirects, ...wwwWorkers];
const workerMeta = 'Content-Type:application/javascript#Cache-Control:no-store';
const origin = 'oss://thoradar-online/';
const publishComplete = 'Publish verified on both domains';

function bashRun(args, options = {}) {
  const run = spawnSync(bash, ['--noprofile', '--norc', ...args], {
    cwd: scratch, env: localEnv, encoding: 'utf8', windowsHide: true, timeout: 60000, ...options
  });
  if (run.error) throw run.error;
  return { status: run.status, stdout: run.stdout, stderr: run.stderr };
}

async function mockCommand(path, tool) {
  const command = `#!/usr/bin/env bash\nexec "$SMOOTH_MOCK_NODE" "$SMOOTH_MOCK_SCRIPT" ${tool} "$@"\n`;
  await writeFile(path, command);
  await chmod(path, 0o755);
}

async function simulate(scenario, retire = false) {
  const label = retire ? `${scenario}-retire` : scenario;
  const trace = join(scratch, `trace-${label}.jsonl`);
  await writeFile(trace, '');
  const env = { ...localEnv, MSYS2_ARG_CONV_EXCL: '*', RUNNER_TEMP: bashPath(scratch),
    OSS_KEY_ID: 'mock-id', OSS_KEY_SECRET: 'mock-secret',
    ALIBABA_CLOUD_ACCESS_KEY_ID: 'mock-id', ALIBABA_CLOUD_ACCESS_KEY_SECRET: 'mock-secret',
    SMOOTH_RETIRE: String(retire), SMOOTH_MOCK_SCENARIO: scenario,
    SMOOTH_MOCK_NODE: bashPath(process.execPath), SMOOTH_MOCK_SCRIPT: fileURLToPath(new URL('./deploy-mock.mjs', import.meta.url)),
    SMOOTH_MOCK_TRACE: trace };
  const script = join(scratch, 'publish.sh');
  const run = bashRun([bashPath(script)], { env });
  const calls = (await readFile(trace, 'utf8')).trim().split('\n').filter(Boolean).map(line => JSON.parse(line));
  simulations[label] = { ...run, calls };
  return { ...run, calls, uploads: calls.filter(call => call.tool === 'ossutil' && call.args[0] === 'cp').map(call => call.args),
    refreshes: calls.filter(call => call.tool === 'aliyun').map(call => call.args),
    heads: calls.filter(call => call.tool === 'curl' && call.args.includes('-I')).map(call => call.args.at(-1)) };
}

function success(run) {
  assert.equal(run.status, 0, run.stderr);
  assert.ok(run.stdout.includes(publishComplete));
}

function failure(run, message) {
  assert.notEqual(run.status, 0, 'deployment exited 0');
  assert.match(run.stderr, message);
  assert.ok(!run.stdout.includes(publishComplete));
}

function rejectsPublicResponse(run, url) {
  failure(run, /^Verification failed for /m);
  assert.ok(run.stderr.includes(`Verification failed for ${url}\n`), run.stderr);
  assert.equal(run.heads.filter(head => head === url).length, 12);
  assert.ok(!run.stdout.includes(`Verified ${url} `));
}

try {
  let deployScript;
  await test('Bash syntax for tool installation and production publish', () => {
    deployScript = shellBlock(deployStep);
    for (const [name, input] of [['install', shellBlock(installStep)], ['publish', deployScript]]) {
      const run = bashRun(['-n'], { input });
      shellRuns[name] = run;
      assert.equal(run.status, 0, run.stderr);
    }
  });
  assert.ok(deployScript, 'cannot simulate an absent publish step');
  const bin = join(scratch, 'bin');
  const aliyun = join(scratch, 'aliyun');
  await mkdir(bin);
  await mkdir(aliyun);
  await Promise.all([
    ...['index.html', 'sw.js', 'sw-retire.js', 'sitemap.xml'].map(file => copyFile(join(root, file), join(scratch, file))),
    mockCommand(join(scratch, 'ossutil'), 'ossutil'), mockCommand(join(aliyun, 'aliyun'), 'aliyun'),
    mockCommand(join(bin, 'curl'), 'curl'), mockCommand(join(bin, 'sleep'), 'sleep')
  ]);
  // Git Bash uses a Unix PATH. Use the host's Python for the real JSON parser on Windows.
  if (windows) {
    const python = join(bin, 'python3');
    await writeFile(python, '#!/usr/bin/env bash\nexec python "$@"\n');
    await chmod(python, 0o755);
  }
  await writeFile(join(scratch, 'publish.sh'), [
    'set -e', 'mock_bin="$RUNNER_TEMP/bin"',
    'if [[ "$OSTYPE" == msys* ]]; then mock_bin=$(cygpath -u "$mock_bin"); fi',
    'export PATH="$mock_bin:$PATH"',
    '# Hosted Windows may prefer system executables over no-extension PATH mocks.',
    'curl() { "$mock_bin/curl" "$@"; }',
    'sleep() { "$mock_bin/sleep" "$@"; }',
    deployScript
  ].join('\n'));

  for (const retire of [false, true]) {
    await test(`${retire ? 'retire' : 'normal'} uploads workers then index, refreshes only four main URLs and verifies both domains`, async () => {
      const run = await simulate('healthy', retire);
      success(run);
      assert.deepEqual(run.uploads, [
        ...['favicon.ico', 'robots.txt', 'sitemap.xml'].map(file => ['cp', '-rf', '--update', file, origin]),
        ['cp', '-rf', '--update', '--meta', 'Cache-Control:no-cache', 'feed.xml', origin],
        ['cp', '-rf', '--update', '--meta', 'Cache-Control:public, max-age=60, s-maxage=300', 'data/radar_latest.json', `${origin}data/`],
        ['cp', '-rf', '--update', '--meta', 'Cache-Control:no-cache', 'api/', `${origin}api/`],
        ['cp', '-rf', '--update', 'thoradar-skill/', `${origin}thoradar-skill/`],
        ['cp', '-f', '--meta', workerMeta, 'sw-retire.js', `${origin}sw-retire.js`],
        ['cp', '-f', '--meta', workerMeta, retire ? 'sw-retire.js' : 'sw.js', `${origin}sw.js`],
        ['cp', '-f', '--meta', 'Cache-Control:public, max-age=60, s-maxage=3600', 'index.html', `${origin}index.html`]
      ]);
      const preflights = run.calls.filter(call => call.tool === 'curl' && call.args.includes('--connect-to'));
      assert.deepEqual(preflights.map(call => call.args.slice(-2)), domains.map(host =>
        [`${host}:443:thoradar-online.cn-shenzhen.taihangtop.cn:443`, `https://${host}/`]));
      const actions = run.calls.filter(call => call.tool === 'curl' || call.tool === 'aliyun');
      assert.deepEqual(actions.map(call => call.tool), ['curl', 'curl', 'aliyun', ...urls.map(() => 'curl')]);
      assert.deepEqual(run.refreshes, [['cdn', 'RefreshObjectCaches', '--region', 'cn-shenzhen', '--ObjectType', 'File', '--ObjectPath', refreshUrls.join('\n')]]);
      assert.match(run.stdout, /CDN RefreshTaskId="123456"/);
      assert.deepEqual(run.heads, urls);
      for (const call of actions.slice(3)) {
        assert.ok(call.args.includes('Accept-Encoding: identity'));
        assert.ok(!call.args.some(arg => ['-L', '--location', '--location-trusted'].includes(arg)));
      }
      for (const [url, status] of wwwRedirects.map((url, index) => [url, index === 1 ? 308 : 301])) {
        assert.ok(run.stdout.includes(`Verified ${url} HTTP=${status} Location=${url.replace('www.', '')}\n`));
      }
    });
  }

  for (const scenario of ['refresh-retry', 'id-retry', 'refresh-error', 'missing-task-id']) {
    await test(`CDN ${scenario} uses at most one retry and requires a task ID`, async () => {
      const run = await simulate(scenario);
      assert.equal(run.refreshes.length, 2);
      assert.deepEqual(run.refreshes[0], run.refreshes[1]);
      assert.equal(run.calls.filter(call => call.tool === 'sleep').length, 1);
      if (scenario.endsWith('-retry')) {
        success(run);
        assert.deepEqual(run.heads, urls);
      } else {
        failure(run, /CDN refresh failed or returned no RefreshTaskId/);
        assert.deepEqual(run.heads, []);
      }
    });
  }

  await test('stale www worker is polled before the retirement worker verifies', async () => {
    const run = await simulate('stale-then-current');
    success(run);
    assert.equal(run.heads.filter(url => url === wwwWorkers[0]).length, 2);
    assert.ok(run.stdout.includes(`Waiting for ${wwwWorkers[0]} (1/12)`));
    assert.deepEqual([...new Set(run.heads)], urls);
  });

  await test('main-domain CDN can take six minutes with two 5s sleeps followed by nine 40s sleeps', async () => {
    const run = await simulate('stale-during-propagation', true);
    success(run);
    const workerUrl = refreshUrls[2];
    assert.equal(run.heads.filter(url => url === workerUrl).length, 12);
    assert.ok(run.stdout.includes(`Waiting for ${workerUrl} (1/12)`));
    assert.deepEqual(run.calls.filter(call => call.tool === 'sleep').map(call => call.args),
      [['5'], ['5'], ...Array.from({ length: 9 }, () => ['40'])]);
    assert.deepEqual([...new Set(run.heads)], urls);
  });

  for (const [scenario, url] of [
    ['www-root-200', wwwRedirects[0]],
    ['www-index-200', wwwRedirects[1]],
    ['www-redirect-302', wwwRedirects[0]],
    ['www-redirect-wrong-location', wwwRedirects[0]],
    ['www-redirect-lost-query', wwwRedirects[2]]
  ]) {
    await test(`post-publish verification rejects ${scenario}`, async () => {
      rejectsPublicResponse(await simulate(scenario), url);
    });
  }

  for (const scenario of ['wrong-md5', 'wrong-mime', 'worker-cacheable', 'worker-404', 'head-error',
    'www-active-worker', 'www-worker-html', 'www-worker-redirect']) {
    await test(`post-publish verification rejects ${scenario}`, async () => {
      const run = await simulate(scenario, scenario === 'wrong-md5');
      rejectsPublicResponse(run, scenario === 'worker-cacheable' ? wwwWorkers[1] : wwwWorkers[0]);
    });
  }

  await test('HTTPS origin preflight rejects 304 and blocks CDN refresh', async () => {
    const run = await simulate('preflight-304');
    failure(run, /www\.thoradar\.online 根路径 HTTPS 304/);
    assert.deepEqual(run.refreshes, []);
    assert.deepEqual(run.heads, []);
  });

  await test('failed worker upload blocks index upload and CDN refresh', async () => {
    const run = await simulate('upload-error');
    assert.notEqual(run.status, 0);
    assert.ok(!run.stdout.includes(publishComplete));
    assert.equal(run.uploads.at(-1).at(-1), `${origin}sw.js`);
    assert.deepEqual(run.refreshes, []);
    assert.deepEqual(run.heads, []);
  });
} finally {
  // Only remove this invocation's mkdtemp directory after all shell processes have exited.
  await rm(scratch, { recursive: true, maxRetries: 3, retryDelay: 100 });
}

const summary = { passed: tests.filter(test => test.pass).length, failed: tests.filter(test => !test.pass).length };
await writeFile(output, JSON.stringify({ workflow, shellRuns, tests, simulations, summary }, null, 2) + '\n', { flag: 'wx' });
console.log('SUMMARY ' + JSON.stringify(summary));
if (summary.failed) process.exitCode = 1;
import { createHash } from 'node:crypto';
import { appendFileSync, readFileSync } from 'node:fs';

const [tool, ...args] = process.argv.slice(2);
const { SMOOTH_MOCK_TRACE: trace, SMOOTH_MOCK_SCENARIO: scenario, SMOOTH_RETIRE: retire } = process.env;
const prior = readFileSync(trace, 'utf8').trim().split('\n').filter(Boolean).map(line => JSON.parse(line));
appendFileSync(trace, JSON.stringify({ tool, args }) + '\n');

switch (tool) {
  case 'ossutil': {
    if (!['config', 'mb', 'website', 'cp', 'ls'].includes(args[0])) throw new Error('Unexpected ossutil command');
    if (scenario === 'upload-error' && args.at(-1) === 'oss://thoradar-online/sw.js') process.exit(1);
    break;
  }
  case 'aliyun': {
    const first = !prior.some(entry => entry.tool === 'aliyun');
    if (scenario === 'refresh-error' || (scenario === 'refresh-retry' && first)) process.exit(1);
    const missing = scenario === 'missing-task-id' || (scenario === 'id-retry' && first);
    console.log(JSON.stringify(missing ? { RequestId: 'fixture-request' } : { RefreshTaskId: '123456' }));
    break;
  }
  case 'curl': {
    const url = new URL(args.at(-1));
    if (url.protocol !== 'https:' || !['thoradar.online', 'www.thoradar.online'].includes(url.host)) {
      throw new Error('Unexpected mock curl target');
    }
    if (args.includes('--connect-to')) {
      process.stdout.write(scenario === 'preflight-304' && url.hostname.startsWith('www.') ? '304' : '200');
      break;
    }
    if (!args.includes('-I')) throw new Error('Expected a HEAD request');
    const isWww = url.hostname === 'www.thoradar.online';
    const wwwWorker = isWww && url.pathname === '/sw.js';
    const wwwRetire = isWww && url.pathname === '/sw-retire.js';
    const proxyHeaders = ['HTTP/1.1 200 Connection established', 'Content-MD5: proxy', 'Location: https://proxy.invalid/', ''];
    const servesWwwIndex = (scenario === 'www-root-200' && url.pathname === '/') ||
      (scenario === 'www-index-200' && url.pathname === '/index.html');
    if ((isWww && !wwwWorker && !wwwRetire && !servesWwwIndex) || (wwwWorker && scenario === 'www-worker-redirect')) {
      const status = scenario === 'www-redirect-302' ? '302 Found' :
        url.pathname === '/index.html' ? '308 Permanent Redirect' : '301 Moved Permanently';
      const targetPath = scenario === 'www-redirect-wrong-location' ? '/index.html' : url.pathname;
      const query = scenario === 'www-redirect-lost-query' ? '' : url.search;
      process.stdout.write([...proxyHeaders, `HTTP/2 ${status}`,
        `lOcAtIoN: https://thoradar.online${targetPath}${query}  `, '', ''].join('\r\n'));
      break;
    }
    const wwwWorkerSource = scenario === 'www-active-worker' ? 'sw.js' :
      scenario === 'www-worker-html' ? 'index.html' : 'sw-retire.js';
    const sources = { '/': 'index.html', '/index.html': 'index.html',
      '/sw.js': isWww ? wwwWorkerSource : retire === 'true' ? 'sw-retire.js' : 'sw.js',
      '/sw-retire.js': 'sw-retire.js' };
    const source = sources[url.pathname];
    if (!source) throw new Error('Unexpected mock object');
    const first = !prior.some(entry => entry.tool === 'curl' && entry.args.includes('-I') && entry.args.at(-1) === url.href);
    if (wwwWorker && scenario === 'head-error') process.exit(28);
    const waited = prior.filter(entry => entry.tool === 'sleep').reduce((seconds, entry) => seconds + Number(entry.args[0]), 0);
    const stale = (wwwWorker && (scenario === 'wrong-md5' || (scenario === 'stale-then-current' && first))) ||
      (!isWww && url.pathname === '/sw.js' && scenario === 'stale-during-propagation' && waited < 360);
    const body = stale ? 'stale CDN entry' : readFileSync(source);
    const status = wwwWorker && scenario === 'worker-404' ? '404 Not Found' : '200 OK';
    const mime = source.endsWith('.js') && !(wwwWorker && scenario === 'wrong-mime')
      ? 'Application/JavaScript ; charset=utf-8' : 'text/html; charset=utf-8';
    const cache = source.endsWith('.js') && !(wwwRetire && scenario === 'worker-cacheable')
      ? 'max-age=0, No-Store' : 'public, max-age=60, s-maxage=3600';
    const md5 = createHash('md5').update(body).digest('base64');
    process.stdout.write([
      ...proxyHeaders, `HTTP/2 ${status}`,
      `cOnTenT-mD5: ${md5}  `, `content-type: ${mime}`, `Cache-Control: ${cache}`, '', ''
    ].join('\r\n'));
    break;
  }
  case 'sleep': break;
  default: throw new Error(`Unexpected mock command ${tool}`);
}
# T1128-SMOOTH C2 发布验收合同

签发：PI 在知悉「核心修复完成、线上交付未完成」后原话「继续做」（2026-11-28）。本合同覆盖发布接线、CI 验证闸、正常/退役部署与线上验收准备；实际 push、deploy、CDN 刷新和退役演练唯 PI 当次亲手。

**基底更新（主控实测）**：`git fetch` 发现远端由 `73dd34e` 前进到 `28131f314f92a05227fd5923607d717c426da2c5`，为 2026-11-28 日报 16 文件更新。主仓已用 stash→新分支→stash pop 保留本地候选并同步该远端基底；当前首页含 `briefing_date=2026-11-28`、43 篇，SHA-256=`27ba018a9a3b4936ec734820af8cb505262bd55f41ae382047615f0a58d7c706`。C1 首页哈希仅用于 Sol S5 的「不得改产品」检查，不得再把旧首页当作最终发布内容。最新基底上 S3 9/9、S1 9/9、S2 24/24、UX 46/46 已复跑通过（`release-sync-check/`）。CI 的源码检查必须兼容正常日报数据变化，不得继续机械要求与旧 `73dd34e` 数据逐字一致。

## 不变量
1. 发布接线不得改缓存程序：worker `e882e9e2...394f`、退役版 `5ae38f2b...6199` 保持不变。Sol S5 的输入首页为 C1 哈希 `33c50bef...1def`；最终发布首页必须采用上述最新日报与缓存改动合并版 `27ba018a...c706`，不得回退到旧 40 篇。
2. 不改 `SITE_DATA/PAPERS/mergePapers/inWindow`，不新增 90 天缓存，不改其它对象现有缓存策略。
3. OSS 首页保持 `max-age=60, s-maxage=3600` 并最后上传。两域的 `/sw.js` 与 `/sw-retire.js` 公网响应均须 `200`、JavaScript MIME、`Cache-Control: no-store`，直接验证响应，禁止跟随跳转。
4. `thoradar.online` 为唯一正式域（PI 2026-11-28 G18 签发）。主域根路径、`/index.html` 和两件 worker 发布后均须返回 `200`，并以 `Content-MD5` 对照本次发布的 Git 文件。主域 `/sw.js` 在正常模式对应 `sw.js`，退役模式对应 `sw-retire.js`，正常部署可恢复。主域 `/sw-retire.js` 始终对应 `sw-retire.js`。
5. CDN 仅刷新 `https://thoradar.online` 的 `/`、`/index.html`、`/sw.js`、`/sw-retire.js`。刷新失败或无 `RefreshTaskId` 判红。公网验真最多 12 次，先等两次 5 秒，再每次等 40 秒，第 12 次累计等待 370 秒。
   - `www.thoradar.online` 的 `/`、`/index.html` 和 `/?from=www` 必须返回 `301` 或 `308`，`Location` 必须精确指向 `https://thoradar.online` 的同路径、同查询。
   - `www` 的 `/sw.js` 与 `/sw-retire.js` 在正常、退役两种发布模式中均须匹配 `sw-retire.js` 的 `Content-MD5`，用于旧客户端退出旧缓存。发布时无需刷新 `www`，两条 worker 例外与普通路径永久跳转由 M3 的 CDN 配置提供。
   - 双域源站预检仅检查 SNI 与根路径 `200`。`Publish verified on both domains` 表示主域四个对象与 `www` 三个跳转、两个退役入口均通过公网验真。
6. CI 必须先跑发布静态检查、源码不变量、S1/S2/S3 与 UX，再允许部署；不拿已知 R08 失真测试充数。
7. 任何真实凭证不得打印、传输到测试或提交；静态/模拟测试只用假命令和假应答。

## 独立复核与发布边界
- Sol 只在隔离树改 `.github/workflows/deploy_oss.yml`、`tests/smooth/`、`docs/tasks/T1128-SMOOTH/`。
- Astra 新会话独立复核，亲自跑静态/模拟测试、至少一项撤防负对照与核心回归，不执行真实部署。
- 线上首访/复访/后台更新/离线/单页退出在 PI 发布后由主控用隔离浏览器实测；桌面模拟不得冒充真机/iOS。
- 退役演练会改变公开网站行为，必须另由 PI 当次亲手触发，不在正常发布中自动演练。

