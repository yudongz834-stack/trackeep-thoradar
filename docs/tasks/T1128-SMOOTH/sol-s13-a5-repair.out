    "bashStdin": "set -eu\ncurl() { printf \"%s\" \"$A5_RESPONSE\"; }\nsleep() { :; }\ncheck_object_headers() {\n  awk -v expected=\"$1\" -v worker=\"$2\" '\n    { sub(/\\r$/, \"\") }\n    /^HTTP\\// { status=$2; md5=\"\"; mime=\"\"; cache=\"\"; next }\n    tolower($0) ~ /^content-md5:/ { md5=$0; sub(/^[^:]+:[ \\t]*/, \"\", md5); sub(/[ \\t]+$/, \"\", md5) }\n    tolower($0) ~ /^content-type:/ { mime=tolower($0); sub(/^[^:]+:[ \\t]*/, \"\", mime); sub(/([ \\t]*;.*|[ \\t]+)$/, \"\", mime) }\n    tolower($0) ~ /^cache-control:/ { line=tolower($0); sub(/^[^:]+:[ \\t]*/, \"\", line); cache=cache \",\" line }\n    END {\n      printf \"HTTP=%s Content-MD5=%s expected=%s MIME=%s Cache-Control=%s\", status, md5, expected, mime, cache\n      if (status != 200 || md5 != expected) exit 1\n      if (worker && (mime !~ /^(application|text)\\/(javascript|ecmascript)$/ || cache !~ /,[ \\t]*no-store[ \\t]*(,|$)/)) exit 1\n    }\n  '\n}\n\ncheck_redirect_headers() {\n  awk -v expected=\"$1\" '\n    { sub(/\\r$/, \"\") }\n    /^HTTP\\// { status=$2; location=\"\"; locations=0; next }\n    tolower($0) ~ /^location:/ {\n      locations++\n      location=$0; sub(/^[^:]+:[ \\t]*/, \"\", location); sub(/[ \\t]+$/, \"\", location)\n    }\n    END {\n      printf \"HTTP=%s Location=%s\", status, location\n      if (status != 301 && status != 308) exit 1\n      if (locations != 1 || location != expected) exit 1\n    }\n  '\n}\n\nverify_public() {\n  local url=\"$1\" headers result attempt\n  shift\n  for attempt in {1..12}; do\n    # \u8bfb\u53d6\u9996\u4e2a\u516c\u7f51\u54cd\u5e94\uff0c\u4e0d\u8ddf\u968f\u8df3\u8f6c\u3002-q \u7981\u6b62 curl \u914d\u7f6e\u6587\u4ef6\u8986\u76d6\u547d\u4ee4\u884c\u4e3a\u3002\n    if headers=$(curl -q -sS -I -H 'Accept-Encoding: identity' --connect-timeout 5 --max-time 10 \"$url\"); then\n      if result=$(\"$@\" <<< \"$headers\"); then\n        echo \"Verified $url $result\"\n        return 0\n      fi\n    else\n      result='HEAD request failed'\n    fi\n    echo \"Waiting for $url ($attempt/12) $result\"\n    # CDN \u5237\u65b0\u4ece\u63d0\u4ea4\u5230\u751f\u6548\u7ea6\u9700 5\u20136 \u5206\u949f\u3002\u4e24\u6b21\u77ed\u7b49\u540e\u62c9\u957f\u95f4\u9694\uff0c\u672b\u6b21\u81f3\u5c11\u5728 370 \u79d2\u540e\u3002\n    if (( attempt <= 2 )); then\n      sleep 5\n    elif (( attempt < 12 )); then\n      sleep 40\n    fi\n  done\n  echo \"Verification failed for $url\" >&2\n  return 1\n}\n\nverify_object() {\n  local url=\"$1\" source=\"$2\" worker=\"$3\" expected\n  expected=$(openssl dgst -md5 -binary \"$source\" | openssl base64 -A)\n  verify_public \"$url\" check_object_headers \"$expected\" \"$worker\"\n}\n\nverify_object https://www.thoradar.online/sw-retire.js sw-retire.js 1\n",
    "response": "HTTP/2 308 Permanent Redirect\r\nLocation: https://thoradar.online/sw-retire.js\r\n\r\n",
    "expectedExit": 1,
    "exit": 1,
    "stdout": "Waiting for https://www.thoradar.online/sw-retire.js (1/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (2/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (3/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (4/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (5/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (6/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (7/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (8/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (9/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (10/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (11/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\nWaiting for https://www.thoradar.online/sw-retire.js (12/12) HTTP=308 Content-MD5= expected=xviHOEexQQLp0q41sv2uuA== MIME= Cache-Control=\n",
