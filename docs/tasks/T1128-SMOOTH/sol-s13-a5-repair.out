exec
"C:\\Program Files\\PowerShell\\7\\pwsh.exe" -Command "@'
import json
from pathlib import Path
import subprocess

evidence = Path(\"docs/tasks/T1128-SMOOTH/online-release/sol-s13\")
def read(name):
    return json.loads((evidence / name).read_bytes())
def summary(report):
    return \"SUMMARY \" + json.dumps(report[\"summary\"], separators=(\",\", \":\"))
def relevant(run):
    return [line for line in run[\"stdout\"].splitlines() if \" (12/12) \" in line or line.startswith(\"Verified \")]
deploy = read(\"deploy.json\")
focused = read(\"focused-replay.json\")
source = read(\"source.json\")
assert deploy[\"summary\"] == {\"passed\": 32, \"failed\": 0}
assert source[\"summary\"] == {\"passed\": 5, \"failed\": 0}
print((evidence / \"deploy.run.txt\").read_text(encoding=\"utf-8-sig\").strip())
print(f\"Canonical {deploy['summary']['passed']}/{len(deploy['tests'])}\")
print(summary(deploy))
print(\"source --ci \" + summary(source))
host = read(\"skip-host.json\")
print(\"skip-host suite exit=\" + str(host[\"status\"]) + \", publish exit=\" + str(host[\"scenarios\"][\"www-redirect-wrong-host\"][\"status\"]))
print(\"A5 focused replay: python docs/tasks/T1128-SMOOTH/online-release/sol-s13/replay.py .git/t1128-s13-worktree focused\")
print(\"Git HEAD \" + focused[\"head\"])
for name, hashes in focused[\"fixtures\"].items():
    print(name, \"Git blob\", hashes[\"gitBlob\"], \"CRLF checkout\", hashes[\"crlfCheckout\"])
for run in focused[\"runs\"]:
    print(run[\"version\"], run[\"case\"], \"exit=\" + str(run[\"status\"]))
    for line in relevant(run): print(line)
    if run[\"stderr\"]: print(run[\"stderr\"].rstrip())
print()
for name in (
    \"git-blob-unavailable\", \"wrong-md5-retire\", \"www-active-worker\", \"www-redirect-302\",
    \"www-redirect-wrong-location\", \"www-redirect-lost-query\", \"stale-during-propagation-retire\",
):
    run = deploy[\"simulations\"][name]
    print(name, \"exit=\" + str(run[\"status\"]))
    if run[\"stderr\"]: print(run[\"stderr\"].rstrip())
    if name == \"stale-during-propagation-retire\":
        sleeps = [int(c[\"args\"][0]) for c in run[\"calls\"] if c[\"tool\"] == \"sleep\"]
        heads = sum(1 for c in run[\"calls\"] if c[\"tool\"] == \"curl\" and \"-I\" in c[\"args\"] and c[\"args\"][-1] == \"https://thoradar.online/sw.js\")
        assert heads == 12 and sum(sleeps) == 370
        print(\"sw.js HEAD\", heads, \"sleep calls\", sleeps, \"total\", sum(sleeps), \"seconds\")
    elif relevant(run):
        print(relevant(run)[-1])
print()
for name in (\"working-tree-md5\", \"skip-host\", \"ignore-homepage-mime\", \"www-refresh\", \"www-allow-302\",
             \"www-active-worker\", \"skip-md5-comparison\", \"short-propagation\"):
    run = read(f\"{name}.json\")
    assert run[\"status\"] == 1
    print(name, \"suite exit=\" + str(run[\"status\"]), summary(run))
    print(subprocess.list2cmdline(run[\"command\"]))
    for scenario, result in run[\"scenarios\"].items():
        print(scenario, \"publish exit=\" + str(result[\"status\"]))
    print((evidence / f\"{name}.stderr.txt\").read_text(encoding=\"utf-8\").rstrip())
