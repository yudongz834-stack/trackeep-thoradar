import hashlib
from pathlib import Path
import subprocess
main = Path.cwd()
wt = main / \".git/t1128-s13-worktree\"
evidence = main / \"docs/tasks/T1128-SMOOTH/online-release/sol-s13\"
patch = evidence / \"canonical.patch\"
products = (\"index.html\", \"sw.js\", \"sw-retire.js\")
code = (
    \".github/workflows/deploy_oss.yml\", \"docs/tasks/T1128-SMOOTH/release-contract.md\",
    \"tests/smooth/deploy-mock.mjs\", \"tests/smooth/verify-deploy.mjs\",
)
with (evidence / \"git-checks.txt\").open(\"w\", encoding=\"utf-8\") as log:
    def record(message):
        print(message)
        print(message, file=log)
    def run(cwd, *args):
        command = [\"git\", *args]
        record(\"> \" + subprocess.list2cmdline(command) + \" [cwd=\" + str(cwd) + \"]\")
        result = subprocess.run(command, cwd=cwd, capture_output=True, text=True, encoding=\"utf-8\")
        for stream in (result.stdout, result.stderr):
            if stream:
                record(stream.rstrip())
        record(f\"exit={result.returncode}\")
        result.check_returncode()
        return result.stdout.strip()
    head = run(main, \"rev-parse\", \"HEAD\")
    assert run(wt, \"rev-parse\", \"HEAD\") == head
    run(wt, \"diff\", \"--check\")
    run(wt, \"diff\", \"--check\", \"HEAD\")
    assert set(run(wt, \"diff\", \"--name-only\", \"HEAD\").splitlines()) == set(code)
    for root in (main, wt):
        run(root, \"diff\", \"HEAD\", \"--exit-code\", \"--\", *products)
        run(root, \"ls-files\", \"--eol\", \"--\", *products)
        for path in products:
            assert run(root, \"hash-object\", f\"--path={path}\", path) == run(root, \"rev-parse\", f\"HEAD:{path}\")
    for path in code:
        assert run(main, \"hash-object\", f\"--path={path}\", path) == run(wt, \"rev-parse\", f\":{path}\")
    run(wt, \"diff\", \"--binary\", f\"--output={patch}\", \"--\", *code)
    run(main, \"apply\", \"--stat\", str(patch))
    run(main, \"apply\", \"--check\", \"--whitespace=error\", str(patch))
    for path in (\"astra-v5/focused.json\", \"astra-v5/skip-host.diff\", \"online-release/main-s12-deploy.json\"):
        actual = main / \"docs/tasks/T1128-SMOOTH\" / path
        record(f\"sha256 {path} {hashlib.sha256(actual.read_bytes()).hexdigest()}\")
'@ | python -" in D:\trackeep\trackeep-product\trackeep-thoradar
