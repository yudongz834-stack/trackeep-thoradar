1748:   const journals=journalUniverse(tierBase.concat(poolForJournals));
1749:   const scheme=activeScheme();
1750:   const keyMap=scheme?schemeKeyMap(scheme):null;
1751:   const assignOf=keyMap?p=>sectorAssign(scheme,keyMap,p):jcatOf;        // 方案激活＝自定义归属驱动盘面（topic 态走 kw 纯函数，零网络）；否则官方阵地
1752:   const allGroups=keyMap?schemeUniverse(tierBase,scheme,keyMap):jcatUniverse(tierBase);
1753:   const groups=keyMap?allGroups.filter(g=>!g.folded):allGroups.filter(g=>!state.jcatFolded.has(g.cat));   // 折叠阵地不出扇区
1754:   const groupCats=new Set(groups.map(g=>g.cat));
