diff --git a/docs/tasks/T1128-SMOOTH/run-sol-s1.ps1 b/docs/tasks/T1128-SMOOTH/run-sol-s1.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..16ae13e372770f71534c7529283b1e31d1994337
--- /dev/null
+++ b/docs/tasks/T1128-SMOOTH/run-sol-s1.ps1
@@ -0,0 +1,33 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)]
+    [ValidatePattern('^[a-zA-Z0-9-]+$')]
+    [string]$RunId,
+    [ValidateSet('none', 'no-local-return', 'allow-truncated')]
+    [string]$Mutation = 'none'
+)
+
+$ErrorActionPreference = 'Stop'
+$root = (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '..\..\..')).Path
+$harness = Join-Path $root 'tests\smooth\verify-s1.mjs'
+$stem = Join-Path $PSScriptRoot "sol-s1-$RunId"
+$jsonPath = "$stem.json"
+$stdoutPath = "$stem.stdout.txt"
+$stderrPath = "$stem.stderr.txt"
+foreach ($item in @($jsonPath, $stdoutPath, $stderrPath)) {
+    if (Test-Path -LiteralPath $item) { throw "Evidence already exists at $item. Use a fresh RunId." }
+}
+
+$node = (Get-Command node -CommandType Application).Source
+$arguments = @(('"{0}"' -f $harness), ('"{0}"' -f $jsonPath), $Mutation)
+$process = Start-Process -FilePath $node -ArgumentList $arguments -WorkingDirectory $root -WindowStyle Hidden `
+    -RedirectStandardOutput $stdoutPath -RedirectStandardError $stderrPath -Wait -PassThru
+[pscustomobject]@{
+    RunId = $RunId
+    Mutation = $Mutation
+    ExitCode = $process.ExitCode
+    JSON = $jsonPath
+    Stdout = $stdoutPath
+    Stderr = $stderrPath
+} | ConvertTo-Json -Compress
+exit $process.ExitCode
