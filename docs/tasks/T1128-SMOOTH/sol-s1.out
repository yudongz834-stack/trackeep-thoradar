/* T1127-SMOOTH 原型：只给同源无查询导航做本地先开；其它请求回到原生网络与 HTTP 缓存。 */
const CACHE='thoradar-shell-v1',PREFIX='thoradar-shell-',INDEX=new URL('./index.html',self.location).href,pending=new Map();
const notify=async message=>{
  try{
    const clients=await self.clients.matchAll({type:'window',includeUncontrolled:true});
    clients.forEach(client=>client.postMessage(message));
  }catch(_){}
};
const debug=(stage,detail={})=>notify({type:'thoradar-debug',stage,...detail});
async function openCache(){try{return await caches.open(CACHE)}catch(_){return null}}
async function fetchIndex(cacheMode,url=INDEX){
  const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),8000);
  try{
    const response=await fetch(new Request(url,{cache:cacheMode,credentials:'same-origin',signal:controller.signal}));
    let text='',valid=false;
    if(response.ok&&response.type==='basic'&&(response.headers.get('Content-Type')||'').includes('text/html')){
      text=await response.clone().text();
      valid=text.includes('/*__THORADAR_DATA_START__*/')&&text.includes('/*__THORADAR_DATA_END__*/')&&text.trimEnd().endsWith('</html>');
    }
    return {response,text,valid};
  }catch(_){return {response:null,text:'',valid:false}}
  finally{clearTimeout(timer)}
}
self.addEventListener('message',event=>{
  if(event.data?.type!=='thoradar-shell-status')return;
  const client=event.source,entry=client&&pending.get(client.id);
  if(entry){client.postMessage(entry.message);pending.delete(client.id)}
});
self.addEventListener('install',event=>{
  event.waitUntil((async()=>{
    const cache=await openCache();if(!cache)return;
    const result=await fetchIndex('reload');
    if(result.valid)try{await cache.put(INDEX,result.response.clone())}catch(_){}
  })());
});
self.addEventListener('activate',event=>{
  event.waitUntil((async()=>{
    const keys=await caches.keys();
    await Promise.all(keys.filter(k=>k.startsWith(PREFIX)&&k!==CACHE).map(k=>caches.delete(k)));
  })());
});
self.addEventListener('fetch',event=>{
  const req=event.request,url=new URL(req.url);
  if(req.method!=='GET'||req.mode!=='navigate'||url.origin!==self.location.origin)return;
  if(url.pathname!=='/'&&url.pathname!=='/index.html')return;
  if(url.search&&url.searchParams.get('sw')!=='1')return;
  const clientId=event.resultingClientId||event.clientId;
  const report=async(message,broadcast=false)=>{
    if(clientId){
      pending.set(clientId,{message,at:Date.now()});
      while(pending.size>20)pending.delete(pending.keys().next().value);
    }
    if(broadcast){await notify(message);return}
    try{const client=await self.clients.get(clientId);if(client)client.postMessage(message)}catch(_){}
  };
  const cachePromise=openCache(),cachedPromise=cachePromise.then(async cache=>{
    if(!cache)return null;
    try{const response=await cache.match(INDEX);return response?{page:response.clone(),compare:response.clone()}:null}catch(_){return null}
  });
  const network=(async()=>{
    try{
      const [cache,cached]=await Promise.all([cachePromise,cachedPromise]);
      const result=await fetchIndex('reload',req.url);
      await debug('fetch-complete',{ok:!!result.response,valid:result.valid});
      if(!result.response){if(cached)await report({type:'thoradar-shell-stale',reason:'offline'});return null}
      if(result.valid&&cache){
        try{
          const changed=cached?(await cached.compare.text())!==result.text:false;
          await cache.put(INDEX,result.response.clone());
          await debug('cache-put',{changed});
          if(cached)await report(changed?{type:'thoradar-shell-update'}:{type:'thoradar-shell-fresh'},changed);
        }catch(error){
          await debug('cache-write-failed',{message:String(error)});
          if(cached)await report({type:'thoradar-shell-stale',reason:'save-failed'});
        }
      }else if(cached)await report({type:'thoradar-shell-stale',reason:'invalid'});
      return result.response;
    }catch(error){await debug('network-error',{message:String(error)});return null}
  })();
  event.waitUntil(network.then(()=>{}));
  event.respondWith((async()=>{
    const cached=await cachedPromise;
    if(cached)return cached.page;
    const response=await network;
    return response||new Response('<!doctype html><meta charset="utf-8"><title>胸科雷达</title><p>当前离线，且本机还没有可用副本。请联网后重试。</p>',{status:503,headers:{'Content-Type':'text/html; charset=utf-8'}});
  })());
});
