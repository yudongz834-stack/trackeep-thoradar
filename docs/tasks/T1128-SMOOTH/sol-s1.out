+<script>
+(() => {
+  const { hostname, protocol, pathname, search, searchParams } = new URL(location.href);
+  if (pathname !== '/' && pathname !== '/index.html') return;
+  const disable = searchParams.getAll('sw').includes('0');
+  const optIn = searchParams.size === 1 && searchParams.get('sw') === '1';
+  const production = protocol === 'https:' && (hostname === 'thoradar.online' || hostname.endsWith('.thoradar.online'));
+  const local = ['localhost', '127.0.0.1', '[::1]'].includes(hostname);
+  const worker = navigator.serviceWorker;
+  const workerUrl = new URL('/sw.js', location.origin).href;
+  const controller = worker?.controller?.scriptURL === workerUrl ? worker.controller : null;
+  const canRegister = production || (local && optIn);
+  if (!disable && ((search && !optIn) || (!canRegister && !(local && controller)))) return;
+
+  const banner = document.getElementById('shell-status');
+  const labels = {
+    network: ['联网打开', 'Opened over the network'],
+    checking: ['本地副本 · 核对更新中', 'Local copy · Checking for updates'],
+    current: ['本地副本 · 已核对，与服务器一致', 'Local copy · Matches the server'],
+    updated: ['有新版，下次打开生效', 'Update available on your next visit'],
+    unavailable: ['本地副本 · 暂未核实更新', 'Local copy · Could not check for updates'],
+    disabled: ['本地副本已停用', 'Local copy disabled'],
+    disableFailed: ['未能停用本地副本', 'Could not disable the local copy']
+  };
+  const date = SITE_DATA.briefing_date || String(SITE_DATA.generated_at || '').slice(0, 10);
+  let status = 'network';
+  function renderStatus() {
+    const english = LANG === 'en';
+    const dataDate = date || (english ? 'Unknown' : '日期未知');
+    banner.textContent = `${english ? 'Data' : '数据'} ${dataDate} · ${labels[status][english ? 1 : 0]}`;
+    banner.hidden = false;
+  }
+  function show(next) {
+    status = next;
+    renderStatus();
+  }
+  document.getElementById('lang-btn').addEventListener('click', renderStatus);
+  show('network');
+
+  if (disable) {
+    (async () => {
+      if (worker) {
+        const registrations = await worker.getRegistrations();
+        await Promise.all(registrations.map(registration => registration.unregister()));
+      }
+      if ('caches' in window) {
+        const names = await caches.keys();
+        await Promise.all(names.filter(name => name.startsWith('thoradar-shell-')).map(name => caches.delete(name)));
+      }
+      show('disabled');
+    })().catch(() => show('disableFailed'));
+    return;
+  }
+  if (!worker) return;
+
+  if (controller) {
+    show('checking');
+    const replyTimeout = setTimeout(() => show('unavailable'), 12000);
+    worker.addEventListener('message', event => {
+      if (event.source !== controller || event.data?.type !== 'thoradar-shell-state') return;
+      const next = event.data.status;
+      if (!['network', 'checking', 'current', 'updated', 'unavailable'].includes(next)) return;
+      if (next !== 'checking') clearTimeout(replyTimeout);
+      show(next);
+    });
+    controller.postMessage({ type: 'thoradar-shell-status' });
+  }
+  if (canRegister) worker.register(workerUrl, { updateViaCache: 'none' }).catch(() => {});
+})();
+</script>
 </body>
 </html>
diff --git a/sw.js b/sw.js
new file mode 100644
index 0000000000000000000000000000000000000000..d284b06c8717945383824820432a7d4dcff7b739
--- /dev/null
+++ b/sw.js
@@ -0,0 +1,97 @@
+const CACHE_PREFIX = 'thoradar-shell-';
+const CACHE_NAME = `${CACHE_PREFIX}v1`;
+const SHELL_URL = new URL('/index.html', self.location.origin).href;
+const DATA_START = '/*__THORADAR_DATA_START__*/';
+const DATA_END = '/*__THORADAR_DATA_END__*/';
+const statuses = new Map();
+let refreshTail = Promise.resolve();
+
+async function fetchShell(url) {
+  const response = await fetch(url, { cache: 'reload', signal: AbortSignal.timeout(8000) });
+  if (!response.ok || response.type !== 'basic' ||
+      !(response.headers.get('Content-Type') || '').toLowerCase().includes('text/html')) return null;
+
+  const html = await response.clone().text();
+  const start = html.indexOf(DATA_START);
+  if (start === -1 || html.indexOf(DATA_END, start + DATA_START.length) === -1 ||
+      !html.trimEnd().toLowerCase().endsWith('</html>')) return null;
+  return { response, html };
+}
+
+async function checkForUpdate(cache, url, displayed) {
+  try {
+    const fresh = await fetchShell(url);
+    if (!fresh) return 'unavailable';
+    const stored = await cache.match(SHELL_URL);
+    if (!stored || await stored.text() !== fresh.html) await cache.put(SHELL_URL, fresh.response);
+    return displayed && await displayed.text() !== fresh.html ? 'updated' : 'current';
+  } catch (_) {
+    return 'unavailable';
+  }
+}
+
+function remember(clientId, status) {
+  if (!clientId) return;
+  statuses.delete(clientId);
+  statuses.set(clientId, status);
+  if (statuses.size > 64) statuses.delete(statuses.keys().next().value);
+}
+
+function sendStatus(client, status) {
+  client?.postMessage({ type: 'thoradar-shell-state', status });
+}
+
+self.addEventListener('message', event => {
+  if (event.data?.type !== 'thoradar-shell-status' || event.source?.type !== 'window') return;
+  sendStatus(event.source, statuses.get(event.source.id) || 'unavailable');
+});
+
+self.addEventListener('install', event => {
+  event.waitUntil((async () => {
+    const cache = await caches.open(CACHE_NAME);
+    const fresh = await fetchShell(SHELL_URL);
+    if (fresh && !await cache.match(SHELL_URL)) await cache.put(SHELL_URL, fresh.response);
+  })().catch(() => {}));
+});
+
+self.addEventListener('activate', event => {
+  event.waitUntil((async () => {
+    const names = await caches.keys();
+    await Promise.all(names.filter(name => name.startsWith(CACHE_PREFIX) && name !== CACHE_NAME)
+      .map(name => caches.delete(name)));
+  })().catch(() => {}));
+});
+
+self.addEventListener('fetch', event => {
+  const request = event.request;
+  if (request.method !== 'GET' || request.mode !== 'navigate') return;
+  const url = new URL(request.url);
+  if (url.origin !== self.location.origin || (url.pathname !== '/' && url.pathname !== '/index.html')) return;
+  // A single test opt-in is cacheable. Other query variants retain native navigation.
+  if (url.search && !(url.searchParams.size === 1 && url.searchParams.get('sw') === '1')) return;
+
+  const clientId = event.resultingClientId;
+  const lookup = (async () => {
+    const cache = await caches.open(CACHE_NAME);
+    const page = await cache.match(SHELL_URL);
+    return { cache, page, displayed: page?.clone() };
+  })().catch(() => null);
+
+  event.respondWith(lookup.then(entry => {
+    remember(clientId, entry?.page ? 'checking' : 'network');
+    if (entry?.page) return entry.page;
+    return fetch(request);
+  }));
+
+  // Keep writes ordered when multiple tabs ask for a check. Cache hits never wait for this queue.
+  const refresh = refreshTail.then(async () => {
+    const entry = await lookup;
+    if (!entry) return;
+    const status = await checkForUpdate(entry.cache, request.url, entry.displayed);
+    if (!entry.displayed || !clientId) return;
+    remember(clientId, status);
+    sendStatus(await self.clients.get(clientId), status);
+  });
+  refreshTail = refresh.catch(() => {});
+  event.waitUntil(refreshTail);
+});
