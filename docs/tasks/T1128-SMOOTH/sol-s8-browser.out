"'$combined=$report+$evidence
$present=@($privateValues | Where-Object { $_ -and $combined.Contains($_) }).Count
$head=$report -split '"'\\r?\\n'
"'$redactionOk=($present -eq 0 -and @($privateValues | Where-Object { $_ }).Count -eq 3 -and $combined.Contains('"'<CDN_OWNER_ACCOUNT_ID>') -and "'$combined -notmatch '"'\\d{12,20}')
