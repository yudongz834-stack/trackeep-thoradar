"'$deliveryOk=($report -match '"'(?m)"'^DELIVERY-T1128-SMOOTH-S8'"\\r?\\n["'^'"\\r\\n]+"'$'"')
[ordered]@{reportHead="'$fieldsOk;deliveryMarkerAndRestatement=$deliveryOk;redaction=$redactionOk;evidenceLinkTarget=(Test-Path -LiteralPath $ePath)} | ConvertTo-Json -Compress
