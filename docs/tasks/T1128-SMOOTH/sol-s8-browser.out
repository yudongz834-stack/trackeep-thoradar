async function proxy(route, body) {
  const response=await fetch('http://127.0.0.1:3456/'+route+'?target='+targetId,
    {method:body===undefined?'GET':'POST',body,signal:AbortSignal.timeout(8000)});
  const value=await response.json();
  if("'!response.ok||value.error) fail('"'proxy_'+route+'_failed');
  return value;
