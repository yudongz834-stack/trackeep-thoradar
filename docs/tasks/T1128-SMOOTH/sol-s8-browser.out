        await cdp('Browser.setClipboardContents',{contents:expected});
      }catch(e){
        if(e.message"'!=='"'Browser.setClipboardContents_cdp_-32601') throw e;
        clipboard='Set-Clipboard';
        const run=spawnSync('pwsh',['-NoProfile','-NonInteractive','-Command','Set-Clipboard -Value ([Console]::In.ReadToEnd())'],{input:expected,encoding:'utf8',timeout:4000,windowsHide:true});
        if(run.status"'!==0) fail('"'windows_clipboard_write_failed');
        clear=true;
      }
      try{
        if("'!safe(await inspect('"'document.hasFocus()&&"'!!document.activeElement?.closest(".monaco-editor")'"'))) fail('editor_lost_focus');
        await key('a','KeyA',65,2);
        await key('v','KeyV',86,2);
        await pause(550);
        const readback=await editorCheck();
        const enabledConfirm=safe(await inspect(maybeConfirm+'.length'));
        out({clipboard,readback,enabledConfirm});
        if("'!readback.scopeExact||!readback.sourceTextEquivalent) process.exitCode=2;
      } finally {
        if(clear) spawnSync('"'pwsh',['-NoProfile','-NonInteractive','-Command','Set-Clipboard -Value ([string]::Empty)'],{stdio:'ignore',timeout:4000,windowsHide:true});
        else await cdp('Browser.setClipboardContents',{contents:''}).catch(()=>{});
      }
    } else {
      fail('unknown_mode');
    }
    await cdp('Target.detachFromTarget',{sessionId}).catch(()=>{});
  }
} catch(e){
  const message=/"'^[A-Za-z0-9_.-]+$/.test(e.message)?e.message:'"'unexpected_guarded_error';
  out({error:message});
  process.exitCode=1;
} finally {
  ws?.close();
}

