# 胸科雷达 ThorRadar 环境变量示例
# 本地使用：复制为 .env 并填入（注意：引擎不自动读 .env，本地请直接设环境变量；
# GitHub Actions 上：把以下变量配置到仓库 Settings -> Secrets and variables -> Actions）

# 1. 大模型接口（OpenAI 兼容；不填则自动降级为启发式模式，功能诚实受限）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 2. LLM 单价（每百万 token，美元）——用于成本熔断估算
LLM_PRICE_IN=0.27
LLM_PRICE_OUT=1.10

# 3. 每日 LLM 成本熔断上限（美元）
MAX_DAILY_COST_USD=0.10

# 4. NCBI E-utilities API Key（选填；免费申请，3 req/s -> 10 req/s）
NCBI_API_KEY=
